@using BIZ
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.CONTENT_FULL
@{
    var langpage = WorkContext.GetLanguage();
}

<div class="video-page pb60 mt20 container">
    <h2 class="title-cm01"><a href="/trang-chu-video">Video</a></h2>
    <div class="video-big mt30">
        <div class="row">
            <div class="col-md-7 col-sm-12">
                <div class="movie">
                    <iframe src="@(Model.Url.Replace("watch?v=", "embed/"))" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position: absolute; top: 0px; right: 0px; bottom: 0px; left: 0px; width: 100%; height: 100%;"></iframe>
                </div>
            </div>
            <div class="col-md-5 col-sm-12">
                <h3 class="big-name text-white">@Model.Title</h3>
                <p class="date-txt mt15 text-white">@Model.PublishDate.ToString("dd/MM/yyyy")</p>
                <p class="mt15 text-white">
                    @Model.IntroText
                </p>
            </div>
        </div>
    </div>
    <div>
        @Html.Action("LoadVideo", "Video", new { VideoId = Model.Id, page = 1, CategoryId = ViewBag.CategoryId })

    </div>
    
</div><!-- end main content-->





<script type="text/javascript">


    $('#menu_66').addClass("active");

</script>
