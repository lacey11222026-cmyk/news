@using BIZ
@using DATA
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.DOCUMENT_FULL
@{
    var langpage = WorkContext.GetLanguage();
}

<div class="document-page container mt20">
      <div class="row">
          <div class="col-lg-8 col-md-12 pb40">
              @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
              <div class="mt30 document-table document-detail">
                  <table>
                      <tbody>
                          <tr>
                              <td><b>Số ký hiệu</b></td>
                              <td> @Html.Raw(Model.Code)</td>
                          </tr>
                          <tr>
                              <td><b>Tên văn bản</b></td>
                              <td> @Html.Raw(Model.Name)</td>
                          </tr>
                          <tr>
                              <td><b>Chi tiết văn bản </b></td>
                              <td>@Html.Raw(Model.Description)</td>
                          </tr>
                          <tr>
                              <td><b>Ngày ban hành</b></td>
                              <td>  @Convert.ToDateTime(Model.PublishDate).ToString(@" dd'/'MM'/'yyyy")</td>
                          </tr>
                          <tr>
                              <td><b>Ngày hiệu lực</b></td>
                              <td>
                                  @if (!Model.EffectiveDate.HasValue)
                                  {

                                      <text>&nbsp;</text>
                                  }
                                  else
                                  {
                                      if (Model.EffectiveDate.Value.Year < 9000)
                                      {
                                          @Convert.ToDateTime(Model.EffectiveDate).ToString(@" dd'/'MM'/'yyyy")
                                      }
                                      else
                                      {
                                          <text>&nbsp;</text>
                                      }

                                  }
                              </td>
                          </tr>
                          <tr>
                              <td><b>Ngày hết hiệu lực</b></td>
                              <td>
                                  @if (!Model.ExpiryDate.HasValue)
                                  {

                                      <text>&nbsp;</text>
                                  }
                                  else
                                  {
                                      if (Model.ExpiryDate.Value.Year < 9000)
                                      {
                                          @Convert.ToDateTime(Model.ExpiryDate).ToString(@" dd'/'MM'/'yyyy")
                                      }
                                      else
                                      {
                                          <text>&nbsp;</text>
                                      }

                                  }
                              </td>
                          </tr>
                          <tr>
                              <td><b>Loại văn bản</b></td>
                              <td> @HtmlHelpers.GetDocType(Model.Type)</td>
                          </tr>
                          <tr>
                              <td><b>Lĩnh vực</b></td>
                              <td> @HtmlHelpers.GetDocArea(Model.Area)</td>
                          </tr>
                          <tr>
                              <td><b>Cơ quan ban hành</b></td>
                              <td> @HtmlHelpers.GetDocAgent(Model.Agent)</td>
                          </tr>
                          <tr>
                              <td><b>Người ký duyệt</b></td>
                              <td>@Model.SignedBy</td>
                          </tr>
                          <tr>
                              <td><b>Tệp đính kèm</b></td>
                              <td style="text-align:left"><a href="@Url.Action("DownloadFile","Document",new { id=Model.Id})" class="document-view textlink"><img src="/Content/images/ico-pdf02.png" alt=""></a></td>
                          </tr>
                      </tbody>
                  </table>
              </div>
          </div><!-- end content left-->

          <div class="col-lg-4 col-md-12">
              <div class="noti-box">
                  @{Html.RenderAction("RightLastestNews2", "News", new { CateName = "", CategoryId = 93, MaxLastestNews = 3, cssClass = "maxheight02" });}

              </div>
              <ul class="link-list mt20">
                  @{Html.RenderAction("BannerRight", "Home", new { lang = langpage });}

              </ul>
          </div>
      </div>
</div>
<!-- end content-->
  <script type="text/javascript">

 $('#menu_' + '@ViewBag.CurrentCategoryId').addClass("active");

  $('#menu_' + '@ViewBag.ParentCategoryId').addClass("active");



  </script>