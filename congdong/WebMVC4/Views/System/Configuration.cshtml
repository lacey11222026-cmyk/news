                                <h4 class="panel-title"><i class="fa fa-wrench" style="margin-right:7px"></i>Thông Tin Cơ Bản</h4>
                            </div>*@
                        <div style="padding: 10px 0 0 0;background-color:#fff !important">

                            <div class="col-md-12">
                                <div>
                                    <!-- dành cho UpdateFunction -->
                                    @*<div class="form-group">
                                        <label for="ExchangeRate" class="control-label col-md-3">LƯỢNG TIẾT KIỆM NĂNG LƯỢNG :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="Result1" name="appSettings" class="form-control" cols="20" style="height: 90px;font-size: 13px;font-weight: bold">@Result1</textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="InterestRate" class="control-label col-md-3">LƯỢNG GIẢM PHÁT THẢI :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="Result2" name="appSettings" class="form-control" style="height: 90px;font-size: 13px;font-weight: bold" cols="20">@Result2</textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="InterestRate" class="control-label col-md-3">GIẢI NGÂN :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="Result3" name="appSettings" class="form-control" style="height: 90px;font-size: 13px;font-weight: bold" cols="20">@Result3</textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="InterestRate" class="control-label col-md-3">Số doanh nghiệp hưởng lợi :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="Result4" name="appSettings" class="form-control" style="height: 90px;font-size: 13px;font-weight: bold" cols="20">@Result4</textarea>

                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="InterestRate" class="control-label col-md-3">Số tiểu dự án được hỗ trợ :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="Result5" name="appSettings" class="form-control" style="height: 90px;font-size: 13px;font-weight: bold" cols="20">@Result5</textarea>

                                            </div>
                                        </div>
                                    </div>*@

                                    <div class="panel-footer form-horizontal">
                                        <div class="form-group submit">


                                            <button type="button" class="btn btn-primary" id="btsubmit" onclick="SaveAppSettings()" style="display:none"><i class="fa fa-save"></i>Lưu lại</button>
                                            <button type="button" class="btn btn-primary" id="btsubmit2" onclick="FlushCache()" ><i class="fa fa-save"></i>Xóa cache</button>
                                        </div>
                                    </div>


                                </div>
                            </div>
                            <div style="clear:both"></div>
                        </div>

