}
else
{
    <div id="document" class="main-content">
        <iframe src="https://docs.google.com/gview?url=https://media.vtkmedia.vn/Images/Profile%20VTK_ENG_Final.pdf&embedded=true" style="width: 100%; height: 1000px; border: 0px none;" id="source"></iframe>



