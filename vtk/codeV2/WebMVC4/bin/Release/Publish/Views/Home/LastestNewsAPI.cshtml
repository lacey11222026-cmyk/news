
@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewsApiModel
@if (Model.lstdata != null)
{
    if (Model.lstdata.Count > 0)
    {

        <div class="@Model.Css">
            <div class="maxheight07">
                <h2 class="title-cm">
                    <a href="@Model.Url" target="_blank">@Model.HeaderTitle</a>
                </h2>
            </div>

            @foreach (var item in Model.lstdata.Take(1).Select((value, i) => new { i, value }))
            {
                <a href="@item.value.LinkUrl" target="_blank">
                    @*<img src="/Content2/images/img-item01.jpg" alt="" class="mt10">*@
                    <img alt="@item.value.Title" src="@item.value.MainImage?w=360&h=210&mode=crop" style="width: auto" class="mt10" />
                </a>
                <h3>
                    <a href="@item.value.LinkUrl" target="_blank">@item.value.Title</a>
                </h3>
                <p>@item.value.IntroText</p>
            }
        </div>
        <ul class="item-news-list">
            @foreach (var item in Model.lstdata.Skip(1).Take(2).Select((value, i) => new { i, value }))
            {
            <li> <a href="@item.value.LinkUrl" target="_blank">@item.value.Title</a></li>
            }

        </ul>

    }
}