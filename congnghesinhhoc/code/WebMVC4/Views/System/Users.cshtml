@{

    Layout = "~/Views/Shared/_AdminV2.cshtml";

}
@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.UserModel

@{
    ViewBag.Title = "Danh sách user";
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <form method="get" action="@Url.Action("Users", "System")">
                    <div class="row" id="form">
                        <div class="form-group col-md-3 col-xs-12 col-sm-6">
                            <input type="text" id="txtTitle" name="searchtext" value="@Model.searchtext" class="form-control" placeholder="Nhập từ khóa">
                        </div>

                        <div class="form-group submit" style="text-align: center">
                            <button type="submit" id="btnSearch" class="btn btn-info"><i class="fa fa-search"></i>Tìm Kiếm</button>
                            @if (HttpContext.Current.User.Identity.Name != "thanhdt")
                            {
                                <a id="btnCreate" href="@Url.Action("UserAdd", "System")" class="btn btn-success"><i class="fa fa-user-plus"></i>Thêm Mới</a>
                            }

                        </div>


                    </div>
                </form>
            </div>
            <div class="table-responsive">
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="ListUser">
                        <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                            <thead>
                                <tr class="rowsao">

                                    <th>
                                        Tên đăng nhập
                                    </th>
                                    <th>
                                        E-Mail
                                    </th>
                                    <th>
                                        Vai trò
                                    </th>
                                    <th>
                                        Ngày tạo
                                    </th>
                                    <th>
                                        Giờ đăng nhập trước
                                    </th>
                                    <th>
                                        Đang Online?
                                    </th>
                                    <th>
                                        Kích hoạt
                                    </th>
                                    <th>
                                        Xóa
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (MembershipUser item in Model.listuser)
                                {
                                    <tr id="tr_@item.UserName">

                                        <td>
                                            <a id="lbtnUserName" href='@Url.Action("UserEdit", "System", new {username=item.UserName})'>
                                                @item.UserName
                                            </a>

                                        </td>
                                        <td align="left">
                                            @item.Email
                                        </td>
                                        <td align="left">@HtmlHelpers.GetRolesByUserName(item.UserName)</td>
                                        <td align="center">
                                            @item.CreationDate.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td align="center">
                                            @item.LastActivityDate.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td align="center">
                                            @if (item.IsOnline)
                                            {
                                                <img alt="" src="/Administrator/Images/online.png" />
                                            }
                                            else
                                            {
                                                <img alt="" src="/Administrator/Images/offline.png" />
                                            }

                                        </td>
                                        <td align="center">
                                            @if (item.IsApproved)
                                            {
                                                <input type="checkbox" onclick="return setApprove('@item.UserName');" checked="checked" class="chkApprove" />
                                            }
                                            else
                                            {

                                                <input type="checkbox" onclick="return setApprove('@item.UserName');" class="chkApprove" />
                                            }
                                        </td>
                                        <td class="alt">
                                            @if (HttpContext.Current.User.Identity.Name != "thanhdt")
                                            {
                                                <a onclick="return userdelete('@item.UserName');" href='javascript:void(0);'>Xóa</a>
                                            }
                                        </td>
                                    </tr>
                                }


                            </tbody>
                        </table>
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
   $('#menu_manageuser').addClass("active");

</script>

<script type="text/javascript">
    function userdelete(username) {
        bootbox.confirm("Bạn có chắc chắn muốn xóa người dùng này không ??? ", function (result) {
            if (result == true) {
                $.post('@Url.Action("UserDelete", "System")', { "username": username },
                   function (data) {
                       if (data == "1") {
                           $("#tr_" + username).hide();
                       }
                       else {

                       }
                   });
            }
        });

    }
    function setApprove(username) {
        bootbox.confirm("Bạn có chắc chắn muốn kích hoạt/bỏ kích hoạt người dùng này không ??? ", function (result) {
            if (result == true) {
                $.post('@Url.Action("UserAppproved", "System")', { "username": username },
              function (data) {
                  bootbox.alert(data);
              });
            }
        });

    }
</script>
