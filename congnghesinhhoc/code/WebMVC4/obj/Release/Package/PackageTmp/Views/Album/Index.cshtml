@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.AlbumModel
@{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
@if (Model.listdata != null)
{


    <ul class="row box-news">
        @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
        {
            <li class="col-md-4 col-sm-4 col-xs-6 maxheight08">
                <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "AlbumDetail")">
                    <img src="@item.value.MainImage?w=300&h=200&mode=crop">
                    <p class="mt10">@item.value.Title</p>
                </a>
            </li>
        }

    </ul><!-- end big news-->
    <div class="pagination mt30 pull-right">
        <ul>
            @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                {
                    PageUrl = Url.SetParameter("Page", "!0"),
                    CurrentPage = Model.pageIndex,
                    PageSize = Model.pageSize,
                    TotalItemCount = Model.total,
                }); }
        </ul>
    </div>

                }
<script>
    $("#divbody").addClass("library-img");
</script>