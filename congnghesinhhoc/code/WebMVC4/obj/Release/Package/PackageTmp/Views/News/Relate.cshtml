@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
    <h2 class="title-cm title-cm-inline"><a href="#">@ViewBag.HeaderTitle</a></h2>
        <ul class="row new-other-list">
            @foreach (var item in Model.Select((value, i) => new {i, value}))
            {
            <li class="col-sm-4 col-xs-4">
                <a title="@item.value.Title" href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=185&h=120&mode=crop" alt="">
                                                                        <p>@item.value.Title</p>
                </a>
            </li>
               
            }
        </ul>

      
   

    }


}