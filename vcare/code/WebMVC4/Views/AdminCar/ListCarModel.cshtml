@using BIZ.Entity
@using UTILS
@using DATA
@model List<CarModel>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>STT</th>

            <th>Tên </th>
            <th> Hãng</th>
           

            <th>Trạng Thái</th>
            <th>Thao Tác</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>
                <td>@obj.Order</td>
                <td style="text-align: left;">
                    <a href="@Url.Action("GetCarModelDetail",new {id=obj.Id })" title="Edit">@obj.Name</a>
                </td>
                <td>@HtmlHelpers.GetCarGroupName(obj.GroupId,ViewBag.GroupList)</td>
              
               

                <td>
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;"  ><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;"  ><i class="fa fa-ban"></i></a>

                    }
                </td>
                <td style="text-align: center">
                    <a href="javascript:;" title="Delete" onclick="DeleteData('@Utils.Base64Encode(obj.Id)','@obj.Name')"><i class="fa fa-trash-o"></i></a>

                </td>

            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            status: $('#ddlStatus :selected').val(),
            groupId: $('#ddlRegion :selected').val(),
            //currentPage: currentPage,
            //pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListCarModel")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListCar").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        @*$("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });*@


    });

    function DeleteData(id,title) {

        bootbox.confirm("Bạn chắc chắn muốn xóa  ??? ", function (result) {
            if (result == true) {
                var postdata= {
                    '_id': id,
                    'Title': title,
                };
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url:"@Url.Action("Delete")",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
    
</script>