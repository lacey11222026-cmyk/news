@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@{
    ViewBag.Title = "Danh sách xe";
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">


                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <select class="form-control" id="ddlStatus">
                            <option value="-1">Trạng Thái</option>
                            <option value="1">Hoạt động</option>
                            <option value="0">Khóa</option>
                        </select>
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        @Html.DropDownList("ddlRegion", new SelectList(ViewBag.GroupList as System.Collections.IEnumerable, "Id", "Name", ""), new { @class = "form-control", })
                       
                    </div>
                    <div class="form-group submit col-md-3 col-xs-12 col-sm-6">

                        <a id="btnCreate" href="@Url.Action("GetCarModelDetail",new {id=0 })" class="btn btn-success"><i class="fa fa-user-plus"></i>Thêm Mới</a>
                    </div>


                </div>
            </div>
            <div class="table-responsive">
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="ListCar">
                        @Html.Action("ListCarModel")
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
   $('#menu_managecarmodel').addClass("active");

</script>
<script type="text/javascript">
        $(document).ready(function () {

            var parameters = {
            };
            $("#form").keypress(function (event) {
                if (event.which == 13) {
                    $("#btnSearch").click();
                }
            });
            $("#btnSearch").click(function () {
                GetList(1);
            });
            $("#ddlStatus").change(function () {
                GetList(1);
            });
            $("#ddlRegion").change(function () {
                GetList(1);
            });
            function GetList(currentPage) {
                parameters = {

                    status: $('#ddlStatus :selected').val(),
                    groupId: $('#ddlRegion :selected').val(),
                    currentPage: currentPage,
                };
                btnSearch(currentPage);
            };
            function btnSearch(currentPage) {
                Utils.Loading();
                var urlRequestAns = "@Url.Action("ListCarModel")";
                $.ajax({
                    type: 'GET',
                    url: urlRequestAns,
                    data: parameters,
                    success: function (data) {
                        $("#ListCar").html(data);
                        Utils.UnLoading();
                    },
                    error: function () {
                        Utils.UnLoading();
                    }
                });
            }

        });

</script>