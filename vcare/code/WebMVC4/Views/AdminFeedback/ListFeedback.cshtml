
@model List<DATA.Feedback>

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>Mã </th>
            <th>Tên</th>
            <th>Email</th>
            @*<th>SĐT</th>*@
            <th>Câu hỏi</th>
            <th>Ngày tạo</th>
           

        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            <tr>
                <td>@obj.Id</td>
                <td>@obj.Name</td>
                <td>@obj.Email</td>
                @*<td>@obj.Mobile</td>*@
                <td>@Html.Raw(obj.Question)</td>
                <td>@obj.CreatedTime.GetValueOrDefault().ToString("dd/MM/yyyy")</td>
                


            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        parameters = {
           
            currentPage: currentPage
        };
        var urlRequestAns = "/AdminFeedback/ListFeedback";
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: parameters,
            success: function (data) {
                $("#ListFeedback").html(data);

            },

        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });


  
</script>
