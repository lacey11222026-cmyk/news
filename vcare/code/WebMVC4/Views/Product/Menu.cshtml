@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.MANUFACTORY_FULL>

<div class="mt15">
    <a href="#" class="title-cm2">Hãng sản xuất<span></span></a>
    <ul class="list-cm">
        @foreach (var item in Model.Select((value, i) => new { i, value }))
        {
            <li>

                <a href="/san-pham.html?manufactory=,@(item.value.Id),">@item.value.Title</a>



            </li>

        }
    </ul>

</div>
