@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<DATA.Product>

@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="quantam container">
            <h2 class="slider-product-title">Có thể bạn quan tâm</h2>
            <div class="mt30 slider-product slider">
                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    <div class="product-sitem">
                        <a class="" href="/san-pham/@item.value.Url">
                            <div class="item">
                                <img src="@item.value.DescriptImage?w=300&h=300&mode=crop" alt="@item.value.Name" />
                            </div>
                            <div class="product-recommend-name">@item.value.Name</div>
                            <div class="product-recommend-price">@Utils.InsertCommaNoStyle(item.value.Price.ToString())₫ <span class="price-old">@Utils.InsertCommaNoStyle(item.value.PriceReal.ToString()) đ</span></div>
                        </a>
                    </div>
                }
                </div>
        </div>

    }


}