                            </ul>
                        </div>
                    }


                    <div class="sidebar-item">
                        <p class="sidebar-title">Giá sản phẩm</p>
                        <ul class="list-cm02 fprice">
                            <li onclick="selectPrice(this)">
                                <div class="form-check">
                                    <input value="1" @(ViewBag.Type == 1 ? "checked" : "") type="checkbox" class="form-check-input" id="p01">
                                    <label class="form-check-label" for="p01">Giá dưới 500.000đ</label>
                                </div>
                            </li>
                            <li onclick="selectPrice(this)">
                                <div class="form-check">
                                    <input value="2" @(ViewBag.Type == 2 ? "checked" : "") type="checkbox" class="form-check-input" id="p02">
                                    <label class="form-check-label" for="p02">500.000đ - 1.000.000đ</label>
                                </div>
                            </li>
                            <li onclick="selectPrice(this)">
                                <div class="form-check">
                                    <input value="3" @(ViewBag.Type == 3 ? "checked" : "") type="checkbox" class="form-check-input" id="p03">
                                    <label class="form-check-label" for="p03">1.000.000đ - 1.500.000đ</label>
                                </div>
                            </li>
                            <li onclick="selectPrice(this)">
                                <div class="form-check">
                                    <input value="4" @(ViewBag.Type == 4 ? "checked" : "") type="checkbox" class="form-check-input" id="p04">
                                    <label class="form-check-label" for="p04">1.500.000đ - 2.000.000đ</label>
                                </div>
                            </li>
                            <li onclick="selectPrice(this)">
                                <div class="form-check">
                                    <input value="5" @(ViewBag.Type == 5 ? "checked" : "") type="checkbox" class="form-check-input" id="p04">
                                    <label class="form-check-label" for="p04">Giá trên 2.000.000đ</label>
                                </div>
                            </li>
