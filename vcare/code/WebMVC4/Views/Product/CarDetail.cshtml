            <div class="col-lg-9 col-md-9 col-sm-12 product-wrap">
                <div class="text-right border-gray-bottom">
                    <div class="viewchoose">
                        <div class="form-group">
                            <label for="">Ưu tiên xem</label>
                            <select class="form-control" id="drlOrder">


                                <option value="3" @(Model.OrderType == 3 ? "selected='selected'" : "")>Giá tăng dần</option>
                                <option value="4" @(Model.OrderType == 4 ? "selected='selected'" : "")>Giá giảm dần</option>
                            </select>
                        </div>
                    </div>
                    <div class="view-mode mb10 margin-left-5 f-right">
                        <a href="javascript:;" data-view="grid" class="grid_h switch-view" onclick="switchView('grid')">
                            <b class="btn button-view-mode view-mode-grid @if (Model.View=="grid") { @Html.Raw("active"); } ">
                                <i class="fa fa-th" aria-hidden="true"></i>
                            </b>
                        </a>
                        <a class="list_h switch-view" href="javascript:;" data-view="list" onclick="switchView('list')">
                            <b class="btn button-view-mode view-mode-list @if (Model.View=="list") { @Html.Raw("active"); } ">
                                <i class="fa fa-bars" aria-hidden="true"></i>
                            </b>
                        </a>
                    </div>
                </div>
                <div class="mt30 @if (Model.View == "list") { @Html.Raw("viewlist")}">
                   <div id="NewsContent">
                       @Html.Raw(Model.CarModel.Description)
                   </div>
                    <ul class="product-list02 mt30 row">
                        @if (Model.listdata != null)
                        {
                            if (Model.View == "grid")
                            {
                                { Html.RenderAction("LoadDataGrid", new { data = Model.listdata }); }
                            }
                            else
                            {
                                { Html.RenderAction("LoadDataList", new { data = Model.listdata }); }
                            }

                        }

                    </ul>
                    
                </div>
            </div>
        </div>

    </div>




    <script>

        var updateQueryStringParam = function (key, value) {
            var baseUrl = [location.protocol, '//', location.host, location.pathname].join(''),
                urlQueryString = document.location.search,
                newParam = key + '=' + value,
                params = '?' + newParam;

            // If the "search" string exists, then build params from it
            if (urlQueryString) {
                var keyRegex = new RegExp('([\?&])' + key + '[^&]*');

                // If param exists already, update it
                if (urlQueryString.match(keyRegex) !== null) {
                    params = urlQueryString.replace(keyRegex, "$1" + newParam);
                } else { // Otherwise, add it to end of query string
                    params = urlQueryString + '&' + newParam;
                }
            }
            window.history.replaceState({}, "", baseUrl + params);
        };
        $('#drlOrder').change(function () {
            updateQueryStringParam('orderType', this.value);
            location.reload();

        });
        function switchView(view) {
            updateQueryStringParam('view', view);
            location.reload();
        }
        function filtermanu() {
            var value = '';
            var data = $('input[type="checkbox"][name="manu"]:checked');
            $.each(data, function (i, item) {

                value += "," + $(item).val();

            });
            if (value.length > 1) {
                value += ",";
            }
            updateQueryStringParam('fManu', value);
            location.reload();
        }
        function selectPrice(obj) {
            var o = $(obj).find(" input");
            var value = o.val();
            //alert(!o.is(":checked"));
            if (!o.is(":checked")) {
                value = 0;
            }

            updateQueryStringParam('type', value);
            location.reload();


        }
        $('.btn-quickview').click(function () {
            var url = $(this).data("url");
            $.ajax({
                type: "GET",
                url: url,
                success: function (data) {

                    // get the ajax response data
                    //var data = res.body;
                    // update modal content
                    $('.modal-body').html(data);
                    // show modal
                    $('#XemNhanh01').modal('show');

                },
                error: function (request, status, error) {
                    console.log("ajax call went wrong:" + request.responseText);
                }
            });
        });
    </script>

    <div class="modal fade" id="XemNhanh01" tabindex="-1" role="dialog" aria-labelledby="XemNhanh01Label" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@ViewBag.SiteTitle</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                </div>
            </div>
        </div>
    </div>
}
