@using BIZ
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.ProductDetailModel

    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="slider-detail">
                <div id="jssor_1" style="position:relative;margin:0 auto;top:0px;left:0px;width:610px;height:740px;overflow:hidden;visibility:hidden;">
                    <!-- Loading Screen -->
                    <div data-u="loading" class="jssorl-009-spin" style="position:absolute;top:0px;left:0px;width:100%;height:100%;text-align:center;background-color:rgba(0,0,0,0.7);">
                        <img style="margin-top:-19px;position:relative;top:50%;width:38px;height:38px;" src="/Content/images/gallery/spin.svg" />
                    </div>
                    <div data-u="slides" style="cursor:default;position:relative;top:0px;left:0px;width:610px;height:610px;overflow:hidden;">
                        @if (!string.IsNullOrEmpty(Model.Detail.ImageParam.Path1))
                        {
                            <div>
                                <img data-u="image" src="@Model.Detail.ImageParam.Path1?w=610&h=610&mode=crop" />
                                <img data-u="thumb" src="@Model.Detail.ImageParam.Path1?w=120&h=120&mode=crop" />
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Detail.ImageParam.Path2))
                        {
                            <div>
                                <img data-u="image" src="@Model.Detail.ImageParam.Path2?w=610&h=610&mode=crop" />
                                <img data-u="thumb" src="@Model.Detail.ImageParam.Path2?w=120&h=120&mode=crop" />
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Detail.ImageParam.Path3))
                        {
                            <div>
                                <img data-u="image" src="@Model.Detail.ImageParam.Path3?w=610&h=610&mode=crop" />
                                <img data-u="thumb" src="@Model.Detail.ImageParam.Path3?w=120&h=120&mode=crop" />
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Detail.ImageParam.Path4))
                        {
                            <div>
                                <img data-u="image" src="@Model.Detail.ImageParam.Path4?w=610&h=610&mode=crop" />
                                <img data-u="thumb" src="@Model.Detail.ImageParam.Path4?w=120&h=120&mode=crop" />
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Detail.ImageParam.Path5))
                        {
                            <div>
                                <img data-u="image" src="@Model.Detail.ImageParam.Path5?w=610&h=610&mode=crop" />
                                <img data-u="thumb" src="@Model.Detail.ImageParam.Path5?w=120&h=120&mode=crop" />
                            </div>
                        }

                    </div>
                    <!-- Thumbnail Navigator -->
                    <div data-u="thumbnavigator" class="jssort101" style="position:absolute;left:0px;bottom:0px;width:610px;height:130px;" data-autocenter="1" data-scale-bottom="1.75">
                        <div data-u="slides">
                            <div data-u="prototype" class="p" style="width:120px;height:120px;">
                                <div data-u="thumbnailtemplate" class="t"></div>
                                <svg viewbox="0 0 16000 16000" class="cv">
                                    <circle class="a" cx="8000" cy="8000" r="3238.1"></circle>
                                    <line class="a" x1="6190.5" y1="8000" x2="9809.5" y2="8000"></line>
                                    <line class="a" x1="8000" y1="9809.5" x2="8000" y2="6190.5"></line>
                                </svg>
                            </div>
                        </div>
                    </div>
                    <!-- Arrow Navigator -->
                    <div data-u="arrowleft" class="jssora106" style="width:55px;height:55px;top:290px;left:30px;" data-scale="0.75">
                        <svg viewbox="0 0 16000 16000" style="position:absolute;top:0;left:0;width:100%;height:100%;">
                            <circle class="c" cx="8000" cy="8000" r="6260.9"></circle>
                            <polyline class="a" points="7930.4,5495.7 5426.1,8000 7930.4,10504.3 "></polyline>
                            <line class="a" x1="10573.9" y1="8000" x2="5426.1" y2="8000"></line>
                        </svg>
                    </div>
                    <div data-u="arrowright" class="jssora106" style="width:55px;height:55px;top:290px;right:30px;" data-scale="0.75">
                        <svg viewbox="0 0 16000 16000" style="position:absolute;top:0;left:0;width:100%;height:100%;">
                            <circle class="c" cx="8000" cy="8000" r="6260.9"></circle>
                            <polyline class="a" points="8069.6,5495.7 10573.9,8000 8069.6,10504.3 "></polyline>
                            <line class="a" x1="5426.1" y1="8000" x2="10573.9" y2="8000"></line>
                        </svg>
                    </div>
                </div>
                <script type="text/javascript">jssor_1_slider_init();</script>
            </div>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12">
            <h2 class="product__name">@Model.Detail.Name</h2>
            <ul class="list-inline">
                @if (Model.Detail.ManufactoryId > 0)
                {
                    <li>Thương hiệu: <a href="/@Model.Manu.Website">@Model.Manu.Title</a> |</li>
                }

                @if (Model.Detail.IsNew.GetValueOrDefault())
                {
                    <li>Tình trạng: <a href="javascript:;">Còn hàng</a></li>
                }
                else
                {
                    <li>Tình trạng: <a href="javascript:;">Hết hàng</a></li>
                }

            </ul>
            @*<div class="star mt5">
                <ul>
                    <li><i class="fa fa-star" aria-hidden="true"></i></li>
                    <li><i class="fa fa-star" aria-hidden="true"></i></li>
                    <li><i class="fa fa-star" aria-hidden="true"></i></li>
                    <li><i class="fas fa-star-half-alt"></i></li>
                    <li><i class="far fa-star"></i></li>
                </ul>
            </div>*@
            <p class="price">Giá: <span>1.110.000đ</span> <span class="price-old">1.500.000đ</span></p>
            <div class="endow">
                <p>Ưu đãi</p>
                @Html.Raw(Model.Detail.Description)
                <a href="/san-pham/@Model.Detail.Url" class="btn-viewmore">Xem thêm <i class="fas fa-sort-down"></i></a>
            </div>
          
            <a href="tel:0966697696" class="btn-buy mt30"><i class="fa fa-phone" aria-hidden="true"></i> GỌI NGAY : <span>0966697696</span></a>
        </div>
    </div>