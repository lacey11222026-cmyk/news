@model List<DATA.Banner>


@foreach (var item in Model.Select((value, i) => new { i, value }))
{

    <div class="item">
        <div class="ms-img">
            <img src="@item.value.Data" alt="@item.value.Name" />
            <div class="ms-desc">
                <div class="line-1 wow fadeInLeft" data-wow-duration="0.75s" data-wow-delay="0.5s">
                    @item.value.Name
                </div>
                <div class="line-2 wow fadeInRight" data-wow-duration="0.75s" data-wow-delay="0.5s">
                    @item.value.Description
                </div>
                <a href="@item.value.Url" class="wow fadeInUp" data-wow-duration="0.5s" data-wow-delay="1.5s">Xem thêm</a>

            </div>
        </div>
    </div>




}
