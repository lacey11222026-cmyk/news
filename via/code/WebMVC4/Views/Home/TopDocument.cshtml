@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.DOCUMENT_FULL>
@{
    var langpage = WorkContext.GetLanguage();
}
@if (Model != null)
{
    foreach (var item in Model.Select((value, i) => new { i, value }))
    {
        
        <li>
            <a href="@Url.Action("Detail","Document",new { id=item.value.Id})">@item.value.Name</a>
            <span class="date-txt mt10">Ngày ban hành: @item.value.PublishDate.GetValueOrDefault().ToString("dd/MM/yyyy")</span>
        </li>
    }
}

