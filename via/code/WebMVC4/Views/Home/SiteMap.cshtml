@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>

@{
    var langpage = WorkContext.GetLanguage();
}
<script type="text/javascript" src="/Scripts/simpletreemenu.js"></script>

<link href="/Styles/simpletree.css" rel="stylesheet" type="text/css" />


@if (Model != null)
{
    <div class="post-new-detail-page container pb60 pt40">
        <div class="row row-50">
            <div class="col-lg-8 col-md-12">
                <div class="post-detail">
                    <h2 class="title-cm-02"><a href="/Home/SiteMap">Site Map</a></h2>
                    <div class="mt30 detail-content">
                        <ul id="treemenu2" class="treeview">
                            @if (Model.Count > 0)
                            {
                                foreach (var item in Model.Select((value, i) => new { i, value }))
                                {
                                    <li>
                                        <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name </a>
                                        @Html.Raw(HtmlHelpers.BindChildCategoriesSiteMap(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                                    </li>
                                }
                            }

                        </ul>

                        <script type="text/javascript">

                            //ddtreemenu.createTree(treeid, enablepersist, opt_persist_in_days (default is 1))
                            ddtreemenu.createTree("treemenu2", false, 5)

                        </script>
                    </div>
                </div>

            </div>
            <div class="col-lg-4 col-md-12 sidebar">
                @Html.Partial("Site_Right2")
            </div>
        </div>
    </div><!-- end main content-->
    <h2 class="title-cm"><a href="#">@Resources.Global.BankSupport</a></h2>
    <br />
    <div class="bg-gray pt40 pb40">
        <div class="container">

            <ul class="slick02">
                @{Html.RenderAction("BannerBottom", "Home", new { lang = langpage });}
            </ul>
        </div>
    </div>

}
