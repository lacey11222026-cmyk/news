@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper


<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">
                    <div class="col-md-12">


                        <div class="form-group col-md-4 col-xs-12 col-sm-6">
                            <label class="control-label"><i class="fa fa-flag"></i>Loại</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">

                                <select class="form-control" id="ddlKey">
                                    <option value="hotnews" @(ViewBag.key == "hotnews" ? "selected='selected'" : "")>Tin nổi bật trang chủ</option>
                                    <option value="topviewnews" @(ViewBag.key == "topviewnews" ? "selected='selected'" : "")>Tin xem nhiều</option>
                                   
                                </select>
                            </div>
                        </div>
                        <div class="form-group col-md-4 col-xs-12 col-sm-6" style="display:none;">
                            <label class="control-label"><i class="fa fa-flag"></i>Trạng thái</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">

                                <select class="form-control" id="ddlActive">
                                    <option value="-1">Lấy tất cả</option>
                                    <option value="1">Hoạt Động</option>
                                    <option value="0">Không Hoạt Động</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group submit" style="text-align:center">
                            <a href="@Url.Action("Info",new {id=0,key=ViewBag.key })" class="btn btn-success"><i class="fa fa-user-plus"></i>Thêm Mới</a>

                        </div>

                    </div>

                </div>
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListHotNews">
                            @Html.Action("ListHotNews", "AdminHotNews", new { key = ViewBag.key })
                        </div>
                        <div class="dataTables_paginate" id="pager">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var parameters = {
        };
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        $("#ddlActive").change(function () {
            GetList(1);
        });
        $("#ddlKey").change(function () {
            window.location = '/AdminHotNews/ManageHotNews/?key=' + $('#ddlKey :selected').val();
        });
        function GetList(currentPage) {
            key = '@ViewBag.key';
            parameters = {
                status: $('#ddlActive :selected').val(),
                key: key,
                currentPage: currentPage
            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {
            Utils.Loading();
            var urlRequestAns = "/AdminHotNews/ListHotNews";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    $("#ListHotNews").html(data);
                    Utils.UnLoading();
                },
                error: function () {
                    Utils.UnLoading();
                }
            });
        }

    });

</script>
<script>
    $('#menu_manageHotNews').addClass("active");
</script>

