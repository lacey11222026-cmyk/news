@{
   
    Layout = "~/Views/Shared/_AdminV2.cshtml";
    
}


    <script type="text/javascript">
        var redirectUrl = '@Url.Action("AlbumAddEdit","AdminNews")';
        var page_index = 1;
        var page_size = 10
        var imageBaseUrl = '@ViewBag.ImageUrl';

        $(document).ready(function () {

            BindCategoriesToSelectBox();

            BindPageSizeToSelectBox();

            OnLoad(1);
        });

        function OnLoad(pi) {
            page_index = pi;
            $('#select_pagesize').show();
            $('#paging_container').show();
            $('#txt_filterbyname').val('');
            Filter(pi)
        }

        function Filter(pi) {
            //$('#select_pagesize').hide();
            // $('#paging_container').hide();
            page_index = pi;
            var tit = $('#txt_filterbyname').val();
            var cid = $('#select_filterbycategory option:selected').val();
            var status = $('#select_filterbystatus option:selected').val();

            $.Services({
                element: $('#grid_items'),
                loadingImg: '<tr><td colspan="8">Đang tải dữ liệu ...</td><tr>',
                serviceName: 'AlbumService.ashx',
                data: {
                    __m: 'get_filter_albums',
                    tit: tit,
                    cid: cid,
                    _pi: page_index,
                    _ps: page_size,
                    status: status
                },
                success: function (data) {
                    var html = '<tr><td colspan="8">Không có album nào</td><tr>';
                    if (data != undefined && data != null && data != '') {
                        var items = data.Items;
                        var total = data.Total;
                        html = BindData(items);
                        RenderPaging(pi, page_size, total, Filter);
                    }

                    $('#grid_items').html(html);
                }
            });
        }

        function BindData(data) {
            var html = '';
            $.each(data, function (index, item) {
                var thumnail = '';
                if (item.Images != null && item.Images != undefined && item.Images != '') {
                    var images = item.Images;
                    var arr_images = images.split(',');
                    thumnail = GetThumbnailUrl(item.Id) + arr_images[0];
                }
                else {
                    thumnail = '//Content/images/nophoto.jpg';
                }

                html += '<tr id="item' + item.Id + '">';
                html += '<td align="center">';
                html += '<input type="checkbox" name="chk_item" value="' + item.Id + '" />';
                html += '</td>';

                html += '<td>';
                html += '<a href="' + redirectUrl + '?id=' + item.Id + '" alt="' + item.Title + '">';
                html += item.Title;
                html += '</a>';
                html += '</td>';

                html += '<td>';
                html += item.CategoryName;
                html += '</td>';


                html += '<td>';
                if (item.Style == 1)
                    html += "LightBox";
                else
                    html += "Gallery";

                html += '</td>';
                html += '<td>';
                html += dateFormat(item.PublishDate, 'dd/mm/yyyy HH:MM');
                html += '</td>';
                html += '<td>';
                html += item.CreatedBy;
                html += '</td>';
                html += '<td align="center">';
                if (item.Status == 1)
                    html += "Hoạt động";
                else
                    html += "Khóa";
                html += '</td>';
                html += '</tr>';
            });

            return html;
        }

        function RenderPaging(pageindex, pagesize, totalrecord, callback) {

            var html = {
                container: '<div class="pagination"></div>',
                wrraper: '<div class="button2-left"><div class="page"></div></div>',
                firstbtn: '<div class="button2-right"><div class="start"><a>Bắt đầu</a></div></div>',
                prevbtn: '<div class="button2-right"><div class="prev"><a>Trước</a></div></div>',
                nextbtn: '<div class="button2-left"><div class="next"><a>Tiếp</a></div></div>',
                lastbtn: '<div class="button2-left"><div class="end"><a>Cuối cùng</a></div></div>'
            }

            if (totalrecord > page_size) {
                $("#paging_container").pager({ pagenumber: pageindex, pagecount: Math.ceil(totalrecord / page_size), buttonClickCallback: callback, html: html });
            }
            else {
                $("#paging_container").html("");
            }

        }



        function New() {
            window.location.href = redirectUrl;
        }
      
        function Delete() {

            DestroyJAlert();
            var arr_checked_items = [];
            $('input[type="checkbox"][name="chk_item"]:checked').each(function (i, e) {
                arr_checked_items.push($(e).val());
            });

            if (arr_checked_items.length > 0) {
                var confirmFunc = function () {
                    $.Services({
                        isCrossDomain: false,
                        url: POST_URL + 'AlbumService.ashx',
                        data: {
                            __m: "delete",
                            'id': arr_checked_items
                        },
                        success: function (data) {
                            if (data != undefined && data != null && data != '') {
                                var json_data = eval('(' + data + ')');

                                if (json_data.Success) {
                                    //$.jCache.setItem("LIST_ITEMS_PAGING_" + page_index + page_size, null);
                                    OnLoad(1);
                                }

                                var jalert_type = "info";
                                if (!json_data.Success)
                                    jalert_type = "fatal";
                                else {
                                    $.each(arr_checked_items, function (index, item) {
                                        $("grid_items").find('tr#item' + item).hide();
                                    });

                                }

                                $('#jalert_notification').jAlert(json_data.Text, jalert_type, "edit", 400);
                            }
                        }
                    });
                };

                OpenConfirmDialog('Bạn có muốn xóa album này không ?', confirmFunc);
            }
            else {
                $('#jalert_notification').jAlert('Bạn phải chọn ít nhất 1 album', "warning", "edit", 400);
            }
        }

        function BindPageSizeToSelectBox() {
            //select_pagesize
            var html = '';
            html += '<option value="10">10</option>';
            html += '<option value="20">20</option>';
            html += '<option value="30">30</option>';
            html += '<option value="40">40</option>';
            html += '<option value="50">50</option>';
            html += '<option value="60">60</option>';
            html += '<option value="70">70</option>';
            html += '<option value="80">80</option>';
            html += '<option value="90">90</option>';
            html += '<option value="100">100</option>';

            $('#select_pagesize').html(html).change(function () {
                page_size = $('#select_pagesize option:selected').val();
                OnLoad(1);
            });
        }

        function BindCategoriesToSelectBox() {

            $('#select_filterbycategory').html('<option value="0">- Tất cả chuyên mục -</option>');
            $.Services({
                serviceName: 'CategoryService.ashx',
                data: {
                    __m: 'get_all_categories',
                    ctype: 4
                },
                success: function (data) {
                    html = '';
                    if (data != undefined && data != null && data != '') {
                        $.each(data, function (i, item) {
                            html = '<option value="' + item.Id + '">';
                            if (item.NodeLevel != 0) {
                                html += "";
                                for (var i = 1; i < item.NodeLevel; i++) {
                                    html += '-+&nbsp;';
                                }
                            }

                            html += item.Name;
                            html += '</option>';
                            if (item.ParentId != 0) {
                                if ($('#select_filterbycategory option[value=' + item.ParentId + ']').length)
                                    $('#select_filterbycategory option[value=' + item.ParentId + ']').after(html);
                                else
                                    $('#select_filterbycategory').append(html);
                            }
                            else
                                $('#select_filterbycategory').append(html);
                        });
                    }

                }
            });
        }

        function GetThumbnailUrl(id) {
            var thumbnail = imageBaseUrl + Math.floor(id / 100000) + '/' + Math.floor(id / 100) + '/' + Math.floor(id) + '/thumb/';
            return thumbnail;
        }
    </script>
    <div id="toolbar-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m">
            <div class="toolbar" id="toolbar">
                <table class="toolbar">
                    <tr>
                        <td class="button" id="toolbar-delete">
                            <a class="toolbar" onclick="Delete();" href="javascript:void(0);"><span class="icon-32-delete"
                                title="Delete"></span>Xóa</a>
                        </td>
                        <td class="button" id="toolbar-new">
                            <a class="toolbar" onclick="New();" href="javascript:void(0);"><span class="icon-32-new"
                                title="New"></span>Tạo mới</a>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="header icon-48-article">
                Quản lý album ảnh
            </div>
            <div class="clr">
            </div>
        </div>
        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
    <div class="clr">
    </div>
    <div id="element-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m">
            <div id="jalert_notification">
                &nbsp;</div>
            <table>
                <tr>
                    <td width="100%">
                        Tên album:
                        <input id="txt_filterbyname" type="text" style="width: 250px;" />
                        <input id="btn_search" type="button" value="Lọc" onclick="Filter(1);" />
                        <input id="btn_clear" type="button" value="Làm lại" onclick="OnLoad(1);" />
                    </td>
                    <td nowrap="nowrap">
                        Chuyên mục:
                        <select id="select_filterbycategory" onchange="Filter();">
                        </select>
                    </td>
                    
                    <td nowrap="nowrap" >
                        Trạng thái:
                        <select id="select_filterbystatus" onchange="Filter();">
                            <option value="-1">--Tất cả--</option>
                            <option value="1">Hoạt động</option>
                            <option value="0">Khóa</option>
                        </select>
                    </td>
                </tr>
            </table>
            <table class="adminlist" cellpadding="1">
                <thead>
                    <tr>
                        <th width="1%" class="title">
                            #
                        </th>
                        <th width="20%" class="title" style="text-align: left">
                            Tên Album
                        </th>
                        <th width="15%" class="title" style="text-align: left">
                            Tên chuyên mục
                        </th>
                        <th width="10%" class="title" style="text-align: left">
                            Style hiển thị
                        </th>
                        <th width="10%" class="title" style="text-align: left">
                            Ngày xuất bản
                        </th>
                        <th width="10%" class="title" style="text-align: left">
                            Người tạo
                        </th>
                        <th width="5%" class="title">
                            Trạng thái
                        </th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <td colspan="6">
                            <del class="container">
                                <div class="limit">
                                    <select id="select_pagesize">
                                    </select>
                                </div>
                                <div id="paging_container">
                                </div>
                            </del>
                        </td>
                    </tr>
                </tfoot>
                <tbody id="grid_items">
                </tbody>
            </table>
            <div class="clr">
            </div>
        </div>
        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
