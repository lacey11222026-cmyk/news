@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel
@{
    var langpage = WorkContext.GetLanguage();
}
@if (Model.listdata != null)
{

    <ul class="row video-list mt40">
        @foreach (var item in Model.listdata.Take(6).Select((value, i) => new { i, value }))
        {
            <li class="col-md-4 col-6">
                <a href="/trang-chu-video?VideoId=@(item.value.Id)"><img src="@item.value.MainImage?w=350&h=204&mode=crop" alt="" class="w-100"></a>
                <a href="/trang-chu-video?VideoId=@(item.value.Id)" class="mt15 font-weight-bold dis-block">@item.value.Title</a>
                <p class="date mt15">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
            </li>
        }

    </ul>
    <div class="bnrCenter mt40">
        <div class="bnrSlider">
            @{Html.RenderAction("Banner", "Home", new { lang = langpage });}
        </div>
    </div>
    <ul class="row video-list mt40">
        @foreach (var item in Model.listdata.Skip(8).Select((value, i) => new { i, value }))
        {
            <li class="col-md-4 col-6">
                <a href="/trang-chu-video?VideoId=@(item.value.Id)"><img src="@item.value.MainImage?w=350&h=204&mode=crop" alt="" class="w-100"></a>
                <a href="/trang-chu-video?VideoId=@(item.value.Id)" class="mt15 font-weight-bold dis-block">@item.value.Title</a>
                <p class="date mt15">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
            </li>
        }

    </ul>
    
    <script>

        function GoVideoPage(page) {
            var VideoId = '@Model.Id';
             var Cateid='@ViewBag.CategoryId'
            if (page > 0) {
                $.ajax({
                    type: "GET",
                     url: "/Video/LoadVideo/?VideoId=" + VideoId + "&page=" + page + "&CategoryId=" + Cateid,
                    success: function (data) {
                        if (data != "null") {
                            $("#lstVideo").html(data);
                        }
                    }
                });
            }

        }

    </script>
}