@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.News2Model
@if (Model.hotnews != null )
{
    /*active menu*/
    if (ViewBag.ParentCategoryId > 0)
    {
    <script type="text/javascript">
        var index = $('#ddtabs1 li').index($('#cate_' + '@ViewBag.ParentCategoryId'));
        ddtabmenu.definemenu("ddtabs1", index);

        setTimeout(function () {
            $("#ddtabs1 .current").parent().addClass("select");

        }, 1000);
    </script>
       
    }
    else
    {
    <script type="text/javascript">
        var index = $('#ddtabs1 li').index($('#cate_' + '@ViewBag.CurrentCategoryId'));

        ddtabmenu.definemenu("ddtabs1", index);
        setTimeout(function () {
            $("#ddtabs1 .current").parent().addClass("select");

        }, 1000);
    </script>
       
    }
    
    <div class="">
        <h2 class="title border-blue">@ViewBag.CateName</h2>
        <div class="big-news-item mt15">
            <div class="big-news">
                <a href="@Utils.FormatUrlRewrite(Model.hotnews.FirstOrDefault().Id, Model.hotnews.FirstOrDefault().Title, "ArticleDetail")">
                    <img src="@Model.hotnews.FirstOrDefault().MainImage?w=460&h=290&mode=crop" alt="@Model.hotnews.FirstOrDefault().Title" />
                    <h3>@Model.hotnews.FirstOrDefault().Title</h3>
                </a>
                <p>@Model.hotnews.FirstOrDefault().IntroText</p>
            </div>
            <div class="big-news-list">
                <ul>
                    @foreach (var item in Model.hotnews.Skip(1).Take(5).Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="@item.value.LinkUrl">
                                <img src="@item.value.MainImage?w=202&h=114&mode=crop" alt="@item.value.Title" />
                                @item.value.Title
                            </a>
                            <div class="clear"></div>
                        </li>
                    }
                </ul>
            </div>
            <div class="clear"></div>

        </div>
		@if( Model.hotnews.Count()>6)
		{	  <div class="big-news-item02">
            <div>
                <ul>
                    @foreach (var item in Model.hotnews.Skip(6).Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="@item.value.LinkUrl">
                                <img src="@item.value.MainImage?w=217&h=122&mode=crop" alt="@item.value.Title" />
                                @item.value.Title
                            </a>
                            <div class="clear"></div>
                        </li>
                    }

                </ul>
                <div class="clear"></div>
            </div>
        </div>
		}
      
		@if(Model.articles!=null)
		{
        foreach (var item in Model.articles.Select((value, i) => new { i, value }))
        {
            if (item.i >= (int)(ViewBag.PageSize / 2))
            {
                break;
            }
            if (ViewBag.CategoryId != 69)
            {
            <div class="listtin" style="width:99%">
                <a href="@item.value.LinkUrl" title="@item.value.Title">
                    <img width="140" alt="@item.value.Title" src="@item.value.MainImage?w=140&mode=crop "/></a>
                <p><a href="@item.value.LinkUrl" title="@item.value.Title">@item.value.Title</a></p>
                @*<p class="date">@item.value.PublishDate.ToString("hh:mm") ngày @item.value.PublishDate.ToString("dd/MM/yyyy")</p>*@
                <span>@item.value.IntroText &nbsp;</span>
                <div class="clear"></div>
            </div>
            }
            else
            {

                if (item.i == 0)
                {
                    @Html.Raw("<div class='content_img'><ul class=\"images_content\" style='border:none;'>")
                }
                <li>
                    <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=209&h=125&mode=crop"></a>
                    <div class="clear"></div>
                    <a href="@item.value.LinkUrl">@item.value.Title</a>
                </li>
                if (item.i == 11 || item.i == Model.articles.Count - 1)
                {
                    @Html.Raw("</ul></div><div class=\"clear\"></div>")
                }
            }



        }
			{ Html.RenderAction("Pagging", "News", new { pageindex = ViewBag.Page, pagesize = ViewBag.PageSize, total = ViewBag.Total, CategoryId = ViewBag.CurrentCategoryId, CateName = ViewBag.CateName, PageNextShow = ViewBag.PageNextShow, pageNext = ViewBag.pageNext }); }
		}


        
    </div>
    <div class="clear padtop10" style="height: 25px"></div>
	if(Model.articles!=null)
		{
		
        if (ViewBag.Type <= 1) { Html.RenderAction("Relate", "News", new { CategoryId = ViewBag.CategoryId, CateName = ViewBag.CateName, HeaderTitle = "Các tin khác", PageNextShow = ViewBag.PageNextShow, pageNext = ViewBag.pageNext, data = Model.articles.Skip((int)ViewBag.PageSize / 2).ToList() }); }
		}
}
