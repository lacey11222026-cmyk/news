@using BIZ.Entity
@using UTILS
@model List<DATA.SMS.SMSLog>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>
                <input id="checkall" type="checkbox" onclick="checkAll(this);" name="checkall" />
            </th>
            <th class="texttable">Họ tên</th>

            <th>
                Số điện thoại
            </th>

            <th>Trạng Thái</th>

        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>
                <td>
                    <input type="checkbox" name="chk_item" value="@obj.Id" title="@obj.Mobile" />
                </td>
                <td>
                    @obj.Name
                </td>

                <td>@obj.Mobile</td>
                <td>
                    @if (obj.Status == 1)
                    {
                        <text>Đã gửi</text>

                    }
                    else
                    {
                        <text>Chưa gửi</text>

                    }
                </td>



            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            title: $("#txtKeyword").val(),
            status: $('#ddlStatus :selected').val(),
            cateId: $('#ddlCate :selected').val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListContact")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListContact").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });
    function checkAll(obj1) {

        $('input[type="checkbox"][name="chk_item"]').each(function (i, e) {

            if (obj1.checked == true) {
                $(e).removeAttr('checked');
                $(e).attr('checked', 'checked');
            }
            else {
                $(e).removeAttr('checked');

            }


        });


    }

</script>