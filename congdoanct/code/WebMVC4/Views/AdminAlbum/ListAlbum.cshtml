@using BIZ.Entity
@using UTILS
@model List<Album_FULL>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>ID</th>

            <th class="texttable">Tên album</th>
            <th class="hidemobile">Chuyên mục</th>
            <th class="hidemobile">Style hiển thị</th>
            <th>
                Ngày xuất bản
            </th>
            <th class="hidemobile">
                Người  tạo
            </th>

            <th>Trạng Thái</th>
            <th>Thao Tác</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>
                <td>@obj.Id</td>

                <td class="texttable" style="text-align:left">
                    <a href="@Url.Action("GetAlbumDetail",new {id=obj.Id })" title="Edit">@obj.Title</a>
                </td>
                <td class="hidemobile">@HtmlHelpers.GetNewsCategoryName(obj.CategoryId, ViewBag.CategoryList)</td>
                <td class="hidemobile">
                    @if (obj.Style == 1)
                    {
                        <text>Light Box</text>

                    }
                    else
                    {
                        <text>Gallery</text>

                    }
                </td>
                <td>@obj.PublishDate.GetValueOrDefault().ToString("dd/MM/yyyy HH:mm")</td>

                <td class="hidemobile">@obj.CreatedBy</td>


                <td>
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatus('@Utils.Base64Encode(obj.Id)', 1,'@obj.Title');"><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatus('@Utils.Base64Encode(obj.Id)',0,'@obj.Title');"><i class="fa fa-ban"></i></a>

                    }
                </td>
                <td style="text-align: center">
                    <a href="javascript:;" title="Delete" onclick="DeleteData('@Utils.Base64Encode(obj.Id)','@obj.Title')"><i class="fa fa-trash-o"></i></a>

                </td>

            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            title: $("#txtKeyword").val(),
            status: $('#ddlStatus :selected').val(),
            cateId: $('#ddlCate :selected').val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListAlbum")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListAlbum").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });

    function DeleteData(id, title) {

        bootbox.confirm("Bạn chắc chắn muốn xóa album này ??? ", function (result) {
            if (result == true) {
                var postdata = {
                    '_id': id,
                    'Title': title,
                };
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("Delete")",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {
                        Utils.UnLoading();
                        BindDataRequest(CurrentPage);
                    }
                });
            }
        });

    }
    function UpdateStatus(id, status, title) {
        var type = "Khóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " album này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                var postdata = {
                    '_id': id,
                    'Title': title,
                };
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("UpdateStatus")",
                    data: addAntiForgeryToken(postdata),

                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
</script>