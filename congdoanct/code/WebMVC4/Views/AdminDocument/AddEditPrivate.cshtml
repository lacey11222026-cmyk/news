    <script type="text/javascript">
        var DocumentId = '@ViewBag.Id';
        var currentCategorytId = 0;
        var redirectUrl = '@Url.Action("IndexPrivate","AdminDocument")';
        var entityName = 'Document';

        $(document).ready(function () {
            InitCalendar();
            BindCategoriesToSelectBox();

            $("#tabs").tabs({ selected: 0 });


        });
        function InitCalendar() {
           
            var cal1 = Zapatec.Calendar.setup({
                inputField: 'txtPublishDate',
                button: "checkInCal1",
                ifFormat: "%d/%m/%Y",
                timeFormat: "24",
                showsTime: false,
                electric: false
            });
            var cal2 = Zapatec.Calendar.setup({
                inputField: 'txtEffectiveDate',
                button: "checkInCal2",
                ifFormat: "%d/%m/%Y",
                timeFormat: "24",
                showsTime: false,
                electric: false
            });
            var cal3 = Zapatec.Calendar.setup({
                inputField: 'txtExpiryDate',
                button: "checkInCal3",
                ifFormat: "%d/%m/%Y",
                timeFormat: "24",
                showsTime: false,
                electric: false
            });
        }

        function OnLoad() {

            if (DocumentId != 0) {

                $('#spDetailTitle').text('Sửa chữa');


                $.Services({
                    serviceName: 'DocumentService.ashx',
                    data: {
                        __m: 'get_document',
                        _id: DocumentId
                    },
                    success: function (data) {

                        if (data != undefined && data != null && data != '')
                            BindData(data);
                        else
                            $('#all_item_info_container').html("Văn bản không tồn tại hoặc đã bị xóa");

                        DestroyDialog();
                    }
                });
            }
            else {

                $('#spDetailTitle').text('Tạo mới');



                DestroyDialog();
            }

        }

        function BindData(data) {

            $('#txtName').val(data.Name);
            $('#txtCode').val(data.Code);
            $('#txtDescription').val(data.Description);
            $('#select_style option[value=' + data.Style + ']').attr('selected', 'selected');
            $('#select_category option[value=' + data.CategoryId + ']').attr('selected', 'selected');

            currentCategorytId = data.CategoryId;

            $('#txtFilePath').val(data.FilePath);
            $('#txtSignedByDesc').val(data.SignedByDesc);
            $('#txtSignedBy').val(data.SignedBy);
            $('#txtPublishDate').val(dateFormat(data.PublishDate, 'dd/mm/yyyy'));
            $('#txtEffectiveDate').val(dateFormat(data.EffectiveDate, 'dd/mm/yyyy'));
            $('#txtExpiryDate').val(dateFormat(data.ExpiryDate, 'dd/mm/yyyy'));


            $('input[name="radPublished"]').each(function (i, e) {
                if ($(e).val() == data.Status)
                    $(e).attr('checked', 'checked');
                else
                    $(e).removeAttr('checked');
            });


        }

        function FormValidate() {
            var title = $.trim($('#txtName').val());
            if (title == '') {
                $('#jalert_notification').jAlert('Tên Document không được để trống', 'warning', "edit", 400);
                $('#txtName').focus();
                return false;
            }


            return true;
        }


        function PostObj(method) {

            var name = Encoder.urlEndcode($.trim($('#txtName').val()));
            var description = Encoder.urlEndcode($('#txtDescription').val());
            var cateogryId = $('#select_category option:selected').val();

            var categorypathway = $('#select_category option:selected').attr('title');
            var status = 0;
            status = $('input[name="radPublished"]:checked').val();

            var code = $.trim($('#txtCode').val());
            var filepath = $.trim($('#txtFilePath').val());
            var signedbydesc = Encoder.urlEndcode($.trim($('#txtSignedByDesc').val()));
            var signedby = Encoder.urlEndcode($.trim($('#txtSignedBy').val()));
            var publishdate = $.trim($('#txtPublishDate').val());
            var effectivedDate = $.trim($('#txtEffectiveDate').val());
            var expirydDate = $.trim($('#txtExpiryDate').val());


            var post_data = {
                __m: method,
                id: DocumentId,
                name: name,
                categoryid: cateogryId,
                categorypathway: categorypathway,
                description: description,
                code: code,
                status: status,
                _private: "1",
                filepath: filepath,
                signedbydesc: signedbydesc,
                signedby: signedby,
                publishdate: publishdate,
                effectivedate: effectivedDate,
                expirydate: expirydDate
            };

            return post_data;
        }

        function Save(type) {

            DestroyJAlert();

            if (!FormValidate())
                return;

            OpenAlertDialog('Đang xử lý ...');

            $.Services({

                isCrossDomain: false,
                url: POST_URL + 'DocumentService.ashx',
                data: PostObj('save'),
                success: function (data) {

                    if (data != undefined && data != null && data != '') {
                        var json_data = eval('(' + data + ')');

                        if (json_data.Success) {

                            if (json_data.Value != 0 && json_data.Value != null && json_data.Value != undefined && json_data.Value != '') {
                                DocumentId = json_data.Value;

                            }

                            //OnLoad();                               
                        }


                        if (type != undefined && type != null && type != '' && type == 'close')
                            Close();


                        DestroyDialog();

                        var jalert_type = "info";
                        if (!json_data.Success)
                            jalert_type = "fatal";

                        $('#jalert_notification').jAlert(json_data.Text, jalert_type, "edit", 400);
                    }



                }
            });
        }

        function Close() {

            window.location.href = redirectUrl;
        }

        function BindCategoriesToSelectBox() {

            //$('#select_category').html('<option value="0">- Không thuộc nhóm nào -</option>');
            $('#select_category').html('<option value="72">- Văn bản nội bộ -</option>');
            $.Services({

                serviceName: 'CategoryService.ashx',
                data: {
                    __m: 'get_categorybyparent',
                    _id: 72
                },
                success: function (data) {
                    html = '';

                    if (data != undefined && data != null && data != '') {

                        $.each(data, function (i, item) {

                            html = '<option value="' + item.Id + '" title="' + item.Pathway + '">';

                            if (item.NodeLevel != 0) {
                                for (var i = 1; i < item.NodeLevel; i++) {
                                    html += '-+&nbsp;';
                                }
                            }

                            html += item.Name;
                            html += '</option>';

                            if (item.ParentId != 0) {
                                if ($('#select_category option[value=' + item.ParentId + ']').length)
                                    $('#select_category option[value=' + item.ParentId + ']').after(html);
                                else
                                    $('#select_category').append(html);
                            }
                            else
                                $('#select_category').append(html);



                        });

                        OnLoad();

                    }

                }
            });



        }

        function openWin() {
            myWindow = window.open('@Url.Action("MultiUpload","Admin")', '', 'width=700,height=500');

            myWindow.focus();
        }

       


    </script>
