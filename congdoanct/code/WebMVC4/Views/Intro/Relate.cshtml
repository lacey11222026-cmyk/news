@using BIZ
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
    <div class="best">
      
         
        
        <div class="bg_org">Các bài khác</div>
        <ul class="list">

            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li><a title="@item.value.Name" href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Name, "Intro")">@item.value.Name </a></li>
            }


        </ul>
       
        <div class="clear"></div>
       
    </div>
   

    }


}