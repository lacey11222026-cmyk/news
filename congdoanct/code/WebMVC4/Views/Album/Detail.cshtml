@using BIZ
@using UTILS
@using WebMVC4.Helper
@model DATA.Album
@if (Model != null)
{
    if (ViewBag.ParentCategoryId > 0)
    {
    <script type="text/javascript">
        var index = $('#ddtabs1 li').index($('#cate_' + '@ViewBag.ParentCategoryId'));
        ddtabmenu.definemenu("ddtabs1", index);

        setTimeout(function () {
            $("#ddtabs1 .current").parent().addClass("select");

        }, 1000);
    </script>
       
    }
    else
    {
    <script type="text/javascript">
        var index = $('#ddtabs1 li').index($('#cate_' + '@ViewBag.CurrentCategoryId'));

        ddtabmenu.definemenu("ddtabs1", index);
        setTimeout(function () {
            $("#ddtabs1 .current").parent().addClass("select");

        }, 1000);
    </script>
       
    }
    <div class="cate">
        @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
        <div class="clear">
        </div>
        <div class="box_nd">
            <div id="titleNews" class="tieude">
                <h2>@Model.Title</h2>
            </div>
            <div id="introNews" class="intro">@Html.Raw(Model.Description)</div>
        </div>
        <br />
        <br />
       @if (ViewBag.ImgList != null)
       {
        <div id="PnlLightBox">
            <div class="chum_anhlist" id="lstlightbox">
                @foreach (BIZ.Entity.AlbumImage item in ViewBag.ImgList)
                {
                    <a href="@(item.Name)?w=0&h=@(ViewBag.Height)&mode=crop" class="chum_anh" title="@item.Text">
                        <img src="@(item.Name)?w=100&h=100&mode=crop" width="100" height="100"
                             alt="" />
                    </a>
                }
                <div class="clear">
                </div>
            </div>
            <div class="clear">
            </div>
            <script src="/Scripts/jquery.lightbox-0.5.js" type="text/javascript"></script>
            <link href="/Styles/jquery.lightbox-0.5.css" rel="stylesheet" type="text/css" />
            <script type='text/javascript'>


                $(function () {

                    $(' #lstlightbox a').lightBox();



                });
            </script>
        </div>
       }
    </div>
}



