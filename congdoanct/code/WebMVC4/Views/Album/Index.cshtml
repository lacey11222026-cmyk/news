@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.AlbumModel
@if (Model.listdata != null)
{
    /*active menu*/
    if (ViewBag.ParentCategoryId > 0)
    {
        <script type="text/javascript">
            var index = $('#ddtabs1 li').index($('#cate_' + '@ViewBag.ParentCategoryId'));
            ddtabmenu.definemenu("ddtabs1", index);

            setTimeout(function () {
                $("#ddtabs1 .current").parent().addClass("select");

            }, 1000);
        </script>

    }
    else
    {
        <script type="text/javascript">
            var index = $('#ddtabs1 li').index($('#cate_' + '@ViewBag.CurrentCategoryId'));

            ddtabmenu.definemenu("ddtabs1", index);
            setTimeout(function () {
                $("#ddtabs1 .current").parent().addClass("select");

            }, 1000);
        </script>

    }
    <div class="cate article">
        @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
        <div class="content_img content_news">
            <ul class="images_content" style="border: none;">
                @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                {
                    <li>
                        <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "AlbumDetail")">
                            <img src="@item.value.MainImage?w=209&h=125&mode=crop">
                        </a>
                        <div class="clear"></div>
                        <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "AlbumDetail")">@item.value.Title</a>
                    </li>

                }
            </ul>
            <div class="clear"></div>

        </div>
        <div class="ctpaging">

            <ul class="paging">
                @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                  {
                      PageUrl = Url.SetParameter("Page", "!0"),
                      CurrentPage = Model.pageIndex,
                      PageSize = Model.pageSize,
                      TotalItemCount = Model.total,
                  }); }
            </ul>

        </div>
    </div>
}