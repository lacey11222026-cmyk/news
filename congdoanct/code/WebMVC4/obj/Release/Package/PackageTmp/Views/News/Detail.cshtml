@using BIZ
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.CONTENT_FULL
@{var RelateTitle = "Các tin khác";}
@if (Model != null)
{
    /*active menu*/
    if (ViewBag.ParentCategoryId > 0)
    {
        <script type="text/javascript">
            var index = $('#ddtabs1 li').index($('#cate_' + '@ViewBag.ParentCategoryId'));
            ddtabmenu.definemenu("ddtabs1", index);

            setTimeout(function () {
                $("#ddtabs1 .current").parent().addClass("select");

            }, 1000);
        </script>

    }
    else
    {
        <script type="text/javascript">
            var index = $('#ddtabs1 li').index($('#cate_' + '@ViewBag.CurrentCategoryId'));

            ddtabmenu.definemenu("ddtabs1", index);
            setTimeout(function () {
                $("#ddtabs1 .current").parent().addClass("select");

            }, 1000);
        </script>

    }
    <div class="best">
        @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
        <div class="chitiet">
            <div class="tenbai">@Model.Title</div>
            <div class="text_blue">Cập nhật lúc @Model.PublishDate.ToString("hh:mm") ngày @Model.PublishDate.ToString("dd/MM/yyyy")</div>

            <div id="introNews" class="intro"></div>
            <div id="igmNews" style="display:none">@Model.MainImage</div>
            <div>
                @if (ViewBag.lstRef != null)
                {
                    <div class="dvtinlienquan">
                        @foreach (var item in ViewBag.lstRef)
                        {
                        <br />
                        <a href="@Utils.FormatUrlRewrite(item.Id, item.Title, "ArticleDetail")">@item.Title </a>

                        }
                    </div>
                   
                    <div style="height:10px;">&nbsp;</div>

                }

            </div>
            <div class="nd" id="NewsContent">
                @if (Model.Type == 1)
                {
                    @Html.Raw(Model.Contents)

                }
                else if (Model.Type == 2)
                {
                    <br />
                    if (Model.Url.Contains("youtube.com"))
                    {
                        <iframe id="ifvideo" width="420" height="315"
                                src="@(Model.Url.Replace("watch?v=", "embed/"))?autoplay=1"></iframe>

                                <script type="text/javascript">
                                    var width = $("#NewsContent").width();
                                    var height = width * 2 / 3;
                                    //var url = '@Model.Url';
                                    $("#ifvideo").width(width);
                                    $("#ifvideo").height(height);
                                </script>
                    }
                    else
                    {
                        if (Model.Url.Contains(".mp4"))
                        {
                            <video controls autoplay preload="auto" poster="@Model.MainImage" name="myvideo" id="myvideo" style="width:100%">


                                <source src="@Model.Url" type="video/mp4" />

                            </video>
                        }
                        else
                        {
                            @Html.Raw(HtmlHelpers.EmbedVideo(Model.Url, Model.MainImage, "600", "360"))
                        }

                    }
                    RelateTitle = "Các Video khác";
                }
                else
                {
                    @Html.Raw(HtmlHelpers.EmbedVideo(Model.Url, "/flash/playerimg.jpg", "600", "376"))
                    RelateTitle = "Các bài khác";
                }

            </div>
        </div>
        @{ Html.RenderAction("Share", "News", new { data = Model }); }
        <div class="clear">
        </div>

    </div>
    <div class="clear"></div>
            if (!string.IsNullOrEmpty(Model.FileParam.Name1))
            {
                <div class="document-attach">
                    <div class="bg_org"><span class="icon-attach"></span> Tài liệu đính kèm <div class="clear"></div></div>
                    <ul class="list">

                        <li><a title="@Model.FileParam.Name1" href="@Model.FileParam.Path1" target="_blank">@Model.FileParam.Name1 </a></li>
                        @if (!string.IsNullOrEmpty(Model.FileParam.Name2))
                        {
                            <li><a title="@Model.FileParam.Name2" href="@Model.FileParam.Path2" target="_blank">@Model.FileParam.Name2 </a></li>
                        }
                        @if (!string.IsNullOrEmpty(Model.FileParam.Name3))
                        {
                            <li><a title="@Model.FileParam.Name3" href="@Model.FileParam.Path3" target="_blank">@Model.FileParam.Name3 </a></li>
                        }




                    </ul>
                    <div class="clear"></div>
                </div>
            }
            <div class="clear padtop10"></div>

            { Html.RenderAction("Relate", "News", new { CategoryId = Model.CategoryId, CateName = ViewBag.CateName, HeaderTitle = RelateTitle, PageNextShow = false, pageNext = 2 }); }

           
           
                    if (ViewBag.IsMobile)
                    {
                        <script>
                            $('#NewsContent table').removeAttr('width');

                            $('#NewsContent  img').removeAttr('width');
                        </script>
                        }


                    }
