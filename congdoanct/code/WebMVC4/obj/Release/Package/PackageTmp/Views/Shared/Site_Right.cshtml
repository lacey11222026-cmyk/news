@if (HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString().ToLowerInvariant() == "home")
{
    Html.RenderAction("BannerRight", "Home");
}
else
{
    var data = new BIZ.CategoryBO().GetAllChildCategories(8, 10, false);

    if (data != null)
    {
        foreach (var item in data.Select((value, i) => new { i, value }))
        {

            { Html.RenderAction("RightLastestNews", "News", new { CateName = item.value.Name, CategoryId = item.value.Id, MaxLastestNews = 2 }); }


        }


    }
}