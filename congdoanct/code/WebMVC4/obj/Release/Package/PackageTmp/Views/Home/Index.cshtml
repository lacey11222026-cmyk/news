@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>


@{Html.RenderAction("Slide", "Home");}

<script>
    $(window).load(function () {
        $("#slide-news2").flexisel({
            visibleItems: 1,
            animationSpeed: 200,
            autoPlay: true,
            autoPlaySpeed: 8000,
            pauseOnHover: true,
            enableResponsiveBreakpoints: true,
            responsiveBreakpoints: {
                portrait: {
                    changePoint: 480,
                    visibleItems: 1
                },
                landscape: {
                    changePoint: 640,
                    visibleItems: 1
                },
                tablet: {
                    changePoint: 768,
                    visibleItems: 1
                }
            }
        });
    });

</script>
@{Html.RenderAction("Banner", "Home", new { Index = 1 });}

@if (Model != null)
{

    if (Model.Count > 0)
    {
        foreach (var item in Model.Select((value, i) => new { i, value }))
        {
            if (item.i % 2 == 0)
            {

                <div class="boxtin fl">
                    @{Html.RenderAction("LastestNews", "Home", new { CateName = item.value.Name, CategoryId = item.value.Id, MaxLastestNews = 3 });}
                </div>

            }
            else
            {
                <div class="boxtin fr">
                    @{Html.RenderAction("LastestNews", "Home", new { CateName = item.value.Name, CategoryId = item.value.Id, MaxLastestNews = 3 });}
                </div>
                <div class="clear"></div>

            }

            if (item.value.Id == 97)
            {
                <div class="clear"></div>
                { Html.RenderAction("Banner", "Home", new { Index = 2 }); }
                <div class="clear"></div>
            }
        }
    }
}
