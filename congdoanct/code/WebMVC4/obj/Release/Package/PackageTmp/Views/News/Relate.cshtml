@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="list_new padtop">



            <div class="bg_org">@ViewBag.HeaderTitle</div>
            <ul class="list">

                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    <li><a title="@item.value.Title" href="@item.value.LinkUrl">@item.value.Title </a></li>
                }


            </ul>

            <div class="clear"></div>

        </div>
        <div class="clear padtop"></div>

    }


}