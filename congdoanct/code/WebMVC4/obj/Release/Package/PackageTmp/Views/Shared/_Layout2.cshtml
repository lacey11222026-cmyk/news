</head>
<body onorientationchange="updateOrientation();">
    @Scripts.Render("~/sitescript")
    <div class="top_link"></div>
    <
    <div id="wrap">
        <div class="header">
            <div class="fl">
                <img src="/images/header.png" />
            </div>
            <div class="link_top"><a href="">Trang chủ</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="">Sơ đồ</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="">Quy chế</a></div>
            <div class="dangnhap">
                <div class="timkiem">
                    <input name="" type="text" class="form2" value="" placeholder="Nhập từ cần tìm" />&nbsp;<a href=""><img src="/images/search.png" /></a>
                </div>
                <div class="clear"></div>
                <div class="timkiem">
                    <select name="" class="form1">
                        <option>Liên kết</option>
                        <option>Liên kết 1</option>
                        <option>Liên kết 2</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="clear"></div>


        @{Html.RenderAction("Menu", "Home");}
        <div class="bgw" id="cap1">
            <div class="left">
                @RenderBody()
            </div>
            <div class="right">
                @Html.Partial("Site_Right2")
            </div>
            <div class="clear"></div>
            @{Html.RenderAction("BannerBottom", "Home");}




        </div>
        <div class="clear"></div>
        <div class="footer">
            @Html.Partial("Site_Footer")
        </div>
    </div>
    <script>
        function updateOrientation() {
            window.location.reload();
        }
    </script>
    @*<script type="text/javascript" src="/Scripts/jquery.mmenu.min.all.js"></script>*@
    <script type="text/javascript">
        $(function () {
            $('nav#menu').mmenu();
        });
        $(document).ready(function () {

            $(".block_mobile .click").bind('click', function () {
                $(".block_mobile .date").hide();
                $(".block_mobile .search_m").animate({ width: "75%" });
            });
        });
    </script>
