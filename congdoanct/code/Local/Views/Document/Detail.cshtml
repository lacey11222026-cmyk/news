@using BIZ
@using DATA
@using UTILS
@using Local.Helper
@model BIZ.Entity.DOCUMENT_FULL

<div class="box_out w775">


    @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
    <div class="noidung">
        <table width="100%" cellspacing="1" cellpadding="5" border="0" bgcolor="#CCC">
            <tbody>
                <tr class="bgcolor1">
                    <td width="25%" height="50" class="titledoc">Tên văn bản
                    </td>
                    <td colspan="3">

                        @Model.Name

                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td width="25%" height="50" class="titledoc">Tải file
                    </td>
                    <td colspan="3">
                        <a target="_blank" href="@Model.FilePath" >Download</a>&nbsp;
                         @if (Model.FilePath.ToLower().Contains(".pdf"))
                         {
                                
                             <a href="@Url.Action("ViewPDF", "Home", new { url = Model.FilePath })" target="_blank">Xem online</a>
                         }
                    </td>

                </tr>
                <tr class="bgcolor1">
                    <td height="50" class="titledoc">Mô tả
                    </td>
                    <td colspan="3">
                        @Model.Description
                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td height="50" class="titledoc">Số hiệu văn bản
                    </td>
                    <td width="28%">
                        @Model.Code
                    </td>
                    <td width="21%" class="titledoc">Ngày có hiệu lực
                    </td>
                    <td width="26%" align="center">
                        @Convert.ToDateTime(Model.EffectiveDate).ToString(@" dd'/'MM'/'yyyy")
                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td height="50" class="titledoc">Ngày ban hành
                    </td>
                    <td>
                        @Convert.ToDateTime(Model.PublishDate).ToString(@" dd'/'MM'/'yyyy")
                    </td>
                    <td class="titledoc">Ngày hết hiệu lực
                    </td>
                    <td align="center">
                        @if (Model.ExpiryDate.Value.Year < 9999)
                        {
                            @Convert.ToDateTime(Model.ExpiryDate).ToString(@" dd'/'MM'/'yyyy")
                                   
                        }
                        else
                        {
                            <text>&nbsp;</text>   
                        }


                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td height="50" class="titledoc">Cơ quan ban hành
                    </td>
                    <td align="center">
                        @Model.SignedByDesc

                    </td>
                    <td class="titledoc">Người ký
                    </td>
                    <td align="center">
                        @Model.SignedBy
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    @*<div class="fb-like" data-href="https://www.giftcard.com" data-send="false" data-width="500" data-show-faces="false">abc</div>*@
</div>
<div class="clear padtop10"></div>
@if (ViewBag.lstRef != null)
{
    <div class="list_new padtop">
        <div class="bg_org">Các văn bản khác</div>
        <ul class="list">


            @foreach (BIZ.Entity.DOCUMENT_FULL item in ViewBag.lstRef)
            {
                <li><a title="@item.Name" href="@Utils.FormatUrlRewrite(item.Id, "", "DocumentDetail")">@item.Name </a></li>
            }



        </ul>
        <div class="clear"></div>

    </div>
    <div class="clear padtop"></div>
    
   


    

}