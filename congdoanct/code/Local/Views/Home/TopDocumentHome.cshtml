@using BIZ
@using UTILS
@using DATA.DocumentDB
@model List<DocumentHome>

@if (Model != null)
{
    if (Model.Count > 0)
    {

        <ul class="list-cm">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li><a href="http://vuit.org.vn/Document/ViewFile/@(item.value.Id)" target="_blank">@item.value.Name</a>
                    @if (item.value.CreatedDate.AddDays(1) >= DateTime.Now)
                    {
                        <span class="c_ic_moi">Mới</span>

                    }
            </li>
            }
        </ul>

    }

}