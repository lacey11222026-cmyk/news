@using BIZ
@using UTILS
@using Local.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        
 <div class="bg_blu">@ViewBag.CateName</div>

    <div class="clear"></div>

    <div class="boxtin_bg">
        @foreach (var item in Model.Select((value, i) => new { i, value }))
        {
            if (item.i == 0)
            {
            <div class="tin_cate">
                <a title="@item.value.Title" href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">
                    <img width="104" alt="@item.value.Title" src="@item.value.MainImage.104.104.jpg"></a>
                 <p style="min-width: 330px;"><a title="@item.value.Title" href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">@item.value.Title</a></p>
                <span>@UTILS.Utils.SubString(item.value.IntroText, 150) </span>
            </div>
           
           

            }
            else
            {
                if (item.i == 1)
                {
            @Html.Raw("<ul class=\"list\">")
   
                }
            <li><a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")"
                                                        title="@item.value.Title">@item.value.Title
            </a></li>
                if (item.i == Model.Count - 1)
                {
            @Html.Raw("<div class=\"clear\"></div></ul>")
                }
            }
        }

        <div class="xemtiep2">
            <a href="@ViewBag.Url" class="opa">
                <img src="/images/xemtiep.jpg"></a>
        </div>
        <div class="clear"></div>
    </div>
    
    
         
       
    
        
    }
}