@using BIZ
@using UTILS
@using Local.Helper
@model List<BIZ.Entity.DOCUMENT_FULL>

@if (Model != null)
{
    if (Model.Count > 0)
    {

        <ul class="list-cm">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li><a href="@Url.Action("ViewFile","Document",new { id=item.value.Id})" target="_blank" >@item.value.Name</a>
                    @if (item.value.CreatedDate.GetValueOrDefault().AddDays(1) >= DateTime.Now)
                    {
                        <span class="c_ic_moi">Mới</span>

                    }
                </li>
            }
        </ul>

    }

}