@using BIZ
@using UTILS
@using Local.Helper
@model List<BIZ.Entity.CATEGORY_FULL>
<div class="box_out width195">
    <div class="box_in width165"><span class="text_w">Thông tin</span></div>
    <div class="clear"></div>
    <ul class="list">
        @if (Model != null)
        {

            if (Model.Count > 0)
            {
                foreach (var item in Model.Select((value, i) => new { i, value }))
                {
            <li id="menuleft_@item.value.Id"><a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name</a>
            </li>      
                }
            }
        }

    </ul>
</div>
