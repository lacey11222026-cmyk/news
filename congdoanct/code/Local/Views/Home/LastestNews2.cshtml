@using BIZ
@using UTILS
@using Local.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <ul class="list-cm">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li>
                    <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">@item.value.Title </a>
                    @if(item.value.CreatedDate.AddDays(1)>=DateTime.Now)
                    {
                    <span class="c_ic_moi">Mới</span>

                    }
                </li>
            }
        </ul>

    }
    else
    {
        if (ViewBag.CategoryId == 97)
        {
            <script>
                $("#badnews").hide();
            </script>
        }
    }
}
else
{
    if (ViewBag.CategoryId == 97)
    {
        <script>
            $("#badnews").hide();
        </script>
    }
}