@using BIZ
@using BIZ.Entity
@using UTILS
@using Local.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    <div id="hotnew">


        <div class="best">

            <div class="toptin">
                <div style="float: none;" id="hotnews">
                    <ul id="mycarouse2">
                        @foreach (var item in Model.Select((value, i) => new { i, value }))
                        {
                            <li>
                                <div class="anh_toptin">
                                    <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">

                                        <img src="@item.value.MainImage.460.290.jpg"></a>
                                    <div class="tit_toptin">
                                        <p><a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">@item.value.Title</a></p>
                                        <p class="sapo">@UTILS.Utils.SubString(item.value.IntroText, 200).</p>
                                    </div>

                                </div>

                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="tinmoi">
                <ul id="home_tabnews" class="home_tab">
                    <li class="chon"><a href="#homeside1" class="select_new">Tin mới nhất</a></li>
                    <li><a href="#homeside2" class="select_view">Tin nổi bật</a></li>
                </ul>
            </div>
            <div id="homeside2">
                <ul class="listtinmoi">
                    @{
                        List<CONTENT_FULL> data = ViewBag.Contents;
                    }
                    @foreach (var item in data.Select((value, i) => new { i, value }))
                    {
                        if (item.i < 7)
                        {
                        <li><a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">@item.value.Title</a></li>
                        }

                    }


                </ul>
            </div>
            <div id="homeside1">
                <ul class="listtinmoi">

                    @foreach (var item in Model.Select((value, i) => new { i, value }))
                    {
                        if (item.i < 7)
                        {
                        <li><a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">@item.value.Title</a></li>
                        }

                    }


                </ul>
            </div>




        </div>
        <div class="clear"></div>
        <div class="best">
            <div class="list_new2">
                @{
                    List<CONTENT_FULL> data2 = ViewBag.HotNews;
                }
                @foreach (var item in data2.Select((value, i) => new { i, value }))
                {
                    if (item.i < 3)
                    {
                    <div class="box_list_img">
                        <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">
                            <img src="@item.value.MainImage.202.114.jpg">@item.value.Title</a>
                    </div>
                
                    }

                }


            </div>
            <div class="clear"></div>
        </div>

    </div>
    <script type="text/javascript">

        jQuery('#mycarouse2').jcarousel({
            wrap: 'circular',
            offset: 1,
            auto: 10, animation: "normal",
            scroll: 1,
            btnPrev: null, btnNext: null
        });
        $("#hotnew .jcarousel-clip-horizontal").css({ width: "460px", height: "390px", overflow: "hidden" });

    </script>
 
    <style>
        .toptin .jcarousel-item {
            width: 460px;
            height: 390px;
        }
    </style>
    <script type="text/javascript">


        $(document).ready(function () {
            $('#home_tabnews').tabify();
        });


    </script>

}