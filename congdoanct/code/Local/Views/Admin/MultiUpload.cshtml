@using BIZ
@using UTILS
@using Local.Helper
@{
    
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@model List<FileInfo>


<script type="text/javascript" language="javascript">
    $(document).ready(function () {
        $('.drl_Month').change(function () {
            window.location = jQuery.query.set("Month", this.value);
        });
    });
    function filedelete(filename, month) {
        if (confirm("Bạn có chắc chắn muốn xóa file này không?")) {
            $.post('@Url.Action("FileDelete", "Admin")', { "filename": filename, "month": month },
                function (data) {
                    window.location.reload();


                });
        }
    }


</script>
<div id="content-box">
    <div class="border">
        <div class="padding">

            <div class="clr">
            </div>
            <div class="clr">
            </div>
            <div id="element-box">
                <div class="t">
                    <div class="t">
                        <div class="t">
                        </div>
                    </div>
                </div>
                <div class="m">
                
                <div id="filepanel" style="display: block;">
                    <div>
                        <div style="float: left;">
                            Thư mục
                                    &nbsp;&nbsp;&nbsp;
                                       @Html.DropDownList("Month", new SelectList(new[] { new { Month = 1, Name = "1" }, new { Month = 2, Name = "2" }, new { Month = 3, Name = "3" }, new { Month = 4, Name = "4" }, new { Month = 5, Name = "5" }, new { Month = 6, Name = "6" }, new { Month = 7, Name = "7" }, new { Month = 8, Name = "8" }, new { Month = 9, Name = "9" }, new { Month = 10, Name = "10" }, new { Month = 11, Name = "11" }, new { Month = 12, Name = "12" } }, "Month", "Name", ViewBag.Month), new { @class = "drl_Month" })
                        </div>
                        <div style="float: right;">
                            <div id="uploadpanel">

                                @{Html.RenderAction("UploadContent", "Admin");}


                            </div>
                        </div>
                        <div style="clear: both">
                        </div>
                    </div>
                    <br />
                    <div style="width: 100%; height: 538px; overflow-y: scroll; display: block;">
                        <table class="adminlist" cellpadding="1">
                            <thead>
                                <tr>
                                    <td align="center" width="1%"></td>
                                    <td align="center" width="10%">ICon
                                    </td>
                                    <td align="center" width="20%">Name
                                    </td>
                                    <td align="center" width="50%">Link
                                    </td>
                                    <td align="center" width="10%">Action
                                    </td>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <td colspan="8"></td>
                                </tr>
                            </tfoot>
                            @if (Model != null)
                            {

                                foreach (FileInfo item in Model)
                                {
                                <tr id="tr_@item.Name">
                                    <td align="center" width="1%"></td>
                                    <td align="center" width="10%">
                                        <img alt="icon" width="50" height="40" src='@(HtmlHelpers.Getimgren(item.Extension.ToLower(), item.Name, ViewBag.hdfCurrentFolder))?w=150&h=100&mode=crop' />
                                    </td>
                                    <td width="20%">
                                        @item.Name
                                    </td>
                                    <td width="50%" valign="middle">
                                        <input style="width: 100%;" id="Text1" type="text" value='@ViewBag.hdfCurrentFolder@item.Name' />

                                    </td>
                                    <td width="20%">
                                        <a onclick="return filedelete('@item.Name','@ViewBag.Month');" href='javascript:void(0);'>Xóa</a>
                                    </td>
                                </tr>
                                             
                                }

                            }

                        </table>
                    </div>
                </div>
                    </div>
            </div>
            <div class="b">
                <div class="b">
                    <div class="b">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

