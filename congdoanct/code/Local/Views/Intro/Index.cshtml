@using BIZ
@using UTILS
@using Local.Helper
@model BIZ.Entity.CATEGORY_FULL

@if (Model != null)
{
   

    <section class="container main-content mt10">
        <div class="row">
            <div class="col-md-8 col-sm-12 col-xs-12 schedule">
                <div class="schedule-title">
                    <h3>@Model.Name</h3>

                    <div class="clearfix"></div>
                </div>
                <div class="clearfix"></div>
                @if (Model != null)
                {
                    <div class="tenbai">@Model.Name</div>
                    <div class="schedule-wrap mt10">
                        @Html.Raw(Model.Contents)
                      
                    </div>
                }
            </div>
            <!-- end schedule -->

            @Html.Partial("Site_Right")
            <!-- end sidebar-->
        </div><!-- end row-->
        <div class="clearfix"></div>


    </section>
    <style>
        .schedule-title h3 {
            background:none;
        }
    </style>


}
