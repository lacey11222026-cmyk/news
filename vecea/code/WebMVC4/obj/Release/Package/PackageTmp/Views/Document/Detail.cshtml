@using BIZ
@using DATA
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.DOCUMENT_FULL
<div class="main-content box-09 video-page">
    @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = ViewBag.CurrentCategoryId });}
    <div class="wrapp-table">
        <table class="document-table mt20">
            <tbody>
                <tr class="bgcolor1">
                    <td width="25%" height="50" class="titledoc">
                        Tên văn bản
                    </td>
                    <td colspan="3">

                        @Model.Name

                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td width="25%" height="50" class="titledoc">
                        Tải file
                    </td>
                    <td colspan="3">
                        <a target="_blank" href="@Url.Action("DownloadFile", "Document", new {Id=Model.Id})">Download</a>&nbsp;
                        @if (Model.FilePath.ToLower().Contains(".pdf"))
                        {

                            <a href="@Url.Action("ViewFile", "Document", new {Id=Model.Id})" target="_blank">
                                Xem online
                            </a>
                        }
                    </td>

                </tr>
                <tr class="bgcolor1">
                    <td height="50" class="titledoc">
                        Mô tả
                    </td>
                    <td colspan="3">
                        @Model.Description
                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td height="50" class="titledoc">
                        Số hiệu văn bản
                    </td>
                    <td width="28%">
                        @Model.Code
                    </td>
                    <td width="21%" class="titledoc">
                        Ngày có hiệu lực
                    </td>
                    <td width="26%" align="center">
                        @if (!Model.EffectiveDate.HasValue)
                        {

                            <text>&nbsp;</text>
                        }
                        else
                        {
                            if (Model.EffectiveDate.Value.Year < 9000)
                            {
                                @Convert.ToDateTime(Model.EffectiveDate).ToString(@" dd'/'MM'/'yyyy")
                            }
                            else
                            {
                                <text>&nbsp;</text>
                            }

                        }
                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td height="50" class="titledoc">
                        Ngày ban hành
                    </td>
                    <td>
                        @Convert.ToDateTime(Model.PublishDate).ToString(@" dd'/'MM'/'yyyy")
                    </td>
                    <td class="titledoc">
                        Ngày hết hiệu lực
                    </td>
                    <td align="center">
                        @if (!Model.ExpiryDate.HasValue)
                        {

                            <text>&nbsp;</text>
                        }
                        else
                        {
                            if (Model.ExpiryDate.Value.Year < 9000)
                            {
                                @Convert.ToDateTime(Model.ExpiryDate).ToString(@" dd'/'MM'/'yyyy")
                            }
                            else
                            {
                                <text>&nbsp;</text>
                            }

                        }


                    </td>
                </tr>
                <tr class="bgcolor1">
                    <td height="50" class="titledoc">
                        Cơ quan ban hành
                    </td>
                    <td align="center">
                        @Model.SignedByDesc

                    </td>
                    <td class="titledoc">
                        Người ký
                    </td>
                    <td align="center">
                        @Model.SignedBy
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    </div>
