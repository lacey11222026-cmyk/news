@using BIZ
@using UTILS
@using WebMVC4.Helper
@{
    var lstcategory = new CategoryBO().GetAllCategoryFullsByPosition(UTILS.Constants.CategoryPosition.MainMenu, 18, false);
    var Date = Utils.formatDateofWeek(DateTime.Now.DayOfWeek) + " " + DateTime.Now.ToString("dd") + "/" + DateTime.Now.ToString("MM") + "/ " + DateTime.Now.Year.ToString();
}
<header>
    <div>
        <a href="/"><img src="~/Content/images/logo-vecea.png" alt="vecea"></a>
        <h1><img src="~/Content/images/logo-vecea_text.png" alt="HỘI KHOA HỌC VÀ CÔNG NGHỆ SỬ DỤNG NĂNG LƯỢNG TIẾT KIỆM VÀ HIỆU QUẢ VIỆT NAM"></h1>
    </div>
    <span class="clearfix"></span>
</header>
<section class="nav-pc">
    <nav>
        <ul class="nav-pc-content">
            <li><a href="/"><img src="~/Content/images/icon_home.png" alt="Trang chủ"></a></li>

            @foreach (var item in lstcategory.Select((value, i) => new { i, value }))
            {
                <li>
                    <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name</a>| @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                </li>
            }
            <li><a href="/hoi-vien.html">Hội viên</a>| </li>
            <li><a href="/tin-tuc/c16/mau-don-gia-nhap-hoi.html">Mẫu đơn gia nhập Hội</a></li>
        </ul>
        <div class="clearfix"></div>
    </nav>
</section>

<!-- nav mobile-->
<div id="page">
    <div class="header-m" style="float:left;">
        <a href="#menu"> <img src="~/Content/images/nav-m.png"></a>
    </div>
    <nav id="menu">
        <ul>
            <li><a href="/">Trang chủ</a></li>
            @foreach (var item in lstcategory.Select((value, i) => new { i, value }))
            {
                <li>
                    <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name</a>
                </li>
            }
            <li><a href="/hoi-vien.html">Hội viên</a></li>
            <li><a href="/tin-tuc/c16/mau-don-gia-nhap-hoi.html">Mẫu đơn gia nhập Hội</a></li>
        </ul>
    </nav>
</div><!-- end page mobile-->
<div class="clear"></div>


<section class="tool-top">
    <p class="date">@(Date)</p>
    <ul class="pull-right">
        <li class="search_m">
            <a class="click" href="javascript:;"></a>
            <input class="submit_m" type="submit" onclick="Msearch();">
            <input class="text_m" type="text" id="MtxtKeyword" onkeydown="javascript: return MAnyInput_KeyDown(this, event);">
        </li>
        <li><input type="text" class="box-search" placeholder="Tìm kiếm" id="txtKeyword" onkeydown="javascript: return AnyInput_KeyDown(this, event);"></li>

    </ul>
    <div class="clearfix"></div>
</section>
<script>
    function Msearch() {
        var searchtext = $("#MtxtKeyword").val();

        window.location = "/News/Search?q=" + searchtext;

    }
    function MAnyInput_KeyDown(sender, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            Msearch();

            return false;
        }

        return true;
    }
    function search() {
        var searchtext = $("#txtKeyword").val();

        window.location = "/News/Search?q=" + searchtext;

    }
    function AnyInput_KeyDown(sender, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            search();

            return false;
        }

        return true;
    }
</script>