@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using DATA
@using WebMVC4.Helper
@model CATEGORY_FULL
@{
    List<CATEGORY_FULL> ListCate = ViewBag.CategoryList;
}
<div class="well">
    <span class="label label-danger">
        Chú ý!
    </span>
    <span>
        Hãy chắc chắn nhập vào đầy đủ thông tin tại các mục bắt buộc đánh dấu (*)
    </span>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                @if (Model.Id > 0)
                {
                    <i class="fa fa-fw fa-user-md"></i><span>Cập Nhật Chuyên mục </span>
                }
                else
                {
                    <i class="fa fa-fw fa-user-plus"></i><span>Thêm mới Chuyên mục</span>
                }
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel panel-info">
                        <div id="Errordiv" style="margin:20px;color:red;font-size:13pt"><center></center></div><br />

                        <div style="padding: 10px 0 0 0;background-color:#fff !important">
                            <ul class="nav nav-tabs">
                                <li class="active"><a href="#tabs-info" data-toggle="tab"><strong>Thông tin chính</strong></a></li>
                                <li><a href="#tabs-config" data-toggle="tab"><strong>Cấu hình</strong></a></li>


                            </ul>
                            <div class="tab-content" style="margin-top: 30px;">
                                <div class="col-md-12 tab-pane active" id="tabs-info">
                                    <!-- dành cho UpdateFunction -->
                                    <div class="form-group">
                                        <label for="txtTitle" class="control-label col-md-3">Tên chuyên mục :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtTitle" name="title" value="@Model.Name" class="form-control" placeholder="Nhập tiêu đề cho bài viết" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtSummary" class="control-label col-md-3">Mô tả :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtSummary" style="height: 100px;" cols="20" name="description" class="form-control">@Model.Description</textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="ddlType" class="control-label col-md-3">Loại :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlType">
                                                    <option value="2" @(Model.Type == 2 ? "selected='selected'" : "")>Tin tức</option>
                                                    <option value="1" @(Model.Type == 1 ? "selected='selected'" : "")>Giới thiệu</option>
                                                    <option value="5" @(Model.Type == 5 ? "selected='selected'" : "")>Văn bản</option>
                                                    <option value="4" @(Model.Type == 4 ? "selected='selected'" : "")>Album Ảnh</option>
                                                   

                                                </select>

                                            </div>
                                        </div>
                                    </div>

                                   
                                    <div class="form-group">
                                        <label for="txtMainCate" class="control-label col-md-3">Chuyên Mục Cha :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlMainCate">
                                                    <option value="0">- Nhóm gốc -</option>
                                                    @if (ListCate != null && ListCate.Count > 0)
                                                    {
                                                        foreach (var obj in ListCate)
                                                        {
                                                            <option value="@obj.Id" title="@obj.Pathway" @if (obj.Id == Model.ParentId) { @Html.Raw("selected='selected'")          ; }>@obj.Name</option>
                                                        }
                                                    }
                                                </select>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none;">
                                        <label for="ddlLanguage" class="control-label col-md-3">Ngôn ngữ :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlLanguage">

                                                    <option value="vi-vn" @(Model.Language == "vi-vn" ? "selected='selected'" : "")>Tiếng Việt</option>

                                                    <option value="en-us" @(Model.Language == "en-us" ? "selected='selected'" : "")>Tiếng Anh</option>
                                                </select>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtUrl" class="control-label col-md-3">Liên kết :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtUrl" name="url" value="@Model.Url" class="form-control" placeholder="Nhập liên kết" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtOrder" class="control-label col-md-3">Thứ tự :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="number" min="0" step="1" id="txtOrder" name="order" value="@Model.Ordering" class="form-control" placeholder="Nhập tiêu đề cho bài viết" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label col-md-3" for="cbxIsActive">Trạng thái :</label>
                                        <div class="col-md-4">
                                            <div class="checkbox">
                                                @if (Model.Published == 1)
                                                {<input type="checkbox" id="cbxIsActive" checked="checked" />}
                                                else
                                                {<input type="checkbox" id="cbxIsActive" /> }

                                            </div>
                                        </div>
                                    </div>


                                </div>
                                <div class="col-md-12 tab-pane" id="tabs-config">
                                    <div class="col-md-12 form-group">
                                        <div class="col-md-4 data" style="padding-left:0px;display: none;">
                                            <input id="chkIsHomepage" type="checkbox" @(Model.Param.IsHomepage == 1 ? "checked='checked'" : "") />
                                            Hiển thị trên <b>Trang chủ</b>
                                        </div>
                                        <div class="col-md-4 data" style="padding-left:0px;display: none;">
                                            <input id="chkIsRightCol" type="checkbox" @(Model.Param.IsRightCol == 1 ? "checked='checked'" : "") />
                                            Hiển thị trên <b>Cột phải</b>
                                        </div>
                                        <div class="col-md-4 data" style="padding-left:0px;">
                                            <input id="chkIsMainMenu" type="checkbox"  @(Model.Param.IsMainMenu == 1 ? "checked='checked'" : "")/>
                                            Hiển thị trên <b>Menu chính</b>
                                        </div>
                                        <div class="col-md-4 data" style="padding-left:0px;display: none;">
                                            <input id="chkIsTopMenu" type="checkbox"  @(Model.Param.IsTopMenu == 1 ? "checked='checked'" : "")/>
                                            Hiển thị trên <b>Menu trên cùng</b>
                                        </div>
                                        <div class="col-md-4 data" style="padding-left:0px;">
                                            <input id="chkIsFooter" type="checkbox" @(Model.Param.IsFooter == 1 ? "checked='checked'" : "") />
                                            Hiển thị trên <b>Footer</b>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="panel-footer form-horizontal">
                                        <div class="form-group submit">


                                            <button type="submit" class="btn btn-primary" id="btsubmit"><i class="fa fa-save"></i>Lưu lại</button>
                                            <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage();"><i class="fa fa-backward"></i>Quay lại</button>
                                        </div>
                                    </div>
                                </div>
                                <div style="clear:both"></div>
                            </div>
                            <div style="clear:both"></div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .input-icon {
        position: relative;
        width: 100%;
    }
</style>
<script>
    $('#menu_addcate').addClass("active");

</script>
<script>
    function GotoListpage() {
        window.location = '@Url.Action("Index")';
    }
    $(document).ready(function () {



        $("button.close").click(function () {
            $(this).parent().css("display", "none");
        });
        $('#defaultForm').bootstrapValidator({
            message: 'This value is not valid',
            //live: 'submitted',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {

                title: {
                    message: 'Nhập tên chuyên mục',
                    validators: {
                        notEmpty: {
                            message: 'tên chuyên mục không được bỏ trống'
                        },

                        stringLength: {
                            min: 5,
                            max: 250,
                            message: 'tên chuyên mục nhỏ nhất 5 ký tự và nhiều nhất 250 ký tự'
                        },

                    }
                },
                description: {
                    message: 'Bạn chưa nhập mô tả.',
                    validators: {
                        notEmpty: {
                            message: 'Bạn chưa nhập mô tả'
                        },

                    }
                },
                order: {
                    validators: {
                        notEmpty: {
                            message: 'Thứ tự không được bỏ trống'
                        }
                    }
                },


            }
        })
        .on('success.form.bv', function (e) {
            // Prevent submit form
            e.preventDefault();

            var $form = $(e.target),
                validator = $form.data('bootstrapValidator');
            SaveData();
            $(".close").click(function () {
                $(".alert-success").css("display", "none");
            });
        })
        .on('error.form.bv', function (e) {
            // Active the panel element containing the first invalid element
            e.preventDefault();
            var $form = $(e.target),
            validator = $form.data('bootstrapValidator');
            $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
            $(".alert-danger").css("display", "block");
            $(".close").click(function () {
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
        });

        $("#btnReset").click(function () {
            $('#defaultForm').data('bootstrapValidator').resetForm(true);
            $(".alert-danger").css("display", "none");
            $(".alert-success").css("display", "none");
        });

        //Save Data
        function SaveData() {
            var param = {
                'Id': '@Model.Id',
                'Name': $("#txtTitle").val(),
                'Description': $("#txtSummary").val(),
                'ParentId': $("#ddlMainCate").val(),
                'Link': $("#txtUrl").val(),
                'Type': $("#ddlType").val(),
                'Language': $("#ddlLanguage").val(),
                'Ordering': $("#txtOrder").val(),
                'Param.IsMainMenu': $("#chkIsMainMenu").is(":checked") ? 1 : 0,
                'Param.IsFooter': $("#chkIsFooter").is(":checked") ? 1 : 0,
                'Published': $("#cbxIsActive").is(":checked") ? 1 : 0

            }
            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "@Url.Action("SaveData")",
                data: addAntiForgeryToken(param),
                async: true,
                success: function (data) {
                    Utils.UnLoading();
                    if (data.ResponseCode >= 0) {
                        $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                        $(".alert-success").show("slow");
                        $(".alert-danger").hide("slow");
                        setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 500);

                    }
                    else {
                        $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                        $("#ErrorMessage").text(data.Description);
                        $(".alert-danger").show("slow");
                        $(".alert-success").hide("slow");
                        setTimeout(function () { $(".alert-danger").hide("slow"); }, 2000);
                    }
                }
            });
        };
    });
</script>
