@using BIZ
@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel

@if (Model != null)
{
    <div class="main-content box-09">
        <a href="javascript:;" class="news-list-title">Tìm kiếm</a>
        <form class="form-inline mt20">
            <div class="form-group">
                <label>Từ khóa :</label>
                <input type="email" id="txtkeyword" value="@ViewBag.keyword" class="form-control">
            </div>
            <div class="form-group">
                <label>Chuyên mục :</label>
                @Html.DropDownList("drlCategory", new SelectList(ViewBag.CategoryList as System.Collections.IEnumerable, "Id", "Name", ViewBag.CategoryId), new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label>Từ ngày :</label>
                <div style="display:inline-block" id="datetimeFromDate">
                    <input type="text" data-date-format="DD/MM/YYYY" name="datetimeFromDate" class="form-control" id="txtfromdate" value="@ViewBag.fromdate">
                </div>
            </div>
            <div class="form-group">
                <label>Đến ngày :</label>
                <div style="display:inline-block" id="datetimeToDate">
                    <input type="text" data-date-format="DD/MM/YYYY" name="datetimeToDate" class="form-control" id="txttodate" value="@ViewBag.todate">
                </div>
            </div>
            <button onclick="searchnews();" class="btn btn-primary">Tìm kiếm</button>
        </form>
        <div class="news-list">
            <ul>
                @if (Model.listdata != null)
                {
                    foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")"><img src="@item.value.MainImage?w=360&h=210&mode=crop" alt="@item.value.Title"></a>
                            <div class="news-item">
                                <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">@item.value.Title</a>
                                <p class="news-date"><span class="glyphicon glyphicon-calendar"></span>@item.value.PublishDate.ToString("HH:mm | dd/MM/yyyy")</p>
                                <p>@item.value.IntroText</p>
                            </div>
                            <div class="clearfix"></div>
                        </li>
                    }
                }
            </ul>
        </div>
        <div class="text-center">

            <ul class="pagination text-center">
                @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                    {
                        PageUrl = Url.SetParameter("Page", "!0"),
                        CurrentPage = Model.pageIndex,
                        PageSize = Model.pageSize,
                        TotalItemCount = Model.total,
                    }); }
            </ul>




        </div>
    </div>
        

        
        <script type="text/javascript">
            $(document).ready(function () {
                $('#datetimeFromDate').datetimepicker();
                $('#datetimeToDate').datetimepicker();
            });

            function searchnews() {
                var keyword = $("#txtkeyword").val();
                var fromdate = $("#txtfromdate").val();
                var todate = $("#txttodate").val();
                var categoryid = $('#drlCategory option:selected').val();
                window.location = '/News/Search/?q=' + keyword + '&fromdate=' + fromdate + '&todate=' + todate + '&categoryid=' + categoryid;
                //window.location = jQuery.query.set("q", keyword).set("fromdate", fromdate).set("todate", todate).set("categoryid", cateid).set("Page", "1");
            }
        </script>
        <style>
            .ui-datepicker table {
                font-size: 11px !important;
            }
        </style>
                            }
