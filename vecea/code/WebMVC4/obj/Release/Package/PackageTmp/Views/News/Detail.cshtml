@using BIZ
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.CONTENT_FULL

@if (Model != null)
{
    <div class="main-content box-09">
        <div class="row">
            <div class="read-more col-md-3 col-sm-4 hidden-xs">
                @Html.Action("LastestNews", "News", new { CategoryId = 4, CateName = "HOẠT ĐỘNG HỘI", MaxLastestNews = 7 })
            </div>
            <div class="col-md-9 col-sm-8 col-xs-12">
                <div class="title-news-detail"><a href="/">Trang chủ</a> >> @Model.CategoryName</div>


                <div class="mt20">
                    <h3>@Model.Title</h3>
                    <p class="news-date pull-left"><span class="glyphicon glyphicon-calendar"></span>Cập nhật lúc : @Model.PublishDate.ToString("HH:mm | dd/MM/yyyy")</p>
                    <div class="pull-right">
                        @{ Html.RenderAction("Share", "News", new { data = Model }); }

                    </div>
                    <div class="clearfix"></div>
                    @if (ViewBag.lstRef != null)
                    {
                        <div class="dvtinlienquan">
                            @foreach (var item in ViewBag.lstRef)
                            {
                                <br />
                                <a href="@Utils.FormatUrlRewrite(item.Id, item.Title, "ArticleDetail")">@item.Title </a>

                            }
                        </div>

                        <div style="height:10px;">&nbsp;</div>

                    }
                    @if (Model.Type == 1)
                    {
                        <div class="nd" id="NewsContent">
                            @Html.Raw(Model.Contents)
                        </div>
                    }
                    else
                    {
                        <div class="w100 mt20" id="VideoContent">
                            <iframe id="ifvideo" width="376" height="250" frameborder="0" allowfullscreen
                                    src="@(Model.Url.Replace("watch?v=", "embed/"))?autoplay=1"></iframe>
                        </div>
                        <script type="text/javascript">
        var width = $("#VideoContent").width();
        var height = width / 1.502040816326531;

        $("#ifvideo").width(width);
        $("#ifvideo").height(height);
                        </script>
                    }

                    @if (!string.IsNullOrEmpty(Model.FileParam.Name1))
                    {
                        <div class="document-attach">
                            <div class="bg_org"><span class="icon-attach"></span> Tài liệu đính kèm <div class="clear"></div></div>
                            <ul class="list">

                                <li><a title="@Model.FileParam.Name1" href="@Model.FileParam.Path1" target="_blank">@Model.FileParam.Name1 </a></li>
                                @if (!string.IsNullOrEmpty(Model.FileParam.Name2))
                                {
                                    <li><a title="@Model.FileParam.Name2" href="@Model.FileParam.Path2" target="_blank">@Model.FileParam.Name2 </a></li>
                                }
                                @if (!string.IsNullOrEmpty(Model.FileParam.Name3))
                                {
                                    <li><a title="@Model.FileParam.Name3" href="@Model.FileParam.Path3" target="_blank">@Model.FileParam.Name3 </a></li>
                                }




                            </ul>
                            <div class="clear"></div>
                        </div>
                    }
                </div>
                @{ Html.RenderAction("Comment", "News", new { ItemId = Model.Id, ItemName = Model.Title, Type = (int)UTILS.Constants.CategoryType.News }); }

            </div>
        </div>
    </div><!-- end main content-->



}
