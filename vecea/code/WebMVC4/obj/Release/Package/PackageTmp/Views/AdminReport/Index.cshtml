@{
   
    Layout = "~/Views/Shared/_AdminV2.cshtml";
    
}

    <div id="toolbar-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m">
            <div class="header icon-48-article">
                Thống kê tin bài
            </div>
            <div class="clr">
            </div>
        </div>
        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
    <div class="clr">
    </div>
    <div id="element-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m">
            <div id="jalert_notification">
                &nbsp;</div>
            <table width="100%">
                <tr>
                    <td>
                        Năm :
                        &nbsp;&nbsp;&nbsp;
                                       @Html.DropDownList("Year", new SelectList(new[] { new { Year = 2011, Name = "2011" },new { Year = 2011, Name = "2011" },new { Year = 2012, Name = "2012" },new { Year = 2013, Name = "2013" },new { Year = 2014, Name = "2014" },new { Year = 2015, Name = "2015" },new { Year = 2016, Name = "2016" } }, "Year", "Name", ViewBag.Year), new { @class = "drl_Year" })
                    </td>
                </tr>
            </table>
            <div class="clr">
            </div>
            <div id="charts" style="text-align: center; padding: 0; margin: auto;">
                <div id="container" style="padding: 10px 10px 0;">
                </div>
            </div>
            <div class="clr">
            </div>
            <div id="table"style="text-align: center; padding: 0; margin: auto;">
            <div style="padding: 10px 10px 0; width:90%;margin: auto;">
                <div style="padding-top: 38px; padding-left: 26px; font-weight: 100; color: #3E576F;
                    font-family: 'Lucida Grande','Lucida Sans Unicode',Verdana,Arial,Helvetica,sans-serif;
                    font-size: 16px;">
                    Bảng số liệu đầy đủ của biểu đồ
                </div>
                <table class="tablestatistic" cellpadding="0" cellspacing="0" style="float: left;
                    width: 10%; margin-right: 0px;">
                    @Html.Raw(ViewBag.datatb1)
                </table>
                <table class="tablestatistic" cellpadding="0" cellspacing="0" style="width: 70%;
                    margin-left: 0px">
                   @Html.Raw(ViewBag.datatb2)
                </table>
                <div class="clr">
                </div>
                </div>
            </div>
        </div>
        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
   @Html.Raw(ViewBag.datagrib)
    <script type="text/javascript">
        $(function () {
            var chart;
            $(document).ready(function () {
                chart = new Highcharts.Chart({
                    chart: {
                        renderTo: 'container',
                        type: 'column'
                    },
                    title: {
                        text: 'Biểu đồ thống kê số lượng tin bài theo chuyên mục'
                    },
                    subtitle: {
                        text: ''
                    },
                    xAxis: {
                        categories: categorydata
                    },
                    yAxis: {
                        min: 0,

                        title: {
                            text: 'Tin bài (số lượng)'
                        },
                        lotLines: [{
                            value: 0,
                            width: 0.1,
                            color: '#808080'
                        }],
                        labels: {
                            formatter: function () {
                                return Highcharts.numberFormat(this.value, 0);
                            }
                        }
                    },
                    legend: {
                        layout: 'vertical',
                        backgroundColor: '#FFFFFF',
                        align: 'left',
                        verticalAlign: 'top',
                        x: 100,
                        y: 70,
                        floating: true,
                        shadow: true
                    },
                    tooltip: {
                        formatter: function () {
                            return '' +
                        this.series.name + ': ' + this.y + ' tin bài';
                        }
                    },
                    plotOptions: {
                        column: {
                            pointPadding: 0.2,
                            borderWidth: 0
                        }
                    },
                    series: dataline
                });
            });

        });
		
		  $(document).ready(function () {
        $('.drl_Year').change(function () {
            window.location = jQuery.query.set("Year", this.value);
        });
    });
   
       
    </script>

