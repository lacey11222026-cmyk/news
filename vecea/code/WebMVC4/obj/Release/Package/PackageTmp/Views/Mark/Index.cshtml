@{

    Layout = "~/Views/Shared/_AdminV2.cshtml";
    double totalMark = 0;
}
@using System.Globalization
@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel

@{
    ViewBag.Title = "Chấm nhuận bút";
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">
                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        @Html.DropDownList("drlCategory", new SelectList(ViewBag.CategoryList as System.Collections.IEnumerable, "ID", "Name", -1), new { @class = "form-control", })
                    </div>

                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <input type="text" id="txtKeyword" class="form-control" placeholder="Nhập từ khóa">
                    </div>



                    <div class="form-group submit col-md-3 col-xs-12 col-sm-6">
                        <button type="button" id="btnSearch" onclick="fillter();" class="btn btn-info"><i class="fa fa-search"></i>Tìm Kiếm</button>
                        <a class="btn btn-info" href="@Url.Action("ToExcel", "Mark", new { title = ViewBag.title, categoryId = ViewBag.categoryId, createdby = ViewBag.createdby, fromdate = ViewBag.fromdate, todate = ViewBag.todate })"><i class="fa fa-search"></i>Xuất ra Excel</a>
                    </div>

                    <div class="form-group col-md-3 col-xs-12 col-sm-6" id="datetimepicker_FromDate">
                        <label class="control-label text-info"><i class="fa fa-calendar"></i>Từ Ngày</label>
                        <div class="col-xs-4 col-md-8 col-sm-8 col-xs-12">
                            <div class="date" id="datetimeFromDate">
                                <input type="text" data-date-format="DD/MM/YYYY" id="fromDate" class="form-control" name="datetimeFromDate" />

                            </div>
                        </div>
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6" id="datetimepicker_ToDate">
                        <label class="control-label text-info"><i class="fa fa-calendar"></i>Đến Ngày</label>
                        <div class="col-xs-4 col-md-8 col-sm-8 col-xs-12">
                            <div class="date" id="datetimeToDate">
                                <input type="text" data-date-format="DD/MM/YYYY" id="toDate" class="form-control" name="datetimeToDate" />

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    @if (Model.listdata.Count > 0)
                    {
                        <div id="ListNotify">
                            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                                <thead>
                                    <tr class="rowsao">
                                        <th width="1%" class="title">
                                            #
                                        </th>

                                        <th width="25%" class="title">
                                            Tên bài viết
                                        </th>
                                        <th width="10%" class="title">
                                            Người viết
                                        </th>
                                        <th width="10%" class="title" nowrap="nowrap">
                                            Ngày xuất bản
                                        </th>

                                        <th width="10%" class="title">
                                            Chuyên mục
                                        </th>
                                        <th width="5%" class="title">
                                            Lượt xem
                                        </th>
                                        <th width="5%" class="title">
                                            Tiền nhuận bút(VND)
                                        </th>
                                        <th width="5%" class="title">
                                            Chấm nhuận bút
                                        </th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.listdata)
                                    {
                                        totalMark += item.Mark.Value;
                                        <tr>

                                            <td width="1%">@item.Id</td>
                                            <td width="25%">
                                                <a target="_blank" href='@Utils.FormatUrlRewrite(item.Id, item.Title, "ArticleDetail")'>
                                                    @item.Title
                                                </a>

                                            </td>
                                            <td width="10%" align="left">
                                                @item.Alias
                                            </td>

                                            <td width="10%" align="left">
                                                @item.PublishDate.ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td width="10%" align="left">
                                                @item.CategoryName
                                            </td>
                                            <td width="5%" align="center">
                                                @item.Hits
                                            </td>
                                            <td width="5%" align="center">
                                                @Utils.FormatMoney(item.Mark)
                                            </td>

                                            <td width="5%" class="alt">
                                                <a onclick="openWin('@Url.Action("AddMark", "Mark", new { id = item.Id })');" href='javascript:void(0);'>Chấm nhuận bút</a>
                                            </td>
                                        </tr>
                                    }
                                    <tr class="rowsao">

                                        <td width="1%"></td>
                                        <td width="25%"><b>Tổng số:</b> </td>
                                        <td width="10%" align="left"></td>

                                        <td width="10%" align="left"></td>
                                        <td width="10%" align="left"></td>
                                        <td width="5%" align="center">

                                        <td width="5%" align="center">
                                            <b>@Utils.FormatMoney(totalMark)</b>
                                        </td>
                                       
                                        <td width="5%" class="alt"></td>
                                    </tr>


                                </tbody>
                            </table>
                        </div>

                        <div class="dataTables_paginate" id="pager">
                            <ul class="paging">
                                @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                                    {
                                        PageUrl = Url.SetParameter("Page", "!0"),
                                        CurrentPage = Model.pageIndex,
                                        PageSize = Model.pageSize,
                                        TotalItemCount = Model.total,
                                    }); }
                            </ul>
                        </div>
                                    }
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#menu_managemark').addClass("active");

</script>



<script type="text/javascript">

    $(document).ready(function () {

        $('#datetimeFromDate').datetimepicker();
        $('#datetimeToDate').datetimepicker();

        var fromdate = '@string.Format("{0:dd/MM/yyyy HH:mm}", ViewBag.fromdate)';
        var todate = '@string.Format("{0:dd/MM/yyyy HH:mm}", ViewBag.todate)';
        $('#datetimeFromDate').data("DateTimePicker").setDate(fromdate);
        $('#datetimeToDate').data("DateTimePicker").setDate(todate);

        $("#datetimeFromDate").on("dp.change dp.show", function (e) {
            $('#datetimeToDate').data("DateTimePicker").setMinDate(e.date);
        });
        $("#datetimeToDate").on("dp.change dp.show", function (e) {
            $('#datetimeFromDate').data("DateTimePicker").setMaxDate(e.date);
        });
        $("#txtaccount").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/Mark/AutoCompleteUser/?Searchtext=" + request.term,
                    dataType: "json",
                    success: function (data) {
                        response(data);

                    }
                });
            },
            select: function (event, ui) {
                $(this).val(ui.item.value);
                fillter();
            },
            minLength: 1
        });
    });
    function openWin(pageurl) {
        $.ajax({
            type: 'GET',
            url: pageurl,
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "html",
            success: function (data) {
                bootbox.dialog({
                    message: data,
                    buttons: {
                        success: {
                            label: "Lưu Lại",
                            className: "btn-success",
                            callback: function () {
                                window.location.reload();
                            }
                        }
                    }
                });
            }
        });
    }
    function fillter() {
        var title = $("#txtKeyword").val();
        var fromdate = $("#txtFromdate").val();
        var todate = $("#txtTodate").val();
        var categoryId = $('#drlCategory option:selected').val();
        var createdby = $("#txtaccount").val();
        window.location = jQuery.query.set("categoryId", categoryId).set("createdby", createdby).set("title", title).set("fromdate", fromdate).set("todate", todate).set("page", "1");
    }
</script>


