@using BIZ
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="info-other mt30">
            <a href="#" class="info-other-title">Các bài khác</a>
            <ul class="read-more">
                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    <li><a title="@item.value.Name" href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Name, "Intro")">@item.value.Name </a></li>
                }
            </ul>
        </div>
   

    }


}