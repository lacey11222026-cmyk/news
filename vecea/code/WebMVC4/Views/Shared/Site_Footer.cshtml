@using BIZ
@using UTILS
@{
    var lstcategory = new CategoryBO().GetAllCategoryFullsByPosition(UTILS.Constants.CategoryPosition.MainMenu, 18, false);

}
<footer class="mt10">
    <div class="nav-pc">
        <nav>
            <ul>
                <li><a href="/"><img src="~/Content/images/icon_home.png" alt="trang chủ"></a></li>
                @foreach (var item in lstcategory.Select((value, i) => new { i, value }))
            {
                    <li>
                        <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name</a>|
                    </li>
                }
                <li><a href="/hoi-vien.html">Hội viên</a></li>
            </ul>
            <div class="clearfix"></div>
        </nav>
    </div>
    <div class="clearfix"></div>
    <div class="row mt15">
        <div class="box-09 footer-content">
            <h4 class="textblue">2017@Bản quyền thuộc Hội Khoa học công nghệ sử dụng năng lượng tiết kiệm và hiệu quả Việt Nam.</h4>
            <p class="textblue">
                Địa chỉ: Tầng 2, Tòa nhà Bộ Công Thương, 655 Phạm Văn Đồng, Từ Liêm, Hà Nội <br>
                Điện thoại: 024-37286113/ Fax: 024-37286112<br>
                Website: http://vecea.vn/
            </p>
        </div>
        <div class="box-03 footer-link">
            <ul>
                <li><a href="#"><img src="~/Content/images/icon_footer.jpg"></a></li>
                <li><a href="#"><img src="~/Content/images/icon_footer02.jpg"></a></li>
                <li><a href="#"><img src="~/Content/images/icon_footer03.jpg"></a></li>
            </ul>
            <div class="clearfix"></div>
            <p class="mt20 text-center">Phát triển bởi <a href="http://vtkmedia.vn/"><img src="~/Content/images/VTK.png?vs=02" alt="VtkMedia"></a></p>
        </div>
    </div>
</footer>