@model List<DATA.Banner>
@if (Model != null)
{

    <!-- slide-->
    <a href="javascript:;" class="title-cm mt20">Đối tác</a>
    <div class="slide-chantrang mt10 container">
        <div>
            <ul id="flexiselDemo3">

                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    <li>
                        <a class="opa" href="@item.value.Url" rel="nofollow">
                        <img src="@item.value.Data?w=185&h=122&mode=crop" alt="@item.value.Name" />
                        </a>
                    </li>

                }
            </ul>
        </div>
    </div>
    <div class="clear"></div>
    <script>
        $(window).load(function () {
            $("#flexiselDemo3").flexisel({
                visibleItems: 7,
                animationSpeed: 1000,
                autoPlay: true,
                autoPlaySpeed: 3000,
                pauseOnHover: true,
                enableResponsiveBreakpoints: true,
                responsiveBreakpoints: {
                    portrait: {
                        changePoint: 480,
                        visibleItems: 2
                    },
                    landscape: {
                        changePoint: 640,
                        visibleItems: 4
                    },
                    tablet: {
                        changePoint: 769,
                        visibleItems: 5
                    }
                }
            });
        });

    </script>

}
