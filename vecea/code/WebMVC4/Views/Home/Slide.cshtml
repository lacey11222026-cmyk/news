@using BIZ
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>

@if (Model != null)
{
    <div class="bignews">
        <div id="big-new" class="carousel slide" data-ride="carousel">
            <!-- Indicators -->
            <ol class="carousel-indicators">
                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    if (item.i == 0)
                    {
                        <li data-target="#big-new" data-slide-to="@(item.i)" class="active"></li>
                    }
                    else
                    {
                        <li data-target="#big-new" data-slide-to="@(item.i)" ></li>
                    }
                }
                
            </ol>
            <div class="carousel-inner" role="listbox">
                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    if (item.i == 0)
                    {
                        <div class="item active">
                            <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")"><img src="@item.value.MainImage?w=760&h=420&mode=crop"></a>
                            <div class="carousel-caption">
                                <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">@item.value.Title</a>
                                <p>@item.value.IntroText</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="item">
                            <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")"><img src="@item.value.MainImage?w=760&h=420&mode=crop"></a>
                            <div class="carousel-caption">
                                <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">@item.value.Title</a>
                                <p>@item.value.IntroText</p>
                            </div>
                        </div>
                    }
                }
               
               
                <div class="clearfix"></div>
            </div>
            <a class="left carousel-control" href="#big-new" role="button" data-slide="prev">
                <span aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="right carousel-control" href="#big-new" role="button" data-slide="next">
                <span aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
        </div>
    </div>
    <div class="clearfix"></div>

}