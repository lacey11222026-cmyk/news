@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel
@if (Model != null)
{
    <ul class="row video-main mt20">
        @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
        {
            <li class="col-md-3 col-sm-3 col-xs-4">
                <a href="/trang-chu-video.html?VideoId=@(item.value.Id)">
                    <img src="@item.value.MainImage?w=300&h=200&mode=crop">
                    @item.value.Title
                </a>
            </li>
        }

    </ul>
    <div class="clearfix"></div>

        <div class="text-center mt30">
            <ul class="pagination text-center">
                @{Html.RenderPartial("PaginationVideo", new WebMVC4.Models.PaginationInfo
                    {
                        PageUrl = Url.SetParameter("Page", "!0"),
                        CurrentPage = Model.pageIndex,
                        PageSize = Model.pageSize,
                        TotalItemCount = Model.total,
                    }); }
            </ul>
        </div>
        <script>

            function GoVideoPage(page) {
                var VideoId = '@Model.Id';
                if (page > 0) {
                    $.ajax({
                        type: "GET",
                        url: "/Video/LoadVideo/?VideoId=" + VideoId + "&page=" + page,
                        success: function (data) {
                            if (data != "null") {
                                $("#lstVideo").html(data);
                            }
                        }
                    });
                }

            }

        </script>
                    }