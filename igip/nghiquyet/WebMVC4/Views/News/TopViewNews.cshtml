@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="sidebar-newsnew">
            <h2 class="title-cm01"><a href="/">@Resources.Global.TopViewNews</a></h2>
            @foreach (var item in Model.Take(1).Select((value, i) => new { i, value }))
            {
               
                <div class="newsbig mt20">
                    <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=367&h=205&mode=crop" alt=""></a>
                    <h2 class="mt10">
                        <a href="@item.value.LinkUrl" class="news-name mt15">@item.value.Title</a>
                    </h2>
                    <p class="mt10">@item.value.IntroText</p>
                    <span class="newsdate mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                </div>
            }
            <div class="sidebar-newsnew-list">
                <ul class="newslist-04 list-border mt10">
                    @foreach (var item in Model.Skip(1).Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="@item.value.LinkUrl" class="mb-0">@item.value.Title</a>
                            <p class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                        </li>
                    }


                </ul>
                <a href="/" class="btn-viewmore mt10">@Resources.Global.More<span>+</span></a>
            </div>
        </div>








    }
}