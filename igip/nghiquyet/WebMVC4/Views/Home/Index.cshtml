<script type="text/javascript">


    function searchdoc() {

        //var keyword = $("#trichyeu").val();
        //var fromdate = $("#fromdate").val();
        //var todate = $("#todate").val();
        //var type = $("#loaivanban").val();
        //var area = $("#linhvuc").val();
        var agent = $("#coquanbanhanh").val();

        var parameters = {
            keyword: $("#trichyeu").val(),
            fromdate: $("#fromdate").val(),
            todate: $("#toDate").val(),
            type: $('#loaivanban').val(),
            area: $('#linhvuc').val(),
            agent: $('#coquanbanhanh').val(),
        };
        var urlRequestAns = "@Url.Action("TopDocument")";
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: parameters,
            success: function (data) {
                $("#ListDocument").html(data);
                //Utils.UnLoading();
            },
            error: function () {
                //Utils.UnLoading();
            }
        });
        }
        //window.location = '/Home/TopDocument/?CategoryId=3&keyword=' + keyword + '&fromdate=' + fromdate + '&todate=' + todate + '&type=' + type + '&area=' + area + '&agent=' + agent;
        //window.location = jQuery.query.set("keyword", keyword).set("fromdate", fromdate).set("todate", todate).set("Page", "1");

</script>
<div id="multimedia" class="tab-wrap container pb50 pt50">
    <ul class="nav-tabs-green nav nav-tabs">
        <li><a href="#video" class="nav-link active" id="video-tab" data-toggle="tab" data-target="#video">Video</a></li>
        <li><a href="#inforgraphic" class="nav-link" id="inforgraphic-tab" data-toggle="tab" data-target="#inforgraphic">INFOGRAPHIC</a></li>
        <li><a href="#podcast" class="nav-link" id="podcast-tab" data-toggle="tab" data-target="#podcast">PODCAST</a></li>
        <li><a href="#e-magazine" class="nav-link" id="e-magazine-tab" data-toggle="tab" data-target="#e-magazine">E-MAGAZINE</a></li>
    </ul>

    <div class="tab-content mt30">
        <div class="tab-pane active" id="video">
            @{Html.RenderAction("HomeVideo", "Home", new { CategoryName = "Video", CategoryId = 4, MaxLastestNews = 5, IsMobile = ViewBag.IsMobile });}
        </div>
        <div class="multimedia-content tab-pane" id="inforgraphic">
            @{Html.RenderAction("LastestNews3", "Home", new { CateName = "", CategoryId = 5, MaxLastestNews = 4, cssClass = "maxheight02" });}

        </div>
        <div class="multimedia-content tab-pane" id="podcast">
            @{Html.RenderAction("Podcast", "Home", new { CategoryId = 6, MaxLastestNews = 4 });}

        </div>
        <div class="multimedia-content tab-pane" id="e-magazine">
            @{Html.RenderAction("Emagazine", "Home", new { CategoryId = 7, MaxLastestNews = 5 });}

        </div>
