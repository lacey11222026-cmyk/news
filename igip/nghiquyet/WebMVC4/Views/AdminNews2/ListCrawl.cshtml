@using BIZ.Entity
@using UTILS
@model List<CONTENT_FULL>
@using WebMVC4.Helper
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>ID</th>
            <th class="texttable">Tiêu Đề</th>
            @*<th >Người viết</th>*@
            
            <th>Ngày xuất bản</th>
            
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>
                <td>@obj.Id</td>
                <td class="texttable" style="text-align:left;">
                    <a href="@Url.Action("DetailCrawl",new {Id=obj.Id,Type=ViewBag.Type })" title="Edit">@obj.Title</a>


                </td>
              
                @*<td >@obj.CreatedBy</td>*@
               
                <td style="width:120px;">@obj.PublishDate.ToString("dd/MM/yyyy HH:mm")</td>
                

            </tr>
        }
    }
</table>
