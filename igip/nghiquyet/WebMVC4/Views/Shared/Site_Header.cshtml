            <div class="search-box-02">
                <button class="search-icon"  onclick="search();"></button>
                <input type="text" placeholder="Tìm kiếm" id="txtKeyword" onkeydown="javascript: return AnyInput_KeyDown(this, event);">
            </div>
        </div>
    </div>
</div>
<div class="header-mobile">
    <a href="#menu">
        <img src="/Content/images/menu.svg" width="30" class="ico-menu">
    </a>
    <div class="header-mobile-content">
        <div class="header-mb-top">
            <a href="#menu" class="ico-close">
                <img src="/Content/images/close.svg" width="18">
            </a>
            <a href="/" class="logo-top-mb"><img src="/Content/images/chuyentrang-logo.png" alt=""></a>
        </div>
        <div class="nav-mb mt20">
            <div class="search-box w100">
                <button class="search-icon" onclick="Msearch();"></button>
                <input type="text" class="form-control" id="txtKeywordMobile" onkeydown="javascript: return MAnyInput_KeyDown(this, event);">
            </div>
            <ul class="nav-mb-list mt20">
                @{Html.RenderAction("MenuMobile", "Home", new { lang = "vi-vn" });}
