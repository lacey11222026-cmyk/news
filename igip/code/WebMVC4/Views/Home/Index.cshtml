<script>
    const items = document.querySelectorAll('.list-hands li');
    let index = 0;

    function animateNext() {
        items.forEach(item => item.classList.remove('blinking'));
        items[index].classList.add('blinking');
        index = (index + 1) % items.length;
        setTimeout(animateNext, 1000);
    }
    animateNext();
</script>

<!-- chuong trinh - du an-->
<script>
    $(document).ready(function () {
        $(".choose-link > p").on("click", function (e) {
            e.preventDefault();

            const $parent = $(this).closest(".choose-link");

            // Đóng tất cả các list khác
            $(".choose-link").not($parent).removeClass("active").find(".choose-list").slideUp(200);

            // Toggle list hiện tại
            $parent.toggleClass("active");
            $parent.find(".choose-list").slideToggle(200);
        });
    });

</script>
<script>
    $('.bnrSmallSlider02').slick({
        autoplay: true,
        infinite: true,
        dots: false,
        arrows: true,
        speed: 300,
        slidesToShow: 4,
        slidesToScroll: 4,
        responsive: [
            {
                breakpoint: 991,
                settings: {
                    slidesToShow: 3,
                    slidesToScroll: 3
                }
            },
            {
                breakpoint: 575,
                settings: {
                    slidesToShow: 1,
                    slidesToScroll: 1
                }
            }
        ]
    });

</script>