@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="view-more container-small mt50">
            <h3 class="view-more-title">Xem thêm:</h3>
            <ul class="view-more-list mt30">
                @foreach (var item in Model.Take(3).Select((value, i) => new { i, value }))
                {
                    <li>
                        <a href="@item.value.LinkUrl">
                            <span class="news-name">@item.value.Title</span>
                            <img src="@item.value.MainImage?w=222&h=125&mode=crop" alt="">
                        </a>
                    </li>
                }
            </ul>
        </div>
       



    }


}