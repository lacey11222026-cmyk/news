@model List<BIZ.Entity.MANUFACTORY_FULL>
@if (Model != null && Model.Count > 0)
{
    <aside  class="widget widget_nav_menu">

        <div class="menu-danh-muc-san-pham-sidebar-container">
            <ul class="menu">
                <li class="menu-cha menu-item menu-item-type-taxonomy menu-item-object-product_cat current-menu-item "><a href="#" aria-current="page" data-wpmeteor-mouseover="true" data-wpmeteor-mouseout="true">Hãng sản xuất</a></li>

                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    <li class="menu-item menu-item-type-taxonomy menu-item-object-product_cat " id="manu_@(item.value.Id)"><a href="@(ViewBag.CateUrl)-@(item.value.Image)" data-wpmeteor-mouseover="true" data-wpmeteor-mouseout="true">@item.value.Title</a></li>

                }
            </ul>
        </div>
    </aside>
}
