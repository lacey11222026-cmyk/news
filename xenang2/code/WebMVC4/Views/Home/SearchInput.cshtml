    <tbody>
        <tr>
            <td width="61%">
           
               <input type="text" onkeydown="javascript: return AnyInput_KeyDown(this, event);" class="f2" id="txtKeyword" name="txtKeyword"> 
            </td>
            <td width="12%">
                
                    <img src="/images/search.jpg" alt="tìm kiếm" id="imgsearch" style="cursor:pointer;"/>
                   @* <div style="display:none;">

                        <input type="submit" class="btn-search-img" id="btnSearch" value="" name="btnSearch">
                    </div>*@
            </td>
            <td width="9%">
                <a href="">
                    <img src="/images/google.jpg" alt="mau giao lieu giai" /></a>
            </td>
            <td width="9%">
                <a href="">
                    <img src="/images/twister.jpg" alt="mau giao lieu giai" /></a>
