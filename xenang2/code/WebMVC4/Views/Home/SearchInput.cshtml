        </tr>
    </tbody>
</table>

<script type="text/javascript">
    function search() {
        var searchtext = $("#txtKeyword").val();
        window.location = "/Home/Search?q=" + searchtext;

    }
    function AnyInput_KeyDown(sender, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            search();

            return false;
        }

        return true;
    }
    $("#imgsearch").click(function () {
        search();
    });
    var defaultKeyword = "Tìm kiếm ...";
    if ($("#txtKeyword").val() == '') {
        $("#txtKeyword>").val(defaultKeyword);
    }

    $("#txtKeyword").focus(function () {
        if ($(this).val() == defaultKeyword) {
            $(this).val('');
        }
    });

    $("#txtKeyword").blur(function () {
        if ($(this).val() == '') {
            $(this).val(defaultKeyword);
        }
    });
</script>
<div class="clear">
</div>
