@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<CATEGORY_FULL>



@foreach (var item in Model.Where(x => x.ParentId == 0).Select((value, i) => new { i, value }))
{
    <li class="menu-item menu-item-type-taxonomy menu-item-object-product_cat menu-item-has-children has-dropdown" id="menu_@item.value.Id">
        <a href="@item.value.Url" class="nav-top-link">@item.value.Name <i class="icon-angle-down"> </i> </a>

        <ul class="sub-menu nav-dropdown nav-dropdown-bold dark">

            @foreach (var sub in Model.Where(x => x.ParentId == item.value.Id).Select((value, i) => new { i, value }))
            {
                @*if (sub.value.Id == 35 || sub.value.Id == 64 || sub.value.Id == 65)
                {
                    <li class="menu-item menu-item-type-taxonomy menu-item-object-product_cat has-dropdown">
                        <a href="@sub.value.Url">
                            @sub.value.Name


                        </a>
                        <ul class="sub-menu nav-dropdown nav-dropdown-bold dark" style="left: 100% !important; top: 0 !important;">
                            @foreach (var sub2 in Model.Where(x => x.ParentId == sub.value.Id).Select((value, i) => new { i, value }))
                            {
                                <li class="menu-item menu-item-type-taxonomy menu-item-object-product_cat">
                                    <a href="@sub2.value.Url">
                                        @sub2.value.Name


                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
                else
                {*@
                    <li class="menu-item menu-item-type-taxonomy menu-item-object-product_cat">
                        <a href="@sub.value.Url">
                            @sub.value.Name


                        </a>
                    </li>
                @*}*@
            }

        </ul>
    </li>

}