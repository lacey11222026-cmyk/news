@if (string.IsNullOrEmpty(ViewBag.SiteTitle))
{
    <title>@System.Net.WebUtility.HtmlDecode(Resources.Global.SiteTitle)</title>
    <meta property="og:title" content="@System.Net.WebUtility.HtmlDecode(Resources.Global.SiteTitle)" />
}
else
{
    <title>@System.Net.WebUtility.HtmlDecode(ViewBag.SiteTitle)</title>
    <meta property="og:title" content="@System.Net.WebUtility.HtmlDecode(ViewBag.SiteTitle)" />
}
@if (string.IsNullOrEmpty(ViewBag.SiteDescription))
{
    <meta property="og:description" content="@System.Net.WebUtility.HtmlDecode(Resources.Global.SiteDescription)" />
    <meta name="description" content="@System.Net.WebUtility.HtmlDecode(Resources.Global.SiteDescription)" />
}
else
{
    <meta name="description" content="@System.Net.WebUtility.HtmlDecode(ViewBag.SiteDescription)" />
    <meta property="og:description" content="@System.Net.WebUtility.HtmlDecode(ViewBag.SiteDescription)" />
}
@if (string.IsNullOrEmpty(ViewBag.SiteImage))
{
    <meta property="og:image" content="" />
    <link rel="image_src" href="" />
    <meta property="og:type" content="article" />
}
else
{
    <meta property="og:image" content="@ViewBag.SiteImage" />
    <link rel="image_src" href="@ViewBag.SiteImage" />
    <meta property="og:type" content="website" />
}

<meta name="revisit-after" content="1 Days" />
<meta property="article:publisher" content="https://www.facebook.com/xenanghangvavieclam/">
<meta property="article:author" content="https://www.facebook.com/xenanghangvavieclam/">
<meta property="og:url" content="@HttpContext.Current.Request.Url.AbsoluteUri.Replace("http:","https:")" />
<link rel="alternate" href="@HttpContext.Current.Request.Url.AbsoluteUri.Replace("http:","https:")" hreflang=" x-default " />
@if (string.IsNullOrEmpty(ViewBag.canonical))
{
    <link rel="canonical" href="@HttpContext.Current.Request.Url.AbsoluteUri.Replace("http:","https:")" />
}
else
{
    <link rel="canonical" href="@ViewBag.canonical" />
}
