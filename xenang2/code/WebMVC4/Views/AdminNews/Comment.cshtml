        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
    <div class="clr">
    </div>
    <div id="element-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m">
            <div id="jalert_notification">
                &nbsp;</div>
            <table width="100%">
                <tr>
                    <td>
                        Tên đối tượng:
                        <input id="txt_filterbyname" type="text" style="width: 250px;" />
                        <input id="btn_search" type="button" value="Lọc" onclick="Filter(1);" />
                        <input id="btn_clear" type="button" value="Làm lại" onclick="OnLoad(1);" />
                    </td>
                    <td nowrap="nowrap">
                        Loại :
                        <select id="select_filterbytype" onchange="Filter(1);">
                            <option value="-1">- Tất cả -</option>
                            <option value="0">Sản phẩm</option>
                            <option value="2">Tin tức</option>
                            <option value="4">Album Ảnh</option>
                        </select>
                        Trạng thái:<select id="select_filterbystatus" onchange="Filter(1);">
                            <option value="-1">- Tất cả -</option>
                            <option value="0">Chưa duyệt</option>
                            <option value="1">Đã duyệt</option>
                        </select>
                    </td>
                </tr>
            </table>
            <table class="adminlist" cellpadding="1">
                <thead>
                    <tr>
                        <th width="1%" class="title">
                            #
                        </th>
                        <th width="10%" class="title" style="text-align: left">
                            Loại
                        </th>
                        <th width="10%" class="title" style="text-align: left">
                            Tên đối tượng
                        </th>
                        <th width="10%" class="title" style="text-align: left">
                            Người viết
                        </th>
                        <th width="10%" class="title" style="text-align: left">
                            Ngày viết
                        </th>
                        <th width="35%" class="title">
                            Nội dung
                        </th>
                        <th width="5%" class="title">
                            Trạng thái
                        </th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <td colspan="7">
                            <del class="container">
                                <div class="limit">
                                     <select id="select_pagesize">
                                    </select>
                                </div>
                                  <div id="paging_container">
                                </div>
                            </del>
