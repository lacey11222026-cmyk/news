                </div>
            </div>
        </div>
        <div class="m">
            <div class="toolbar" id="toolbar">
                <table class="toolbar">
                    <tr>
                        
                        <td class="button" id="toolbar-delete">
                            <a class="toolbar" onclick="Delete();" href="javascript:void(0);"><span class="icon-32-delete"
                                title="Delete"></span>Xóa</a>
                        </td>
                         <td class="button" id="toolbar-edit">
                            <a class="toolbar" onclick="Published();" href="javascript:void(0);"><span class="icon-32-edit"
                                title="Publish"></span>Duyệt</a>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="header icon-48-article">
                Quản lý bình luận
            </div>
            <div class="clr">
            </div>
