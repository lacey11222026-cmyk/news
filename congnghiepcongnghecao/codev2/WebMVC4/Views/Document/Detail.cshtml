@using BIZ
@using DATA
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.DOCUMENT_FULL
@{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
    <div class="data-page container">
        <div id="document" class="main-content">
            <div class="list-page">
                <div class="document-table table-responsive mt20">
                    <table>
                        <tbody>
                            <tr class="bgcolor1">
                                <td width="25%" height="50">
                                    Tên văn bản
                                </td>
                                <td colspan="3">

                                    @Model.Name

                                </td>
                            </tr>
                            <tr class="bgcolor1">
                                <td width="25%" height="50">
                                    Xem online
                                </td>
                                <td colspan="3" class="titledoc2">

                                    <a href="@Url.Action("ViewFile","Document",new { id=Model.Id})" target="_blank">Xem online</a>
                                </td>

                            </tr>
                            <tr class="bgcolor1">
                                <td width="25%" height="50" class="titledoc">
                                    Tải file
                                </td>
                                <td colspan="3" class="titledoc2">
                                    <a href="@Url.Action("DownloadFile","Document",new { id=Model.Id})">Tải file </a>


                                </td>

                            </tr>
                            <tr class="bgcolor1">
                                <td height="50" class="titledoc">
                                    Mô tả
                                </td>
                                <td colspan="3">
                                    @Model.Description
                                </td>
                            </tr>
                            <tr class="bgcolor1">
                                <td height="50" class="titledoc">
                                    Số hiệu văn bản
                                </td>
                                <td width="28%">
                                    @Model.Code
                                </td>
                                <td width="21%" class="titledoc">
                                    Ngày có hiệu lực
                                </td>
                                <td width="26%" align="center">

                                    @if (!Model.EffectiveDate.HasValue)
                                    {

                                        <text>&nbsp;</text>
                                    }
                                    else
                                    {
                                        if (Model.EffectiveDate.Value.Year < 9000)
                                        {
                                            @Convert.ToDateTime(Model.EffectiveDate).ToString(@" dd'/'MM'/'yyyy")
                                        }
                                        else
                                        {
                                            <text>&nbsp;</text>
                                        }

                                    }

                                </td>
                            </tr>
                            <tr class="bgcolor1">
                                <td height="50" class="titledoc">
                                    Ngày ban hành
                                </td>
                                <td>
                                    @Convert.ToDateTime(Model.PublishDate).ToString(@" dd'/'MM'/'yyyy")
                                </td>
                                <td class="titledoc">
                                    Ngày hết hiệu lực
                                </td>
                                <td align="center">
                                    @if (!Model.ExpiryDate.HasValue)
                                    {

                                        <text>&nbsp;</text>
                                    }
                                    else
                                    {
                                        if (Model.ExpiryDate.Value.Year < 9000)
                                        {
                                            @Convert.ToDateTime(Model.ExpiryDate).ToString(@" dd'/'MM'/'yyyy")
                                        }
                                        else
                                        {
                                            <text>&nbsp;</text>
                                        }

                                    }



                                </td>
                            </tr>
                            <tr class="bgcolor1">
                                <td height="50" class="titledoc">
                                    Cơ quan ban hành
                                </td>
                                <td align="center">
                                    @Model.SignedByDesc

                                </td>
                                <td class="titledoc">
                                    Người ký
                                </td>
                                <td align="center">
                                    @Model.SignedBy
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
        <div class="clear padtop10"></div>
    </div>
    @*@if (ViewBag.lstRef != null)
        {
            <div class="news-other mt30">
                <h3 class="title-blue">Các văn bản khác</h3>
                <ul class="news-list">


                    @foreach (BIZ.Entity.DOCUMENT_FULL item in ViewBag.lstRef)
                    {
                        if (item.Id != Model.Id)
                        {
                            <li><a title="@item.Name" href="@Utils.FormatUrlRewrite(item.Id, "", "DocumentDetail")">@item.Name </a></li>
                        }

                    }



                </ul>


            </div>







        }*@
    <style>
        .titledoc2 a {
            color: #1f5ecb !important;
        }
    </style>
