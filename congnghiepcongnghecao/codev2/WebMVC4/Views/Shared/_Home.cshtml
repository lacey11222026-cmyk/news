<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html>
<head>

    @Html.Partial("MetaData")

    @Styles.Render("~/Content/site.css")

    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css">

    <script src="/Content/js/jquery.min.js"></script>
    <script src="/Content/js/bootstrap.min.js"></script>

</head>
<body onorientationchange="updateOrientation();">
    @{Html.RenderAction("MenuMobile", "Home");}
    <div>
        @Html.Partial("Site_Header")
       
            @RenderBody()
            <div class="clearfix"></div>

            @{Html.RenderAction("BannerBottom", "Home");}
            @{Html.RenderAction("MenuBottom", "Home");}
            <div class="clearfix"></div>
            @Html.Partial("Site_Footer")
       

    </div>

    <div id="top_gototop"><a href="#" class="gototop clearfix">↑</a></div>
    <div id="fb-root"></div>
    <div class="clearfix">
    </div>
    @Scripts.Render("~/sitescript")
    <script>
        function updateOrientation() {
            window.location.reload();
        }
    </script>
    <script src="/Content/js/script.js"></script>
    <script>
        function searchFunction() {
            document.getElementsById("search_box").style.display = "block";
        }
    </script>
    <script src="https://sp.zalo.me/plugins/sdk.js"></script>
    <script>

        (function (d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
            js = d.createElement(s); js.id = id;
            js.src = "//connect.facebook.net/vi_VN/sdk.js#xfbml=1&version=v2.8&appId=275786053207358";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));
    </script>
    <script>
        (function (i, s, o, g, r, a, m) {
        i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () {
            (i[r].q = i[r].q || []).push(arguments)
        }, i[r].l = 1 * new Date(); a = s.createElement(o),
            m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
        })(window, document, 'script', 'https://www.google-analytics.com/analytics.js', 'ga');

        ga('create', 'UA-80239134-1', 'auto');
        ga('send', 'pageview');

    </script>
</body>





</html>
