@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>
    <ul class="nav-list pull-left">
        <li class="home"><a href="/"><i class="fa fa-home" aria-hidden="true"></i></a></li>
        @if (Model != null)
        {

            if (Model.Count > 0)
            {
                foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    if (item.i == 0)
                    {
                        <li class="active">
                            <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)" @(item.value.Type.GetValueOrDefault() == 11 ? " target='_blank'" : "")><img src="/images/logo-menu.png" alt="Công nghiệp công nghệ cao"> </a>
                            @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                        </li>
                    }
                    else
                    {
                        <li>
                            <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)" @(item.value.Type.GetValueOrDefault() == 11 ? " target='_blank'" : "")>@item.value.Name </a>
                            @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                        </li>
                    }


                }
            }
        }
    </ul>


