@using BIZ
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.SlideModel


<div class="container content01 mt20">
    <div class="row">
        <div class="col-md-4 col-sm-4 hidden-sm">
            <h2 class="title-cm"><a href="#">Tin mới</a></h2>
            <ul class="news-list-num">
                @foreach (var item in Model.LstLastestNews.Select((value, i) => new { i, value }))
                {
                    if (item.i < 5)
                    {
                       

                        <li>
                            <span class="num">@(item.i+1)</span>
                            <a href="@item.value.LinkUrl">
                                <p>@item.value.Title</p>
                                <span class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy - HH:mm")</span>
                            </a>
                        </li>
                    }

                }


            </ul>
        </div>
        <div class="col-md-5 col-sm-8 col-xs-12 big-news">
            @foreach (var item in Model.LstHotNews.Take(1).Select((value, i) => new { i, value }))
            {

                <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=500&h=300&mode=crop" alt="" class="w100"></a>
                <h3 class="mt15 f22"><a href="@item.value.LinkUrl">@item.value.Title</a></h3>
                <span class="date mt20">@item.value.PublishDate.ToString("dd/MM/yyyy - HH:mm")</span>
                <p class="mt10">@item.value.IntroText </p>
            }

        </div>
        <div class="col-md-3 col-sm-4 col-xs-12">
            <ul class="news-hot-small">
                @foreach (var item in Model.LstHotNews.Skip(1).Take(2).Select((value, i) => new { i, value }))
                {
                    <li>
                        <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=263&h=165&mode=crop" alt="" class="w100"></a>
                        <a href="@item.value.LinkUrl" class="mt10">@item.value.Title</a>
                    </li>

                }

              
            </ul>
        </div>
    </div><!-- end row-->
</div><!-- end container-->


