    //var lstBanner = new BIZ.BannerBO().GetTopLastestBanners(0, 8, 1);
}
<header>
    <div class="menu-top">
        <div class="container">
            <ul>
                <li><a href="/"><i class="fa fa-home" aria-hidden="true"></i></a></li>
                <li>
                    <a href="/gioi-thieu/c2/gioi-thieu.html">Giới thiệu</a>
                    <ul class="menutop-item">
                        <li><a href="/gioi-thieu/c27/co-so-phap-ly.html">Cơ sở pháp lý</a></li>
                        <li><a href="/gioi-thieu/c28/to-chuc-quan-ly.html">Tổ chức quản lý</a></li>
                        <li><a href="/gioi-thieu/c38/quy-trinh-thuc-hien.html">Quy trình thực hiện</a></li>
                    </ul>
                </li>
                <li><a href="/gioi-thieu/c11/lien-he.html">Liên hệ</a></li>
