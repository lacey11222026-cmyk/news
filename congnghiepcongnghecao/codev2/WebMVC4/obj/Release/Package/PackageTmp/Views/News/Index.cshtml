@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.News2Model


    <div class="congnghe-page container">
        <h2 class="title-blue mt30"><a href="@Request.Url">@ViewBag.CateName</a></h2>
        @if (Model.listcate != null)
        {
            if (Model.listcate.Count > 0)
            {
                <div class="submenu mt10">
                    <ul class="submenu-list">
                        @foreach (var item in Model.listcate.Select((value, i) => new { i, value }))
                        {
                            if (item.value.Id == Model.CategoryId)
                            {
                                <li class="active"><a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name</a></li>
                            }
                            else
                            {
                                <li><a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name</a></li>
                            }

                        }

                    </ul>
                </div>
            }
        }

        <div class="row mt20">
            @if (Model.hotnews != null)
            {
                foreach (var item in Model.hotnews.Take(1).Select((value, i) => new { i, value }))
                {

                    <div class="col-md-6 col-sm-7 col-xs-12 big-news">
                        <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=555&h=350&mode=crop" alt="" class="w100"></a>
                        <h3 class="mt15 f22"><a href="@item.value.LinkUrl">@item.value.Title</a></h3>
                        <span class="date mt20">@item.value.PublishDate.ToString("dd/MM/yyyy - HH:mm")</span>
                        <p class="mt10">@item.value.IntroText </p>
                    </div>
                }

            }
            @if (Model.hotnews != null)
            {

                <div class="col-md-3 col-sm-5 col-xs-12">
                    <ul class="news-hot-small">
                        @foreach (var item in Model.hotnews.Skip(1).Select((value, i) => new { i, value }))
                        {
                            <li>
                                <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=263&h=165&mode=crop" alt="" class="w100"></a>
                                <a href="@item.value.LinkUrl" class="mt10">@item.value.Title</a>
                                <span class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy - HH:mm")</span>
                            </li>
                        }
                    </ul>
                </div>
            }
            <div class="col-md-3 col-sm-12 col-xs-12">
                @{Html.RenderAction("RightLastestNews", "News", new { CateName = "Tin mới nhất", CategoryId = 0, MaxLastestNews = 5 });}
            </div>

        </div>
        <div class="row mt30">
            <div class="col-md-3 col-sm-4 col-xs-12 pull-right">
                @{Html.RenderAction("TopViewNews", "News", new { CateName = "Tin đọc nhiều", CategoryId = Model.CategoryId, MaxLastestNews = 8 });}
            </div>
            <div class="col-md-9 col-sm-8 col-xs-12 pull-left">
                @if (Model.articles != null)
                {

                    <div class="border-top-gray">
                        <h2 class="title-blue mt30"><a href="#">Xem thêm</a></h2>
                        <ul class="viewmore-list mt20">
                            @foreach (var item in Model.articles.Select((value, i) => new { i, value }))
                            {
                                <li class="row">
                                    <div class="col-md-3 col-sm-4 col-xs-4">
                                        <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=334&h=216&mode=crop" alt=""></a>
                                    </div>
                                    <div class="col-md-9 col-sm-8 col-xs-8">
                                        <h3><a href="@item.value.LinkUrl">@item.value.Title</a></h3>
                                        <span class="date mt15"></span>
                                        <p class="mt15 hidden-xs">@item.value.IntroText</p>
                                    </div>
                                </li>
                            }
                        </ul>
                        <div class="pagination pull-right mt30">
                            <ul>
                                @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                                    {
                                        PageUrl = Url.SetParameter("Page", "!0"),
                                        CurrentPage = ViewBag.Page,
                                        PageSize = ViewBag.PageSize,
                                        TotalItemCount = ViewBag.Total,
                                    }); }
                            </ul>
                        </div>

                    </div>
                }
            </div>
        </div>

    </div><!-- end cong nghe page-->


