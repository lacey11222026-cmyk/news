@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewModel
@if (Model != null)
{

    <h2><a href="/tin-tuc/c69/phat-bieu-cua-lanh-dao.html">Phát biểu của lãnh đạo</a></h2>
    <div>
        <div id="sidebar-slide" class="carousel slide" data-ride="carousel">
            <!-- Wrapper for slides -->
            <div class="carousel-inner">
                @foreach (var item in Model.lstdata.Select((value, i) => new { i, value }))
                {
                    <div class="@(item.i==0?"item active":"item")">
                        <a href="@item.value.LinkUrl">
                            @*<img src="/Content2/images/img-lanhdao.jpg" style="width: 100%;">*@
                            <img alt="@item.value.Title" src="@item.value.MainImage?w=368&h=208&mode=crop" style="width: 100%;"/>
                            <p>@item.value.Title</p>
                        </a>
                    </div>

                }
                
            </div>
            <!-- Left and right controls -->
            <a class="left carousel-control" href="#sidebar-slide" data-slide="prev">
                <span class="glyphicon glyphicon-chevron-left"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="right carousel-control" href="#sidebar-slide" data-slide="next">
                <span class="glyphicon glyphicon-chevron-right"></span>
                <span class="sr-only">Next</span>
            </a>
        </div>
    </div>

}





