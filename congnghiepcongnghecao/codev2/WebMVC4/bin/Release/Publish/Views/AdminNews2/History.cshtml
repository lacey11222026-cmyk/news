@model List<DATA.ContentLog>

<div class="row" id="ContentPopUp">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon"></span>@ViewBag.ItemName</div>
            <div class="panel-body">
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <table class="table table-striped table-bordered table-hover dataTable no-footer">
                            <thead>
                                <tr class="rowsao">
                                    @*<th>ID</th>*@
                                    <th>Tài khoản</th>
                                    <th>Hành động</th>
                                    <th>Thời gian</th>


                                </tr>
                            </thead>
                            @if (Model != null && Model.Count > 0)
                            {
                                for (int i = 0; i < Model.Count; i++)
                                {
                                    var obj = Model[i];
                                    <tr>
                                        @*<td>@obj.Id</td>*@

                                        <td>@obj.UserName</td>
                                        <td>@obj.Note</td>

                                        <td>@obj.CreateTime.GetValueOrDefault().ToString("dd/MM/yyyy HH:mm")</td>



                                    </tr>
                                }
                            }
                        </table>
                    </div>
                </div></div>
                </div>
            </div>
</div>