@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewModel
@if (Model.lstdata != null)
{
    if (Model.lstdata.Count > 0)
    {

        <h2 class="title-cm"><a href="@Model.Url">@Model.HeaderTitle</a></h2>
        <div class="@Model.Css mt20">
            @foreach (var item in Model.lstdata.Take(1).Select((value, i) => new { i, value }))
            {
                <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=409&h=264&mode=crop" alt=""></a>
                <h3><a href="@item.value.LinkUrl">@item.value.Title</a></h3>
                <span class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy - HH:mm")</span>
                <p class="mt10">@item.value.IntroText</p>

            }

        </div>
        <ul class="news-list mt20">
            @foreach (var item in Model.lstdata.Skip(1).Select((value, i) => new { i, value }))
            {
                <li>
                    <a href="@item.value.LinkUrl">@item.value.Title</a>
                    <span class="date mt5">@item.value.PublishDate.ToString("dd/MM/yyyy - HH:mm")</span>
                </li>
            }


        </ul>


    }
}