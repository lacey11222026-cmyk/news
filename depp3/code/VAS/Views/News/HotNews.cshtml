@using BIZ
@using UTILS
@using VAS.Helper
@model List<BIZ.Entity.CONTENT_FULL>


@if (Model != null)
{
    if (Model.Count > 0)
    {
    
        <div class="col-sm-7 col-xs-12">
            @foreach (var item in Model.Take(1).Select((value, i) => new { i, value }))
            {
                <div class="newsbig">
                    <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=433&h=243&mode=crop" alt=""></a>
                    <h2 class="mt10"><a href="@item.value.LinkUrl">@item.value.Title</a></h2>
                    <span class="newsdate mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                    <p class="mt10">@item.value.IntroText</p>
                </div>
            }

        </div>
        <div class="col-sm-5 col-xs-12">
            <ul class="newslist02">
                @foreach (var item in Model.Skip(1).Select((value, i) => new { i, value }))
                {

                    <li>
                        <a href="@item.value.LinkUrl">
                            <img src="@item.value.MainImage?w=110&h=73&mode=crop">
                            <span>@item.value.Title</span>
                        </a>
                    </li>
                }


            </ul>
            
        </div>
   
       


      
    }

}



