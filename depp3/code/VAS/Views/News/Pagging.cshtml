@using UTILS
@using  VAS.Helper
<div class="xemtiepthemngay" style="float: left;">
    <input type="text" id="newsdate" style="display: none" />
</div>

@if (ViewBag.PageNextShow)
{

  
<ul >
    @{Html.RenderPartial("Pagination", new VAS.Models.PaginationInfo
        {
            PageUrl = Url.SetParameter("page", "!0"),
            CurrentPage = ViewBag.pageIndex,
            PageSize = ViewBag.pageSize,
            TotalItemCount = ViewBag.total,
        }); }
</ul>
   
}
