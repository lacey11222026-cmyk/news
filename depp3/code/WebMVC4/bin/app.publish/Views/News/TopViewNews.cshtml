@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewModel
@if (Model != null)
{
    if (Model.lstdata != null)
    {

        <p class="title-cm title-cm-inline"><a href="#">@Model.HeaderTitle</a></p>
        foreach (var item in Model.lstdata.Take(1).Select((value, i) => new { i, value }))
        {
            @*<img src="/Content2/images/new-list.jpg">*@
            <img src="@item.value.MainImage?w=260&mode=crop" />
            <h4><a href="@item.value.LinkUrl">@item.value.Title</a></h4>
        }
        <ul class="news-list">
            @foreach (var item in Model.lstdata.Skip(1).Select((value, i) => new { i, value }))
            {
                <li><a href="@item.value.LinkUrl">@item.value.Title</a></li>
            }


        </ul>
       

    }
}
