@model List<DATA.Project>


<h2 class="title-cm title-cm-inline"><a href="#">Sản phẩm khác</a></h2>
<ul class="row new-other-list">
    @foreach (var item in Model.Select((value, i) => new { i, value }))
    {
        <li class="col-sm-3 col-xs-4">
            <a title="@item.value.Name" href="@Url.Action("Detail","Project",new { Id=item.value.Id})">
                <img src="@item.value.Image?w=185&h=120&mode=crop" alt="">
                <p>@item.value.Name</p>
            </a>
        </li>

    }
</ul>


