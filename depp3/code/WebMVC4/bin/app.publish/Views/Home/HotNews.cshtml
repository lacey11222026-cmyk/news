@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
       

            foreach (var item in Model.Take(7).Select((value, i) => new { i, value }))
            {
            <li>
                <div class="num maxheight02"><span>@(item.i + 1)</span></div>
                <p class="maxheight02"><a href="@item.value.LinkUrl">@item.value.Title</a></p>
                <div class="clearfix"></div>
            </li>
                
            }
        
    }


}
