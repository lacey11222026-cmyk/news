@using BIZ
@using DATA
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.DOCUMENT_FULL
@{
    var langpage = WorkContext.GetLanguage();
}
<div class="document-page container pb80">
    <div class="row mt30">



        <div class="col-md-12 col-lg-8 pb-5">
            @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
            <div class="list-page">
                <div class="document-table table-responsive mt20">
                    <table>
                        <tbody>
                            <tr class="bgcolor1">
                                <td width="25%" height="50">
                                    @Resources.Global.DocName
                                </td>
                                <td colspan="3">

                                    @Model.Name

                                </td>
                            </tr>
                            <tr class="bgcolor1">
                                <td width="25%" height="50">
                                    @Resources.Global.DocViewOnline
                                </td>
                                <td colspan="3" class="titledoc2">

                                    <a href="@Url.Action("ViewFile","Document",new { id=Model.Id})" target="_blank"> @Resources.Global.DocViewOnline</a>
                                </td>

                            </tr>
                            <tr class="bgcolor1">
                                <td width="25%" height="50" class="titledoc">
                                    @Resources.Global.DocDownload
                                </td>
                                <td colspan="3" class="titledoc2">
                                    <a href="@Url.Action("DownloadFile","Document",new { id=Model.Id})"> <img style="width: 17px;" src="/Content/images/ico-pdf02.png"> </a>


                                </td>

                            </tr>
                            <tr class="bgcolor1">
                                <td height="50" class="titledoc">
                                    @Resources.Global.DocDescription
                                </td>
                                <td colspan="3">
                                    @Model.Description
                                </td>
                            </tr>
                            <tr class="bgcolor1">
                                <td height="50" class="titledoc">
                                    @Resources.Global.DocCode
                                </td>
                                <td width="28%">
                                    @Model.Code
                                </td>
                                <td width="21%" class="titledoc">
                                    @Resources.Global.DocEffectiveDate
                                </td>
                                <td width="26%" align="center">

                                    @if (!Model.EffectiveDate.HasValue)
                                    {

                                        <text>&nbsp;</text>
                                    }
                                    else
                                    {
                                        if (Model.EffectiveDate.Value.Year < 9000)
                                        {
                                            @Convert.ToDateTime(Model.EffectiveDate).ToString(@" dd'/'MM'/'yyyy")
                                        }
                                        else
                                        {
                                            <text>&nbsp;</text>
                                        }

                                    }

                                </td>
                            </tr>
                            <tr class="bgcolor1">
                                <td height="50" class="titledoc">
                                    @Resources.Global.DocPublishDate
                                </td>
                                <td>
                                    @Convert.ToDateTime(Model.PublishDate).ToString(@" dd'/'MM'/'yyyy")
                                </td>
                                <td class="titledoc">
                                    @Resources.Global.DocExpiryDate
                                </td>
                                <td align="center">
                                    @if (!Model.ExpiryDate.HasValue)
                                    {

                                        <text>&nbsp;</text>
                                    }
                                    else
                                    {
                                        if (Model.ExpiryDate.Value.Year < 9000)
                                        {
                                            @Convert.ToDateTime(Model.ExpiryDate).ToString(@" dd'/'MM'/'yyyy")
                                        }
                                        else
                                        {
                                            <text>&nbsp;</text>
                                        }

                                    }



                                </td>
                            </tr>
                            <tr class="bgcolor1">
                                <td height="50" class="titledoc">
                                    @Resources.Global.DocSignedByDesc
                                </td>
                                <td align="center">
                                    @Model.SignedByDesc

                                </td>
                                <td class="titledoc">
                                    @Resources.Global.DocSignedBy
                                </td>
                                <td align="center">
                                    @Model.SignedBy
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-12 col-lg-4">
            @{Html.RenderAction("LastestNews", "News", new { MaxLastestNews = 8, lang = langpage });}

        </div>

    </div>
</div>

<
<style>
    .titledoc2 a {
        color: #1f5ecb !important;
    }
</style>
