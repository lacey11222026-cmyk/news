@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.AuthorProfile

    <div class="row mt20 author-content">
        <div class="col-sm-4 col-xs-4 authoravt" >
            <img src="@Model.Avatar?w=600&h=0&mode=crop"  alt="">
        </div><!-- end side bar left-->
        <div class="col-sm-8 col-xs-8">
            <h3 class="author-name">@Model.FullName</h3>
            <span class="author-work">@Model.Title</span>
            <p class="author-text">@Model.Description</p>
            <div class="author-text" id="dvcontent" style="display:none">
                @Html.Raw(Model.Content)
            </div>
            <a href="javascript:;" onclick="showmore()" id="btshowmore" class="btn-viewmore02"><span><span class="glyphicon glyphicon-triangle-bottom"></span></span>Xem thêm</a>
            <div class="author-post mt20">
               
                    @{Html.RenderAction("RelateAuthor", "News", new { CategoryId = 42, username = Model.UserName });}
               
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-sm-12 post-other mt30">
            @{Html.RenderAction("Relate", "Author", new { CategoryId = 42 });}
        </div>


    </div>
<script>
    function showmore() {
        $("#dvcontent").show();
        $("#btshowmore").hide();
    }
</script>
<style>
    .authoravt img {
           max-width:100%;
        }
    @@media screen and (max-width: 485px) {
        .authoravt img {
           max-width:79%;
        }
    }
</style>