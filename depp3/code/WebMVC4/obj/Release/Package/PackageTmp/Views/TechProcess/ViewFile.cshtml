<div id="document" class="main-content">
    @if (ViewBag.FilePath.ToLower().Contains(".jpg"))
    {
        <div class="nd" id="NewsContent">
            <img alt="" src="@ViewBag.FilePath" width="100%" />
        </div>
    }
    else
    {
        <iframe src="@ViewBag.url" style="width: 100%; height: 1000px; border: 0px none;" id="source"></iframe>

    }


</div>