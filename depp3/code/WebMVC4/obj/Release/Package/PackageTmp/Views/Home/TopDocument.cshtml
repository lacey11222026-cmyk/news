@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.DOCUMENT_FULL>
@{
    var langpage = WorkContext.GetLanguage();
}
@if (Model != null)
{
    if (Model.Count > 0)
    {
        if (langpage == "vi-vn")
        {


            <h2 class="title-cm">
                <a href="/Document/Index/3" class="active">Tài liệu</a>
            </h2> }
        else
        {
            <h2 class="title-cm">
                <a href="/Document/Index/56" class="active">Publications</a>
            </h2>
        }
        <ul class="document-list mt30">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {

                <li><a href="@Url.Action("Detail","Document",new { id=item.value.Id})">@item.value.Name</a></li>
            }
        </ul>
        if (langpage == "vi-vn")
        {


            <div class="text-right mt30"><a href="/Document/Index/3" class="btn-viewmore">@Resources.Global.More</a></div>

        }
        else
        {
            <div class="text-right mt30"><a href="/Document/Index/56" class="btn-viewmore">@Resources.Global.More</a></div>
        }


    }

}