@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="mt20 row">
            <div class="col-md-6 col-sm-12">
                @foreach (var item in Model.Take(1).Select((value, i) => new { i, value }))
                {
                    <div class="news-big">
                        <a href="@item.value.LinkUrl">
                            <img src="@item.value.MainImage?w=425&h=239&mode=crop" alt="">
                            <p class="news-title mt15">@item.value.Title</p>
                        </a>
                        <p class="date-green mt15">@item.value.PublishDate.ToString("HH:mm")   |  @item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                    </div>
                }
                </div>
            <div class="col-md-6 col-sm-12">
                <ul class="newslist-border">
                    @foreach (var item in Model.Skip(1).Take(4).Select((value, i) => new { i, value }))
                    {
                        <li><a href="@item.value.LinkUrl">@item.value.Title</a></li>
                    }
                    </ul>
            </div>
        </div>
        <div class="newslist-04 mt40">
            @foreach (var item in Model.Skip(5).Select((value, i) => new { i, value }))
            {
                <div>
                    <a href="@item.value.LinkUrl" class="newslist-04-item">
                        <img src="@item.value.MainImage?w=425&h=239&mode=crop" alt="@item.value.Title" />
                        <div>
                            <p class="news-name">@item.value.Title</p>
                            <p class="mt10 date-green">@item.value.PublishDate.ToString("HH:mm") - @item.value.PublishDate.ToString("dd/MM/yyyy")<</p>
                        </div>
                    </a>
                </div>
            }


        </div>

        




    }


}