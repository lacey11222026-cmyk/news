@model List<DATA.Banner>

@if (Model != null)
{

    <div class="banner-new">
        <div class="slider bnrSlider">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <div class="slider-item">
                    <a href="@item.value.Url"><img src="@item.value.Data" alt="" class="hidden-767"></a>
                    <a href="item.value.Url"><img src="@item.value.Description" alt="" class="block-767"></a>
                </div>
            }

        </div>
    </div>


}


