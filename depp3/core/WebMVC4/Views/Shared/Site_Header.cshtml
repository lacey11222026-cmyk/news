@using UTILS
@using WebMVC4.Helper
@{
    var langpage = WorkContext.GetLanguage();
}
@{
    var date = Utils.formatDateofWeek(DateTime.Now.DayOfWeek) + "," + DateTime.Now.ToString(" dd") + "/" + DateTime.Now.ToString("MM") + "/" + DateTime.Now.Year.ToString() + " | " + DateTime.Now.ToString("HH") + ":" + DateTime.Now.ToString("mm");
    var DateEN = DateTime.Now.DayOfWeek.ToString() + ", " + DateTime.Now.ToString("dd") + "/" + DateTime.Now.ToString("MM") + "/" + DateTime.Now.Year.ToString() + " | " + DateTime.Now.ToString("HH") + ":" + DateTime.Now.ToString("mm");
}

<div class="header">
    <div class="container">
        @if (langpage == "vi-vn")
        {
            <div class="header-c1">
                <div class="top-logo logo-pc">
                    <a href="/"><img src="/Content/img/bocongthuong-logo.png" alt="Bộ Công Thương Việt Nam" height="60"></a>
                    <a href="/"><img src="/Content/img/Denmark.svg?vs=1" alt="Bộ Ngoại Giao Đan Mạch" height="42"></a>
                    <a href="/"><img src="/Content/img/danishEnergyAgency.svg" alt="Danish Energy Agency" height="40"></a>
                </div>
                <div class="top-logo logo-mb">
                    <a href="/"><img src="/Content/img/bocongthuong-logo-mb.svg" alt="Bộ Công Thương Việt Nam" width="50"></a>
                    <a href="/"><img src="/Content/img/bongoaigiaodanmach-logo-mb.svg" alt="Bộ Ngoại Giao Đan Mạch" width="50"></a>
                    <a href="/"><img src="/Content/img/danishEnergyAgency-mb.svg" alt="Danish Energy Agency" width="50"></a>
                </div>
                <div class="logo-txt">
                    <h1>TRUNG TÂM XUẤT SẮC VỀ HIỆU QUẢ NĂNG LƯỢNG</h1>
                </div>
            </div>

        }
        else
        {
            <div class="header-c1">
                <div class="top-logo logo-pc">
                    <a href="/"><img src="/Content/img/Logo MOIT-ENG.png?vs=01" alt="Bộ Công Thương Việt Nam" height="60"></a>
                    <a href="/"><img src="/Content/img/Denmark.svg?vs=0" alt="Bộ Ngoại Giao Đan Mạch" height="42"></a>
                    <a href="/"><img src="/Content/img/danishEnergyAgency.svg" alt="Danish Energy Agency" height="40"></a>
                </div>
                <div class="top-logo logo-mb">
                    <a href="/"><img src="/Content/img/bocongthuong-logo-mb.svg" alt="Bộ Công Thương Việt Nam" width="50"></a>
                    <a href="/"><img src="/Content/img/bongoaigiaodanmach-logo-mb.svg" alt="Bộ Ngoại Giao Đan Mạch" width="50"></a>
                    <a href="/"><img src="/Content/img/danishEnergyAgency-mb.svg" alt="Danish Energy Agency" width="50"></a>
                </div>
                <div class="logo-txt">
                    <h1>CENTER OF EXCELLENCE FOR ENERGY EFFICIENCY</h1>
                </div>
            </div>
            
        }
    </div>

    <div class="nav_top" id="navsticky">
        <div class="container">
            <div class="nav-inner">
                @*  *@
                <nav class="nav-left">
                    <ul>
                        <li class="active" id="menu_home"><a href="/"><img src="/Content/img/icon-home.svg" alt="Trang chủ" width="21"></a></li>
                        @{Html.RenderAction("Menu", "Home", new { lang = langpage });}


                    </ul>
                </nav>
                <div class="nav-right">
                    <div class="search-box">
                        <button class="search-icon" onclick="search()"></button>
                        <input type="text" class="form-control" id="txtKeyword" onkeydown="javascript: return AnyInput_KeyDown(this, event);">
                    </div>
                    <div class="flag">
                        @if (langpage == "vi-vn")
                        {
                            <a href="/Home/Language?lang=en-us"><img src="/Content/img/en.png" alt="" width="30"></a>
                        }
                        else
                        {
                            <a href="/Home/Language?lang=vi-vn"><img src="/Content/img/vn.png" alt="" width="30"></a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="nav-mobile">
        <div class="header-m">
            <a href="#menu">
                <img src="/Content/img/icon-menu.svg" width="30" class="ico-menu pull-right">
            </a>
        </div>
        <div id="menu">
            <ul>
                <li class="search-box w100">
                    <button class="search-icon" onclick="Msearch()"></button>
                    <input type="text" class="form-control" id="txtKeywordMobile" onkeydown="javascript: return AnyInput_KeyDown(this, event);">
                </li>
                <li><a href="/"><img src="/Content/img/icon-home.svg" alt="Trang chủ" width="22"></a></li>
                @{Html.RenderAction("Menu", "Home", new { lang = langpage });}
                @if (langpage == "vi-vn")
                {

                    <li><a href="/Home/Language?lang=en-us">Ngôn ngữ : <img src="/Content/img/en.png" alt="" width="22" style="margin-left: 10px; vertical-align: middle;"></a></li>
                }
                else
                {
                    <li><a href="/Home/Language?lang=vi-vn">Language: <img src="/Content/img/vn.png" alt="" width="22" style="margin-left: 10px; vertical-align: middle;"></a></li>
                }

            </ul>
        </div>
    </div>
</div><!-- end header-->



<script type="text/javascript">
    function search() {
        var searchtext = $("#txtKeyword").val();
        window.location = "/News/Search?q=" + searchtext;

    }
    function AnyInput_KeyDown(sender, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            search();

            return false;
        }

        return true;
    }


    function Msearch() {
        var searchtext = $("#txtKeywordMobile").val();
        window.location = "/News/Search?q=" + searchtext;

    }
    function MAnyInput_KeyDown(sender, e) {
        if ((e.which && e.which === 13) || (e.keyCode && e.keyCode === 13)) {
            Msearch();

            return false;
        }

        return true;
    }



</script>
