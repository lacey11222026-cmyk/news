@using WebMVC4.Helper
@{
    var langpage = WorkContext.GetLanguage();
}
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html>
<head>

    @Html.Partial("MetaData")

    <link rel="stylesheet" href="/Content2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/Content2/css/common.css">
    <link rel="stylesheet" href="/Content2/css/style.css?vs=12">
    <link rel="stylesheet" href="/Content2/css/extend.css?vs=12">
    <link type="text/css" rel="stylesheet" href="/Content2/css/jquery.mmenu.all.css" />



    <!-- Script-->
    <script src="/Content2/js/jquery.min.js"></script>
    <script src="/Content2/js/bootstrap.min.js"></script>

    <script type="text/javascript" src="/Content2/js/jquery.mmenu.min.all.js"></script>
    <script type="text/javascript" src="/Content2/js/jquery.flexisel.js"></script>
    <script type="text/javascript" src="/Content2/js/jquery.matchHeight.js"></script>
    <script type="text/javascript" src="/Content2/js/marquee.js"></script>


</head>
<body onorientationchange="updateOrientation();">

    @{Html.RenderAction("MenuMobile", "Home", new { lang = langpage });}
    <div class="bg-gray">
        @Html.Partial("Site_Header")
        <section class="content-wrap container">
            @RenderBody()
            <div class="clearfix"></div>
            @{Html.RenderAction("BannerBottom", "Home");}
            @{Html.RenderAction("MenuBottom", "Home", new { lang = langpage });}
            @Html.Partial("Site_Footer")
        </section>
    </div>
    <div id="top_gototop"><a href="#" class="gototop clearfix"><img src="/Content2/images/gotop.png" alt="lên đầu trang" /></a></div>
    <div id="fb-root"></div>
    <div class="clearfix">
    </div>

    <script src="/Content2/js/script.js?vs=12"></script>
    <script type="text/javascript">
        $('.toptobottom').Css3Marquee();
    </script>
    <script>
        function updateOrientation() {
            window.location.reload();
        }
    </script>

    <script src="https://sp.zalo.me/plugins/sdk.js"></script>
    <script>

        (function (d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
            js = d.createElement(s); js.id = id;
            js.src = "//connect.facebook.net/vi_VN/sdk.js#xfbml=1&version=v2.8&appId=1017677488409545";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));
    </script>
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-46237204-2"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'UA-46237204-2');
    </script>

</body>





</html>
