                                </div>
                                <div class="form-group" style="font-size:150%;font-weight:bold">

                                    <br />Tải file mẫu tại <a href="~/Content/OrderGarena.xlsx?vs=202001" target="_blank">đây</a>

                                </div>
                                <div class="form-group">

                                    <img src="~/Content/OrderGanera.PNG?vs=?vs=202005" style="width:89%" />
                                    <br /><br />
                                    <img src="~/Content/OrderGanera2.PNG?vs=10201905" style="width:89%" />

                                </div>
                                <div class="form-group">
                                    <label for="groupName" class="text-info ng-binding">Tên đơn:</label>

                                    <input type="text" class="form-control" placeholder="Nhập tên đơn(thêm vào cuối đơn)" id="txtOrderNo" maxlength="10">

                                </div>
                                <div class="form-group">
                                    <label for="groupName" class="text-info ng-binding">Mật khẩu bán hàng:</label>

                                    <input type="password" class="form-control" placeholder="Nhập mật khẩu bán hàng" id="txtPassword2" value="@ViewBag.MKBH" autocomplete="new-password">

