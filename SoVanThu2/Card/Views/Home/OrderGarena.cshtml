                        @{ Html.RenderAction("TopCkBar", "Home", new { type = 2 });}
                    </div>
                    <div style="border-bottom:1px solid #ccc">

                    </div>
                    <div class="form-body">
                        <div class="panel-group" id="steps">

                            <div class="panel">
                                <div class="form-group">
