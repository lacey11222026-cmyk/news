@using Card.Data.Api
@using Card.Utility

<div class="row" id="ContentPopUp">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><span class="glyphicon"></span><b>Đua giá</b> </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="form-horizontal">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label id="ErrorMessage">Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-6">
                        </div>
                        <div class="col-md-6">
                            <ul style2="list-style: none;">
                                <li>
                                    Tổng tiền còn lại:   <b>@StringUtils.InsertCommaNoStyle(ViewBag.amount.ToString()) đ</b>
                                </li>
                                
                                <li>
                                    Chi phí sau đua giá: <b id="lblPrice"></b>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="form-group">

                        <label for="txtAmount" class="control-label col-md-2">Chiết khấu đua :<span class="required">*</span></label>
                        <div class="col-md-2">
                            <input type="number" name="amount" style="font-size:20px;font-weight:bold" min="0" max="@ViewBag.max" value="@string.Format("{0:F0}", ViewBag.maxBidRate)" class="form-control" id="txtBidRate">
                        </div>
                        <div class="col-md-8">
                            <div class="input-icon right">
                                <input type="range" min="0" max="@ViewBag.max" value="@ViewBag.maxBidRate" class="slider" id="myRange">
                            </div>
                        </div>

                    </div>

                </div>

                <div class="panel-footer form-horizontal">
                    <div class="form-group submit">
                        <button type="submit" class="btn btn-primary" id="btnSave"><i class="fa fa-save"></i> Cập nhập</button>

                        <button type="button" class="btn btn-default" id="btnBack" data-dismiss="modal"><i class="fa fa-backward"></i> Hủy</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<style type="text/css">
    .modal-dialog {
        width: 55% !important;
        height: 55% !important;
    }

    .modal-footer {
        display: none;
    }

    @@media (max-width: 768px) {

        .modal-dialog {
            width: 90% !important;
            height: 90% !important;
        }
    }
</style>

<style>
    .slider {
        -webkit-appearance: none;
        width: 100%;
        height: 10px;
        border-radius: 5px;
        background: #d3d3d3;
        outline: none;
        opacity: 0.7;
        -webkit-transition: .2s;
        transition: opacity .2s;
    }

        .slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 15px;
            height: 15px;
            border-radius: 50%;
            background: #4CAF50;
            cursor: pointer;
        }

        .slider::-moz-range-thumb {
            width: 25px;
            height: 25px;
            border-radius: 50%;
            background: #4CAF50;
            cursor: pointer;
        }
</style>
<script>
    var slider = document.getElementById("myRange");
    var output = document.getElementById("txtBidRate");
    output.innerHTML = slider.value; // Display the default slider value

    // Update the current slider value (each time you drag the slider handle)
    slider.oninput = function () {
        $("#txtBidRate").val(this.value);
        getPrice();
    }

    $("#txtBidRate").change(function () {
        $("#myRange").val(this.value);
        getPrice();
    });
    function getPrice()
    {
        var rate = $("#txtBidRate").val();
        var amount =@(ViewBag.amount);
        //var amount = 10000;
        var price = amount * rate / 100;

        $("#lblPrice").html(  price.formatMoney(0, '', '.')+ " đ");
    }


</script>
<script>


    $(document).ready(function () {
        function GotoListpage()
        {
            location.reload();

        }
        $('#defaultForm').bootstrapValidator({
            message: 'This value is not valid',
            //live: 'submitted',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {

                amount: {
                    message: 'The username is not valid',
                    validators: {
                        notEmpty: {
                            message: 'chiết khấu không được bỏ trống'
                        },
                        integer: {
                            message: 'chiết khấu không đúng định dạng'
                        }

                    }
                }
            }
        })
            .on('success.form.bv', function (e) {
                // Prevent submit form
                e.preventDefault();

                var $form = $(e.target),
                    validator = $form.data('bootstrapValidator');
                SaveData();
                $(".close").click(function () {
                    $(".alert-success").css("display", "none");
                });
            })
            .on('error.form.bv', function (e) {
                // Active the panel element containing the first invalid element
                e.preventDefault();
                var $form = $(e.target),
                    validator = $form.data('bootstrapValidator');
                $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
                $(".alert-danger").css("display", "block");
                $(".close").click(function () {
                    $(".alert-danger").css("display", "none");
                    $(".alert-success").css("display", "none");
                });
            });

        function SaveData() {
            var param = {
                'OrderNo': '@ViewBag.Order',
                'bidRate': $("#txtBidRate").val(),

            };
              $.ajax({
                    type: 'POST',
                    url: "@Url.Action("OrderBidMulti")",
                    data: addAntiForgeryToken(param),
                    async: true,
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            $(".alert-success").show("slow");
                            $(".alert-danger").hide("slow");
                            setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 2000);
                        }
                        else {

                            $("#ErrorMessage").text(data.Description);
                            $(".alert-danger").show("slow");
                            $(".alert-success").hide("slow");
                            setTimeout(function () { $(".alert-danger").hide("slow"); }, 5000);
                        }
                    }
                });


        }
    });

</script>