@model Card.Data.DTO.Users

<div class="row" style="font-weight:bold;font-size:14px;">
    <div class="col-sm-4 col-xs-4">
        Zing : <span class="label label-success" style="padding:2px 2px;font-size: 14px;float:right"><b>@(100 - Model.PercentZing)% </b></span>
    </div>
    <div class="col-sm-4 col-xs-4">
        Garena: <span class="label label-success" style="padding:2px 2px;font-size: 14px;float:right"><b>@(100 - Model.PercentGarena)% </b></span>
    </div>
    
</div>

<style>
    @@media (max-width: 640px) {
        #StatusBard .row {
            font-size: 12px !important;
            margin-bottom: 10px;
        }
    }
</style>