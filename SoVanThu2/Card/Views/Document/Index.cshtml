@{ var canViewAll = ViewBag.canViewAll;
    ViewBag.Title = "Danh sách đơn thư"; }
<div class="row">
    <div class="col-xs-12">
        <div class="box box-primary">
            <div class="box-header with-border"><h3 class="box-title">Danh sách đơn thư</h3></div>
            <div class="box-body">
                <div class="row" id="searchForm">
                    <div class="col-md-3 col-sm-6 form-group"><label>Mã đơn</label><input type="text" id="txtTitle" class="form-control" placeholder="Nhập mã đơn" /></div>
                    @if (canViewAll)
                    {
                        <div class="col-md-3 col-sm-6 form-group">
                            <label>Đơn vị</label><select class="form-control" id="ddlGroupId" name="GroupId">
                                <option value="-1">Tất cả</option>
                                <option value="1">Văn phòng</option>
                                <option value="2">Phòng Tổ chức cán bộ</option>
                                <option value="3">Phòng Quản trị dữ liệu và quản lý rủi ro</option>
                                <option value="4">Phòng Thuế cá nhân, hộ kinh doanh và thu khác</option>
                                <option value="5">Phòng Quản lý các khoản thu từ đất</option>
                                <option value="6">Phòng Nghiệp vụ, dự toán, pháp chế</option>

                                <option value="7">Phòng Quản lý, hỗ trợ doanh nghiệp số 1</option>
                                <option value="8">Phòng Quản lý, hỗ trợ doanh nghiệp số 2</option>
                                <option value="9">Phòng Quản lý, hỗ trợ doanh nghiệp số 3</option>
                                <option value="10">Phòng Quản lý, hỗ trợ doanh nghiệp số 4</option>
                                <option value="11">Phòng Quản lý, hỗ trợ doanh nghiệp số 5</option>

                                <option value="12">Phòng Kiểm tra số 1</option>
                                <option value="13">Phòng Kiểm tra số 2</option>
                                <option value="14">Phòng Kiểm tra số 3</option>
                                <option value="15">Phòng Kiểm tra số 4</option>
                                <option value="16">Phòng Kiểm tra số 5</option>

                                <option value="17">Thuế cơ sở 1 TP Hà Nội</option>
                                <option value="18">Thuế cơ sở 2 TP Hà Nội</option>
                                <option value="19">Thuế cơ sở 3 TP Hà Nội</option>
                                <option value="20">Thuế cơ sở 4 TP Hà Nội</option>
                                <option value="21">Thuế cơ sở 5 TP Hà Nội</option>
                                <option value="22">Thuế cơ sở 6 TP Hà Nội</option>
                                <option value="23">Thuế cơ sở 7 TP Hà Nội</option>
                                <option value="24">Thuế cơ sở 8 TP Hà Nội</option>
                                <option value="25">Thuế cơ sở 9 TP Hà Nội</option>
                                <option value="26">Thuế cơ sở 10 TP Hà Nội</option>
                                <option value="27">Thuế cơ sở 11 TP Hà Nội</option>
                                <option value="28">Thuế cơ sở 12 TP Hà Nội</option>
                                <option value="29">Thuế cơ sở 13 TP Hà Nội</option>
                                <option value="30">Thuế cơ sở 14 TP Hà Nội</option>
                                <option value="31">Thuế cơ sở 15 TP Hà Nội</option>
                                <option value="32">Thuế cơ sở 16 TP Hà Nội</option>
                                <option value="33">Thuế cơ sở 17 TP Hà Nội</option>
                                <option value="34">Thuế cơ sở 18 TP Hà Nội</option>
                                <option value="35">Thuế cơ sở 19 TP Hà Nội</option>
                                <option value="36">Thuế cơ sở 20 TP Hà Nội</option>
                                <option value="37">Thuế cơ sở 21 TP Hà Nội</option>
                                <option value="38">Thuế cơ sở 22 TP Hà Nội</option>
                                <option value="39">Thuế cơ sở 23 TP Hà Nội</option>
                                <option value="40">Thuế cơ sở 24 TP Hà Nội</option>
                                <option value="41">Thuế cơ sở 25 TP Hà Nội</option>

                            </select>
                        </div>
                    }
                    <div class="col-md-2 col-sm-6 form-group"><label>Từ ngày báo cáo</label><input type="text" id="fromDate" class="form-control search-date" placeholder="dd/MM/yyyy" autocomplete="off" /></div>
                    <div class="col-md-2 col-sm-6 form-group"><label>Đến ngày báo cáo</label><input type="text" id="toDate" class="form-control search-date" placeholder="dd/MM/yyyy" autocomplete="off" /></div>
                    <div class="col-md-2 col-sm-12 form-group"><label>&nbsp;</label><div><button id="btnSearch" type="button" class="btn btn-info"><i class="fa fa-search"></i> Tìm kiếm</button> <a href="@Url.Action("GetDocumentDetail")" class="btn btn-success" title="Thêm đơn mới"><i class="fa fa-plus"></i> Thêm đơn mới</a></div></div>
                </div><div id="searchError" class="text-danger" style="display:none"></div>
            </div>
            <div class="box-body table-responsive"><div id="ListDocument">@Html.Action("ListDocument")</div><div id="pager" class="dataTables_paginate"></div></div>
        </div>
    </div>
</div>
<script>
$(function(){
    $('#menu_managedoc').addClass('active');
    if ($.fn.select2) $('#ddlGroupId').select2({width:'100%'});
    if ($.fn.datetimepicker) $('.search-date').datetimepicker({format:'DD/MM/YYYY',pickTime:false,useCurrent:false});
    $('#fromDate').val('@(ViewBag.fromDate == null ? "" : ((DateTime)ViewBag.fromDate).ToString("dd/MM/yyyy"))');
    $('#toDate').val('@(ViewBag.toDate == null ? "" : ((DateTime)ViewBag.toDate).ToString("dd/MM/yyyy"))');
    $('#btnSearch').on('click',function(){window.BindDataRequest(1);});
    $('#searchForm').on('keydown', 'input',function(e){if(e.which===13){e.preventDefault();window.BindDataRequest(1);}});
    $('#ddlGroupId').on('change',function(){window.BindDataRequest(1);});
});
window.BindDataRequest = function(page){
    var f=$('#fromDate').val(),t=$('#toDate').val();
    var pattern=/^\d{2}\/\d{2}\/\d{4}$/;
    if((f&&!pattern.test(f))||(t&&!pattern.test(t))){$('#searchError').text('Ngày phải theo định dạng dd/MM/yyyy').show();return;}
    $('#searchError').hide();
    var data={title:$('#txtTitle').val(),group:($('#ddlGroupId').length ? $('#ddlGroupId').val() : -1),fromDate:f,endDate:t,currentPage:page,pageSize:50};
    if(window.Utils&&Utils.Loading)Utils.Loading();
    $.ajax({url:'@Url.Action("ListDocument")',type:'GET',data:data,cache:false})
     .done(function(html){$('#ListDocument').html(html);})
     .fail(function(xhr){$('#searchError').text('Không tải được danh sách: '+(xhr.responseText||xhr.status)).show();})
     .always(function(){if(window.Utils&&Utils.UnLoading)Utils.UnLoading();});
};
</script>
