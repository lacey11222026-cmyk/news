                    </div>
                </div>
            </div>
        </section>
        <div id="vtValidationSummary" class="alert alert-danger" role="alert"></div>
        <div class="wizard-actions"><button type="button" class="btn btn-default" id="wizardBack">← Quay lại</button> <button type="button" class="btn btn-info" id="wizardDraft">Lưu nháp</button> <button type="button" class="btn btn-primary" id="wizardNext">Tiếp tục →</button> <button type="button" class="btn btn-success" id="wizardFinish">Kết thúc hồ sơ</button><span id="wizardMessage" style="margin-left:12px"></span></div>
    </form>
</div>
<script>
(function($){
    var priorThamQuyen = @(Model.ThamQuyenDon.HasValue ? Model.ThamQuyenDon.Value.ToString() : "0");
    var priorLoaiDon = @(Model.LoaiDon.HasValue ? Model.LoaiDon.Value.ToString() : "0");
    var priorKetQua = @(Model.KetQuaXuLyChinh.HasValue ? Model.KetQuaXuLyChinh.Value.ToString() : "0");
    var priorDieuKien = @(Model.DieuKienXuLy.HasValue ? Model.DieuKienXuLy.Value.ToString() : "0");
    var current = parseInt($('#Step').val(),10)||1;
    var busy=false, locked=$('#IsCompleted').val()==='true';
    var requiredByStep={1:[],2:['DieuKienXuLy'],3:['ThamQuyenDon'],4:['LoaiDon'],5:['KetQuaXuLyChinh'],6:['CaseStatus','DeadlineStatus'],7:[]};
    function field(name){return $('#field_'+name);}
    function val(name){return $.trim(field(name).val()||'');}
    function checked(name){return field(name).is(':checked');}
    function initDates(){
        if(typeof $.fn.datetimepicker!=='function')return;
        $('#vanThuWizard .wizard-date').each(function(){
            var $x=$(this); if($x.data('DateTimePicker'))return;
            $x.attr('autocomplete','off').attr('placeholder','dd/MM/yyyy');
            $x.datetimepicker({format:'DD/MM/YYYY',pickTime:false,useCurrent:false});
        });
    }
    function toggleRelatedOther(){
        var show=checked('RelatedField19');
        $('#vtRelatedOther').toggle(show);
        if(!show){ field('RelatedFieldOtherText').val(''); }
    }
    function toggleConditions(){
        var transfer=val('NguonTiepNhan')==='2',loai=val('LoaiDon')||String(priorLoaiDon),result=val('KetQuaXuLyChinh')||String(priorKetQua);
        var state={transfer:transfer,tc:loai==='1',kn:loai==='2',knpa:loai==='3',type:loai==='1'||loai==='2'||loai==='3',
            chuyen:result==='2',huongdan:result==='3',thuly:result==='4',khongthuly:result==='5',
            resolution:(loai==='1'||loai==='2')&&result==='4',pending:val('CaseStatus')==='2',returned:checked('PhieuChuyenBiTraLai')};
        $('.vt-conditional').each(function(){var $w=$(this),active=!!state[$w.attr('data-condition')];$w.toggle(active);$w.find(':input').prop('disabled',!active||locked);});
        // Thay danh mục 02/XLD theo loại đơn, giữ giá trị nếu còn hợp lệ.
        var $lv=field('LinhVuc02Xld'),currentValue=$lv.val();
        var choices=loai==='1'? [['1','Hành chính'],['2','Tham nhũng'],['3','Tư pháp'],['4','Khác']]:[['1','Đất đai'],['2','Chế độ, chính sách'],['3','Khác']];
        if(loai==='1'||loai==='2'||loai==='3'){
            $lv.empty().append($('<option>').val('').text('-- Chọn --'));
            $.each(choices,function(_,a){$lv.append($('<option>').val(a[0]).text(a[1]));});
            $lv.val(currentValue);
        }
        // Không được chọn NND khi thuộc thẩm quyền.
        field('LoaiDon').find('option[value="4"]').prop('disabled',(val('ThamQuyenDon')||String(priorThamQuyen))!=='2');
    }
    var validationMessages=[];
    function clearErrors(){
        $('#vanThuWizard .vt-error').removeClass('vt-error');
        $('#vanThuWizard .vt-error-message').remove();
        $('#vtValidationSummary').hide().empty();
        validationMessages=[];
    }
    function error(name,message){
        var $f=field(name), $box=$f.closest('.wizard-field');
        var label=$box.find('label').first().text().replace(/\*/g,'').trim() || name;
        var msg=message||'Vui lòng nhập trường bắt buộc';
        validationMessages.push(label+': '+msg);
        $f.addClass('vt-error');
        if($box.length && !$box.find('.vt-error-message').length){
            $box.append($('<div class="vt-error-message"></div>').text(msg));
        }
    }
    function validDate(s){
        if(!/^\d{2}\/\d{2}\/\d{4}$/.test(s))return false;
        var a=s.split('/').map(Number),d=new Date(a[2],a[1]-1,a[0]);
        return d.getFullYear()===a[2]&&d.getMonth()===a[1]-1&&d.getDate()===a[0];
    }
    function validateStep(){
        clearErrors();var ok=true;
        function require(n){if(!val(n)){error(n,'Vui lòng nhập trường bắt buộc');ok=false;}}
        $.each(requiredByStep[current]||[],function(_,n){require(n);});
        if(current===1){
            // Bắt buộc kiểm tra theo đúng NAME trong form, không phụ thuộc class/datepicker.
            var requiredStep1 = [
                ['NgayBaoCao','Ngày báo cáo'],
                ['NgayCvd','Ngày công văn đến'],
                ['SoCvDen','Số công văn đến'],
                ['NguonTiepNhan','Nguồn tiếp nhận'],
                ['NoiDungDon','Nội dung đơn']
            ];
            $.each(requiredStep1,function(_,item){
                var $control=$('#vanThuWizard [name="'+item[0]+'"]');
                var value=$control.length ? $.trim(String($control.val()||'')) : '';
                if(!value){
                    if(!$control.hasClass('vt-error'))error(item[0],'Bắt buộc nhập '+item[1].toLowerCase());
                    ok=false;
                }
            });
            if(val('NguonTiepNhan') && ['1','2'].indexOf(val('NguonTiepNhan'))<0){error('NguonTiepNhan','Nguồn tiếp nhận không hợp lệ');ok=false;}
            $.each(['NgayBaoCao','NgayCvd'],function(_,name){
                if(val(name) && !validDate(val(name))){error(name,'Ngày không hợp lệ (dd/MM/yyyy)');ok=false;}
            });
        }
        var $pane=$('.wizard-pane[data-pane="'+current+'"]');
        $pane.find('input.wizard-date:enabled').each(function(){var s=$.trim($(this).val());if(s&&!validDate(s)){error($(this).attr('name'),'Ngày phải đúng dd/MM/yyyy');ok=false;}});
        if(current===1){
            var chosen=false;for(var i=1;i<=19;i++)if(checked('RelatedField'+i))chosen=true;
            if(!chosen){error('RelatedField1','Phải chọn ít nhất một lĩnh vực');ok=false;}
            if(checked('RelatedField19'))require('RelatedFieldOtherText');
            if(val('NguonTiepNhan')==='2'){require('TransferSource');require('TransferSourceNo');}
        }
        if(current===2&&val('DieuKienXuLy')==='2'){
            var hasReason=false;for(var j=1;j<=5;j++)if(checked('Kdk0'+j))hasReason=true;
            if(!hasReason){error('Kdk01','Không đủ điều kiện: chọn ít nhất một lý do');ok=false;}
        }
        if(current===4){
            var type=val('LoaiDon');if(type==='4'&&(val('ThamQuyenDon')||String(priorThamQuyen))!=='2'){error('LoaiDon','NND chỉ áp dụng với đơn không thuộc thẩm quyền');ok=false;}
            if(type==='1'){require('PhanLoaiTc');require('LanTc');require('LinhVuc02Xld');}
            if(type==='2'){require('LanKn');require('LinhVuc02Xld');}
            if(type==='3'){require('KNPADetail');require('LinhVuc02Xld');}
        }
        if(current===5){
            var result=val('KetQuaXuLyChinh');
            if(result==='2')$.each(['SoPhieuChuyen','NgayPhieuChuyen','NoiNhanPhieuChuyen'],function(_,n){require(n);});
            if(result==='3')$.each(['SoPhieuHuongDan','NgayPhieuHuongDan'],function(_,n){require(n);});
            if(result==='4')$.each(['SoQdTbThuLy','NgayQdTbThuLy'],function(_,n){require(n);});
            if(result==='5')$.each(['NonAcceptanceNo','NonAcceptanceDate'],function(_,n){require(n);});
        }
        if(current===6&&val('CaseStatus')==='2')require('PendingReason');
        if(current===7&&checked('PhieuChuyenBiTraLai'))require('LyDoTraLaiPhieuChuyen');
        if(!ok){
            var $summary=$('#vtValidationSummary').empty();
            $summary.append($('<strong></strong>').text('Vui lòng kiểm tra các trường sau:'));
            var $ul=$('<ul style="margin:6px 0 0;"></ul>');
            $.each(validationMessages,function(_,msg){$ul.append($('<li></li>').text(msg));});
            $summary.append($ul).show();
            // Không focus vào input ngày: datetimepicker có thể mở popup che các lỗi khác.
            if($summary.length && $summary.offset())$('html, body').animate({scrollTop:Math.max(0,$summary.offset().top-100)},200);
        }
        return ok;
    }
    function render(){
        $('.wizard-pane').hide().filter('[data-pane="'+current+'"]').show();
        $('.wizard-step-button').removeClass('btn-primary').addClass('btn-default').prop('disabled',true);
        $('.wizard-step-button[data-step="'+current+'"]').removeClass('btn-default').addClass('btn-primary');
        $('#wizardBack').toggle(current>1&&!locked);$('#wizardNext').toggle(current<7&&!locked);
        $('#wizardDraft').toggle(!locked);$('#wizardFinish').toggle(current===7&&!locked);
        $('#Step').val(current);initDates();toggleConditions();
    }
    // Kiểm tra độc lập các trường tiếp nhận trước khi gọi AJAX.
    // Không phụ thuộc vào current/requiredByStep hoặc sự kiện DateTimePicker.
    function guardStep1Next(){
        var $form = $('#vanThuWizard');
        var fields = [
            ['NgayBaoCao', 'Ngày báo cáo'],
            ['NgayCvd', 'Ngày công văn đến'],
            ['SoCvDen', 'Số công văn đến'],
            ['NguonTiepNhan', 'Nguồn tiếp nhận'],
            ['NoiDungDon', 'Nội dung đơn']
        ];
        var missing = [];
        $.each(fields, function(_, item){
            var $input = $form.find('[name="' + item[0] + '"]').first();
            if (!$input.length || !$.trim(String($input.val() || ''))) {
                missing.push(item[1]);
                $input.addClass('vt-error');
                var $box = $input.closest('.wizard-field');
                if ($box.length && !$box.find('.vt-error-message').length) {
                    $box.append($('<div class="vt-error-message"></div>').text('Bắt buộc nhập ' + item[1].toLowerCase()));
                }
            }
        });
        var selected = false;
        for(var i=1;i<=19;i++){
            if($form.find('[name="RelatedField'+i+'"]').is(':checked')) {selected=true;break;}
        }
        if(!selected) missing.push('Ít nhất một lĩnh vực liên quan');
        if(missing.length){
            $('#vtValidationSummary').empty()
                .append($('<strong></strong>').text('Không thể lưu hoặc tiếp tục. Các trường bắt buộc chưa nhập:'))
                .append($('<div></div>').text(missing.join('; '))).show();
            $('html, body').animate({scrollTop:Math.max(0,$('#vtValidationSummary').offset().top-120)},200);
            return false;
        }
        return true;
    }
    function save(direction){
        if(busy||locked)return;
        toggleConditions();
        toggleRelatedOther();
        if(direction==='next'||direction==='finish'||direction==='draft'){
            // Áp dụng cùng validation cho Tiếp tục, Lưu nháp và Kết thúc.
            if(current===1 && !guardStep1Next())return false;
            if(!validateStep())return false;
            // Chặn thêm một lần ở cửa gửi AJAX cho cả Lưu nháp.
            if(current===1){
                var mustHave=['NgayBaoCao','NgayCvd','SoCvDen','NguonTiepNhan'];
                var missing=$.grep(mustHave,function(n){
                    return !$.trim(String($('#vanThuWizard [name="'+n+'"]').val()||''));
                });
                if(missing.length){
                    validateStep();
                    alert('Không thể lưu: còn thiếu Ngày báo cáo, Ngày công văn đến, Số công văn đến hoặc Nguồn tiếp nhận.');
                    return false;
                }
            }
        }
        busy=true;
        var data=$('#vanThuWizard').find('input[type=hidden]').serializeArray();
        data=data.concat($('.wizard-pane[data-pane="'+current+'"]').find(':input').serializeArray());
        data.push({name:'direction',value:direction});$('#wizardMessage').text('Đang lưu...');
        $.ajax({url:'@Url.Action("SaveData")',type:'POST',data:$.param(data),
          success:function(r){if(r&&r.ResponseCode>=0&&r.Id>0){window.location.href='@Url.Action("GetDocumentDetail")'+'?Id='+encodeURIComponent(r.Id);}else alert((r&&r.Description)||'Lưu không thành công');},
          error:function(){alert('Không thể kết nối máy chủ');},
          complete:function(){busy=false;$('#wizardMessage').text('');}
        });
    }
    $('#vanThuWizard').on('change','select,input[type=checkbox],input.wizard-date',function(){toggleConditions();});
    $('#field_NguonTiepNhan').on('change select2:select select2:clear', function(){
        toggleConditions();
        toggleRelatedOther();
        if (val('NguonTiepNhan')) {
            $(this).removeClass('vt-error');
            $(this).closest('.wizard-field').find('.vt-error-message').remove();
        }
    });
    $('#vanThuWizard').on('submit',function(e){e.preventDefault();});
    $('#wizardNext').off('click.vtRequired').on('click.vtRequired',function(e){
        e.preventDefault();
        // Nếu có script khác thay đổi biến current, vẫn dựa vào pane đang hiển thị.
        var stepFromForm=parseInt($('#Step').val(),10)||1;
        if(stepFromForm===1 && !guardStep1Next())return false;
        save('next');
        return false;
    });
    $('#wizardBack').on('click',function(){save('back');});
    $('#wizardDraft').on('click',function(){save('draft');});
    $('#wizardFinish').on('click',function(){if(confirm('Kết thúc và khóa hồ sơ?'))save('finish');});
    if(locked)$('#vanThuWizard :input').not('[type=hidden]').prop('disabled',true);
    render();
    $('#vanThuWizard').on('change','#field_RelatedField19',toggleRelatedOther);
    toggleRelatedOther();
})(jQuery);
</script>
