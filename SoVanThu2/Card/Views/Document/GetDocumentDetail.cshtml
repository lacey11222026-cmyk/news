@model DATA.ContentDB.VanThu
@using System

<style>
    .wizard-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 20px
    }

        .wizard-nav .btn {
            margin-bottom: 4px
        }

    .wizard-pane {
        display: none
    }

        .wizard-pane.active {
            display: block
        }

    .wizard-actions {
        margin-top: 20px;
        border-top: 1px solid #ddd;
        padding-top: 15px
    }

    .wizard-field {
        margin-bottom: 14px
    }

        .wizard-field label {
            display: block;
            font-weight: 600
        }

        .wizard-field .form-control {
            max-width: 100%
        }

    .wizard-step-description {
        margin: 8px 0 0;
    }

    .wizard-pane .box {
        margin-bottom: 0;
    }

    .wizard-pane .box-body {
        padding: 18px 15px 5px;
    }

    .wizard-actions {
        margin-top: 15px;
    }

    .vt-required-star {
        color: #dd4b39;
        font-weight: bold;
        margin-left: 3px;
    }

    .vt-related-grid {
        margin-top: 8px;
    }

    .vt-related-item {
        min-height: 32px;
        margin-bottom: 4px;
    }

        .vt-related-item label {
            display: inline-block;
            font-weight: normal;
            cursor: pointer;
            line-height: 1.5;
        }

        .vt-related-item input {
            vertical-align: middle;
            margin: 0 5px 2px 0;
        }

    .vt-related-other {
        margin-top: 8px;
    }

    .vt-error {
        border-color: #dd4b39 !important;
    }

    .vt-error-message {
        color: #dd4b39;
        font-size: 12px;
        margin-top: 4px;
    }

    #vtValidationSummary {
        display: none;
        margin-top: 12px;
    }

    .wizard-locked {
        opacity: .7
    }
</style>
<div class="container-fluid">
    <h3>Quản lý đơn thư — 7 bước</h3><div class="alert alert-info">Lưu nháp và Tiếp tục đều yêu cầu nhập đủ các trường bắt buộc của bước hiện tại. Hồ sơ kết thúc sẽ không cho sửa.</div>
    <form id="vanThuWizard" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" id="Id" name="Id" value="@Model.Id" /><input type="hidden" id="Step" name="Step" value="@(Model.Step ?? 1)" /><input type="hidden" id="IsCompleted" name="IsCompleted" value="@(Model.IsCompleted == true ? "true" : "false")" />

        <div class="wizard-nav">
            <button type="button" class="btn btn-default wizard-step-button" data-step="1">1. Thông tin đơn</button>
            <button type="button" class="btn btn-default wizard-step-button" data-step="2">2. Điều kiện xử lý</button>
            <button type="button" class="btn btn-default wizard-step-button" data-step="3">3. Thẩm quyền</button>
            <button type="button" class="btn btn-default wizard-step-button" data-step="4">4. Phân loại đơn</button>
            <button type="button" class="btn btn-default wizard-step-button" data-step="5">5. Kết quả xử lý chính</button>
            <button type="button" class="btn btn-default wizard-step-button" data-step="6">6. Kết quả giải quyết</button>
            <button type="button" class="btn btn-default wizard-step-button" data-step="7">7. Theo dõi, đôn đốc</button>
        </div>
        <section class="wizard-pane" data-pane="1">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">Bước 1 — Thông tin đơn</h3>
                    <p class="text-muted wizard-step-description">Thông tin tiếp nhận, người gửi, nội dung và lĩnh vực</p>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div class="col-md-6 wizard-field">
                            <label for="field_NgayBaoCao">Ngày báo cáo <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <input class="form-control wizard-date" id="field_NgayBaoCao" name="NgayBaoCao" type="text" placeholder="dd/MM/yyyy" value="@(Model.NgayBaoCao.HasValue ? Model.NgayBaoCao.Value.ToString("dd/MM/yyyy") : "")" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_NgayCvd">Ngày công văn đến <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <input class="form-control wizard-date" id="field_NgayCvd" name="NgayCvd" type="text" placeholder="dd/MM/yyyy" value="@(Model.NgayCvd.HasValue ? Model.NgayCvd.Value.ToString("dd/MM/yyyy") : "")" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_SoCvDen">Số công văn đến <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <input class="form-control" id="field_SoCvDen" name="SoCvDen" value="@Model.SoCvDen" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_NguonTiepNhan">Nguồn tiếp nhận <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <select class="form-control" id="field_NguonTiepNhan" name="NguonTiepNhan">
                                <option value="">-- Chọn nguồn tiếp nhận --</option>
                                <option value="1" @(Model.NguonTiepNhan == 1 ? "selected" : "")>1 - Nhận trực tiếp từ người viết đơn</option>
                                <option value="2" @(Model.NguonTiepNhan == 2 ? "selected" : "")>2 - Nơi khác chuyển đến</option>
                            </select>
                        </div>
                        <div class="col-md-6 wizard-field vt-conditional" data-condition="transfer" style="@(Model.NguonTiepNhan == 2 ? "" : "display:none;")">
                            <label for="field_TransferSource">Nơi chuyển đơn <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <input class="form-control" id="field_TransferSource" name="TransferSource" value="@Model.TransferSource" />
                        </div>
                        <div class="col-md-6 wizard-field vt-conditional" data-condition="transfer" style="@(Model.NguonTiepNhan == 2 ? "" : "display:none;")">
                            <label for="field_TransferSourceNo">Số phiếu chuyển đơn <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <input class="form-control" id="field_TransferSourceNo" name="TransferSourceNo" value="@Model.TransferSourceNo" />
                        </div>
                        <div class="col-md-6 wizard-field vt-conditional" data-condition="transfer" style="@(Model.NguonTiepNhan == 2 ? "" : "display:none;")">
                            <label for="field_TransferSourceDate">Ngày phiếu chuyển đơn</label>
                            <input class="form-control wizard-date" id="field_TransferSourceDate" name="TransferSourceDate" type="text" placeholder="dd/MM/yyyy" value="@(Model.TransferSourceDate.HasValue ? Model.TransferSourceDate.Value.ToString("dd/MM/yyyy") : "")" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_SoKyHieuVb">Số và ký hiệu văn bản</label>
                            <input class="form-control" id="field_SoKyHieuVb" name="SoKyHieuVb" value="@Model.SoKyHieuVb" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_CbDuocGiao">Cán bộ được giao giải quyết</label>
                            <input class="form-control" id="field_CbDuocGiao" name="CbDuocGiao" value="@Model.CbDuocGiao" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_TenNguoiGui">Tên người gửi đơn</label>
                            <input class="form-control" id="field_TenNguoiGui" name="TenNguoiGui" value="@Model.TenNguoiGui" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_Mst">Mã số thuế</label>
                            <input class="form-control" id="field_Mst" name="Mst" value="@Model.Mst" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_AffectedUnits">Phòng/Thuế cơ sở theo địa bàn bị KN/TC/PAKN (danh sách ID)</label>
                            <input class="form-control" id="field_AffectedUnits" name="AffectedUnits" value="@Model.AffectedUnits" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_NoiDungDon">Nội dung đơn <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <textarea class="form-control" id="field_NoiDungDon" name="NoiDungDon" rows="3">@Model.NoiDungDon</textarea>
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_DonDaCoBanAn">Đơn đã có bản án của Tòa</label>
                            <label style="font-weight:normal"><input type="checkbox" id="field_DonDaCoBanAn" name="DonDaCoBanAn" value="true" @(Model.DonDaCoBanAn == true ? "checked" : "") /> Có</label>
                        </div>
                        <div class="col-xs-12 wizard-field vt-related-fields">
                            <label>Đặc điểm/lĩnh vực liên quan <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <div class="row vt-related-grid">
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField1"><input type="checkbox" id="field_RelatedField1" name="RelatedField1" value="true" @(Model.RelatedField1 == true ? "checked" : "") /> 1. Chế độ/chính sách</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField2"><input type="checkbox" id="field_RelatedField2" name="RelatedField2" value="true" @(Model.RelatedField2 == true ? "checked" : "") /> 2. QĐ hành chính của CQT</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField3"><input type="checkbox" id="field_RelatedField3" name="RelatedField3" value="true" @(Model.RelatedField3 == true ? "checked" : "") /> 3. Hành vi HC của CBCC</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField4"><input type="checkbox" id="field_RelatedField4" name="RelatedField4" value="true" @(Model.RelatedField4 == true ? "checked" : "") /> 4. Tham nhũng.</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField5"><input type="checkbox" id="field_RelatedField5" name="RelatedField5" value="true" @(Model.RelatedField5 == true ? "checked" : "") /> 5. Tư pháp.</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField6"><input type="checkbox" id="field_RelatedField6" name="RelatedField6" value="true" @(Model.RelatedField6 == true ? "checked" : "") /> 6. Trốn thuế.</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField7"><input type="checkbox" id="field_RelatedField7" name="RelatedField7" value="true" @(Model.RelatedField7 == true ? "checked" : "") /> 7. Đảng/đoàn thể;</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField8"><input type="checkbox" id="field_RelatedField8" name="RelatedField8" value="true" @(Model.RelatedField8 == true ? "checked" : "") /> 8. Kiểm tra Thuế;</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField9"><input type="checkbox" id="field_RelatedField9" name="RelatedField9" value="true" @(Model.RelatedField9 == true ? "checked" : "") /> 9. Hoàn thuế</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField10"><input type="checkbox" id="field_RelatedField10" name="RelatedField10" value="true" @(Model.RelatedField10 == true ? "checked" : "") /> 10. Nợ thuế</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField11"><input type="checkbox" id="field_RelatedField11" name="RelatedField11" value="true" @(Model.RelatedField11 == true ? "checked" : "") /> 11. Đất đai.</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField12"><input type="checkbox" id="field_RelatedField12" name="RelatedField12" value="true" @(Model.RelatedField12 == true ? "checked" : "") /> 12. TNDN</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField13"><input type="checkbox" id="field_RelatedField13" name="RelatedField13" value="true" @(Model.RelatedField13 == true ? "checked" : "") /> 13. GTGT</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField14"><input type="checkbox" id="field_RelatedField14" name="RelatedField14" value="true" @(Model.RelatedField14 == true ? "checked" : "") /> 14. TNCN</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField15"><input type="checkbox" id="field_RelatedField15" name="RelatedField15" value="true" @(Model.RelatedField15 == true ? "checked" : "") /> 15. Hóa đơn</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField16"><input type="checkbox" id="field_RelatedField16" name="RelatedField16" value="true" @(Model.RelatedField16 == true ? "checked" : "") /> 16. Miễn giảm</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField17"><input type="checkbox" id="field_RelatedField17" name="RelatedField17" value="true" @(Model.RelatedField17 == true ? "checked" : "") /> 17. Khai khống TNCN</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField18"><input type="checkbox" id="field_RelatedField18" name="RelatedField18" value="true" @(Model.RelatedField18 == true ? "checked" : "") /> 18. Mạo danh thành lập DN</label>
                                </div>
                                <div class="col-xs-6 col-sm-4 col-md-3 vt-related-item">
                                    <label for="field_RelatedField19"><input type="checkbox" id="field_RelatedField19" name="RelatedField19" value="true" @(Model.RelatedField19 == true ? "checked" : "") /> 19. Khác.</label>
                                </div>
                            </div>
                            <div class="vt-error-message" id="vtRelatedError" style="display:none"></div>
                        </div>
                        <div class="col-xs-12 wizard-field vt-related-other" id="vtRelatedOther" style="display:none;">
                            <label for="field_RelatedFieldOtherText">Lĩnh vực khác (ghi rõ) <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <input class="form-control" id="field_RelatedFieldOtherText" name="RelatedFieldOtherText" value="@Model.RelatedFieldOtherText" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_CccdNguoiGuiDon">CCCD</label>
                            <input class="form-control" id="field_CccdNguoiGuiDon" name="CccdNguoiGuiDon" value="@Model.CccdNguoiGuiDon" />
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_NgayDonThu">Ngày ghi trên đơn</label>
                            <input class="form-control wizard-date" id="field_NgayDonThu" name="NgayDonThu" type="text" placeholder="dd/MM/yyyy" value="@(Model.NgayDonThu.HasValue ? Model.NgayDonThu.Value.ToString("dd/MM/yyyy") : "")" />
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="wizard-pane" data-pane="2">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">Bước 2 — Điều kiện xử lý</h3>
                    <p class="text-muted wizard-step-description">Đánh giá điều kiện xử lý, hình thức của đơn</p>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div class="col-md-6 wizard-field">
                            <label for="field_DieuKienXuLy">Kết quả đánh giá điều kiện <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <select class="form-control" id="field_DieuKienXuLy" name="DieuKienXuLy"><option value="">-- Chọn --</option><option value="1" @(Model.DieuKienXuLy == 1 ? "selected" : "")>Đủ điều kiện (DU)</option><option value="2" @(Model.DieuKienXuLy == 2 ? "selected" : "")>Không đủ điều kiện (KDU)</option><option value="3" @(Model.DieuKienXuLy == 3 ? "selected" : "")>Đơn trùng đã giải quyết (DONTRUNG)</option></select>
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_Kdk01">KĐK-01 — Không đáp ứng yêu cầu tại điểm a Khoản 2 TT05</label>
                            <label style="font-weight:normal"><input type="checkbox" id="field_Kdk01" name="Kdk01" value="true" @(Model.Kdk01 == true ? "checked" : "") /> Có</label>
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_Kdk02">KĐK-02 — Gửi nhiều cơ quan</label>
                            <label style="font-weight:normal"><input type="checkbox" id="field_Kdk02" name="Kdk02" value="true" @(Model.Kdk02 == true ? "checked" : "") /> Có</label>
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_Kdk03">KĐK-03 — Đơn Khiếu nại đã được hướng dẫn</label>
                            <label style="font-weight:normal"><input type="checkbox" id="field_Kdk03" name="Kdk03" value="true" @(Model.Kdk03 == true ? "checked" : "") /> Có</label>
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_Kdk04">KĐK-04 — Nội dung chống đối/xúc phạm</label>
                            <label style="font-weight:normal"><input type="checkbox" id="field_Kdk04" name="Kdk04" value="true" @(Model.Kdk04 == true ? "checked" : "") /> Có</label>
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_Kdk05">KĐK-05 — Đơn không thể đọc</label>
                            <label style="font-weight:normal"><input type="checkbox" id="field_Kdk05" name="Kdk05" value="true" @(Model.Kdk05 == true ? "checked" : "") /> Có</label>
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_GhiChuDieuKien">Ghi chú điều kiện</label>
                            <textarea class="form-control" id="field_GhiChuDieuKien" name="GhiChuDieuKien" rows="3">@Model.GhiChuDieuKien</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="wizard-pane" data-pane="3">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">Bước 3 — Thẩm quyền</h3>
                    <p class="text-muted wizard-step-description">Xác định thuộc hoặc không thuộc thẩm quyền</p>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div class="col-md-6 wizard-field">
                            <label for="field_ThamQuyenDon">Kết luận thẩm quyền đơn <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <select class="form-control" id="field_ThamQuyenDon" name="ThamQuyenDon"><option value="">-- Chọn --</option><option value="1" @(Model.ThamQuyenDon == 1 ? "selected" : "")>Thuộc thẩm quyền (TQ)</option><option value="2" @(Model.ThamQuyenDon == 2 ? "selected" : "")>Không thuộc thẩm quyền (KTQ)</option></select>
                        </div>
                        <div class="col-md-6 wizard-field">
                            <label for="field_GhiChuThamQuyen">Ghi chú thẩm quyền</label>
                            <textarea class="form-control" id="field_GhiChuThamQuyen" name="GhiChuThamQuyen" rows="3">@Model.GhiChuThamQuyen</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="wizard-pane" data-pane="4">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">Bước 4 — Phân loại đơn</h3>
                    <p class="text-muted wizard-step-description">Chọn loại đơn theo đúng nội dung đơn.</p>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div class="col-md-6 wizard-field">
                            <label for="field_LoaiDon">Loại đơn chính <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <select class="form-control" id="field_LoaiDon" name="LoaiDon"><option value="">-- Chọn --</option><option value="1" @(Model.LoaiDon == 1 ? "selected" : "")>Tố cáo (TC)</option><option value="2" @(Model.LoaiDon == 2 ? "selected" : "")>Khiếu nại (KN)</option><option value="3" @(Model.LoaiDon == 3 ? "selected" : "")>Kiến nghị, phản ánh (KNPA)</option><option value="4" @(Model.LoaiDon == 4 ? "selected" : "")>Đơn nhiều nội dung (NND)</option></select>
                        </div>
                        <div class="col-md-6 wizard-field vt-conditional" data-condition="tc">
                            <label for="field_PhanLoaiTc">Phân loại chi tiết tố cáo <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <select class="form-control" id="field_PhanLoaiTc" name="PhanLoaiTc"><option value="">-- Chọn --</option><option value="1" @(Model.PhanLoaiTc == 1 ? "selected" : "")>Tố cáo NNT</option><option value="2" @(Model.PhanLoaiTc == 2 ? "selected" : "")>Tố cáo CQT/CBT</option><option value="3" @(Model.PhanLoaiTc == 3 ? "selected" : "")>Tố cáo TC/CN khác</option></select>
                        </div>
                        <div class="col-md-6 wizard-field vt-conditional" data-condition="tc">
                            <label for="field_LanTc">Lần tố cáo <span class="vt-required-star" aria-hidden="true">*</span></label>
                            <select class="form-control" id="field_LanTc" name="LanTc"><option value="">-- Chọn --</option><option value="1" @(Model.LanTc == 1 ? "selected" : "")>Tố cáo lần đầu</option><option value="2" @(Model.LanTc == 2 ? "selected" : "")>Tố cáo tiếp</option></select>
                        </div>
