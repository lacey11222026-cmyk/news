@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model Album_FULL
@{
    List<CATEGORY_FULL> ListCate = ViewBag.CategoryList;
}

<div class="well">
    <span class="label label-danger">
        Chú ý!
    </span>
    <span>
        Hãy chắc chắn nhập vào đầy đủ thông tin tại các mục bắt buộc đánh dấu (*)
    </span>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-fw fa-user-md"></i><span>@ViewBag.Title </span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel panel-info">
                        @*<div id="Errordiv" style="margin:20px;color:red;font-size:13pt"><center></center></div><br />*@
                        @*<div class="panel-heading">
                                <h4 class="panel-title"><i class="fa fa-wrench" style="margin-right:7px"></i>Thông Tin Cơ Bản</h4>
                            </div>*@
                        <div style="padding: 10px 0 0 0;background-color:#fff !important">
                            <ul class="nav nav-tabs">
                                <li class="active"><a href="#tabs-info" data-toggle="tab"><strong>Thông tin chính</strong></a></li>
                                <li><a href="#tabs-image" data-toggle="tab"><strong>Ảnh</strong></a></li>
                                <li><a href="#tabs-product" data-toggle="tab"><strong>Sản phẩm</strong></a></li>

                            </ul>

                            <div class="tab-content" style="margin-top: 30px;">
                                <div class="col-md-12 tab-pane" id="tabs-product">
                                    @{Html.RenderAction("Reference", new { ids = Model.Param });}
                                </div>
                                <div class="col-md-12 tab-pane active" id="tabs-info">
                                    <!-- dành cho UpdateFunction -->
                                    <div class="form-group">
                                        <label for="txtTitle" class="control-label col-md-3">Tên  :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtTitle" name="title" value="@Model.Title" class="form-control" placeholder="Nhập tên" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtTitle" class="control-label col-md-3">Địa điểm :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtSummary" name="description" value="@Model.Description" class="form-control" placeholder="Nhập địa điểm" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtImgPath1" class="control-label col-md-3">Ảnh đại diện :<span class="required">*</span></label>
                                        <div class="col-md-6">
                                            <input type="text" id="txtImgPath" name="imgPath" value="@Model.CreatedBy" class="form-control" placeholder="Nhập ảnh" />
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtImgPath');"><i class="fa fa-file"></i></a>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none;">
                                        <label for="txtMainCate" class="control-label col-md-3">Chuyên Mục :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlMainCate">

                                                    @if (ListCate != null && ListCate.Count > 0)
                                                    {
                                                        foreach (var obj in ListCate)
                                                        {
                                                            <option value="@obj.Id" title="@obj.Pathway" @if (obj.Id == Model.CategoryId) { @Html.Raw("selected='selected'") ; }>@obj.Name</option>
                                                        }
                                                    }
                                                </select>

                                            </div>
                                        </div>
                                    </div>



                                    <div class="form-group">
                                        <label for="txtPublicTime" class="control-label col-md-3">Ngày xuất bản :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtPublicTime" data-format="DD/MM/YYYY HH:mm" name="publictime" value="@Model.PublishDate.GetValueOrDefault().ToString("dd/MM/yyyy HH:mm")" class="form-control" />

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none">
                                        <label for="ddlType" class="control-label col-md-3">Style hiển thị<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select id="ddlStyle" name="Type" class="form-control">
                                                    <option value="1" @(Model.Style == 1 ? "selected='selected'" : "")>Light Box</option>
                                                    <option value="2" @(Model.Style == 2 ? "selected='selected'" : "")>Gallery</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-3" for="cbxIsActive">Trạng thái :</label>
                                        <div class="col-md-4">
                                            <div class="checkbox">
                                                @if (Model.Status == 1)
                                                {<input type="checkbox" id="cbxIsActive" checked="checked" />}
                                                else
                                                {<input type="checkbox" id="cbxIsActive" />}

                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-12 tab-pane" id="tabs-image">

                                    <div class="form-group">
                                        <label for="txtImgPath2" class="control-label col-md-3">Ảnh 1 :<span class="required">*</span></label>
                                        <div class="col-md-6">
                                            <input type="text" id="txtImgPath1" name="imgPath1" value="@Model.ImageParam.Path1" class="form-control" placeholder="Nhập ảnh " />
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtImgPath1');"><i class="fa fa-file"></i></a>

                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtImgPath3" class="control-label col-md-3">Ảnh 2 :<span class="required">*</span></label>
                                        <div class="col-md-6">
                                            <input type="text" id="txtImgPath2" name="imgPath2" value="@Model.ImageParam.Path2" class="form-control" placeholder="Nhập ảnh" />
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtImgPath2');"><i class="fa fa-file"></i></a>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtImgPath4" class="control-label col-md-3">Ảnh 3 :<span class="required">*</span></label>
                                        <div class="col-md-6">
                                            <input type="text" id="txtImgPath3" name="imgPath3" value="@Model.ImageParam.Path3" class="form-control" placeholder="Nhập ảnh " />
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtImgPath3');"><i class="fa fa-file"></i></a>

                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtImgPath5" class="control-label col-md-3">Ảnh 4 :<span class="required">*</span></label>
                                        <div class="col-md-6">
                                            <input type="text" id="txtImgPath4" name="imgPath4" value="@Model.ImageParam.Path4" class="form-control" placeholder="Nhập ảnh" />
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtImgPath4');"><i class="fa fa-file"></i></a>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none">
                                        <label for="txtImgPath5" class="control-label col-md-3">Ảnh 5 :<span class="required">*</span></label>
                                        <div class="col-md-6">
                                            <input type="text" id="txtImgPath5" name="imgPath5" value="@Model.ImageParam.Path5" class="form-control" placeholder="Nhập ảnh" />
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtImgPath5');"><i class="fa fa-file"></i></a>

                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none">
                                        <label for="txtImgPath7" class="control-label col-md-3">Ảnh 7 :<span class="required">*</span></label>
                                        <div class="col-md-6">
                                            <input type="text" id="txtImgPath7" name="imgPath5" value="@Model.ImageParam.Path7" class="form-control" placeholder="Nhập ảnh" />
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtImgPath7');"><i class="fa fa-file"></i></a>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none">
                                        <label for="txtImgPath8" class="control-label col-md-3">Ảnh 8 :<span class="required">*</span></label>
