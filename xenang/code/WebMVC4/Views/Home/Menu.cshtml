@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<CATEGORY_FULL>
<li  class="menu-item menu-item-type-post_type menu-item-object-page"> <a href="/" class="nav-top-link">Trang chủ</a> </li>
@foreach (var item in Model.Select((value, i) => new { i, value }))
{

    <li id="menu-item-@(item.value.Id)" class="menu-item menu-item-type-post_type menu-item-object-page"> <a href="@item.value.Url" class="nav-top-link">@item.value.Name</a> </li>
}


