@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<CATEGORY_FULL>
@foreach (var item in Model.Where(x => x.ParentId == 0).Select((value, i) => new { i, value }))
{
    <li class="menu-item menu-item-type-taxonomy menu-item-object-product_cat menu-item-has-children  has-child" aria-expanded="false">
        <a href="@item.value.Url">@item.value.Name</a>@*<button class="toggle"><i class="icon-angle-down"></i></button>*@
        <ul class="sub-menu nav-sidebar-ul children">

            @foreach (var sub in Model.Where(x => x.ParentId == item.value.Id).Select((value, i) => new { i, value }))
            {
                <li class="menu-item menu-item-type-taxonomy menu-item-object-product_cat">
                    <a href="@sub.value.Url">
                        @sub.value.Name
                    </a>
                </li>
            }
            
        </ul>
    </li>
}

