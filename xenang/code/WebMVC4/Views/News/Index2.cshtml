@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>

@if (Model != null)
{
    /*active menu*/
    if (ViewBag.ParentCategoryId > 0)
    {
    <script type="text/javascript">
        var index = $('#ddtabs1 li').index($('#cate_' + '@ViewBag.ParentCategoryId'));
        ddtabmenu.definemenu("ddtabs1", index);

        setTimeout(function () {
            $("#ddtabs1 .current").parent().addClass("select");

        }, 1000);
    </script>
       
    }
    else
    {
    <script type="text/javascript">
        var index = $('#ddtabs1 li').index($('#cate_' + '@ViewBag.CurrentCategoryId'));

        ddtabmenu.definemenu("ddtabs1", index);
        setTimeout(function () {
            $("#ddtabs1 .current").parent().addClass("select");

        }, 1000);
    </script>
       
    }
    if (Model.Count > 0)
    {
        foreach (var item in Model.Select((value, i) => new { i, value }))
        {

            { Html.RenderAction("LastestNews", "News", new { CateName = item.value.Name, CategoryId = item.value.Id, MaxLastestNews = 5 }); }


        }


    }
    if (ViewBag.CurrentCategoryId == 11)
    {
        Html.RenderAction("LastestNews", "Album", new { CateName = "", CategoryId = 71, MaxLastestNews = 5 });
    }


}
