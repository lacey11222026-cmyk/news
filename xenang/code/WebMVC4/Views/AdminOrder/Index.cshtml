@{

    Layout = "~/Views/Shared/_AdminV2.cshtml";
    ViewBag.Title = "Danh Sách Đơn hàng";
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>Tìm Kiếm danh sách đơn hàng</div>
            <div class="panel-body">
                <div class="row" id="form">
                    <div class="col-md-12">

                        <div class="form-group col-md-4 col-xs-12 col-sm-6">
                            <label class="control-label text-info"><i class="fa fa-flag"></i>Trạng thái</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">

                                <select class="form-control" id="ddlActive">
                                    <option value="-1000">--Tất cả--</option>
                                    <option value="1">Đã giao hàng</option>
                                    <option value="0">Đã tạo đơn hàng</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group col-md-4 col-xs-12 col-sm-6">
                            <label for="txtKeyword" class="control-label text-info"><i class="fa fa-pencil"></i>Từ Khóa</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                                <input type="text" id="txt_filterbyname" class="form-control" placeholder="Nhập từ khóa">
                            </div>
                        </div>

                        <div class="form-group col-md-4 col-xs-12 col-sm-6" id="datetimepicker_FromDate">
                            <label class="control-label text-info"><i class="fa fa-calendar"></i>Từ Ngày</label>
                            <div class="col-xs-4 col-md-8 col-sm-8 col-xs-12">
                                <div class="date" id="datetimeFromDate">
                                    <input type="text" data-date-format="DD/MM/YYYY" id="fromDate" class="form-control" name="datetimeFromDate" />

                                </div>
                            </div>
                        </div>
                        <div class="form-group col-md-4 col-xs-12 col-sm-6" id="datetimepicker_ToDate">
                            <label class="control-label text-info"><i class="fa fa-calendar"></i>Đến Ngày</label>
                            <div class="col-xs-4 col-md-8 col-sm-8 col-xs-12">
                                <div class="date" id="datetimeToDate">
                                    <input type="text" data-date-format="DD/MM/YYYY" id="toDate" class="form-control" name="datetimeToDate" />

                                </div>
                            </div>
                        </div>


                        <div class="form-group submit" style="text-align: center">
                            <button type="button" id="btn_search" class="btn btn-info"><i class="fa fa-search"></i>Tìm Kiếm</button>
                            <button type="button" id="btn_export" class="btn btn-success"><i class="fa fa-file-excel-o"></i>Download</button>

                        </div>
                    </div>

                </div>
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListOrder">
                            @Html.Action("ListOrder", "AdminOrder", new { fromdate = ViewBag.fromDate.ToString("dd/MM/yyyy"), todate = ViewBag.toDate.ToString("dd/MM/yyyy") })
                        </div>
                        <div class="dataTables_paginate" id="pager">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .table-responsive {
        overflow-x: auto !important;
    }
</style>
<script type="text/javascript">

    $(document).ready(function () {
        $("#btn_export").click(function () {
            $("#dataTables").table2excel({
                exclude: ".noExl",
                name: "Order",
                filename: "Order",
                fileext: ".xls",
                exclude_img: true,
                exclude_links: true,
                exclude_inputs: true
            });
        });

        $('#datetimeFromDate').datetimepicker();
        $('#datetimeToDate').datetimepicker();

        var fromdate = '@string.Format("{0:dd/MM/yyyy HH:mm}", ViewBag.fromDate)';
        var todate = '@string.Format("{0:dd/MM/yyyy HH:mm}", ViewBag.toDate)';
        $('#datetimeFromDate').data("DateTimePicker").setDate(fromdate);
        $('#datetimeToDate').data("DateTimePicker").setDate(todate);

        $("#datetimeFromDate").on("dp.change dp.show", function (e) {
            $('#datetimeToDate').data("DateTimePicker").setMinDate(e.date);
        });
        $("#datetimeToDate").on("dp.change dp.show", function (e) {
            $('#datetimeFromDate').data("DateTimePicker").setMaxDate(e.date);
        });
        var parameters = {
        };
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btn_search").click();
            }
        });
        $("#btn_search").click(function () {
            GetList(1);
        });
        $("#select_filterbystatus").change(function () {
            GetList(1);
        });

        function GetList(currentPage) {
            parameters = {
                status: $('#select_filterbystatus :selected').val(),
                name: $("#txt_filterbyname").val(),
                fromdate: $("#fromDate").val(),
                todate: $("#toDate").val(),
                currentPage: currentPage
            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {

            var urlRequestAns = "/AdminOrder/ListOrder";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    $("#ListOrder").html(data);

                },

            });
        }

    });

</script>