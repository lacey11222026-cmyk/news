@using UTILS
@using DATA
@using WebMVC4.Helper
@model List<Product>
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr>
            <th>Mã </th>
            <th>Tên</th>
            <th>Chuyên mục</th>
            <th>Hãng</th>
            <th>Giá</th>
            <th>Giá cũ</th>
            <th>Trạng Thái</th>
            <th>Hot</th>
            <th>Chức Năng</th>
            <th>Sắp Xếp</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            <tr>
                <td>@obj.Id</td>
                <td style="text-align:left"><a href="@Url.Action("AddEdit", new { id = obj.Id })">@obj.Name</a></td>
                <td  style="text-align:left">@HtmlHelpers.GetNewsCategoryName(obj.CategoryId, ViewBag.CategoryList)</td>
                <td style="text-align:left">@HtmlHelpers.GetManuName(obj.ManufactoryId, ViewBag.ManuList)</td>
                <td>@Utils.InsertCommaNoStyle(obj.Price.ToString())</td>
                <td>@Utils.InsertCommaNoStyle(obj.PriceReal.ToString())</td>
                <td>
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatus(@obj.Id, 1);"><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatus(@obj.Id,0);"><i class="fa fa-ban"></i></a>

                    }
                </td>
                <td>
                    @if (obj.IsHot.GetValueOrDefault())
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hot" onclick="SetHot(@obj.Id, 1);"><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hot" onclick="SetHot(@obj.Id,0);"><i class="fa fa-ban"></i></a>

                    }
                </td>
                <td style="text-align: center">

                    <a href="@Url.Action("AddEdit", new { id = obj.Id })"><i class="fa fa-edit"></i></a>

                    <a href="javascript:;" title="Delete" onclick="DeleteData(@obj.Id)"><i class="fa fa-trash-o"></i></a>

                </td>
                <td>
                    <a href="javascript:;" onclick="UpdateSortOrder(@obj.Id,1)"><i class="fa fa-arrow-up"></i></a>

                    <a href="javascript:;" onclick="UpdateSortOrder(@obj.Id,0)"><i class="fa fa-arrow-down"></i></a>
                    <a href="javascript:;" onclick="UpdateSortOrderTop(@obj.Id)"><i class="fa fa-angle-double-up"></i></a>
                </td>



            </tr>
        }
    }
</table>
<script type="text/javascript">
       var PageOnSize = '@ViewBag.PageSize';
       var CurrentPage = '@ViewBag.CurrentPage';
        var Total = '@ViewBag.TotalRecord';


    function BindDataRequest(currentPage) {
            parameters = {
                status: $('#select_filterbystatus :selected').val(),
                lang: $('#select_language :selected').val(),
                categoryId: $('#select_category :selected').val(),
                manufactoryId: $('#select_manu :selected').val(),
                name: $("#txtKeyword").val(),
                currentPage: currentPage
            };
            var urlRequestAns = "/AdminProduct/ListProduct";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    $("#ListProduct").html(data);

                },

            });
        };
        $(document).ready(function () {

            $("#pager").pager({
                pagenumber: CurrentPage,
                pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
                buttonClickCallback: function (page) { BindDataRequest(page); }
            });


        });
        function UpdateSortOrder(Id, UpOrder) {
            var postdata = {
                Id: Id,
                SortOrder: UpOrder==1?true:false
            }

            $.ajax({
                type: 'POST',
                url: '/AdminProduct/UpdateSortOrder',
                data: postdata,
                //contentType: 'application/json; charset=utf-8',
               // dataType: 'json',
                //async: true,
                success: function (data) {

                    var msg = data.Msg;
                    if (data.ResponseCode >= 0) {
                        BindDataRequest(CurrentPage);
                    }
                    else {
                        alert(msg);
                    }
                }
            });
        }
        function UpdateSortOrderTop(Id) {
            var postdata = {
                Id: Id,
               
            }

            $.ajax({
                type: 'POST',
                url: '/AdminProduct/UpdateSortOrderTop',
                data: postdata,
                //contentType: 'application/json; charset=utf-8',
                // dataType: 'json',
                //async: true,
                success: function (data) {

                    var msg = data.Msg;
                    if (data.ResponseCode >= 0) {
                        BindDataRequest(CurrentPage);
                    }
                    else {
                        alert(msg);
                    }
                }
            });
        }
        function UpdateStatus(id, status) {
            var type = "Vô hiệu hóa";
            if (status == 0) {
                type = "Kích hoạt";
            }

            if (confirm("Bạn muốn " + type + " sản phẩm này ?")) {
                var postdata = {
                    'id': id,
                };
                $.ajax({
                    type: 'POST',
                    url: "/AdminProduct/UpdateStatus",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {

                        if (data.ResponseCode >= 0) {
                            alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            alert(data.Description);
                            return;
                        }
                    }
                });
            }
        }
        function SetHot(id, status) {
            var type = "Bỏ hot";
            if (status == 0) {
                type = "Set hot";
            }

            if (confirm("Bạn muốn " + type + " sản phẩm này ?")) {
                var postdata = {
                    'id': id,
                };
                $.ajax({
                    type: 'POST',
                    url: "/AdminProduct/Sethot",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {

                        if (data.ResponseCode >= 0) {
                            alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            alert(data.Description);
                            return;
                        }
                    }
                });
            }

        }
        function SetNew(id, status) {
            var type = "Bỏ set new";
            if (status == 0) {
                type = "Set new";
            }

            if (confirm("Bạn muốn " + type + " sản phẩm này ?")) {

                var postdata = {
                    'id': id,
                };
                $.ajax({
                    type: 'POST',
                    url: "/AdminProduct/SetNew",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {

                        if (data.ResponseCode >= 0) {
                            alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            alert(data.Description);
                            return;
                        }
                    }
                });

            }
        }



        function SetSell(id, status) {
            var type = "Bỏ mở bán";
            if (status == 0) {
                type = "Set mở bán";
            }

            if (confirm("Bạn muốn " + type + " sản phẩm này ?")) {
                var postdata = {
                    'id': id,
                };
                $.ajax({
                    type: 'POST',
                    url: "/AdminProduct/SetSell",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {

                        if (data.ResponseCode >= 0) {
                            alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            alert(data.Description);
                            return;
                        }
                    }
                });
            }


        }
        function DeleteData(id) {
            var IsDelete = "true";
            if (IsDelete != "true") {
                alert("Bạn không có quyền xóa ");
                return;
            }

            if (confirm("Bạn chắc chắn muốn xóa sản phẩm này ??? ")) {
                var postdata = {
                    'id': id,
                };
                $.ajax({
                    type: 'POST',
                    url: "/AdminProduct/Delete",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {

                        if (data.ResponseCode >= 0) {
                            alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            alert(data.Description);
                            return;
                        }
                    }
                });
            }


        }
</script>
<script>
    $("#qnmb").remove();
</script>