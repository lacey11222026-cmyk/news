@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
  
    <div style="padding: 0 10px;" class="box1 li-barright" id="HomeVideo">
        <div class="title2"><a href="@ViewBag.Url" class="opa">Phát biểu của lãnh đạo</a></div>
        @foreach (var item in Model.Select((value, i) => new { i, value }))
        {
            if (item.i == 0)
            {
                if (ViewBag.IsIpad || ViewBag.Iphone)
                {
            <video controls preload="auto"  name="myvideo" id="myvideo">
                <source src="@item.value.Url" type="video/mp4" />

            </video>

                }
                else
                {
            <div id="video_viewer">
            </div>
            <script src="/flash/jwplayer.js" type="text/javascript"></script>
                
            <script type="text/javascript">
                var url_homevideo = '@item.value.Url';
                var width_homevideo = $("#HomeVideo").width();
                var height_homevideo = width_homevideo * 3 / 4;
                jwplayer('video_viewer').setup({
                    'flashplayer': '/flash/player.swf',
                    'id': 'playerID',
                    'width': width_homevideo,
                    'height': height_homevideo,
                    'file': url_homevideo,
                    'image': '@item.value.MainImage.268.160.jpg',
                                //'plugins': { 'ova-jw': {} },
                                //'config': configadsvideo,
                                'abouttext': 'vtkmedia.vn',
                                'aboutlink': 'http://vtkmedia.vn',
                                //skin': '/flash/newsplayerskin.zip',
                                'autostart': 'false',
                            });
            </script>
                }
            }
        }
        <ul>
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                if (item.i < 2)
                {
                <li>
                    <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">@item.value.Title</a>
                </li>
                }
            }


        </ul>
    </div> 
    
}





