@using BIZ
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.CATEGORY_FULL

@if (Model != null)
{
    { Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.Id }); }
    <main id="main" class="">
        <div class="row category-page-row">
            <div class="large-3 col hide-for-medium ">
                @Html.Partial("Site_Right")
            </div><!-- large-3 -->
            <div class="col large-9">
                <div class="shop-container">
                    <div class="entry-detail NewsContent" id="NewsContent">

                        @Html.Raw(Model.Contents)

                    </div>
                </div>
            </div><!-- col-fit  -->


        </div>

    </main>


    if (ViewBag.IsMobile)
    {
        <script>
            $('#NewsContent table').removeAttr('width');

            $('#NewsContent  img').removeAttr('width');
        </script>
    }

    <script>
        $('#menu_@(Model.Id)').addClass('active');
    </script>
}



