        .on('error.form.bv', function (e) {
            // Active the panel element containing the first invalid element
            e.preventDefault();
            var $form = $(e.target),
                    validator = $form.data('bootstrapValidator');
            $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
            $(".alert-danger").css("display", "block");
            $(".close").click(function () {
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
        });

        function SaveData() {
            //var content = tinyMCE.get('txtIntro').getContent();

            var param = {
                'Id': '@Model.Id',
                'Name': $("#txtName").val(),
                'Price': $("#txtPrice").val(),
                'PriceReal': $("#txtPriceReal").val(),
                'Intro': CKEDITOR.instances['txtIntro'].getSnapshot(),
                'DescriptImage': $("#txtImgPath").val(),
                'Description': CKEDITOR.instances['txtDescription'].getSnapshot(),
                'CategoryId': $("#select_category").val(),
                'ManufactoryId': "0",
                'Language': $("#select_language").val(),
                'CategoryPathway': $("#select_category option:selected").attr('title'),
                'IsHot': $("#cbxIsHot").is(":checked") ? true : false,
                'IsNew': $("#cbxIsNew").is(":checked") ? true : false,
                'AvailableSell': $("#cbxAvailableSell ").is(":checked") ? true : false,
                'Status': $("#cbxIsActive1").is(":checked") ? 1 : 0,
                'Path1': $("#txtImgPath1").val(),
                'Path2': $("#txtImgPath2").val(),
                'Path3': $("#txtImgPath3").val(),
                'Path4': $("#txtImgPath4").val(),
                'Path5': $("#txtImgPath5").val(),
                'Path6': $("#txtImgPath6").val(),
                'Path7': $("#txtImgPath7").val(),
                'Path8': $("#txtImgPath8").val(),
                'Path9': $("#txtImgPath9").val(),
            }
            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "/AdminProduct/SaveData",
                data: addAntiForgeryToken(param),
                async: true,
                success: function (data) {

                    Utils.UnLoading();
                    if (data.ResponseCode >= 0) {
                        $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                        $(".alert-success").show("slow");
                        $(".alert-danger").hide("slow");
                        setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 500);

                    }
                    else {
                        $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                        $("#ErrorMessage").text(data.Description);
                        $(".alert-danger").show("slow");
                        $(".alert-success").hide("slow");
                        setTimeout(function () { $(".alert-danger").hide("slow"); }, 2000);
                    }
                }
            });
        }
    });
    function LoadManu(rvalue, cateid) {
        $.ajax({
            cache: false,
            type: "GET",
            url: "/AdminProduct/GetListManu?CategoryId=" + cateid,
            data: {},
            success: function (data) {
                $('#select_manu').html('');
                var html = '';
                $.each(data, function (id, item) {

                    if (rvalue == item.Id) {
                        html = '<option selected="selected" value="' + item.Id + '" title="' + item.Title + '">';
                    }
                    else {
                        html = '<option value="' + item.Id + '" title="' + item.Title + '">';
                    }


                    html += item.Title;
                    html += '</option>';

                    $('#select_manu').append(html);



                });
            },

        });
    }
    function LoadCate(rvalue, lang) {
        $.ajax({
            cache: false,
            type: "GET",
            url: "/AdminProduct/GetListCate?lang=" + lang,
            data: {},
            success: function (data) {
                $('#select_category').html('');
                var html = '';
                $.each(data, function (id, item) {

                    if (rvalue == item.Id) {
                        html = '<option selected="selected" value="' + item.Id + '" title="' + item.Pathway + '">';
                    }
                    else {
                        html = '<option value="' + item.Id + '" title="' + item.Pathway + '">';
                    }
                    if (item.NodeLevel != 0) {
                        for (var i = 1; i < item.NodeLevel; i++) {
                            html += '-+&nbsp;';
                        }
                    }

                    html += item.Name;
                    html += '</option>';

                    if (item.ParentId != 0) {
                        if ($('#select_category option[value=' + item.ParentId + ']').length)
                            $('#select_category option[value=' + item.ParentId + ']').after(html);
                        else
                            $('#select_category').append(html);
                    }
                    else
                        $('#select_category').append(html);


                });
                //LoadManu('@Model.ManufactoryId', rvalue)
            },

        });
    }
