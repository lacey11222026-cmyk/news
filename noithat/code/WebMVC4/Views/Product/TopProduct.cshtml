@using BIZ
@using UTILS
@using WebMVC4.Helper
@using WebMVC4.Models
@model ProductModel

@if (Model != null)
{
<h2 class="heading">
    
    <a href="@Model.Cate.Url"><span> @Model.Cate.Name.ToUpper()</span> </a>
    <ul class="hidden-xs">
        @if (Model.listmanu != null)
        {
            foreach (var item in Model.listmanu.Select((value, i) => new { i, value }))
            {
                <li >
                    <a href="@Model.Cate.Url?ManuId=@(item.value.ManufactoryId)">@item.value.ManufactoryName </a>

                </li>

            }
        }
        
    </ul>
</h2>
    <div class="row large-columns-5 medium-columns-3 small-columns-2 row-small">
        @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
        {
        <div class="product-small col has-hover post-@item.value.Id product type-product status-publish has-post-thumbnail product_cat-phu-kien-tu-tren product_cat-gia-bat-nang-ha instock sale shipping-taxable purchasable product-type-simple">
            <div class="col-inner">

                <div class="badge-container absolute left top z-1">
                    <div class="callout badge badge-circle"><div class="badge-inner secondary on-sale"><span class="onsale">-@(Utils.GetPromotion(item.value.Price, item.value.PriceReal))%</span></div></div>
                </div>
                <div class="product-small box ">
                    <div class="box-image">
                        <div class="image-zoom">
                            <a href="@UTILS.Utils.FormatUrlRewrite(item.value.Id,item.value.Name,"ProductDetail")">
                                <img width="300" height="300" src="@item.value.DescriptImage?h=300&w=300&mode=crop" class="attachment-woocommerce_thumbnail size-woocommerce_thumbnail" alt="" />
                            </a>
                        </div>
                        <div class="image-tools is-small top right show-on-hover">
                        </div>
                        <div class="image-tools is-small hide-for-small bottom left show-on-hover">
                        </div>
                        <div class="image-tools grid-tools text-center hide-for-small bottom hover-slide-in show-on-hover">
                        </div>
                    </div><!-- box-image -->

                    <div class="box-text box-text-products">
                        <div class="title-wrapper"><p class="name product-title"><a href="@UTILS.Utils.FormatUrlRewrite(item.value.Id,item.value.Name,"ProductDetail")">@item.value.Name</a></p></div>
                        <div class="price-wrapper">
                            <span class="price"><del><span class="woocommerce-Price-amount amount">@Utils.InsertCommaNoStyle(item.value.PriceReal.ToString())<span class="woocommerce-Price-currencySymbol">₫</span></span></del> <ins><span class="woocommerce-Price-amount amount">@Utils.InsertCommaNoStyle(item.value.Price.ToString())<span class="woocommerce-Price-currencySymbol">₫</span></span></ins></span>
                        </div>
                    </div><!-- box-text -->
                </div><!-- box -->



            </div><!-- .col-inner -->
        </div><!-- col -->
        }
    </div>


        }
        else
        {

        }
