@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<CATEGORY_FULL>
@if (Model != null)
{
    foreach (var item in Model.Select((value, i) => new { i, value }))
    {

        <li class=""><a href="@item.value.Url" title="@item.value.Name"><span class="nav-link-text">@item.value.Name</span></a></li>

    }
}
