@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<DATA.Product>


@if (Model != null)
{
    if (Model.Count >= 0)
    {

        foreach (var item in Model.Select((value, i) => new { i, value }))
        {


            <div class="slide-product owl-carousel-item">

                <div class="product-grid-item product product-no-swatches woodmart-hover-base  col-md-12 first  post-1437 type-product status-publish has-post-thumbnail product_cat-sofa first instock shipping-taxable purchasable product-type-simple" data-loop="1" data-id="1437">


                    <div class="product-wrapper">
                        <div class="content-product-imagin"></div>
                        <div class="product-element-top">
                            <a href="@UTILS.Utils.FormatUrlRewrite(item.value.Id,item.value.Name,"ProductDetail")" class="product-image-link">
                                <img width="300" height="300" src="@item.value.DescriptImage?h=300&w=300&mode=crop" class="attachment-woocommerce_thumbnail" alt="" />
                            </a>

                        </div>

                        <div class="product-information">
                            <h3 class="product-title"><a href="@UTILS.Utils.FormatUrlRewrite(item.value.Id,item.value.Name,"ProductDetail")">@item.value.Name</a></h3>               <div class="product-rating-price">
                                <div class="wrapp-product-price">

                                    <span class="price"><span class="woocommerce-Price-amount amount">@Utils.InsertCommaNoStyle(item.value.Price.ToString())</span></span>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>


        }



    }
}
