<script src="~/Content/js/formvalidate.js"></script>
<script type="text/javascript">

        function validateEmail() {
            if (!ValidateControls("@Resources.Order.EmailValidateEmpty", "#txtemail")) {
                return false;
            }
            var mail = $('#txtemail').val();
            if (!isValidEmailAddress(mail)) {

                $("#msgBox").html("@Resources.Order.EmailValidateFormat").show();

                $('#txtemail').focus();
                return false;
            }
            return true;
        }
        function validateMobile() {
            if (!ValidateControls("Vui lòng nhập số điện thoại", "#txtMobile")) {
                return false;
            }
            var mail = $('#txtMobile').val();

            return true;
        }

        function validateData() {
            if (!ValidateControls("@Resources.Order.FullNameEmpty", "#txtname")) {
                return false;
            }
            if (!validateEmail()) {
                return false;
            }
            if (!validateMobile()) {
                return false;
            }
            if (!ValidateControls("@Resources.Order.QuestionValidateEmpty", "#txtcontent")) {
                return false;
            }
            var postdata = {
                Name: $('#txtname').val(),
                Email: $('#txtemail').val(),
                Mobile: $('#txtMobile').val(),
                Question: $('#txtcontent').val()

            };
            $.ajax({
                type: "post",
                dataType: "html",
                url: '@Url.Action("Feedback", "Contact")',
                data: addAntiForgeryToken(postdata),
                success: function (response) {

                    var data = parseInt(response);
                    if (data == 1) {
                        $("#comment-form").hide();
                        $("#comment-result").show();
                        $('#txtname').val("");
                        $('#txtemail').val("");
                        $('#txtMobile').val("");
                        $('#txtcontent').val("");

                    }

                    if (data == -99) {
                        $("#msgBox").html("@Resources.Order.MessageError").show();

                    }
                    if (data == -4) {
                        $("#msgBox").html("@Resources.Order.MessageSoMuch").show();

                    }

                }
            });

            return true;
        }
</script>
