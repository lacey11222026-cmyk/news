@using UTILS
@using DATA

@model List<Order>
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>STT </th>
            <th>Mã </th>
            <th>Tên</th>
            <th>SDT</th>
            <th>Địa chỉ</th>
            <th>Ngày tạo</th>
            <th>Trạng Thái</th>
            <th class="noExl">Chuyển trạng thái</th>
            <th class="noExl">Quản trị</th>
            <th>Giá trị</th>
            <th>Phí vận chuyển</th>
            <th>Phí toàn bộ</th>
        </tr>
        @foreach (var obj in Model.Select((value, i) => new { i, value }))
        {
        <tr>
            <td>@(ViewBag.TotalRecord - (obj.i + (ViewBag.CurrentPage - 1) * ViewBag.PageSize))</td>
            <td><a href="@Url.Action("Info",new { id=obj.value.Id})">@obj.value.OrderNo</a></td>
            <td>@obj.value.FullName</td>
            <td>@obj.value.Mobile</td>
            <td>@obj.value.CustomerAddress</td>
            <td>@obj.value.CreatedTime.GetValueOrDefault().ToString("dd/MM/yyyy HH:mm:ss")</td>
            <td class="noExl">
                @if (obj.value.Status == 0)
                {
                <span>Đã tạo đơn hàng hàng</span>
                }
                else
                {
                <span>Đã giao hàng</span>
                }

            </td>

            <td style="text-align:center" class="noExl"> 


                @if (obj.value.Status == 0)
                {

                <a href="javascript:;" title="giao hàng" onclick="UpdateStatus(@obj.value.Id)">Chuyển đã giao hàng</a>
                }


            </td>

            <td class="noExl">
                @if (obj.value.Status == 0)
                {
                <text>&nbsp;&nbsp;&nbsp;</text><a href="javascript:;" title="xóa đơn hàng" onclick="DeleteData(@obj.value.Id)"><i class="fa fa-trash-o"></i></a>

                }


            </td>
            <td>@Utils.InsertCommaNoStyle(obj.value.OrderPrice.ToString())</td>
            <td>@Utils.InsertCommaNoStyle(obj.value.OrderTotalShipping.ToString())</td>
            <td>@Utils.InsertCommaNoStyle(obj.value.OrderTotal.ToString())</td>
        </tr>
        }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';

    $(document).ready(function () {

       

        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });



    });
    function BindDataRequest(currentPage) {
        parameters = {
            status: $('#select_filterbystatus :selected').val(),
            name: $("#txt_filterbyname").val(),
            fromdate: $("#fromDate").val(),
            todate: $("#toDate").val(),
            currentPage: currentPage
        };
        var urlRequestAns = "/AdminOrder/ListOrder";
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: parameters,
            success: function (data) {
                $("#ListOrder").html(data);

            },

        });
    };


    function UpdateStatus(id, status) {

        if (confirm("Bạn muốn chuyển trạng thái đơn hàng này ?")) {

            $.ajax({
                type: 'POST',
                url: "/AdminOrder/SaveData",
                data: {
                    'id': id
                },
                success: function (data) {

                    if (data.ResponseCode >= 0) {
                        alert(data.Description);
                        BindDataRequest(CurrentPage);
                    }
                    else {
                        alert(data.Description);
                        return;
                    }
                }
            });
        }


    }
    function DeleteData(id) {
        var IsDelete = "true";
        if (IsDelete != "true") {
            alert("Bạn không có quyền xóa ");
            return;
        }

        if (confirm("Bạn chắc chắn muốn xóa đơn hàng này ??? ")) {

            $.ajax({
                type: 'POST',
                url: "/AdminOrder/Delete",
                data: {
                    'id': id
                },
                success: function (data) {

                    if (data.ResponseCode >= 0) {
                        alert(data.Description);
                        BindDataRequest(CurrentPage);
                    }
                    else {
                        alert(data.Description);
                        return;
                    }
                }
            });
        }
        ;

    }
</script>
