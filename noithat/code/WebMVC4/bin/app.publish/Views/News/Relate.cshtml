@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
    <div class="tinkhac">
      
         
        
        <div class="title5"><a href="@{Utils.FormatUrlRewrite(ViewBag.CategoryId, ViewBag.CategoryTitle, "Articles");}?page=@ViewBag.PageNext">@ViewBag.HeaderTitle</a></div>
        <ul >

            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li><a class="frist_child" title="@item.value.Title" href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")">@item.value.Title </a>
                <span class="last_child">@item.value.PublishDate.ToString("dd/MM/yyyyy")</span></li>
            }


        </ul>
        @*@if (ViewBag.PageNextShow)
        {
            <div class="clear"></div><div class="xemtiep"><a class="opa" href="@{Utils.FormatUrlRewrite(ViewBag.CategoryId, ViewBag.CategoryTitle, "Articles");}?page=@ViewBag.PageNext">
                <img src="/images/xemtiep.jpg"></a></div>
        }*@

        <div class="clear"></div>

    </div>
   

    }


}