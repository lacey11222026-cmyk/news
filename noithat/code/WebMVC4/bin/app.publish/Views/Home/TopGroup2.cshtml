                        <div class="wpb_wrapper">
                            @foreach (var item in Model.Skip(2).Take(1).Select((value, i) => new { i, value }))
                            {
                                <div class="promo-banner-wrapper">
                                    <div id="wd-5ff3e1d46e196" class="promo-banner banner-vr-align-top banner-hr-align-left banner- banner-hover-zoom color-scheme-light banner-btn-size-default banner-btn-style-link  with-btn banner-btn-position-static cursor-pointer" onclick="window.location.href='@item.value.Url'">

