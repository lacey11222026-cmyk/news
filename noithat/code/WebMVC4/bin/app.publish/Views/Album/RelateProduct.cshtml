@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.Product_Full>


@if (Model != null)
{
    if (Model.Count > 0)
    {
        foreach (var item in Model.Select((value, i) => new { i, value }))
        {

            <li>
                <a href="@UTILS.Utils.FormatUrlRewrite(item.value.Id,item.value.Name,"ProductDetail")" title="@item.value.Name">
                    <img width="100" height="100" src="@item.value.DescriptImage?h=300&w=300&mode=crop" class="attachment-woocommerce_gallery_thumbnail size-woocommerce_gallery_thumbnail" alt="" srcset="https://eurokitstore.vn/wp-content/uploads/2018/09/gia-xong-noi-ch600-100x100.jpg 100w, https://eurokitstore.vn/wp-content/uploads/2018/09/gia-xong-noi-ch600-150x150.jpg 150w, https://eurokitstore.vn/wp-content/uploads/2018/09/gia-xong-noi-ch600-300x300.jpg 300w, https://eurokitstore.vn/wp-content/uploads/2018/09/gia-xong-noi-ch600-768x768.jpg 768w, https://eurokitstore.vn/wp-content/uploads/2018/09/gia-xong-noi-ch600-600x600.jpg 600w, https://eurokitstore.vn/wp-content/uploads/2018/09/gia-xong-noi-ch600.jpg 900w" sizes="(max-width: 100px) 100vw, 100px">		
                    <span class="product-title">@item.value.Name</span>
                </a>
                <del><span class="woocommerce-Price-amount amount">@Utils.InsertCommaNoStyle(item.value.PriceReal.ToString())<span class="woocommerce-Price-currencySymbol">₫</span></span></del> 
                <ins><span class="woocommerce-Price-amount amount">@Utils.InsertCommaNoStyle(item.value.PriceReal.ToString())<span class="woocommerce-Price-currencySymbol">₫</span></span></ins>
            </li>
        }
    }

}