@using DATA.ContentDB
@model List<Project2>
@using WebMVC4.Helper
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>STT </th>

            <th>Tên dự án </th>

            <th>Loại dự án</th>
            <th>Hạng mục</th>
            <th>Tổng vốn dự án</th>
            <th class="noExl">Thời gian tạo</th>


            <th>Quản trị</th>


        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>
                <td>@(i + 1)</td>

                <td align="left" class="texttable"><div style="min-width:168px"><a href="@Url.Action("AddProject",new { id=obj.Id})">@obj.Name</a></div></td>

                <td>@HtmlHelpers.UserProjectType(obj.Type)</td>
                <td>@HtmlHelpers.UserProjectSubType(obj.SubType, obj.Type)</td>
                @if (obj.Type == 1)
                {
                    <td>@obj.Total</td>
                }
                else
                {
                    <td>@obj.Total @obj.Currency</td>
                }
                <td class="noExl">@obj.CreateTime.ToString("dd/MM/yyyy HH:mm")</td>
                <td style="text-align:center">



                    <a href="@Url.Action("AddProject",new { id=obj.Id})"><i class="fa fa-edit"></i></a>



                    <a href="javascript:;" title="Delete" onclick="DeleteData(@obj.Id)"><i class="fa fa-trash-o"></i></a>

                </td>



            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        key = '@ViewBag.key';
        var params = {
            status: $('#ddlActive :selected').val(),
            type: $('#ddlType :selected').val(),
            title: $("#txtTitle").val(),
            lang: $('#ddlCate :selected').val(),
            fromdate: $("#fromDate").val(),
            endDate: $("#toDate").val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = "/AdminProject/ListProject";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListProject").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });
    function UpdateSortOrder(Id, UpOrder) {
        var param = {
            Id: Id,
            SortOrder: UpOrder
        }
        $.ajax({
            type: 'POST',
            url: '/AdminProject/UpdateSortOrder',
            data: JSON.stringify(param),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: true,
            success: function (data) {
                Utils.UnLoading();
                var msg = data.Msg;
                if (data.ResponseCode > 0) {
                    BindDataRequest(CurrentPage);
                }
                else {
                    bootbox.alert(msg);
                }
            }
        });
    }

    function DeleteData(id) {
        var IsDelete = "true"
        if (IsDelete != "true") {
            bootbox.alert("Bạn không có quyền xóa ");
            return;
        }
        bootbox.confirm("Bạn chắc chắn muốn xóa trang này ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/AdminProject/Delete",
                    data: {
                        'id': id
                    },
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
</script>
