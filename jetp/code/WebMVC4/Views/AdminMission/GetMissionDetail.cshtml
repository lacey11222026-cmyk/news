@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model MISSION_FULL

<div class="well">
    <span class="label label-danger">
        Chú ý!
    </span>
    <span>
        Hãy chắc chắn nhập vào đầy đủ thông tin tại các mục bắt buộc đánh dấu (*)
    </span>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-fw fa-user-md"></i><span>@ViewBag.Title </span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel panel-info">
                        <div id="Errordiv" style="margin:20px;color:red;font-size:13pt"><center></center></div><br />
                        @*<div class="panel-heading">
                                <h4 class="panel-title"><i class="fa fa-wrench" style="margin-right:7px"></i>Thông Tin Cơ Bản</h4>
                            </div>*@
                        <div style="padding: 10px 0 0 0;background-color:#fff !important">

                            <div class="col-md-12">
                                <div>
                                    <!-- dành cho UpdateFunction -->
                                    <div class="form-group">
                                        <label for="txtTitle" class="control-label col-md-3">Tên :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtTitle" name="title" value="@Model.Name" class="form-control" placeholder="Nhập tên" />
                                            </div>
                                        </div>
                                    </div>


                                    <div class="form-group" style="display:none">
                                        <label for="ddlCreatedBy" class="control-label col-md-3">Ảnh đại diện :<span class="required">*</span></label>
                                        <div class="col-md-8">
                                            <div class="input-icon right">
                                                <input type="text" id="ddlCreatedBy" name="title" value="@Model.CreatedBy" class="form-control" placeholder="" />


                                            </div>
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('ddlCreatedBy');"><i class="fa fa-file"></i></a>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="txtCode" class="control-label col-md-3">Ngôn ngữ  :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlLanguage">

                                                    <option value="vi-vn" @(Model.Code == "vi-vn" ? "selected='selected'" : "")>Tiếng Việt</option>

                                                    <option value="en-us" @(Model.Code == "en-us" ? "selected='selected'" : "")>Tiếng Anh</option>
                                                </select>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtMainCate" class="control-label col-md-3">Thứ tự :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtCategoryId" name="categroy" value="@Model.CategoryId" class="form-control" placeholder="Nhập thứ tự" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtMainCate" class="control-label col-md-3">Câu hỏi :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtSummary" style="height: 100px;" cols="20" name="description" class="form-control">@Model.Description</textarea>

                                            </div>
                                        </div>
                                    </div>


                                    <div class="form-group">

                                        <label for="txtMainCate" class="control-label col-md-3">Câu trả lời :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtOrgan" name="content">@Html.Raw(Model.Organ)</textarea>
                                               
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group" style="display:none">
                                        <label for="txtPublicTime" class="control-label col-md-3">Thời gian :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtPublicTime" data-date-format="DD/MM/YYYY" name="publictime" value="@HtmlHelpers.GetDateDocument(Model.PublishDate)" class="form-control" />

                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group" style="display:none ">
                                        <label for="txtPublicTime" class="control-label col-md-3">Thời gian (bắt đầu) :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtFromDate" name="publictime" value="@Model.FromDate" class="form-control" />

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none ">
                                        <label for="txtPublicTime" class="control-label col-md-3">Thời gian (kết thúc) :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtToDate" name="publictime" value="@Model.ToDate" class="form-control" />

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none ">
                                        <label for="ddlAccept" class="control-label col-md-3">Tình trạng nghiệm thu :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlAccept">

                                                    <option value="1" @(Model.Accept == 1 ? "selected='selected'" : "")>Đã nghiệm thu</option>

                                                    <option value="0" @(Model.Accept == 0 ? "selected='selected'" : "")>Chưa nghiệm thu</option>
                                                </select>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none ">
                                        <label for="ddlResult" class="control-label col-md-3">Kết quả nghiệm thu :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlResult">

                                                    <option value="1" @(Model.Result == 1 ? "selected='selected'" : "")>Đạt</option>

                                                    <option value="0" @(Model.Result == 0 ? "selected='selected'" : "")>Chưa đạt</option>

                                                    <option value="2" @(Model.Result == 2 ? "selected='selected'" : "")>Chưa nghiệm thu</option>
                                                </select>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none ">
                                        <label for="txtDescription" class="control-label col-md-3">Kết quả thực hiện :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtDescription" style="height: 100px;" cols="20" name="description" class="form-control">@Model.Description</textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-3" for="cbxIsActive">Trạng thái :</label>
                                        <div class="col-md-4">
                                            <div class="checkbox">
                                                @if (Model.Status == 1)
                                                {<input type="checkbox" id="cbxIsActive" checked="checked" />}
                                                else
                                                {<input type="checkbox" id="cbxIsActive" />}

                                            </div>
                                        </div>
                                    </div>

                                    <div class="panel-footer form-horizontal">
                                        <div class="form-group submit">


                                            <button type="submit" class="btn btn-primary" id="btsubmit"><i class="fa fa-save"></i>Lưu lại</button>
                                            <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage();"><i class="fa fa-backward"></i>Quay lại</button>
                                        </div>
                                    </div>



                                </div>
                            </div>
                            <div style="clear:both"></div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    $('#menu_mision').addClass("active");

</script>
<script>
    function GotoListpage() {
        window.location = '@Url.Action("Index")';
    }
    $(document).ready(function () {

       
        var editor = CKEDITOR.instances['txtOrgan'];
        if (editor) {
            CKEDITOR.remove(editor);
        }
        CKEDITOR.replace('txtOrgan', {
            filebrowserBrowseUrl: "/AdminImages/ManageImage",
            filebrowserWindowWidth: '1000',
            filebrowserWindowHeight: '300',
            uiColor: '#FAFAFA',
            allowedContent: true,
            extraAllowedContent: '*(*)',
            // ALLOW <i></i>

            //extraAllowedContent: 'p(*)[*]{*};div(*)[*]{*};li(*)[*]{*};ul(*)[*]{*}',
           
            height: 300
        });

        $('#txtPublicTime').datetimepicker({
            //pickTime: false
        });
        $("button.close").click(function () {
            $(this).parent().css("display", "none");
        });
        $('#defaultForm').bootstrapValidator({
            message: 'This value is not valid',
            //live: 'submitted',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {

                title: {
                    message: 'Nhập tên ',
                    validators: {
                        notEmpty: {
                            message: 'tên không được bỏ trống'
                        },

                        

                    }
                },

                publictime: {
                    message: 'Bạn chưa nhập thời gian.',
                    validators: {
                        notEmpty: {
                            message: 'Bạn chưa nhập thời gian'
                        },

                    }
                },


            }
        })
        .on('success.form.bv', function (e) {
            // Prevent submit form
            e.preventDefault();

            var $form = $(e.target),
                validator = $form.data('bootstrapValidator');
            SaveData();
            $(".close").click(function () {
                $(".alert-success").css("display", "none");
            });
        })
        .on('error.form.bv', function (e) {
            // Active the panel element containing the first invalid element
            e.preventDefault();
            var $form = $(e.target),
            validator = $form.data('bootstrapValidator');
            $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
            $(".alert-danger").css("display", "block");
            $(".close").click(function () {
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
        });

        $("#btnReset").click(function () {
            $('#defaultForm').data('bootstrapValidator').resetForm(true);
            $(".alert-danger").css("display", "none");
            $(".alert-success").css("display", "none");
        });

        //Save Data
        function SaveData() {
            var param = {
                'Id': '@Model.Id',
                'Name': $("#txtTitle").val(),
                'Description': $("#txtSummary").val(),
                'Organ': CKEDITOR.instances['txtOrgan'].getSnapshot(),
                'CategoryId': $("#txtCategoryId").val(),
                'CreatedBy': $("#ddlCreatedBy").val(),
                'Code': $("#ddlLanguage").val(),
                'Result': $("#ddlResult").val(),
                'Accept': $("#ddlAccept").val(),
                'FromDate': $("#txtFromDate").val(),
                'ToDate': $("#txtToDate").val(),
                'SPublishDate': $('#txtPublicTime').val(),
                'Status': $("#cbxIsActive").is(":checked") ? 1 : 0

            }
            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "@Url.Action("SaveData")",
                data: addAntiForgeryToken(param),
            async: true,
            success: function (data) {
                Utils.UnLoading();
                if (data.ResponseCode >= 0) {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $(".alert-success").show("slow");
                    $(".alert-danger").hide("slow");
                    setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 500);

                }
                else {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $("#ErrorMessage").text(data.Description);
                    $(".alert-danger").show("slow");
                    $(".alert-success").hide("slow");
                    setTimeout(function () { $(".alert-danger").hide("slow"); }, 2000);
                }
            }
        });
    };
    });
</script>
<style>
    .input-icon {
        position: relative;
        width: 100%;
    }
</style>