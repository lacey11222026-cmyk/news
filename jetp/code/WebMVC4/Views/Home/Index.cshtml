                        <div class="mt20 text-center"><a href="/du-an/" class="btn-gradient">More</a></div>
                    </div>
                </div>
            </div>
            <div class="pt70 pb70 section-home-3-2">
                @{Html.RenderAction("Intro", "Home", new { CategoryId = 101 });}
