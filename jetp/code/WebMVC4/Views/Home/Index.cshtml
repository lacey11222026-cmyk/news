<script>
    function searchproject() {
        var status = $('#ddlStatus').val();
        var type = $('#ddlType').val()
        var keyword = $('#txtName').val();
        window.location = '/du-an/?keyword=' + keyword + '&systemtype=' + type;
    }
</script>
<style>
    @@media (min-width: 991px) {


        .banner .swiper .swiper-wrapper .swiper-slide .item h2 {
            font-size: 2.5rem;
        }
    }
</style>