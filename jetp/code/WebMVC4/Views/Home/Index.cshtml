                                        <option value="5">Sử dụng năng lượng hiệu quả</option>
                                        <option value="6">Chuyển đổi năng lượng trong lĩnh vực giao thông vận tải</option>
                                        <option value="7">Đổi mới, phát triển và chuyển giao công nghệ</option>*@
                                    @*<option value="8">Đảm bảo quá trình chuyển đổi công bằng</option>*@
                                </select>
                            </div>
                            @*<div class="item">
                                    <select name="status" id="ddlStatus">
                                        <option value="1">Đang triển khai</option>
                                        <option value="3">Hoàn thành</option>
                                        <option value="2">Đang chờ duyệt</option>
                                    </select>
                                </div>*@
                            <div class="item">
                                <input type="text" name="project_name" id="txtName" placeholder="Tìm dự án theo tên">
                            </div>
                            <button type="button" class="btn-cm btn-blue" onclick="return searchproject();">
