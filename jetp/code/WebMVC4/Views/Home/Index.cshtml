            </div>
        </div>
    </section>
    <section class="section-home-4">
        @{Html.RenderAction("Intro", "Home", new { CategoryId = 100 });}
    </section>
    <section class="section-home-5 pt70 pb70">
        @{Html.RenderAction("LastestNews2", "Home", new { CateName = "", CategoryId = 69, MaxLastestNews = 3, cssClass = "maxheight02", lang = langpage });}
