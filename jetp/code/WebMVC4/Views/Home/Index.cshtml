                                        <option value="4">Power transmission and energy storage</option>
                                        <option value="5">Energy efficiency use </option>
                                        <option value="6">Energy transition in the transportation sector</option>
                                        <option value="7">Innovation, development and technology transfer</option>
                                        <option value="8">Ensuring a just transition</option>*@
                                </select>
                            </div>
                            @*<div class="item">
                                    <select name="status" id="ddlStatus">
                                        <option value="1">In Progress</option>
                                        <option value="3">Completed</option>
                                        <option value="2">Pending approval </option>
                                    </select>
                                </div>*@
                            <div class="item">
                                <input type="text" name="project_name" id="txtName" placeholder="Search project by name ">
                            </div>
                            <button type="button" class="btn-cm btn-blue" onclick="return searchproject();">
                                <i class="icon-search"></i>
                                <span>Search</span>
                            </button>
