                                <select name="priority" id="ddlType">
                                    <option value="1">Dự án đầu tư có cấu phần xây dựng</option>
                                    <option value="2">
                                        Dự án hỗ trợ kỹ thuật
                                    </option>
                                    @*<option value="3">Phát triển ngành năng lượng tái tạo</option>
