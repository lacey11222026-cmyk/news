@model List<DATA.Banner>

@using WebMVC4.Helper
@{
    var langpage = WorkContext.GetLanguage();
}


@if (Model != null)
{
    foreach (var item in Model.Select((value, i) => new { i, value }))
    {
        if (langpage == "vi-vn")
        {
            <li><a href="@item.value.Url"><img src="@item.value.Data" alt=""></a></li>
        }
        else
        {
            <li><a href="@item.value.Url"><img src="@item.value.Description" alt=""></a></li>
        }

    }

}
