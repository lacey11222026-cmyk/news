@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.News2Model

@{
    var langpage = WorkContext.GetLanguage();
}
<div class="section-news">
    <section class="section-intro-1" style="background-image: url('@ViewBag.CateImg');">
        <div class="container">
            <div class="content">
                <div class="title">
                    <h1>@ViewBag.CateName</h1>
                    <div class="breadcrumbs-02">
                        <ul>
                            <li><a href="/">@Resources.Global.Home</a></li>
                            <li><span>@ViewBag.CateName</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="section-news-2 mt50 pb100">
        <div class="container">
            <div class="content">
                @if (Model.articles != null)
                {
                    if (Model.articles.Count > 0)
                    {
                        <div class="news-list">
                            @foreach (var item in Model.articles.Select((value, i) => new { i, value }))
                            {
                                <div>
                                    <div class="news-item">
                                        <a href="@item.value.LinkUrl" class="picture"><img src="@item.value.MainImage?w=372&h=248&mode=crop"></a>
                                        <div class="desc">
                                            <div class="v-card">
                                                <div class="time-read">
                                                    <i class="fa-regular fa-clock"></i>
                                                    <span>@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                            <h3><a href="@item.value.LinkUrl">@item.value.Title</a></h3>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <nav data-aos="fade-up" aria-label="navigation" class="navigation-nav aos-init mt50">
                            <ul class="pagination page-numbers">
                                @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                                    {
                                        PageUrl = Url.SetParameter("Page", "!0"),
                                        CurrentPage = ViewBag.Page,
                                        PageSize = ViewBag.PageSize,
                                        TotalItemCount = ViewBag.Total,
                                    }); }
                              
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </section>
</div>


