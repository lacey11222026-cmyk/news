@using DATA.ContentDB
@model UserProjectFull

@using WebMVC4.Helper
<div class="row" id="ContentPopUp">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="tbl-wrap" style="border:none;">

                <table>
                    <tbody>
                        <tr>
                            <th>1. Tên dự án</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th>2. Địa điểm dự án</th>
                            <td>@Model.Location</td>
                        </tr>
                        <tr>
                            <th>3. Hạng mục dự án</th>
                            <td>@HtmlHelpers.UserProjectSubType(Model.SubType, Model.Type)</td>
                        </tr>
                        <tr>
                            <th>4. Hỗ trợ Dự án đầu tư có cấu phần xây dựng nào</th>
                            <td>@Model.ProjectConfig.Support</td>
                        </tr>
                        <tr>
                            <th>5. Đơn vị đăng ký đề xuất</th>
                            <td>@Model.Unit</td>
                        </tr>
                        <tr>
                            <th>6. Thông tin liên lạc của đại diện đơn vị ký đề xuất </th>
                            <td>
                                @Model.ProjectConfig.Fullname<br />
                                @Model.ProjectConfig.Role<br />
                                @Model.ProjectConfig.Email<br />
                                @Model.ProjectConfig.Mobile
                            </td>
                        </tr>
                        <tr>
                            <th>7. Chủ dự án</th>
                            <td>
                                <div class="show-txt">
                                    <p>
                                        @Html.Raw(Model.Organ.Replace("\n", "<br>"))
                                    </p>
                                    <a href="#" class="btn-orange">Xem thêm</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>8. Cơ quan chủ quản</th>
                            <td>
                                <p>
                                    @Html.Raw(Model.ProjectConfig.UnitDev)
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <th>9. Tổng vốn dự án</th>
                            <td>@Model.Total @Model.Currency</td>
                        </tr>
                        <tr>
                            <th>10. Ngân sách chi tiết</th>
                            <td>
                                <div class="show-txt">
                                    <p>
                                        @Html.Raw(Model.Detail.Replace("\n", "<br>"))
                                    </p>
                                    <a href="#" class="btn-orange">Xem thêm</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>11. Nguồn vốn</th>
                            <td>
                                <div class="show-txt">
                                    <p>
                                        @Html.Raw(Model.Source.Replace("\n", "<br>"))
                                    </p>
                                    <a href="#" class="btn-orange">Xem thêm</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>12. Tiến độ dự án</th>
                            <td>@HtmlHelpers.UserProjectProgress2(Model.Progress)</td>
                        </tr>
                        <tr>
                            <th>13. Thời gian thực hiện</th>
                            <td>@Model.ProjectConfig.Time</td>
                        </tr>
                        <tr>
                            <th>13. Hiện trạng pháp lý của dự án </th>
                            <td>
                                <div class="show-txt">
                                    <p>
                                        @Html.Raw(Model.LegalStatus.Replace("\n", "<br>"))
                                    </p>
                                    <a href="#" class="btn-orange">Xem thêm</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>14. Mô tả ngắn gọn dự án và mục tiêu dự án </th>
                            <td>
                                <div class="show-txt">

                                    <p>
                                        @Html.Raw(Model.Detail.Replace("\n", "<br>"))
                                    </p>
                                    <a href="#" class="btn-orange">Xem thêm</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>15. Tác động dự kiến dự án tạo ra</th>
                            <td>
                                <div class="show-txt">

                                    <p>
                                        @Html.Raw(Model.Impact.Replace("\n", "<br>"))
                                    </p>
                                    <a href="#" class="btn-orange">Xem thêm</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>16. Đáp ứng 4 nguyên tắc chung của JETP: </th>
                            <td></td>
                        </tr>
                        <tr>
                            <th>16.1 Nguyên tắc chung 1</th>
                            <td>
                                <div class="show-txt">
                                    <p>
                                        @Html.Raw(Model.Rule1.Replace("\n", "<br>"))
                                    </p>
                                    <a href="#" class="btn-orange">Xem thêm</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>16.2 Nguyên tắc chung 2</th>
                            <td>
                                <div class="show-txt">
                                    <p>
                                        @Html.Raw(Model.Rule2.Replace("\n", "<br>"))
                                    </p>
                                    <a href="#" class="btn-orange">Xem thêm</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>16.3 Nguyên tắc chung 3</th>
                            <td>
                                <div class="show-txt">
                                    <p>
                                        @Html.Raw(Model.Rule3.Replace("\n", "<br>"))
                                    </p>
                                    <a href="#" class="btn-orange">Xem thêm</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>16.4 Nguyên tắc chung 4</th>
                            <td>
                                <div class="show-txt">
                                    <p>
                                        @Html.Raw(Model.Rule4.Replace("\n", "<br>"))
                                    </p>
                                    <a href="#" class="btn-orange">Xem thêm</a>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th>17. Tài liệu dự án</th>
                            <td>
                                @Html.Raw(Model.Document.Replace("\n", "<br>"))
                            </td>
                        </tr>

                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<style>
    .modal-dialog {
        width: 86%;
    }

    .tbl-wrap {
        margin: 10px 0 10px 0;
        padding: 10px 0;
        border-top: 2px solid #1f5ecb;
        border-bottom: 2px solid #1f5ecb;
    }

        .tbl-wrap table,
        .tbl-wrap table tr,
        .tbl-wrap table th,
        .tbl-wrap table td {
            border-collapse: collapse;
            padding: 10px;
        }

            .tbl-wrap table tr:nth-child(even) {
                background-color: #f0f0f0;
            }

            .tbl-wrap table th {
                font-size: 15px;
                font-weight: bold;
                color: #1f5ecb;
                width: 33%;
            }

            .tbl-wrap table td {
                font-size: 15px;
            }

    .btn-orange {
        font-size: 14px;
        color: #ec8000;
        font-style: italic;
        text-decoration: underline;
        font-weight: 500;
        display: inline-block;
    }
</style>

<script>
    $(document).ready(function () {
        $('.btn-orange').click(function (e) {
            e.preventDefault();
            var paragraph = $(this).siblings('p');
            if (paragraph.hasClass('expanded')) {
                paragraph.removeClass('expanded');
                $(this).text('Xem thêm');
            } else {
                paragraph.addClass('expanded');
                $(this).text('Ẩn bớt');
            }
        });
    });
    $('.show-txt').each(function (index, element) {
        // index: vị trí của phần tử trong danh sách
        // element: phần tử DOM hiện tại
        // $(this): phần tử hiện tại được bọc trong jQuery
        if ($(this).height() < 80) {
            $(this).addClass("show-txt show-txt1");
        }
    });
</script>
<style>
    .show-txt1 .btn-orange {
        display: none
    }
</style>