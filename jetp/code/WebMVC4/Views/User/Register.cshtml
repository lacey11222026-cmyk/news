<!-- Modal -->
<div class="modal fade" id="modalComplete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"> <span aria-hidden="true">&times;</span> </button>
            <div class="modal-body">
                <h4 class="text-center">Đăng ký tài khoản thành công</h4>
                <p class="text-center mt20">Email xác nhận tài khoản đã được gửi tới email của bạn.<br> Vui lòng kiểm tra email để hoàn tất đăng ký tài khoản</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cm btn-blue font-weight-bold" data-dismiss="modal" aria-label="Close">OK</button>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/js/formvalidate.js?vs=02"></script>

<script>

    function goLogin() {
       window.location.href = "@Url.Action("Login")"
    }

    function goStep1() {
        $('#step2').hide();
        $('#step1').show();
    }
    function validatePhone() {
        if (!ValidateControls("Vui lòng nhập số điện thoại !", "#phone", "#phone-er")) {
            return false;
        }

        var phone = $('#phone').val();

        if (phone.length < 9 || phone.length > 12) {

            $("#phone-er").html("Số điện thoại không hợp lệ.").show();
            $('#phone').focus();
            return false;
        }
        if (!isInteger(phone)) {

            $("#phone-er").html("Số điện thoại không hợp lệ.").show();

            $('#phone').focus();
            return false;
        }
        return true;

    }
    function validateEmail() {
        if (!ValidateControls("Vui lòng nhập email !", "#email", "#email-er")) {
            return false;
        }
        var mail = $('#email').val();
        if (!isValidEmailAddress(mail)) {

            $("#email-er").html("email không hợp lệ").show();

            $('#email').focus();
            return false;
        }
        return true;
    }
    function validateData() {
        if (!ValidateControls("Vui lòng nhập tên !", "#firstName", '#firstName-er')) {
            $('#firstName').focus();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập họ !", "#lastName", '#lastName-er')) {
            $('#lastName').focus();
            return false;
        }
        if (!validateEmail()) {
            return false;
        }
        //if (!validatePhone()) {
        //    return false;
        //}


        $('#step1').hide();
        $('#step2').show();
    }
    function validateData2() {
        if (!ValidateControls("Vui lòng nhập tên đăng nhập!", "#username", '#username-er')) {
            return false;
        }
        var username = $('#username').val();

        if (username.length < 5) {

            $("#username-er").html("Vui lòng nhập ít nhất 5 ký tự.").show();
            $('#username').focus();
            return false;
        }
        if (!CheckAlpha(username)) {
            $("#username-er").html("Tên người dùng chỉ chứa các chữ cái từ A đến Z (không phân biệt chữ hoa chữ thường) hoặc các số từ 0 đến 9").show();
            $('#username').focus();

            return false;
        }
        if (!ValidateControls("Vui lòng nhập mật khẩu !", "#password", '#password-er')) {
            return false;
        }
        var password = $('#password').val();
        if (password.length < 8) {

            $("#password-er").html("Vui lòng nhập ít nhất 8 ký tự.").show();
            $('#password').focus();
            return false;
        }
        if (!isValidPassword(password)) {
            $("#password-er").html("Mật khẩu phải có ít nhất 1 chữ in hoa, 1 số, 1 ký tự đặc biệt (trong số các ký tự: !@@#$%&*)").show();
            $('#username').focus();

            return false;
        }
        var repassword = $('#repassword').val();
        if (password != repassword) {
            $("#repassword-er").html("Mật khẩu không trùng khớp").show();
            $('#repassword').focus();

            return false;
        }
        var check = $('#commit').prop("checked") ? 1 : 0;
        if (check == 0) {
            $("#msgBox").html("Bạn chưa đồng ý với Điều khoản dịch vụ và Chính sách quyền riêng tư của chúng tôi").show();

            $('.error').hide();
            return false;
        }


        var param2 = {
            Password: password,
            Username: username,
            FistName: $("#firstName").val(),
            LastName: $("#lastName").val(),
            Email: $("#email").val(),
            Mobile: '',
            Organ: $("#organization").val(),
        };
        $.ajax({
            type: 'POST',
            url: "@Url.Action("Reg")",
            data: addAntiForgeryToken(param2),
            async: true,
            success: function (data) {

                if (data.success === true) {
                    // bootbox.alert("Đăng ký thành công");
                    //setTimeout(function () {  goLogin(); }, 3000);
                   $('#notebox').on('hidden.bs.modal', function () {
                     goLogin();
                    });
                    $('#modalComplete').modal('show');
                } else {

                    $("#msgBox").text(data.msg).show();
                    return;
                }
            }
        });
    }
</script>
