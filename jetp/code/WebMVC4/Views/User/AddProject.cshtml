@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@using UTILS;
@using DATA.ContentDB;
@model DATA.ContentDB.UserProjectFull
@{
    List<TestLocation> ListCate = ViewBag.listLocation;
}
<div class="manage-body">
    <div class="manage-bnr">
        <img src="/Content2/images/manage-bnr.jpg" alt="">
        <div class="manage-title">
            <ul>
                <li class="active">Dự án đầu tư <br>Có cấu phần xây dựng</li>
            </ul>
        </div>
    </div>
    <div class="manage-content">
        <div class="mw-01 manage-sidebar">
            @Html.Partial("User_Menu")
        </div>
        <div class="mw-02 manage-main">
            <div class="manage-wrap mt50">
                <div class="mt50">
                    <strong>Lưu ý:</strong><br>
                    <p style="padding-left: 20px;">
                        - Các trường thông tin có dấu hoa thị (<span class="textred">*</span>) là các trường thông tin bắt buộc.<br>
                        - Các trường thông tin không có dấu hoa thị (<span class="textred">*</span>) là các trường thông tin không bắt buộc.<br>
                        - Người điền cần nhập đầy đủ thông tin tại mục I. Thông tin chung và II. Tính phù hợp JETP</a>.
                    </p>
                </div>
                <div class="wrap-tabs mt50">
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" data-toggle="tab" data-target="#tabs01" id="tabs01-tab">I. Thông tin chung</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-toggle="tab" data-target="#tabs02" id="tabs02-tab">II. Tính phù hợp JETP</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="pills-tabContent">
                        <div class="tab-pane fade show active" id="tabs01" role="tabpanel">
                            <div class="m-form">
                                <div class="m-form-item">
                                    <label>
                                        1. Tên dự án <span class="textred">*</span>
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Tên chính xác của dự án trong các Quy hoạch, Giấy phép đầu tư hoặc các tài liệu chính thức khác nếu có.<br>Lưu ý: nếu trước đây dự án đã từng gửi đề xuất và bị từ chối (không phù hợp với JETP), dự án có thể cập nhật thêm thông tin và gửi lại đề xuất"></span>
                                        </p>
                                    </label>
                                    <input type="text" placeholder="" id="name" value="@Model.Name">
                                    <label class="name-error error" for="name" id="name-er"></label>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        2. Địa điểm dự án <span class="textred">*</span>
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Địa điểm triển khai dự án có thể là dự kiến (chưa xác định) hoặc đã xác định (tại các giấy phép đã có) tùy thuộc vào tiến độ của dự án"></span>
                                        </p>
                                    </label>
                                    <select id="location">
                                        <option value="-1">--Chọn địa điểm--</option>
                                        @if (ListCate != null && ListCate.Count > 0)
                                        {

                                            foreach (var obj in ListCate)
                                            {
                                                <option value="@obj.Id" title="@obj.Name" @if (obj.Id.ToString() == Model.Location) { @Html.Raw("selected='selected'") ; }>@obj.Name</option>
                                            }
                                        }
                                    </select>
                                    @*<input type="text" placeholder="" value="@Model.Location" id="location">*@
                                    <label class="location-error error" for="location" id="location-er"></label>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        3. Hạng mục dự án <span class="textred">*</span>
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="
                                                  Người điền thông tin có thể chọn hạng mục dự án đầu tư (Theo Bảng 7 RMP) như sau:<br>
                1. Các dự án về thúc đẩy chuyển đổi điện than sang năng lượng sạch<br>
                2. Các dự án về phát triển ngành công nghiệp năng lượng tái tạo<br>
                3. Sản xuất năng lượng tái tạo (gió, mặt trời, khác)<br>
                4. Sản xuất và sử dụng hydro xanh và các chất dẫn xuất<br>
                5. Các dự án về truyền tải điện và lưu trữ năng lượng<br>
                6. Các dự án về sử dụng năng lượng tiết kiệm và hiệu quả<br>
                7. Các dự án về chuyển đổi năng lượng xanh, giảm phát thải khí nhà kính của ngành giao thông vận tải
          ">
          </span>
                                        </p>
                                    </label>
                                    <select id="SubType">
                                        <option value="1" @(Model.SubType == 1 ? "selected='selected'" : "")>1. Các dự án về thúc đẩy chuyển đổi điện than sang năng lượng sạch</option>
                                        <option value="2" @(Model.SubType == 2 ? "selected='selected'" : "")>2. Các dự án về phát triển ngành công nghiệp năng lượng tái tạo</option>
                                        <option value="3" @(Model.SubType == 3 ? "selected='selected'" : "")>3. Sản xuất năng lượng tái tạo (gió, mặt trời, khác)</option>
                                        <option value="4" @(Model.SubType == 4 ? "selected='selected'" : "")>4. Sản xuất và sử dụng hydro xanh và các chất dẫn xuất</option>
                                        <option value="5" @(Model.SubType == 5 ? "selected='selected'" : "")>5. Các dự án về truyền tải điện và lưu trữ năng lượng</option>
                                        <option value="6" @(Model.SubType == 6 ? "selected='selected'" : "")>6. Các dự án về sử dụng năng lượng tiết kiệm và hiệu quả</option>
                                        <option value="7" @(Model.SubType == 7 ? "selected='selected'" : "")>7. Các dự án về chuyển đổi năng lượng xanh, giảm phát thải khí nhà kính của ngành giao thông vận tải</option>
                                    </select>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        4. Đơn vị đăng ký đề xuất  <span class="textred">*</span>
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Người điền cần sử dụng tên chính thức của đơn vị đề xuất dự án, ví dụ các chủ dự án, đơn vị phát triển dự án, doanh nghiệp nhà nước, các Tập đoàn tư nhân và công ty con, tổ chức tài chính trong nước và quốc tế, các cơ quan Chính phủ, và các pháp nhân khác."></span>
                                        </p>
                                    </label>
                                    <input type="text" placeholder="" value="@Model.Unit" id="unit">
                                    <label class="unit-error error" for="unit" id="unit-er"></label>
                                </div>
                                <div class="m-form-item">
                                    <label style="margin-bottom: 0;">
                                        5. Thông tin liên lạc của đại diện đơn vị ký đề xuất <span class="textred">*</span>
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Người điền cần cung cấp đầy đủ họ tên, chức danh, bộ phận công tác, địa chỉ thư điện tử, số điện thoại"></span>
                                        </p>
                                    </label>
                                </div>
                                <div class="m-form-item w-50">
                                    <label>
                                        Họ và tên: <span class="textred">*</span>
                                    </label>
                                    <input type="text" placeholder="" id="fullname" value="@Model.ProjectConfig.Fullname">
                                    <label class="fullname-error error" for="fullname" id="fullname-er"></label>
                                </div>
                                <div class="m-form-item w-50">
                                    <label>
                                        Chức danh, bộ phận công tác: <span class="textred">*</span>
                                    </label>
                                    <input type="text" placeholder="" id="role" value="@Model.ProjectConfig.Role">
                                    <label class="role-error error" for="role" id="role-er"></label>
                                </div>
                                <div class="m-form-item w-50">
                                    <label>
                                        E-mail: <span class="textred">*</span>
                                    </label>
                                    <input type="text" placeholder="" id="email" value="@Model.ProjectConfig.Email">
                                    <label class="email-error error" for="email" id="email-er"></label>
                                </div>
                                <div class="m-form-item w-50">
                                    <label>
                                        Số điện thoại: <span class="textred">*</span>
                                    </label>
                                    <input type="text" placeholder="" id="mobile" value="@Model.ProjectConfig.Mobile">
                                    <label class="mobile-error error" for="mobile" id="mobile-er"></label>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        6. Đơn vị phát triển dự án
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Người điền cần cung cấp tên của tổ chức/ cá nhân đại diện. Thông tin này có thể trùng với thông tin liên hệ của đại điện đơn vị đăng ký đề xuất/ hoặc có thể là của Chủ dự án (dự kiến)"></span>
                                        </p>
                                    </label>
                                    <input type="text" placeholder="" value="@Model.ProjectConfig.UnitDev" id="UnitDev">
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        7. Chủ dự án <span class="textred">*</span>
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Người điền cần cung cấp tên của chủ dự án/các chủ đầu tư (dự kiến). Thông tin này có thể trùng với thông tin đơn vị đăng ký đề xuất và/hoặc đơn vị phát triển dự án. <br>Trong trường hợp Chủ dự án có thể chưa được xác định cụ thể, loại hình chủ sở hữu dự án có thể được điền thay cho tên dự án"></span>
                                        </p>
                                    </label>
                                    <input type="text" placeholder="" value="@Model.Organ" id="organ">
                                    <label class="organ-error error" for="organ" id="organ-er"></label>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        8. Tổng chi phí dự án (Ví dụ: 70 triệu USD) <span class="textred">*</span>
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Người điền cần cung cấp chính xác giá trị tổng vốn dự án hoặc giá trị tạm tính tùy theo tiến độ của dự án (có thể được cập nhật lại sau). "></span>
                                        </p>
                                    </label>
                                    <input type="text" placeholder="" value="@Model.Total" id="total">
                                    <label class="total-error error" for="total" id="total-er"></label>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        9. Đơn vị tiền tệ đầu tư mong muốn (Ví dụ: VND, USD, EUR)
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Người điền chọn chính xác đơpn vị tiền tệ mà dự án mong muốn được đầu tư/thanh toán như VND &amp; USD." aria-expanded="false"></span>
                                        </p>
                                    </label>
                                    <input type="text" placeholder="" value="@Model.Currency" id="currency">
                                    <label class="currency-error error" for="organ" id="currency-er"></label>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        10. Chi tiết ngân sách
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Người điền cung cấp bảng chi phí chi tiết theo từng hạng mục, trong phạm vi bảo mật cho phép; tỷ lệ nợ trên vốn chủ sở hữu, thể hiện tỷ lệ % của dự án được đầu tư bằng khoản nợ. Thông tin này chủ yếu phù hợp với các dự án đang hoặc sắp hoàn tất đàm phán tài chính."></span>
                                        </p>
                                    </label>
                                    <textarea rows="3" id="detail">@Model.Detail </textarea>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        11. Nguồn tài chính
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Người cấp danh sách các bên cung cấp tài chính hoặc tên nhà đầu tư cụ thể, tùy theo tiến độ của dự án. Nếu được, ghi rõ tên ngân hàng phát triển quốc tế, các quỹ, ngân hàng tư nhân quốc tế, ngân hàng thương mại."></span>
                                        </p>
                                    </label>
                                    <textarea rows="3" id="source">@Model.Source </textarea>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        12. Loại hình tài chính hiện có và mong muốn
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="
                                                  Nếu có thể, người điền chia sẻ cụ thể: <br>
                                                  (a) Tài chính công<br>
                                                  <span>(i) Viện trợ không hoà lại/ ODA<br></span>
                                                  <span>(ii) Các khoản vay ưu đãi<br></span>
                                                  <span>(iii) Các khoản vay có bảo lãnh chính phủ<br></span>
                                                  (b) Tài chính tư nhân:<br>
                                                  <span>(i) Vốn chủ sở hữu:<br></span>
                                                  <span>- Vốn chủ sở hữu của nhà đầu tư/chủ dự án<br></span>
                                                  <span>- Đầu tư vốn cổ phần tư nhân<br></span>
                                                  <span>- Vốn đầu tư mạo hiểm<br></span>
                                                  <span>(ii) Công cụ nợ:<br></span>
                                                  <span>- Khoản vay doanh nghiệp<br></span>
                                                  <span>- Tài chính dự án<br></span>
                                                  <span>  - Khoản vay hợp vốn<br></span>
                                                  <span>- Tài trợ hạng hai (mezzanine)<br></span>
                                                  <span>- Nợ thứ cấp<br></span>
                                                  <span>- Phát hành trái phiếu (trái phiếu xanh, trái phiếu xã hội, v.v.)<br></span>
                                                  <span>- Tài chính bắc cầu<br></span>
                                                  <span>- Tín dụng xuất khẩu<br></span>

                                                  <span>(iii) Nâng cấp tín dụng:<br></span>
                                                  <span>- Bảo lãnh<br></span>
                                                  <span>- Sản phẩm bảo hiểm<br></span>
                                                  <span>- Dự phòng tổn thất<br></span>
                                                  (c) Dịch vụ tư vấn<br>
                                                  (d) Tài chính hỗn hợp:<br>
                                                  <span>(i) Kết hợp tài chính công và tư nhân<br></span>
                                                  <span>(ii) Hợp tác công tư (PPP)<br></span>
                                                  (e) Tài chính thay thế:<br>
                                                  <span>(i) Đầu tư tác động<br></span>
                                                  <span>(ii) Tài chính dựa trên kết quả<br></span>
                                                  (f) Các loại tài chính khác"></span>
                                        </p>
                                    </label>
                                    <textarea rows="3" id="finance">@Model.ProjectConfig.Finance </textarea>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        13. Dòng doanh thu dự kiến
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Nếu có thể, người điền cung cấp thông tin về cách dự án tạo ra thu nhập, nguồn doanh thu chính, cấu trúc giá, phân khúc khách hàng, và cơ chế thanh toán (tối đa 300 từ)."></span>
                                        </p>
                                    </label>
                                    <textarea rows="3" id="revenue" class="limited-textarea" maxlength="1500">@Model.ProjectConfig.Revenue </textarea>
                                    <div class="char-info mt4">
                                        @if (string.IsNullOrEmpty(Model.ProjectConfig.Revenue))
                                        {
                                            <span class="char-count">Đã nhập: 0 ký tự</span>
                                        }
                                        else
                                        {
                                            <span class="char-count">Đã nhập: @Model.ProjectConfig.Revenue.Length ký tự</span>
                                        }

                                        <span class="char-warning" style="display:none; color: red; margin-left: 10px;">
                                            Số lượng ký tự không được vượt quá 1500 ký tự.
                                        </span>
                                    </div>
                                </div>
                                <div class="m-form-item">
                                    <label>
                                        14. Tiến độ dự án <span class="textred">*</span>
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="
                                                  Người điền cung cấp thông tin về tiến độ của dự án đầu tư bằng cách chọn 1 giai đoạn phù hợp nhất. Thông tin này có thể được tiếp tục cập nhật.<br>
                                          1. Giai đoạn đề xuất ý tưởng<br>
                                          2. Giai đoạn nghiên cứu tiền khả thi<br>
                                          3. Giai đoạn nghiên cứu khả thi<br>
                                          4. Giai đoạn thu mua đất<br>
                                          5. Giai đoạn xin phép<br>
                                          6. Giai đoạn thiết kế kỹ thuật (thiết kế chi tiết)<br>
                                          7. Giai đoạn đàm phán tài chính<br>
                                          8. Giai đoạn thương thảo và ký kết hợp đồng<br>
                                          9. Giai đoạn khởi công xây dựng<br>
                                          10. Giai đoạn hoàn thành xây dựng<br>
                                          11. Giai đoạn vận hành thử nghiệm<br>
                                          12. Giai đoạn vận hành chính thức và bảo trì/ bảo dưỡng
                                        "></span>
                                        </p>
                                    </label>
                                    <select id="Progress">
                                        <option value="1" @(Model.Progress == 1 ? "selected='selected'" : "")>Giai đoạn đề xuất ý tưởng</option>
                                        <option value="2" @(Model.Progress == 2 ? "selected='selected'" : "")>Giai đoạn nghiên cứu tiền khả thi</option>
                                        <option value="3" @(Model.Progress == 3 ? "selected='selected'" : "")>Giai đoạn nghiên cứu khả thi</option>
                                        <option value="4" @(Model.Progress == 4 ? "selected='selected'" : "")>Giai đoạn thu mua đất</option>
                                        <option value="5" @(Model.Progress == 5 ? "selected='selected'" : "")>Giai đoạn xin phép</option>
                                        <option value="6" @(Model.Progress == 6 ? "selected='selected'" : "")>Giai đoạn thiết kế kỹ thuật (thiết kế chi tiết)</option>
                                        <option value="7" @(Model.Progress == 7 ? "selected='selected'" : "")>Giai đoạn đàm phán tài chính</option>
                                        <option value="8" @(Model.Progress == 8 ? "selected='selected'" : "")>Giai đoạn thương thảo và ký kết hợp đồng</option>
                                        <option value="9" @(Model.Progress == 9 ? "selected='selected'" : "")>Giai đoạn khởi công xây dựng</option>
                                        <option value="10" @(Model.Progress == 10 ? "selected='selected'" : "")>Giai đoạn hoàn thành xây dựng</option>
                                        <option value="11" @(Model.Progress == 11 ? "selected='selected'" : "")>Giai đoạn vận hành thử nghiệm</option>
                                        <option value="12" @(Model.Progress == 12 ? "selected='selected'" : "")>Giai đoạn vận hành chính thức và bảo trì/bảo dưỡng</option>
                                    </select>
                                </div>
                                <div class="m-form-item w-50">
                                    <label>
                                        15. Ngày dự kiến khởi công <span class="textred">*</span>
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Người điền cung cấp ngày khởi công dự án chính thức hoặc dự kiến, có thể khác với ngày tổ chức Lễ khởi công."></span>
                                        </p>
                                    </label>
                                    <input type="text" placeholder="dd/mm/yyyy" value="@Model.ProjectConfig.Time" id="time">
                                    <label class="time-error error" for="time" id="time-er"></label>
                                </div>
                                <div class="m-form-item w-50">
                                    <label>
                                        16. Ngày dự kiến hoàn thành (CoD) <span class="textred">*</span>
                                        <p class="question-wrap">
                                            <span class="icon-question" data-tippy-content="Người điền cung cấp ngày bắt đầu giai đoạn vận hành chạy thử"></span>
                                        </p>
                                    </label>
                                    <input type="text" placeholder="dd/mm/yyyy" value="@Model.ProjectConfig.Finish" id="finish">
                                    <label class="finish-error error" for="finish" id="finish-er"></label>
