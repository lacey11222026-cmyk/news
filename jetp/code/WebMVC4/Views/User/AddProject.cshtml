<script>
    $(document).ready(function () {
        $('.limited-textarea').on('input', function () {
            const $textarea = $(this);
            const currentLength = $textarea.val().length;
            const maxLength = parseInt($textarea.data('maxlength'), 10);

            const $wrapper = $textarea.closest('.m-form-item');
            const $count = $wrapper.find('.char-count');
            const $warning = $wrapper.find('.char-warning');

            $count.text(`Đã nhập: ${currentLength} ký tự`);

            if (currentLength >= maxLength) {
                $warning.text(`Số lượng ký tự không được vượt quá ${maxLength} ký tự.`).show();
            } else {
                $warning.hide();
            }
        });
    });
</script>
