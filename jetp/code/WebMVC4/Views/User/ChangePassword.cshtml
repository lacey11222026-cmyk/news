@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@using UTILS;
@model UserSession
<div class="manage-body">
    <div class="manage-bnr">
        <img src="/Content2/images/manage-bnr.jpg" alt="">
        <div class="manage-title">
            <ul>
                <li ><a href="/User/">Quản lý thông tin</a></li>
                <li class="active">Đổi mật khẩu</li>
            </ul>
        </div>
    </div>
    <div class="manage-content">
        <div class="mw-01 manage-sidebar">
            @Html.Partial("User_Menu")
        </div>
        <div class="mw-02 manage-main">
            <div class="manage-wrap mt50">
                <div class="m-form">
                    <div class="m-form-item">
                        <label>Nhập mật khẩu cũ <span class="textred">*</span></label>
                        <input type="password" id="oldpassword">
                    </div>
                    <div class="m-form-item">
                        <label>Nhập mật khẩu mới <span class="textred">*</span></label>
                        <input type="password"  id="password">
                    </div>
                    <div class="m-form-item">
                        <label>Nhập lại mật khẩu mới <span class="textred">*</span></label>
                        <input type="password" id="repassword"  >
                    </div>
                </div>
                <div class="text-center mt20 w-100">
                    <a href="javascript:;" onclick="validateData()" class="btn-blue btn-cm">Cập nhật</a>
                </div>
                <div class="form-box mt20">
                    <p style="color: red;text-align: left;font-weight:bold" id="msgBox"></p>
                </div>
            </div>
        </div>
        <div class="m-log-out">
            <img src="/Content2/images/manage-img.png" alt="">
            <a href="@Url.Action("Login","User",new { act="out"})" class="btn-log-out"><img src="/Content2/images/icon-log-out.png" alt=""> Đăng xuất</a>
        </div>
    </div>
</div>
<script src="~/Content/js/formvalidate.js?vs=02"></script>
<script>
    $("#menu_1").addClass("active");
    function validateData() {
        if (!ValidateControls("Vui lòng nhập mật khẩu cũ !", "#oldpassword")) {
            return false;
        }
        if (!ValidateControls("Vui lòng nhập mật khẩu mới !", "#password")) {
            return false;
        }
        var password = $('#password').val();
        if (password.length < 8) {

            $("#msgBox").html("Vui lòng nhập ít nhất 8 ký tự.").show();
            return false;
        }
        if (!isValidPassword(password)) {
            $("#msgBox").html("Mật khẩu phải có ít nhất 1 chữ in hoa, 1 số, 1 ký tự đặc biệt (trong số các ký tự: !@@#$%&*)").show();
            
            return false;
        }
        var repassword = $('#repassword').val();
        if (password != repassword) {
            $("#msgBox").html("Mật khẩu không trùng khớp").show();
          

            return false;
        }
         var param2 = {
    
             Password: $("#oldpassword").val(),
             NewPassword: $("#password").val(),
            
            };
            $.ajax({
                type: 'POST',
                url: "@Url.Action("ChangePassword")",
                data: addAntiForgeryToken(param2),
                async: true,
                success: function (data) {

                    if (data.success === true) {
                        bootbox.alert("Cập nhật thành công");
                        
                    } else {

                        $("#msgBox").text(data.msg).show();
                        return;
                    }
                }
            });

    }
</script>