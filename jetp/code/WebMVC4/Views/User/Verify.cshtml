@{
    Layout = "~/Views/Shared/_Login.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
<section class="section-login-1" style="background-image: url('/Content/images/bg-dangnhap.jpg');">
    <div class="container-fulid" style="height: inherit;">
        <div class="content">
            <div class="col-left">
                <div class="header-login">
                    <div class="logo">
                        <a href="/">
                            <img src="/Content/images/logo2025.png?vs=01" alt="images">
                        </a>
                    </div>
                    <div class="lang">
                        <button class="bnt-lang">
                            <img src="/Content/images/vn.png" alt="images">
                            <span>Tiếng Việt</span>
                            <i class="fas fa-caret-down"></i>
                        </button>
                        <ul class="list-lang">
                            <li><a href="#"><img src="/Content/images/gb.png" alt="images"><span>English</span></a></li>
                            <li><a href="#"><img src="/Content/images/vn.png" alt="images"><span>Tiếng Việt</span></a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-right">
                <div class="right-form">
                    <div class="title">
                        <h2>Đăng nhập</h2>
                        <p>Chào mừng bạn đến <br><strong>Quan hệ đối tác chuyển đổi năng lượng công bằng (JETP)</strong> Trang đăng nhập. Đăng nhập để tham gia.</p>
                    </div>
                    <div id="form-login">

                        <div class="f-col">
                            <label for="">Tên đăng nhập</label>
                            <input type="text" name="username" autocomplete="off" id="username" placeholder="Nhập tên đăng nhập của bạn" class="input-cm">
                        </div>
                        <div class="f-col">
                            <label for="">Mật khẩu</label>
                            <input type="password" name="password" autocomplete="new-password" id="password" placeholder="Nhập mật khẩu của bạn" class="input-cm">
                        </div>
                        <a href="#" class="repass">Quên mật khẩu?</a>
                        @*<div class="note">
                                <p>Bằng việc đăng nhập, tôi đồng ý với JETP Việt Nam <a href="#">Điều khoản sử dụng</a> Và <a href="#">Chính sách bảo mật</a></p>
                            </div>*@
                        <button class="btn-cm btn-blue w-100" onclick="validateData()"><span>Đăng nhập</span></button>
                        <div class="bnt-more mt10">
                            <p>Chưa có tài khoản? <a href="/User/Register" class="textblue">Tạo tài khoản</a></p>
                        </div>
                        <div class="form-box mt20">
                            <p style="color: red;text-align: left;font-weight:bold" id="msgBox"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" id="save" tabindex="-1" role="dialog" aria-labelledby="" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            @if (ViewBag.status == 1)
            {
                <h4 >@ViewBag.message</h4>
            }
            else
            {
                <h4 style="color:red">@ViewBag.message</h4>
            }


        </div>
    </div>
</div>

<style>

    .section-login-1 .content .col-right .right-form #form-login .note {
        width: 100%;
        max-width: 17.75rem;
        margin: 0 auto 1.69rem;
        display: block;
        text-align: center;
    }
</style>
<script>
    $('#save').on('hidden.bs.modal', function () {
       window.location.href = "@Url.Action("Login")"
    });
    $('#save').modal('show');
</script>