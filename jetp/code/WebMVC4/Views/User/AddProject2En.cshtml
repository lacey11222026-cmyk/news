<script>
    $("#menu_2").addClass("active");
    function gotab1() {
        $('button[data-target="#tabs01"]').tab('show');
        $('button[data-target="#tabs01"]').on('shown.bs.tab', function () {
            const offset = 100;
            const $target = $('#tabs01');
            if ($target.length) {
                $('html, body').animate({
                    scrollTop: $target.offset().top - offset
                }, 500);
            }
        });
    }
    function validateData() {
        if (!ValidateControls("Please enter the project name!", "#name", '#name-er')) {
            $('#name').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Please enter the project location!", "#location", '#location-er')) {
            $('#location').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Please enter the proposing entity!", "#unit", '#unit-er')) {
            $('#unit').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Please enter the managing agency !", "#UnitDev", '#UnitDev-er')) {
            $('#organ').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Please enter full name!", "#fullname", '#fullname-er')) {
            $('#fullname').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Please enter title/dpartment!", "#role", '#role-er')) {
            $('#role').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Please enter email!", "#email", '#email-er')) {
            $('#email').focus(); gotab1();
            return false;
        }
        var mail = $('#email').val();
        if (!isValidEmailAddress(mail)) {
            gotab1();
            $("#email-er").html("Invalid email").show();
            $('#email').focus();
            return false;
        }
        if (!ValidateControls("Please enter phone number!", "#mobile", '#mobile-er')) {
            $('#mobile').focus(); gotab1();
            return false;
        }
        var phone = $('#mobile').val();
        if (phone.length < 9 || phone.length > 12) {

            $("#mobile-er").html("Invalid phone number.").show();
            gotab1();
            $('#mobile').focus();
            return false;
        }
        if (!isInteger(phone)) {

            $("#mobile-er").html("Invalid phone number.").show();

            gotab1();
            $('#mobile').focus();
            return false;
        }
       
        if (!ValidateControls("Please enter the project owner!", "#organ", '#organ-er')) {
            $('#organ').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Please enter the total budget !", "#total", '#total-er')) {
            $('#total').focus(); gotab1();
            return false;
        }

        //if (!$("#cusd").hasClass("active") && !$("#cvnd").hasClass("active")) {
        //    $("#Currency-er").html("Please select a currency.").show();
        //    $('#total').focus(); gotab1();
        //    return false;
        //}

        if (!ValidateControls("Please enter the duration !", "#time", '#time-er')) {
            $('#time').focus(); gotab1();
            return false;
        }

        if (!ValidateControls("Please enter the legal status!", "#legalStatus", '#legalStatus-er')) {
            $('#legalStatus').focus();
            return false;
        }
        if (!ValidateControls("Please enter  description!", "#description", '#description-er')) {
            $('#description').focus();
            return false;
        }
        if ($('#description').val().length > 2500) {
            $('#description').focus();
            return false;
        }
        if ($('#impact').val().length > 1200) {

            $('#impact').focus();
            return false;
        }
        if (!ValidateControls("Please enter General Principle 1!", "#rule1", '#rule1-er')) {
            $('#rule1').focus();
            return false;
        }
        if ($('#rule1').val().length > 1000) {
            $('#rule1').focus();
            return false;
        }
        if (!ValidateControls("Please enter General Principle 2!", "#rule2", '#rule2-er')) {
            $('#rule2').focus();
            return false;
        }
        if ($('#rule2').val().length > 1000) {
            $('#rule2').focus();
            return false;
        }
        if (!ValidateControls("Please enter General Principle 3!", "#rule3", '#rule3-er')) {
            $('#rule3').focus();
            return false;
        }
        if ($('#rule3').val().length > 1000) {
            $('#rule3').focus();
            return false;
        }
        if (!ValidateControls("Please enter General Principle 4!", "#rule4", '#rule4-er')) {
            $('#rule4').focus();
            return false;
        }
        if ($('#rule4').val().length > 1000) {
            $('#rule4').focus();
            return false;
        }

        return true;
    }

    function save1() {
