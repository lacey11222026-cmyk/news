             Currency: "",

             Type: 2,
        };
        //if ($("#cusd").hasClass("active")) {
        //    param2.Currency = "USD";
        //}

        param2.Status = 0;

         $.ajax({
             type: 'POST',
             url: "@Url.Action("SaveData")",
             data: addAntiForgeryToken(param2),
             async: true,
             success: function (data) {

                 if (data.ResponseCode >= 0) {
                      //bootbox.alert("Cập nhật thành công");
                     //setTimeout(function () { window.location = '/User/AddProject2?id=' + data.ResponseCode; }, 500);
                     $('#save').on('hidden.bs.modal', function () {
                         window.location = '/User/AddProject2?id=' + data.ResponseCode;;
                     });
                     $('#save').modal('show');
                 } else {

                     $("#msgBox").text(data.Description).show();
                     return;
                 }
             }
        });
    }
    function send2() {
        $('#send').modal('hide');
         var param2 = {
                     Id: '@Model.Id',
