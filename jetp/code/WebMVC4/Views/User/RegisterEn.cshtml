                                        <span>Back</span>
                                    </a>
                                </div>
                            </div>
                            <div class="note note-v2">
                                <input type="checkbox" name="commit" id="commit">
                                <label for="commit">I agree to  the Terms of Use and Privacy Policy of the website</label>
                            </div>
                            <button type="submit" class="btn-cm btn-blue w-100" onclick="validateData2()"><span>Register</span></button>
                            <div class="my-account">
                                <p>Already have an account?  <a href="/User/Login" class="textblue textlink">Log in now</a></p>
                            </div>
