                                    <label class="repassword-error error" for="repassword" id="repassword-er"></label>
                                </div>
                            </div>
                            <div class="step">
                                <div class="step-left">
                                    <strong>(Step 2/2)</strong>
                                    <div class="dot-step step-v2">
                                        <span class="dot step-1"></span>
                                        <span class="dot step-2"></span>
                                    </div>
                                </div>
                                <div class="step-right">
                                    <a href="javascript:void(0)" class="back-to-basic-info" onclick="goStep1()">
