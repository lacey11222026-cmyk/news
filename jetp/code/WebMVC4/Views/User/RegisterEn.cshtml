                            <img src="/Content/images/gb.png" alt="images">
                            <span>English</span>
                            <i class="fas fa-caret-down"></i>
                        </button>
                        <ul class="list-lang">

                            <li><a href="/Home/Language?lang=vi-vn"><img src="/Content/images/vn.png" alt="images"><span>VietNamese</span></a></li>
                            <li><a href="/Home/Language?lang=en-us"><img src="/Content/images/gb.png" alt="images"><span>English</span></a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-right">
                <div class="right-form ">
                    <div class="title">
                        <h2>Create an account</h2>
                        <p>Welcome to  <br /><strong>the Just Energy Transition Partnership (JETP)</strong> <br />Registration page. Register to participate.</p>
                    </div>
                    <div action="" class="form-register" id="step1">

                        <div class="basic-info">
                            <div class="f-item">
                                <div class="f-col" style="height: 146px;">
                                    <label for="">First Name <span class="textred">*</span></label>
                                    <input type="text" name="firstName" id="firstName" placeholder="Enter your first name" class="input-cm">
                                    <label class="firstName-error error" for="firstName" id="firstName-er"></label>
                                </div>
                                <div class="f-col" style="height:146px;">
                                    <label for="">Last Name <span class="textred">*</span></label>
                                    <input type="text" name="lastName" id="lastName" placeholder="Enter your last name" class="input-cm">
                                    <label class="lastName-error error" for="lastName" id="lastName-er"></label>
                                </div>
                            </div>
                            <div class="f-item fw-100">
                                <div class="f-col">
                                    <label for="">Email <span class="textred">*</span></label>
                                    <input type="text" name="email" id="email" autocomplete="new-password" placeholder="Enter your email address" class="input-cm">
                                    <label class="email-error error" for="email" id="email-er"></label>
                                </div>
                            </div>
                            @*<div class="f-item fw-100">
                                    <div class="f-col">
                                        <label for="">Số điện thoại *</label>
                                        <input type="number" name="phone" id="phone" placeholder="Nhập số điện thoại của bạn" class="input-cm">
                                        <label class="phone-error error" for="phone" id="phone-er"></label>
                                    </div>
                                </div>*@
                            <div class="f-item fw-100">
                                <div class="f-col">
                                    <label for="">Organization</label>
                                    <input type="text" name="organization" id="organization" placeholder="Enter your organization" class="input-cm">
                                </div>
                            </div>

                            <div class="step">
                                <div class="step-left">
                                    <strong>(Step 1/2)</strong>
                                    <div class="dot-step">
                                        <span class="dot step-1"></span>
                                        <span class="dot"></span>
                                    </div>
                                </div>
                                @*<div class="step-right">
                                        <a href="javascript:;" onclick="goLogin()">
                                            <i class="fa fa-undo" aria-hidden="true"></i>
                                            <span>Quay lại</span>
                                        </a>
                                    </div>*@
                            </div>
                            <button type="button" onclick="validateData()" class="btn-cm btn-blue w-100">Next</button>

                        </div>

                    </div>
                    <div action="" class="form-register" style="display:none" id="step2">
                        <input type="hidden" name="csrfToken" value="86bd02aa27">
                        <div class="account-info">
                            <div class="f-item fw-100">
                                <div class="f-col">
                                    <label for="">Username <span class="textred">*</span></label>
                                    <input type="text" name="username" autocomplete="off" id="username" placeholder="Enter your username" class="input-cm">
                                    <label class="username-error error" for="username" id="username-er"></label>
                                </div>
                            </div>
                            <div class="f-item fw-100">
                                <div class="f-col">
                                    <label for="">Password <span class="textred">*</span></label>
