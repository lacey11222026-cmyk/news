                </div>
            </div>
        </div>
    </div>
</section>
<!-- Modal -->
<div class="modal fade" id="modalComplete" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"> <span aria-hidden="true">&times;</span> </button>
            <div class="modal-body">
                <h4 class="text-center">Account registration successful</h4>
                <p class="text-center mt20">An account confirmation email has been sent to your email address.<br> Please check your email to complete account registration.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cm btn-blue font-weight-bold" data-dismiss="modal" aria-label="Close">OK</button>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/js/formvalidate.js?vs=02"></script>

<script>

    function goLogin() {
       window.location.href = "@Url.Action("Login")"
    }

    function goStep1() {
        $('#step2').hide();
        $('#step1').show();
    }
    function validatePhone() {
        if (!ValidateControls("Vui lòng nhập số điện thoại !", "#phone", "#phone-er")) {
            return false;
        }

        var phone = $('#phone').val();

        if (phone.length < 9 || phone.length > 12) {

            $("#phone-er").html("Số điện thoại không hợp lệ.").show();
            $('#phone').focus();
            return false;
        }
        if (!isInteger(phone)) {

            $("#phone-er").html("Số điện thoại không hợp lệ.").show();

            $('#phone').focus();
            return false;
        }
        return true;

    }
    function validateEmail() {
        if (!ValidateControls("Please enter your email address! !", "#email", "#email-er")) {
            return false;
        }
        var mail = $('#email').val();
        if (!isValidEmailAddress(mail)) {

            $("#email-er").html("Invalid email").show();

            $('#email').focus();
            return false;
        }
        return true;
    }
    function validateData() {
        if (!ValidateControls("Please enter your first name!", "#firstName", '#firstName-er')) {
            $('#firstName').focus();
            return false;
        }
        if (!ValidateControls("Please enter your last name!", "#lastName", '#lastName-er')) {
            $('#lastName').focus();
            return false;
        }
        if (!validateEmail()) {
            return false;
        }
        //if (!validatePhone()) {
        //    return false;
        //}


        $('#step1').hide();
        $('#step2').show();
    }
    function validateData2() {
        if (!ValidateControls("Please enter your username!", "#username", '#username-er')) {
            return false;
        }
        var username = $('#username').val();

        if (username.length < 5) {

            $("#username-er").html("Please enter at least 5 characters.").show();
            $('#username').focus();
            return false;
        }
        if (!CheckAlpha(username)) {
            $("#username-er").html("Usernames must contain only letters from A to Z (case insensitive) or numbers from 0 to 9").show();
            $('#username').focus();

            return false;
        }
        if (!ValidateControls("Please enter your password !", "#password", '#password-er')) {
            return false;
        }
        var password = $('#password').val();
        if (password.length < 8) {

            $("#password-er").html("Please enter at least 8 characters.").show();
            $('#password').focus();
            return false;
        }
        if (!isValidPassword(password)) {
            $("#password-er").html("Password must contain at least 1 uppercase letter, 1 number, and 1 special character (!@@#$%&*).").show();
            $('#username').focus();

            return false;
        }
        var repassword = $('#repassword').val();
        if (password != repassword) {
            $("#repassword-er").html("Passwords do not match").show();
            $('#repassword').focus();

            return false;
        }
        var check = $('#commit').prop("checked") ? 1 : 0;
        if (check == 0) {
            $("#msgBox").html("You have not agreed to our Terms of Service and Privacy Policy").show();

            $('.error').hide();
            return false;
        }


        var param2 = {
            Password: password,
            Username: username,
            FistName: $("#firstName").val(),
            LastName: $("#lastName").val(),
            Email: $("#email").val(),
            Mobile: '',
            Organ: $("#organization").val(),
        };
        $.ajax({
            type: 'POST',
            url: "@Url.Action("Reg")",
            data: addAntiForgeryToken(param2),
            async: true,
            success: function (data) {

                if (data.success === true) {
                    // bootbox.alert("Đăng ký thành công");
                    //setTimeout(function () {  goLogin(); }, 3000);
                   $('#notebox').on('hidden.bs.modal', function () {
                     goLogin();
                    });
                    $('#modalComplete').modal('show');
                } else {

                    $("#msgBox").text(data.msg).show();
                    return;
                }
            }
        });
    }
</script>
