@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model UserSession

<div class="manage-body">
    <div class="manage-bnr">
        <img src="/Content2/images/manage-bnr.jpg" alt="">
        <div class="manage-title">
            <ul>
                <li><a href="/User/">Account Information</a></li>
                <li class="active">Change Password</li>
            </ul>
        </div>
    </div>
    <div class="manage-content">
        <div class="mw-01 manage-sidebar">
            @Html.Partial("User_MenuEn")
        </div>
        <div class="mw-02 manage-main">
            <div class="manage-wrap mt50">
                <div class="m-form">
                    <div class="m-form-item">
                        <label>Enter old password<span class="textred">*</span></label>
                        <input type="password" id="oldpassword">
                    </div>
                    <div class="m-form-item">
                        <label>Enter new password <span class="textred">*</span></label>
                        <input type="password" id="password">
                    </div>
                    <div class="m-form-item">
                        <label>Re-enter new password <span class="textred">*</span></label>
                        <input type="password" id="repassword">
                    </div>
                </div>
                <div class="text-center mt20 w-100">
                    <a href="javascript:;" onclick="validateData()" class="btn-blue btn-cm">Update</a>
                </div>
                <div class="form-box mt20">
                    <p style="color: red;text-align: left;font-weight:bold" id="msgBox"></p>
                </div>
            </div>
        </div>
        <div class="m-log-out">
            <img src="/Content2/images/manage-img.png" alt="">
            <a href="@Url.Action("Login","User",new { act="out"})" class="btn-log-out"><img src="/Content2/images/icon-log-out.png" alt=""> Log Out</a>
        </div>
    </div>
</div>

<script src="~/Content/js/formvalidate.js?vs=02"></script>
<script>
    $("#menu_1").addClass("active");
    function validateData() {
        if (!ValidateControls("Please enter your old password!", "#oldpassword")) {
            return false;
        }
        if (!ValidateControls("Please enter a new password!", "#password")) {
            return false;
        }
        var password = $('#password').val();
        if (password.length < 8) {
            $("#msgBox").html("Please enter at least 8 characters.").show();
            return false;
        }
        if (!isValidPassword(password)) {
            $("#msgBox").html("Password must include at least 1 uppercase letter, 1 number, and 1 special character (!@@#$%&*)").show();
            return false;
        }
        var repassword = $('#repassword').val();
        if (password != repassword) {
            $("#msgBox").html("Passwords do not match.").show();
            return false;
        }

        var param2 = {
            Password: $("#oldpassword").val(),
            NewPassword: $("#password").val(),
        };

        $.ajax({
            type: 'POST',
            url: "@Url.Action("ChangePassword")",
            data: addAntiForgeryToken(param2),
            async: true,
            success: function (data) {
                if (data.success === true) {
                    bootbox.alert("Password updated successfully.");
                } else {
                    $("#msgBox").text(data.msg).show();
                    return;
                }
            }
        });
    }
</script>
