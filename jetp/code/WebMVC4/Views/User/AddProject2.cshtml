<script>
    $("#menu_2").addClass("active");
    function gotab1() {
        $('button[data-target="#tabs01"]').tab('show');
        $('button[data-target="#tabs01"]').on('shown.bs.tab', function () {
            const offset = 100;
            const $target = $('#tabs01');
            if ($target.length) {
                $('html, body').animate({
                    scrollTop: $target.offset().top - offset
                }, 500);
            }
        });
    }
    function validateData() {
        if (!ValidateControls("Vui lòng nhập tên dự án !", "#name", '#name-er')) {
            $('#name').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Vui lòng chọn địa điểm dự án !", "#location", '#location-er')) {
            $('#location').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập đơn vị đăng ký !", "#unit", '#unit-er')) {
            $('#unit').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập họ và tên !", "#fullname", '#fullname-er')) {
            $('#fullname').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập chức danh !", "#role", '#role-er')) {
            $('#role').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập Email !", "#email", '#email-er')) {
            $('#email').focus(); gotab1();
            return false;
        }
        var mail = $('#email').val();
        if (!isValidEmailAddress(mail)) {
            gotab1();
            $("#email-er").html("email không hợp lệ").show();
            $('#email').focus();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập số điện thoại !", "#mobile", '#mobile-er')) {
            gotab1();
            $('#mobile').focus();
            return false;
        }
        var phone = $('#mobile').val();
        if (phone.length < 9 || phone.length > 12) {

            $("#mobile-er").html("Số điện thoại không hợp lệ.").show();
            gotab1();
            $('#mobile').focus();
            return false;
        }
        if (!isInteger(phone)) {

            $("#mobile-er").html("Số điện thoại không hợp lệ.").show();

            gotab1();
            $('#mobile').focus();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập chủ dự án !", "#organ", '#organ-er')) {
            $('#organ').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập cơ quan chủ quản !", "#UnitDev", '#UnitDev-er')) {
            $('#organ').focus(); gotab1();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập tổng chi phí !", "#total", '#total-er')) {
            $('#total').focus(); gotab1();
            return false;
        }
        //var total = $('#total').val();
        //if (!isInteger(total)) {
        //    $("#total-er").html("Tổng chi phí phải là số nguyên.").show();
        //    $('#total').focus(); gotab1();
        //    return false;
        //}
        //if (!$("#cusd").hasClass("active") && !$("#cvnd").hasClass("active")) {
        //    $("#Currency-er").html("Vui lòng chọn tiền tệ.").show();
        //    $('#total').focus(); gotab1();
        //    return false;
        //}
        if (!ValidateControls("Vui lòng nhập ngày dự kiến khởi công !", "#time", '#time-er')) {
            $('#time').focus(); gotab1();
            return false;
        }

        if (!ValidateControls("Vui lòng nhập hiện trạng pháp lý !", "#legalStatus", '#legalStatus-er')) {
            $('#legalStatus').focus();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập mô tả ngắn gọn !", "#description", '#description-er')) {
            $('#description').focus();
            return false;
        }
        if ($('#description').val().length > 2500) {

            $('#description').focus();
            return false;
        }
        if ($('#impact').val().length > 1200) {

            $('#impact').focus();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập nguyên tắc chung 1 !", "#rule1", '#rule1-er')) {
            $('#rule1').focus();
            return false;
        }
        if ($('#rule1').val().length > 1000) {

            $('#rule1').focus();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập nguyên tắc chung 2 !", "#rule2", '#rule2-er')) {
            $('#rule2').focus();
            return false;
        }
        if ($('#rule2').val().length > 1000) {

            $('#rule2').focus();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập nguyên tắc chung 3 !", "#rule3", '#rule3-er')) {
            $('#rule3').focus();
            return false;
        }
        if ($('#rule3').val().length > 1000) {

            $('#rule3').focus();
            return false;
        }
        if (!ValidateControls("Vui lòng nhập nguyên tắc chung 4 !", "#rule4", '#rule4-er')) {
            $('#rule4').focus();
            return false;
        }
        if ($('#rule4').val().length > 1000) {

            $('#rule4').focus();
            return false;
        }
        return true;
    }
    function save1() {
        if (!validateData()) {
            return false;
        }
         var param2 = {
             Id: '@Model.Id',
             Name: $("#name").val(),
             Location: $("#location").val(),
             SubType: $("#SubType").val(),
             Unit: $("#unit").val(),
             UnitDev: $("#UnitDev").val(),
             Fullname: $("#fullname").val(),
             Mobile: $("#mobile").val(),
             Role: $("#role").val(),
             Email: $("#email").val(),
             UnitIInfo: '',
             Support: $("#support").val(),
             Organ: $("#organ").val(),
             Total: $("#total").val(),
             Detail: $("#detail").val(),

             Source: $("#source").val(),

             Progress: $("#Progress").val(),
             Time: $("#time").val(),

             LegalStatus: $("#legalStatus").val(),
             Description: $("#description").val(),
             Impact: $("#impact").val(),

             Document: $("#document").val(),
             Rule1: $("#rule1").val(),
             Rule2: $("#rule2").val(),
             Rule3: $("#rule3").val(),
             Rule4: $("#rule4").val(),

             Currency: "VND",

             Type: 2,
        };
        if ($("#cusd").hasClass("active")) {
            param2.Currency = "USD";
        }

        param2.Status = 0;

         $.ajax({
             type: 'POST',
             url: "@Url.Action("SaveData")",
             data: addAntiForgeryToken(param2),
             async: true,
             success: function (data) {

                 if (data.ResponseCode >= 0) {
                      //bootbox.alert("Cập nhật thành công");
                     //setTimeout(function () { window.location = '/User/AddProject2?id=' + data.ResponseCode; }, 500);
                     $('#save').on('hidden.bs.modal', function () {
                         window.location = '/User/AddProject2?id=' + data.ResponseCode;;
                     });
                     $('#save').modal('show');
                 } else {

                     $("#msgBox").text(data.Description).show();
                     return;
                 }
             }
        });
    }
    function send2() {
        $('#send').modal('hide');
         var param2 = {
                     Id: '@Model.Id',
                     Name: $("#name").val(),
                     Location: $("#location").val(),
                     SubType: $("#SubType").val(),
                     Unit: $("#unit").val(),
                     UnitDev: $("#UnitDev").val(),
                     Fullname: $("#fullname").val(),
                     Mobile: $("#mobile").val(),
                     Role: $("#role").val(),
                     Email: $("#email").val(),
                     UnitIInfo: '',
                     Support: $("#support").val(),
                     Organ: $("#organ").val(),
                     Total: $("#total").val(),
                     Detail: $("#detail").val(),

                     Source: $("#source").val(),

                     Progress: $("#Progress").val(),
                     Time: $("#time").val(),

                     LegalStatus: $("#legalStatus").val(),
                     Description: $("#description").val(),
                     Impact: $("#impact").val(),

                     Document: $("#document").val(),
                     Rule1: $("#rule1").val(),
                     Rule2: $("#rule2").val(),
                     Rule3: $("#rule3").val(),
                     Rule4: $("#rule4").val(),

                     Currency: "VND",

                     Type: 2,
                };
                if ($("#cusd").hasClass("active")) {
                    param2.Currency = "USD";
                }

                param2.Status = 1;

                 $.ajax({
                     type: 'POST',
                     url: "@Url.Action("SaveData")",
                     data: addAntiForgeryToken(param2),
                     async: true,
                     success: function (data) {

                         if (data.ResponseCode >= 0) {

                             $('#notebox').on('hidden.bs.modal', function () {
                                window.location = '@Url.Action("ManageProject")';
                             });
                             $('#notebox').modal('show');

                         } else {

                             $("#msgBox").text(data.Description).show();
                             return;
                         }
                     }
                });
    }
    function save2() {
    if (!validateData()) {
        return false;
    }
        $('#send').modal('show');
    }
</script>
