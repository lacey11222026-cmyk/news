@{
    Layout = "~/Views/Shared/_Login.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
<section class="section-login-1" style="background-image: url('/Content/images/bg-dangnhap.jpg');">
    <div class="container-fulid" style="height: inherit;">
        <div class="content">
            <div class="col-left">
                <div class="header-login">
                    <div class="logo">
                        <a href="/">
                            <img src="/Content/images/logo2025.png?vs=01" alt="images">
                        </a>
                    </div>
                    <div class="lang">
                        <button class="bnt-lang">
                            <img src="/Content/images/gb.png" alt="images">
                            <span>English</span>
                            <i class="fas fa-caret-down"></i>
                        </button>
                        <ul class="list-lang">

                            <li><a href="/Home/Language?lang=vi-vn"><img src="/Content/images/vn.png" alt="images"><span>VietNamese</span></a></li>
                            <li><a href="/Home/Language?lang=en-us"><img src="/Content/images/gb.png" alt="images"><span>English</span></a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-right">
                <div class="right-form">
                    <div class="title">
                        <h2>Reset your password</h2>
                      
                    </div>
                    <div id="form-login">

                        @*<div class="f-col">
                            <label for="">Username</label>
                            <input type="text" name="username" autocomplete="off" id="username" placeholder="Enter your username" class="input-cm">
                        </div>*@
                        <div class="f-col">
                            <label for="">Email</label>
                            <input type="text" name="password" autocomplete="new-password" id="email" placeholder="Enter your email address" class="input-cm">
                        </div>
                      
                        
                        <button class="btn-cm btn-blue w-100" onclick="validateData()"><span>Get New Password</span></button>
                      
                        <div class="form-box mt20">
                            <p style="color: red;text-align: left;font-weight:bold" id="msgBox"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="save2" tabindex="-1" role="dialog" aria-labelledby="" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>

            <p class="text-center mt20">Password reset email has been sent to your email.<br> Please check your email to retrieve your new password.</p>
            <div class="text-center mt30 list-inline btn-list-03">

                <div class="text-center mt30"><button type="button" class="btn-blue btn-cm" data-dismiss="modal">Close</button> </div>
            </div>

        </div>
    </div>
</div>

<style>

    .section-login-1 .content .col-right .right-form #form-login .note {
        width: 100%;
        max-width: 17.75rem;
        margin: 0 auto 1.69rem;
        display: block;
        text-align: center;
    }
</style>
<script src="~/Content/js/formvalidate.js?vs=02"></script>

<script>

    function validateData() {
        //if (!ValidateControls("Please enter username !", "#username")) {
        //    return false;
        //}
        if (!ValidateControls("Please enter email !", "#email")) {
            return false;
        }
        var mail = $('#email').val();
        if (!isValidEmailAddress(mail)) {

            $("#msgBox").html("Invalid email").show();

            $('#email').focus();
            return false;
        }
     var param2 = {
         //Username: $("#username").val(),
         Email: $("#email").val()

         };
         $.ajax({
             type: 'POST',
             url: "@Url.Action("ResetPassword")",
             data: addAntiForgeryToken(param2),
             async: true,
             success: function (data) {

                 if (data.success === true) {

                     $('#save2').modal('show');
                     $('#save2').on('hidden.bs.modal', function () {
                         window.location.href = "@Url.Action("Login")";
                     });
                 } else {
                     $("#msgBox").text(data.msg).show();
                     return;

                 }
             }
         });



    }
    //bootbox.alert("Đăng ký thành công");
</script>

