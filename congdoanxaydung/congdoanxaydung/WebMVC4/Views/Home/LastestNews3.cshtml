@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewModel
@if (Model != null)
{
    if (Model.lstdata.Count > 0)
    {
        <div class="newsbook">
            <h2 class="title-cm">
                <a href="@Model.Url">@Model.HeaderTitle</a>
            </h2>
            <ul class="row hidden-xs">
                @foreach (var item in Model.lstdata.Select((value, i) => new { i, value }))
                {
                    <li class="col-md-3 col-sm-3 col-xs-3">
                        <a href="@item.value.LinkUrl">
                            <img alt="@item.value.Title" src="@item.value.MainImage?w=135&h=191&mode=crop"/>
                            <span>@item.value.Title</span>
                        </a>
                    </li>

                }

            </ul>
            <div class="block-xs">
                <ul id="flexiselDemo2">
                    @foreach (var item in Model.lstdata.Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="@item.value.LinkUrl">
                                <img alt="@item.value.Title" src="@item.value.MainImage?w=380&h=480&mode=crop" />
                                <span>@item.value.Title</span>
                            </a>
                        </li>

                    }
                </ul>
            </div>
        </div>
    }
}