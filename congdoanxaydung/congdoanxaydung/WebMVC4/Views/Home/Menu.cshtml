@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>
<header class="header">
    <img src="/Content/images/bnr-gif.gif" alt="Công đoàn Xây dựng Việt Nam" class="bnr-img">
    <div class="container">
        <div class="logo pull-left">
            <a href="/"><img src="/images/banner2019.png?vs=201903" alt="Công đoàn Xây Dựng Việt Nam"></a>
        </div>
    </div>
    <nav class="nav_top">
        <ul class="container">
            <li class="active"><a href="/"><img src="/Content/images/ico-home.png" alt="Trang chủ"></a></li>
            @if (Model != null)
            {

                if (Model.Count > 0)
                {
                    foreach (var item in Model.Select((value, i) => new {i, value}))
                    {

                        <li>
                            <a id="cate_@item.value.Id" rel="ct@(item.i + 2)" href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name </a>
                            @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                        </li>
                    }
                }
            }
        </ul>
    </nav>

</header><!-- end header-->
<div class="nav-mobile">
    <div class="header-m">
        <a href="/">
            <img src="/Content/images/bnr-gif.gif" alt="Công đoàn Xây dựng Việt Nam" class="bnr-img">
            <img src="/images/banner2019.png?vs=201903" alt="Công đoàn Xây Dựng Việt Nam" class="m-logo pull-left">
        </a>
        <a href="#menu">
            <img src="/Content/images/ico-menu.png" class="ico-menu pull-right">
            <span class="clearfix"></span>
        </a>
    </div>
    <div id="menu">
        <ul>
            @if (Model != null)
            {

                if (Model.Count > 0)
                {
                    foreach (var item in Model.Select((value, i) => new { i, value }))
                    {

                        <li>
                            <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name </a>
                            @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                        </li>
                    }
                }
            }
        </ul>
    </div>
</div>


