@using BIZ.Entity
@using UTILS
@model List<DATA.SurveyItem>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">

            
            <th class="texttable">Câu trả lời</th>

            <th>Thứ tự</th>

           
            <th>Thao Tác</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>

               
                <td class="texttable" style="text-align:left;min-width:150px;">
                    <span id="sp_content_@(obj.Id)" onclick="edititem('@obj.Id')">@obj.Content</span>
                    <input type="text" id="txt_content_@(obj.Id)"  onkeydown="javascript: return AnyInput_KeyDown('@obj.Id', event);" value="@obj.Content" style="display: none;"/>
                </td>
                <td>
                    <span id="sp_order_@(obj.Id)" onclick="edititem('@obj.Id')">@obj.Order</span>
                    <input type="number" id="txt_order_@(obj.Id)" onkeydown="javascript: return AnyInput_KeyDown('@obj.Id', event);" value="@obj.Order" style="display: none;" />
                </td>
               

                <td style="text-align: center">
                    <a href="javascript:;" title="Delete" onclick="DeleteData('@Utils.Base64Encode(obj.Id)')"><i class="fa fa-trash-o"></i></a>
                    
                </td>

            </tr>
        }
    }
</table>
<script type="text/javascript">
    function AnyInput_KeyDown(id, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            
            var param = {
                'SurveyId': '@ViewBag.Id',
                'Content': $("#txt_content_" + id).val(),
                'Status': 1,
                'Id':id,
                'Order': $("#txt_order_" + id).val(),
            };
            $.ajax({
                type: 'POST',
                url: "@Url.Action("SurveyItemSaveData")",
                data: addAntiForgeryToken(param),
            async: true,
            success: function (data) {
                Utils.UnLoading();
                if (data.ResponseCode >= 0) {
                   
                    BindDataRequest();
                }
                else {

                    alert(data.Description);

                }
            }
        });
            return false;
        }

        return true;
    }
    function edititem(id) {
        $("#sp_content_" + id).hide();
        $("#sp_order_" + id).hide();
        $("#txt_content_" + id).show();
        $("#txt_order_" + id).show();
    }

    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest() {
        var params = {

            Id: '@ViewBag.Id'
        };
        var urlRequestAns = '@Url.Action("ListSurveyItem")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListSurveyItem").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
   


   
    function DeleteData(id) {

        bootbox.confirm("Bạn chắc chắn muốn xóa câu hỏi này ??? ", function (result) {
            if (result == true) {
                var postdata= {
                    '_id': id,
                };
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url:"@Url.Action("DeleteSurveyItem")",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest();
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
</script>