@using BIZ
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="news-other mt30">

            <h3 class="title-blue">CÁC BÀI KHÁC</h3>
            <ul class="news-list">
                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    <li><a class="frist_child" title="@item.value.Name" href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Name, "Intro")">@item.value.Name </a></li>
                }
            </ul>



        </div>


    }


}