@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.DOCUMENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="box-cm document border-t-gray bggray">
            <h2 class="title-cm03">
                <a href="/Document/Index/3">Văn bản/Tra cứu</a>
            </h2>
            <ul class="document-list">
                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    <li>
                        <a href="@Url.Action("Detail","Document",new { id=item.value.Id})"
                           title="@item.value.Name">
                            @item.value.Name
                    </a>
                </li>
                }
            </ul>
        </div>
     
    
    }

}