@using BIZ
@using UTILS
@using WebMVC4.Helper
@model DATA.Album

@{
    Layout = "~/Views/Shared/_Home.cshtml";
}


@if (Model != null)
{
    <link href="/fancybox2.1.5/jquery.fancybox.css" rel="stylesheet" />
    <script src="/fancybox2.1.5/jquery.fancybox.js"></script>
    <div class="detail-content">
        @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
        <h3>@Model.Title</h3>
        <p>
            @Html.Raw(Model.Description)
        </p>
        
        @if (ViewBag.ImgList != null)
        {
            <div id="PnlLightBox">
                <ul class="video-list row mt10" id="lstlightbox">
                    @foreach (BIZ.Entity.AlbumImage item in ViewBag.ImgList)
                    {
                        <li class="col-md-3 col-sm-4 col-xs-6">
                            <a href="@(item.Name)?w=0&h=@(ViewBag.Height)&mode=crop" class="chum_anh" title="@item.Text" rel="group">
                                <img src="@(item.Name)?w=263&h=175&mode=crop" 
                                     alt="" />
                            </a>
                        </li>
                    }
                    
                </ul>
                <div class="clear">
                </div>
                @*<script src="/Scripts/jquery.lightbox-0.5.js" type="text/javascript"></script>
                    <link href="/Styles/jquery.lightbox-0.5.css" rel="stylesheet" type="text/css" />*@
                <script type='text/javascript'>

                    $(document).ready(function () {
                        $("#lstlightbox a").fancybox({

                        });
                    });
                </script>
            </div>
        }
    </div>
            }
