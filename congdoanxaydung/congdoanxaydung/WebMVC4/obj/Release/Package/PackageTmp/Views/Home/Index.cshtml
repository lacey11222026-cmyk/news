@using BIZ
@using UTILS
@using WebMVC4.Helper


@{
    Layout = "~/Views/Shared/_Home.cshtml";
}

<div class="row">
    <div class="col-md-8 col-sm-12 col-xs-12">
        @{Html.RenderAction("Slide", "Home");}
    </div><!-- end main content -->
    <div class="col-md-4 col-sm-12 col-xs-12 sidebar border-l-gray hidden-sm">
       @{Html.RenderAction("HomeVideo", "Home", new { CateName = "Thư viện hình ảnh", CategoryId = 6});}
        @{Html.RenderAction("TopDocument", "Home");}
    </div><!-- end sidebar-->

    <div class="clearfix"></div>
</div>
@{Html.RenderAction("Banner", "Home");}
<div class="row item-cm mt20">
    <div class="col-md-4 col-sm-4 col-xs-12 box-item">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "Tin Tổng Liên Đoàn", CategoryId = 7, MaxLastestNews = 3, cssClass = "maxheight02" });}
    </div>
    <div class="col-md-4 col-sm-4 col-xs-12 box-item border-l-gray">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "TIN CÔNG ĐOÀN XÂY DỰNG VIỆT NAM", CategoryId = 8, MaxLastestNews = 3, cssClass = "maxheight02" });}
    </div>
    <div class="col-md-4 col-sm-4 col-xs-12 box-item border-l-gray">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 5, MaxLastestNews = 3, cssClass = "maxheight02" });}
    </div>
</div>
<div class="border-t-gray mt15">
    <div class="row">
        <div class="col-md-8 col-sm-12 col-xs-12">
            @{Html.RenderAction("LastestNews2", "Home", new { CateName = "", CategoryId = 15, MaxLastestNews = 5 });}
            <div class="clearfix"></div>
            @{Html.RenderAction("Banner2", "Home");}
        </div>
        <div class="col-md-4 col-sm-12 col-xs-12 hidden-sm" >
            @{Html.RenderAction("RightLastestNews", "News", new { CateName = "", CategoryId = 41, MaxLastestNews = 3 });}
            <div class="bnr-link mt20" id="bannerright">
                @{Html.RenderAction("BannerRight", "Home",new {top=2});}

            </div>

        </div>
    </div>
</div>
<div class="row item-cm mt20">
    <div class="col-md-4 col-sm-4 col-xs-12 box-item">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 48, MaxLastestNews = 3, cssClass = "maxheight" });}
    </div>
    <div class="col-md-4 col-sm-4 col-xs-12 box-item border-l-gray">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 39, MaxLastestNews = 3, cssClass = "maxheight" });}
    </div>
    <div class="col-md-4 col-sm-4 col-xs-12 box-item border-l-gray">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 45, MaxLastestNews = 3, cssClass = "maxheight" });}
    </div>
</div>

<div class="only-sm">
    <div class="news-general mt30">
        @{Html.RenderAction("TopAlbum2", "Home", new { CateName = "Thư viện hình ảnh", CategoryId = 42, Top = 4 });}
    </div>
    <div class="clearfix"></div>
    <div class="row-8px">
        <div class="col-sm-6 col-xs-12">
            @{Html.RenderAction("TopDocument2", "Home");}
        </div>
        <div class="col-sm-6 col-xs-12">
           @{Html.RenderAction("RightLastestNews2", "News", new { CateName = "", CategoryId = 41, MaxLastestNews = 3 });}
        </div>

    </div>
</div>
<div class="row mt20">
    <div class="col-md-8 col-sm-12 col-xs-12">
        @{Html.RenderAction("LastestNews3", "Home", new { CateName = "", CategoryId = 40, MaxLastestNews = 4  });}
    </div><!-- end col-md-8-->

    <div class="col-md-4 col-sm-12 col-xs-12 ">
        @*@{Html.RenderAction("HomeVote", "Vote");}*@
