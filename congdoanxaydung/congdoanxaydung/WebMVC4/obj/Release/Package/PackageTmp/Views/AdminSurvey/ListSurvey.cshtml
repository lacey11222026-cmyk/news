@using BIZ.Entity
@using UTILS
@model List<DATA.Survey>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">

            <th>Mã</th>
            <th class="texttable">Tên khảo sát</th>

            <th>Loại khảo sát</th>
            
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Trạng Thái</th>
            <th>Thao Tác</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>

                <td>@obj.Id</td>
                <td class="texttable" style="text-align:left;min-width:150px;">
                    <a href="@Url.Action("SurveyDetail",new {id=obj.Id })" title="Edit">@obj.Title</a>
                </td>

                <td>
                    @if (obj.Type == 1)
                    {
                        <text>Chọn một đáp án</text>

                    }
                    else
                    {
                        <text>Chọn nhiều đáp án</text>

                    }
                </td>

                <td>@obj.BeginDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@obj.EndDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatus('@Utils.Base64Encode(obj.Id)', 1,'@obj.Title');"><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatus('@Utils.Base64Encode(obj.Id)',0,'@obj.Title');"><i class="fa fa-ban"></i></a>

                    }
                </td>

                <td style="text-align: center">
                    <a href="javascript:;" onclick="CommonCtrl.PopupManagerPage('@Url.Action("SurveyItem", new {Id=obj.Id})')">Danh sách câu trả lời</a>&nbsp;
                    <a href="javascript:;" title="Delete" onclick="DeleteData('@Utils.Base64Encode(obj.Id)', '@obj.Title')"><i class="fa fa-trash-o"></i></a>

                </td>

            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
           
            status: $('#ddlStatus :selected').val(),

            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListSurvey")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListSurvey").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });


    function UpdateStatus(id, status, title) {
        var type = "Khóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " khảo sát này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                var postdata = {
                    '_id': id,
                    'Title': title,
                };
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("SurveyUpdateStatus")",
                    data: addAntiForgeryToken(postdata),

                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
    function DeleteData(id,title) {
      
        bootbox.confirm("Bạn chắc chắn muốn xóa khảo sát này ??? ", function (result) {
            if (result == true) {
                var postdata= {
                    '_id': id,
                    'Title': title,
                };
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url:"@Url.Action("DeleteSurvey")",
                    data: addAntiForgeryToken(postdata),
                success: function (data) {
                    Utils.UnLoading();
                    if (data.ResponseCode >= 0) {
                        bootbox.alert(data.Description);
                        BindDataRequest(CurrentPage);
                    }
                    else {
                        bootbox.alert(data.Description);
                        return;
                    }
                }
            });
        }
        });

    }
</script>