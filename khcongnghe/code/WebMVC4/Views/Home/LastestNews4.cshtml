{
    if (Model.Count > 0)
    {
        
   

    <div class="bg_grey">
        <div class="bg_blu">
            <a href="@ViewBag.Url">@ViewBag.CateName</a></div>
        <div class="box_anh">
          @foreach (var item in Model.Select((value, i) => new { i, value }))
        {
