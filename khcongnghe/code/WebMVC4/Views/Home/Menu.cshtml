@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>
<header class="header">
    <img src="/Content/images/bnr-img.png" alt="Khoa học công nghệ ngành Công Thương" class="bnr-img">
    <div class="container">
        <div class="logo pull-left"><a href="/"><img src="/Content/images/logo.png" alt="Khoa học công nghệ ngành Công Thương"></a></div>
    </div>
    <nav class="nav_top">
        <ul class="container">
            <li class="active"><a href="/"><img src="/Content/images/ico-home.png" alt="Trang chủ"></a></li>
            @if (Model != null)
            {

                if (Model.Count > 0)
                {
                    foreach (var item in Model.Select((value, i) => new { i, value }))
                    {

                        <li>
                            <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)" @(item.value.Type.GetValueOrDefault() == 11 ? " target='_blank'" : "")>@item.value.Name </a>
                            @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                        </li>
                    }
                }
            }
        </ul>
    </nav>

</header><!-- end header-->
<div class="nav-mobile">
    <div class="header-m">
        <img src="~/Content/images/bnr-img.png" alt="Khoa học công nghệ ngành Công Thương" class="bnr-img">
        <a href="/">
            <img src="~/Content/images/logo.png" alt="Khoa học công nghệ ngành Công Thương" class="m-logo pull-left">
        </a>
        <a href="#menu">
            <img src="~/Content/images/ico-menu.png" class="ico-menu pull-right">
            <span class="clearfix"></span>
        </a>
    </div>
    <div id="menu">
        <ul>
            @if (Model != null)
            {

                if (Model.Count > 0)
                {
                    foreach (var item in Model.Select((value, i) => new { i, value }))
                    {

                        <li>
                            <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)" @(item.value.Type.GetValueOrDefault() == 11 ? " target='_blank'" : "")>@item.value.Name </a>
                            @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                        </li>
                    }
                }
            }
        </ul>
    </div>
</div>


