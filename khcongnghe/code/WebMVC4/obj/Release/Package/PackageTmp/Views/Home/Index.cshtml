@using BIZ
@using UTILS
@using WebMVC4.Helper


@{
    Layout = "~/Views/Shared/_Home.cshtml";
}

<div class="row">
    <div class="col-md-8 col-sm-12 col-xs-12">
        <div class="row">
            @{Html.RenderAction("Slide", "Home");}
            <div class="clearfix"></div>
            @{Html.RenderAction("Banner", "Home");}
        </div>
    </div><!-- end main content -->
    <div class="col-md-4 col-sm-12 col-xs-12 sidebar">
        <div class="row">
            <ul class="bnr-linkhot hidden-xs">
                @{Html.RenderAction("BannerRight", "Home", new { top = 2 });}
            </ul>
            <div class="col-md-12 col-sm-12 col-xs-12 box-document hidden-sm">
                @{Html.RenderAction("TopDocument", "Home");}
            </div>
            <ul class="col-md-12 bnr-link hidden-sm">
                @{Html.RenderAction("BannerRight2", "Home");}
            </ul>

        </div>
    </div><!-- end sidebar-->

    <div class="clearfix"></div>
</div>

<div class="row item-cm mt10">
    <div class="col-md-4 col-sm-4 col-xs-12 box-item">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "CHÍNH SÁCH KHCN", CategoryId = 7, MaxLastestNews = 3, cssClass = "maxheight02" });}
    </div>
    <div class="col-md-4 col-sm-4 col-xs-12 box-item border-l-gray">
        @{Html.RenderAction("LastestNewsAPI", "Home", new { CateName = "CÔNG NGHIỆP 4.0", CategoryId = 15, MaxLastestNews = 3, cssClass = "maxheight02" });}
    </div>
    <div class="col-md-4 col-sm-4 col-xs-12 box-item border-l-gray">
        @{Html.RenderAction("LastestNewsAPI", "Home", new { CateName = "", CategoryId = 20, MaxLastestNews = 3, cssClass = "maxheight02" });}
    </div>
</div>

<div class="border-t-gray mt15">
    <div class="row">
        <div class="col-md-8 col-sm-12 col-xs-12">
            @{Html.RenderAction("LastestNews2", "Home", new { CateName = "Tin Khoa học và Công nghệ", CategoryId = 5, MaxLastestNews = 5 });}
            <div class="clearfix"></div>
            @{Html.RenderAction("Banner2", "Home");}
        </div>
        <div class="col-md-4 col-sm-12 col-xs-12">
            <div class="row">
                <div class="col-md-12 col-sm-6 col-xs-12">

                    @{Html.RenderAction("HomeVideo", "Home", new { CateName = "", CategoryId = 6 });}

                </div>
                <div class="col-md-12 col-sm-6 col-xs-12 box-document block-sm">
                    @{Html.RenderAction("TopDocument", "Home");}

                    <ul class="bnr-linkhot block-xs row">
                        @{Html.RenderAction("BannerRight", "Home", new { top = 2 });}
                    </ul>

                </div>
                <div class="col-md-4 col-sm-6 col-xs-12 mt20 block-sm">
                    <div class="document-suport border-l-gray">
                        @Html.Partial("_DocMenu")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row item-cm mt20">
    <div class="col-md-4 col-sm-4 col-xs-12 box-item">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 37, MaxLastestNews = 3, cssClass = "maxheight" });}
    </div>
    <div class="col-md-4 col-sm-4 col-xs-12 box-item border-l-gray">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 38, MaxLastestNews = 3, cssClass = "maxheight" });}
    </div>
    <div class="col-md-4 col-sm-4 col-xs-12 box-item border-l-gray">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 36, MaxLastestNews = 3, cssClass = "maxheight" });}
    </div>
</div>
<div class="row item-cm mt20">
    <div class="col-md-8 col-sm-12 col-xs-12" style="margin-top:-30px">
        @{Html.RenderAction("LastestNews2", "Home", new { CategoryId = 35, MaxLastestNews = 5 });}

    </div>
    <div class="col-md-4 col-sm-12 col-xs-12 hidden-sm">
        <div class="document-suport border-l-gray mt30">
            @Html.Partial("_DocMenu")
        </div>
    </div>
</div>
<div class="row mt20">
    <div class="col-md-12 col-sm-12 col-xs-12">
        @{Html.RenderAction("LastestNews3", "Home", new { CateName = "", CategoryId = 18, MaxLastestNews = 6 });}

    </div><!-- end col-md-8-->
    <!-- end col-md-4-->

</div><!-- end row-->
