@using BIZ
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.CONTENT_FULL
@{var RelateTitle = "Các tin khác";}
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
@if (Model != null)
{
    <div class="row-8px detail-page">
        <div class="col-md-3 col-sm-4 col-xs-12 detail-news">
            @{Html.RenderAction("TopViewNews", "News", new { CategoryId = Model.CategoryId, MaxLastestNews = 8 });}
        </div>
        <div class="col-md-9 col-sm-8 col-xs-12 detail-content ">
            <h2 class="title-blue"><a href="@ViewBag.Url">@Model.CategoryName</a></h2>
            <span class="news-date">Cập nhật lúc @Model.PublishDate.ToString("HH:mm") ngày @Model.PublishDate.ToString("dd/MM/yyyy")</span>
            <h3>@Model.Title</h3>

            <div class="tinlienquan">
                <ul class="related-posts">
                    @if (ViewBag.lstRef != null)
                    {
                        foreach (var item in ViewBag.lstRef)
                        {
                            <li>
                                <a href="@Utils.FormatUrlRewrite(item.Id, item.Title, "ArticleDetail")">@item.Title </a>
                            </li>
                        }

                    }
                </ul>
            </div>
            <div class="nd" id="NewsContent">
                @Html.Raw(Model.Contents.Replace("font-size: small", ""))
            </div>
            @if (!string.IsNullOrEmpty(Model.FileParam.Name1))
            {
                <div class="document-attach">
                    <div class="bg_org"><span class="icon-attach"></span> Tài liệu đính kèm <div class="clear"></div></div>
                    <ul class="list">

                        <li><a title="@Model.FileParam.Name1" href="@Model.FileParam.Path1" target="_blank">@Model.FileParam.Name1 </a></li>
                        @if (!string.IsNullOrEmpty(Model.FileParam.Name2))
                        {
                            <li><a title="@Model.FileParam.Name2" href="@Model.FileParam.Path2" target="_blank">@Model.FileParam.Name2 </a></li>
                        }
                        @if (!string.IsNullOrEmpty(Model.FileParam.Name3))
                        {
                            <li><a title="@Model.FileParam.Name3" href="@Model.FileParam.Path3" target="_blank">@Model.FileParam.Name3 </a></li>
                        }




                    </ul>
                    <div class="clear"></div>
                </div>
            }
            <div class="clearfix"></div>
            @if (Model.SiteUrl != null)
            {
                if (!String.IsNullOrEmpty(Model.SiteUrl.Trim()))
                {
                    <div class="tags mt20">
                        <span class="pull-left">Tag:</span>
                        <ul class="list-inline">
                            @foreach (var item in Model.SiteUrl.Split(',').Select((value, i) => new { i, value }))
                            {
                                <li>  <a href="@Url.Action("Search", new { q = item.value.Trim() })">@item.value.Trim()</a></li>
                            }
                        </ul>
                    </div>

                }
            }
            <ul class="detail-link clearfix mt20 brbottom">
                <li>  <div class="fb-like" data-href="@(Model.LinkUrl)" data-layout="button_count" data-action="like" data-show-faces="false" data-share="true"></div></li>
                <li>
                    <div style="position:relative;top:6px">
                        <div class="zalo-share-button" data-href="@(Model.LinkUrl)" data-oaid="579745863508352884" data-layout="2" data-color="blue" data-customize=false></div>
                    </div>

                </li>
                <li><a href="javascript:void(0);" onclick="openWin('@ViewBag.MailShare');"><img src="/Content/images/ico-mail.png"></a></li>
                @*<li><a href="#"><img src="/Content/images/ico-link.png"></a></li>*@
                <li><a href="@Url.Action("Print", "News", new {Id=Model.Id})" target="_blank"><img src="/Content/images/ico-print.png"></a></li>
            </ul>

            <div class="clearfix"></div>

            <div class="news-other mt30">
                @{Html.RenderAction("Relate", "News", new { CategoryId = Model.CategoryId });}

            </div>

        </div>
    </div><!-- end big news-->


}
<script>
    $('.news_detail_img').removeAttr('style');
    $('.news_detail_img').attr('style', 'margin:0 auto;text-align:center');
    $('#NewsContent table').removeAttr('width');
    $('#NewsContent span img').removeAttr('width');
    $('#NewsContent img').removeAttr('width');
    $('#NewsContent img').removeAttr('height');
    $('#NewsContent img').removeAttr('style');

</script>
<style>
    #NewsContent ul {
        display: block;
        list-style-type: disc;
        margin-block-start: 1em;
        margin-block-end: 1em;
        margin-inline-start: 0px;
        margin-inline-end: 0px;
        padding-inline-start: 40px;
    }

    #NewsContent li {
        display: list-item;
        list-style-type: disc;
        text-align: -webkit-match-parent;
    }
</style>
<script type="text/javascript">



    function openWin(url) {
        var myWindow = window.open(url, '', 'width=700,height=500');
        myWindow.focus();
    }
</script>