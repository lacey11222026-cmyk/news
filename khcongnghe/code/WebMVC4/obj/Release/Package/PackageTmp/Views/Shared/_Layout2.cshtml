</head>
<body onorientationchange="updateOrientation();">
    @{Html.RenderAction("Menu", "Home");}
    <div>
        @Html.Partial("Site_Header")
        <section class="content-wrap container">
            <div class="row">
                <div class="col-md-9 col-sm-12 col-xs-12">
                    @RenderBody()
                </div><!-- end main content -->
                <div class="col-md-3 col-sm-12 col-xs-12 sidebar">
                    @Html.Partial("Site_Right")
                </div><!-- end sidebar-->

                <div class="clearfix"></div>
            </div>
            @{Html.RenderAction("BannerBottom", "Home");}
            @{Html.RenderAction("MenuBottom", "Home");}
            <div class="clearfix"></div>
            @Html.Partial("Site_Footer")
        </section>

    </div>

    <div id="top_gototop"><a href="javascript:;" class="gototop clearfix"><img src="/Content/images/gotop.png" alt="lên đầu trang" /></a></div>
    <div id="fb-root"></div>
    <div class="clearfix">
    </div>
    @Scripts.Render("~/sitescript")
    <script>
        function updateOrientation() {
            window.location.reload();
        }
    </script>
    <script src="/Content/js/script.js"></script>
    <script src="https://sp.zalo.me/plugins/sdk.js"></script>
    <script>

        (function (d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
            js = d.createElement(s); js.id = id;
            js.src = "//connect.facebook.net/vi_VN/sdk.js#xfbml=1&version=v2.8&appId=275786053207358";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));
