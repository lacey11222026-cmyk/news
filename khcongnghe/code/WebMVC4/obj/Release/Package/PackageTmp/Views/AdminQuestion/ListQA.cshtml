@using DATA
@model List<QA>

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            @*<th>STT </th>*@
            <th>Họ và tên</th>
            <th>Email</th>
            <th>Câu hỏi</th>
            <th>Trạng Thái</th>
            <th>Chức Năng</th>
            <th>Sắp Xếp</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            <tr>
                @*<td>@obj.Id</td>*@
                <td style="text-align:left"><a href="@Url.Action("Info",new { id=obj.Id})">@obj.Name </a></td >
                <td style="text-align:left"><a href="@Url.Action("Info",new { id=obj.Id})">@obj.Email </a></td>
                <td style="text-align:left"><a href="@Url.Action("Info",new { id=obj.Id})">@obj.Question</a></td>


                <td>
                    @if (obj.Status == 1)
                    {
                        <text> Đã xuất bản</text>

                    }
                    else
                    {
                        <text> Đợi xuất bản</text>

                    }
                </td>

                <td style="text-align:center">



                    <a href="@Url.Action("Info",new { id=obj.Id})"><i class="fa fa-edit"></i></a>



                    <a href="javascript:;" title="Delete" onclick="DeleteData(@obj.Id)"><i class="fa fa-trash-o"></i></a>

                </td>
                <td>
                    <a href="javascript:;" onclick="UpdateSortOrder(@obj.Id,1)"><i class="fa fa-arrow-up"></i></a>

                    <a href="javascript:;" onclick="UpdateSortOrder(@obj.Id,0)"><i class="fa fa-arrow-down"></i></a>
                </td>



            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            status: $('#ddlActive :selected').val(),
            lang: $('#txtTitle').val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = "/AdminQuestion/ListQA";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListQA").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });
    function UpdateSortOrder(Id, UpOrder) {
        var param = {
            Id: Id,
            SortOrder: UpOrder
        }
        $.ajax({
            type: 'POST',
            url: '/AdminQuestion/UpdateSortOrder',
            data: JSON.stringify(param),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: true,
            success: function (data) {
                Utils.UnLoading();
                var msg = data.Msg;
                if (data.ResponseCode > 0) {
                    BindDataRequest(CurrentPage);
                }
                else {
                    bootbox.alert(msg);
                }
            }
        });
    }
    function UpdateStatus(id,status) {
        var type = "Vô hiệu hóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " câu hỏi này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/AdminQuestion/UpdateStatus",
                    data: {
                        'id': id
                    },
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
    function DeleteData(id) {
        var IsDelete = "true"
        if (IsDelete != "true") {
            bootbox.alert("Bạn không có quyền xóa ");
            return;
        }
        bootbox.confirm("Bạn chắc chắn muốn xóa trang này ??? ", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/AdminQuestion/Delete",
                    data: {
                        'id': id
                    },
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
</script>
