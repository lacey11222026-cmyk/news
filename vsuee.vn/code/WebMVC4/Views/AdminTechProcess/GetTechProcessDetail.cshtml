@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@using DATA
@model TechProcess

<div class="well">
    <span class="label label-danger">
        Chú ý!
    </span>
    <span>
        Hãy chắc chắn nhập vào đầy đủ thông tin tại các mục bắt buộc đánh dấu (*)
    </span>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-fw fa-user-md"></i><span>@ViewBag.Title </span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel panel-info">
                        <div id="Errordiv" style="margin:20px;color:red;font-size:13pt"><center></center></div><br />
                        @*<div class="panel-heading">
                                <h4 class="panel-title"><i class="fa fa-wrench" style="margin-right:7px"></i>Thông Tin Cơ Bản</h4>
                            </div>*@
                        <div style="padding: 10px 0 0 0;background-color:#fff !important">

                            <div class="col-md-12">
                                <div>
                                    <!-- dành cho UpdateFunction -->
                                    <div class="form-group">
                                        <label for="txtTitle" class="control-label col-md-5">Tên quy trình </label>
                                        <div class="col-md-7">
                                            <div class="input-icon right">
                                                <input type="text" id="txtTitle" name="title" value="@Model.Name" class="form-control" placeholder="Nhập tên" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtScale" class="control-label col-md-5">Quy mô </label>
                                        <div class="col-md-7">
                                            <div class="input-icon right">
                                                <input type="text" id="txtScale" name="Scale" value="@Model.Scale" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtTopic" class="control-label col-md-5">Đề tài </label>
                                        <div class="col-md-7">
                                            <div class="input-icon right">
                                                <input type="text" id="txtTopic" name="Topic" value="@Model.Topic" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtCode" class="control-label col-md-5">Mã số Đề tài/Dự án SXTN </label>
                                        <div class="col-md-7">
                                            <div class="input-icon right">
                                                <input type="text" id="txtCode" name="Code" value="@Model.Code" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtOrgan" class="control-label col-md-5">Cơ quan chủ trì </label>
                                        <div class="col-md-7">
                                            <div class="input-icon right">
                                                <input type="text" id="txtOrgan" value="@Model.Organ" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtCreatedBy" class="control-label col-md-5">Cá nhân chủ nhiệm  </label>
                                        <div class="col-md-7">
                                            <div class="input-icon right">
                                                <input type="text" id="txtCreatedBy" value="@Model.CreatedBy" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtFromDate" class="control-label col-md-5">Thời gian thực hiện Đề tài/Dự án SXTN </label>
                                        <div class="col-md-7">
                                            <div class="input-icon right">
                                                <input type="text" id="txtFromDate" name="FromDate" value="@Model.FromDate" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtStatus" class="control-label col-md-5">Tình trạng sở hữu trí tuệ (nếu có)</label>
                                        <div class="col-md-7">
                                            <div class="input-icon right">
                                                <input type="text" id="txtStatus" name="Status" value="@Model.Status" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtCode2" class="control-label col-md-5">Số giấy chứng nhận sở hữu trí tuệ/công nghiệp (nếu có)</label>
                                        <div class="col-md-7">
                                            <div class="input-icon right">
                                                <input type="text" id="txtCode2" name="code2" value="@Model.Code2" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtResult" class="control-label col-md-5">Tình trạng ứng dụng quy trình sản xuất trong và sau khi hoàn thành quy trình </label>
                                        <div class="col-md-7">
                                            <div class="input-icon right">
                                                <input type="text" id="txtResult" name="Result" value="@Model.Result" class="form-control" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="txtFilePath" class="control-label col-md-5">File</label>
                                        <div class="col-md-6">
                                            <div class="input-icon right">
                                                <input type="text" id="txtFilePath" name="txtFilePath" value="@Model.FilePath" class="form-control" placeholder="" />
                                            </div>
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtFilePath');"><i class="fa fa-file"></i></a>
                                        </div>
                                    </div>





                                    <div class="panel-footer form-horizontal">
                                        <div class="form-group submit">


                                            <button type="submit" class="btn btn-primary" id="btsubmit"><i class="fa fa-save"></i>Lưu lại</button>
                                            <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage();"><i class="fa fa-backward"></i>Quay lại</button>
                                        </div>
                                    </div>



                                </div>
                            </div>
                            <div style="clear:both"></div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    $('#menu_techprocess').addClass("active");

</script>
<script>
    function GotoListpage() {
        window.location = '@Url.Action("Index")';
    }
    $(document).ready(function () {




        $('#txtPublicTime').datetimepicker({
            //pickTime: false
        });
        $("button.close").click(function () {
            $(this).parent().css("display", "none");
        });
        $('#defaultForm').bootstrapValidator({
            message: 'This value is not valid',
            //live: 'submitted',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {

                title: {
                    message: 'Nhập tên quy trình',
                    validators: {
                        notEmpty: {
                            message: 'tên quy trình không được bỏ trống'
                        },

                        stringLength: {
                            min: 10,
                            max: 250,
                            message: 'tên quy trình nhỏ nhất 10 ký tự và nhiều nhất 250 ký tự'
                        },

                    }
                },

                


            }
        })
        .on('success.form.bv', function (e) {
            // Prevent submit form
            e.preventDefault();

            var $form = $(e.target),
                validator = $form.data('bootstrapValidator');
            SaveData();
            $(".close").click(function () {
                $(".alert-success").css("display", "none");
            });
        })
        .on('error.form.bv', function (e) {
            // Active the panel element containing the first invalid element
            e.preventDefault();
            var $form = $(e.target),
            validator = $form.data('bootstrapValidator');
            $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
            $(".alert-danger").css("display", "block");
            $(".close").click(function () {
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
        });

        $("#btnReset").click(function () {
            $('#defaultForm').data('bootstrapValidator').resetForm(true);
            $(".alert-danger").css("display", "none");
            $(".alert-success").css("display", "none");
        });

        //Save Data
        function SaveData() {
            var param = {
                'Id': '@Model.Id',
                'Name': $("#txtTitle").val(),
                'Scale': $("#txtScale").val(),
                'Topic': $("#txtTopic").val(),
                'Organ': $("#txtOrgan").val(),
                'CreatedBy': $("#txtCreatedBy").val(),
                'Code': $("#txtCode").val(),
                'Result': $("#txtResult").val(),
                'Code2': $("#txtCode2").val(),
                'FromDate': $("#txtFromDate").val(),
                'Result': $("#txtResult").val(),
                'FilePath': $('#txtFilePath').val(),
                'Status': $("#txtStatus").val()

            }
            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "@Url.Action("SaveData")",
                data: addAntiForgeryToken(param),
            async: true,
            success: function (data) {
                Utils.UnLoading();
                if (data.ResponseCode >= 0) {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $(".alert-success").show("slow");
                    $(".alert-danger").hide("slow");
                    setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 500);

                }
                else {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $("#ErrorMessage").text(data.Description);
                    $(".alert-danger").show("slow");
                    $(".alert-success").hide("slow");
                    setTimeout(function () { $(".alert-danger").hide("slow"); }, 2000);
                }
            }
        });
    };
    });
</script>
<style>
    .input-icon {
        position: relative;
        width: 100%;
    }
</style>