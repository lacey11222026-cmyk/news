@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.Album_FULL>
@if (Model != null)
{
<div class="row row-50">
    <div class="col-md-6 col-sm-12">
        @foreach (var item in Model.Take(1).Select((value, i) => new { i, value }))
        {
            <div>
                <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "AlbumDetail")"><img src="@item.value.MainImage?w=640&h=360&mode=crop" alt="" class="w-100"></a>
                <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "AlbumDetail")" class="big-name font-weight-bold mt15">@item.value.Title</a>
                <p class="date02 mt15">@item.value.PublishDate.GetValueOrDefault().ToString("dd/MM/yyyy")</p>
                @*<p class="mt15">Tài sản của 400 người giàu nhất nước Mỹ (Forbes 400) đã tăng mạnh trong 20 năm qua. Để lọt vào Forbes 400 năm 2022, các tỷ phú phải sở hữu tài sản ít nhất 2,7 tỷ USD. Để lọt vào Forbes 400 năm 2022 Tài sản của 400 người giàu nhất nước Mỹ (Forbes 400) đã tăng mạnh trong 20 năm qua. Để lọt vào Forbes 400 năm 2022, các tỷ </p>*@
            </div>

        }
    </div>
    <div class="col-md-6 col-sm-12">
        <ul class="video-list">
            @foreach (var item in Model.Skip(1).Select((value, i) => new { i, value }))
            {
                <li>
                    <div>
                        <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "AlbumDetail")"><img src="@item.value.MainImage?w=256&h=150&mode=crop" alt=""></a>
                        <div>
                            <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "AlbumDetail")">@item.value.Title </a>
                            <p class="date02 mt10">@item.value.PublishDate.GetValueOrDefault().ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </li>
            }
            </ul>
    </div>
</div>
   
    
}





