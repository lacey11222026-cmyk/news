        <h2 class="title-cm"><a href="/su-kien.html">SỰ KIỆN</a></h2>
        <div class="mt40">
            <div class="slick04">

                @{Html.RenderAction("TopMission", "Home", new { lang = langpage });}
            </div>
        </div>
    </div><!-- end event-->

    <div class="support-box pt60 pb60 container">
        <h2 class="title-cm"><a href="#">ĐƠN VỊ TƯ VẤN</a></h2>
        <div class="mt30">
            <ul class="slick05">
                @{Html.RenderAction("BannerRight2", "Home", new { lang = langpage });}
            </ul>
        </div>
    </div>
