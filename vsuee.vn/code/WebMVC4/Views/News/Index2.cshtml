        </div>
        <div class="col-md-9 col-sm-12">
            @*<div class="">
            <div class="date-icon">
                <label>Xem theo ngày </label>
                <div id="datepicker" class="input-group date" data-date-format="dd-mm-yyyy">
                    <input class="form-control" readonly="" type="text">
                    <span class="input-group-addon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                </div>
            </div>
        </div>*@
            @if (Model.articles != null)
            {
                if (Model.articles.Count() > 0)
                {
                    <ul class="row video-list-02 mt30">
                        @foreach (var item in Model.articles.Select((value, i) => new { i, value }))
                        {
                            <li class="col-md-4 col-6">
                                <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=491&h=291&mode=crop" alt="" class="w-100"></a>
                                <a href="@item.value.LinkUrl" class="mt15 font-weight-bold dis-block"> @item.value.Title</a>
                            </li>
                        }
                    </ul>

                    <div class="paging mt50 text-center">
                        <ul>
                            @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                                {
                                    PageUrl = Url.SetParameter("Page", "!0"),
                                    CurrentPage = ViewBag.Page,
                                    PageSize = ViewBag.PageSize,
                                    TotalItemCount = ViewBag.Total,
                                }); }
                        </ul>
                    </div>
                }
            }

        </div>

    </div>
</div><!-- end main content-->
<div class="bg-gray pt40 pb40">
    <div class="container">
        <ul class="slick02">
            @{Html.RenderAction("BannerBottom", "Home", new { lang = langpage });}
        </ul>
    </div>
</div>