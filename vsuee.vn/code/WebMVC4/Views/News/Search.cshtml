@using BIZ
@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel
@{
    var langpage = WorkContext.GetLanguage();
}
@if (Model != null)
{
    <div class="post-new-page container pb60 pt40">
        <div class="row row-50">
            <div class="col-lg-8 col-md-12">
                <div class="post-hot">
                    <h2 class="title-cm-02"><a href="#">@Resources.Global.MenuSearch</a></h2>

                    <div class="mt30">
                        <div class="text-center document-search">

                            <div class="form-group">
                                <label class="">@Resources.Global.Keyword</label>
                                <input id="txtkeyword" class="form-control" type="text" value="@ViewBag.keyword" width="100">
                            </div>

                            <div class="form-group">
                                <label>@Resources.Global.FromDate</label>
                                <input id="txtfromdate" placeholder="dd/MM/yyyy" value="@ViewBag.fromdate" class="form-control" width="80">
                            </div>
                            <div class="form-group">
                                <label>@Resources.Global.ToDate</label>
                                <input id="txttodate" placeholder="dd/MM/yyyy" value="@ViewBag.todate" class="form-control" width="80">
                            </div>

                            <div>
                                <a href="javascript:;" onclick="searchnews();" class="btn-green">@Resources.Global.MenuSearch</a>
                            </div>
                            @*<button type="button" onclick="searchnews();" class="btn-search">@Resources.Global.MenuSearch</button>*@

                        </div>
                    </div>
                    <div style="display: none">
                        <label class="">Chuyên mục</label>
                        @Html.DropDownList("drlCategory", new SelectList(ViewBag.CategoryList as System.Collections.IEnumerable, "Id", "Name", ViewBag.CategoryId), new { @class = "form-control" })
                    </div>
                </div>

                <div class="view-more mt50">
                    @if (Model.listdata != null)
                    {
                        if (Model.listdata.Count > 0)
                        {
                            @*<h2 class="title-cm-02"><a href="#">@Resources.Global.More</a></h2>*@
                            <ul class="mt30 post-list">
                                @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                                {


                                    <li>
                                        <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=277&h=170&mode=crop" alt="@item.value.Title" /></a>
                                        <div class="post-content">
                                            <a href="@item.value.LinkUrl" class="post-big-name">@item.value.Title</a>
                                            <p class="mt15">@item.value.IntroText</p>
                                            <p class="date mt15">@item.value.PublishDate.ToString("HH:mm") - @item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                                        </div>
                                    </li>
                                }


                            </ul>
                            <div class="paging mt50 text-center">
                                <ul>
                                    @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                                        {
                                            PageUrl = Url.SetParameter("Page", "!0"),
                                            CurrentPage = Model.pageIndex,
                                            PageSize = Model.pageSize,
                                            TotalItemCount = Model.total,
                                        }); }
                                </ul>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="col-lg-4 col-md-12 sidebar">
                @Html.Partial("Site_Right2")
            </div>
        </div>
    </div><!-- end main content-->
    <h2 class="title-cm"><a href="#">@Resources.Global.BankSupport</a></h2>
    <br />
    <div class="bg-gray pt40 pb40">
        <div class="container">
            <ul class="slick02">
                @{Html.RenderAction("BannerBottom", "Home", new { lang = langpage });}
            </ul>
        </div>
    </div>







    <script src="~/Scripts/jquery.query.js"></script>
    <script type="text/javascript">


        function searchnews() {
            var keyword = $("#txtkeyword").val();
            var fromdate = $("#txtfromdate").val();
            var todate = $("#txttodate").val();
            var cateid = $('#drlCategory option:selected').val();
            window.location = jQuery.query.set("q", keyword).set("fromdate", fromdate).set("todate", todate).set("categoryid", cateid).set("Page", "1");
        }
    </script>
}
