@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel
@{
    var langpage = WorkContext.GetLanguage();
}
@if (Model.listdata != null)
{
    <ul class="row video-list-02">
        @foreach (var item in Model.listdata.Take(8).Select((value, i) => new { i, value }))
        {
            <li class="col-md-4 col-6">
                <a href="/trang-chu-video.html?VideoId=@(item.value.Id)"><img src="@item.value.MainImage?w=350&h=204&mode=crop" alt="" class="w-100"></a>
                <a href="/trang-chu-video.html?VideoId=@(item.value.Id)" class="mt15 font-weight-bold dis-block">@item.value.Title</a>
                <p class="date mt15">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
            </li>
        }
    </ul>
    <div class="bnr-video mt20">
        @{Html.RenderAction("BannerVideo", "Home", new { lang = langpage });}
    </div>
    <div class="mt50">
        <ul class="row video-list-02">
            @foreach (var item in Model.listdata.Skip(6).Select((value, i) => new { i, value }))
            {
                <li class="col-md-4 col-6">
                    <a href="/trang-chu-video.html?VideoId=@(item.value.Id)"><img src="@item.value.MainImage?w=350&h=204&mode=crop" alt="" class="w-100"></a>
                    <a href="/trang-chu-video.html?VideoId=@(item.value.Id)" class="mt15 font-weight-bold dis-block">@item.value.Title</a>
                    <p class="date mt15">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                </li>
            }
        </ul>
    </div>
    <div class="paging mt50 text-center">
        <ul>
            @{Html.RenderPartial("PaginationVideo", new WebMVC4.Models.PaginationInfo
                {
                    PageUrl = Url.SetParameter("Page", "!0"),
                    CurrentPage = Model.pageIndex,
                    PageSize = Model.pageSize,
                    TotalItemCount = Model.total,
                }); }
        </ul>
    </div>

    <script>

        function GoVideoPage(page) {
            var VideoId = '@Model.Id';
             var Cateid='@ViewBag.CategoryId'
            if (page > 0) {
                $.ajax({
                    type: "GET",
                     url: "/Video/LoadVideo/?VideoId=" + VideoId + "&page=" + page + "&CategoryId=" + Cateid,
                    success: function (data) {
                        if (data != "null") {
                            $("#lstVideo").html(data);
                        }
                    }
                });
            }

        }

    </script>
}