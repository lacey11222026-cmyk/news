        $(document).on("click", ".alert", function (e) {
            bootbox.alert(" Cảm ơn bạn đã quan tâm!<br>Vui lòng liên hệ với Ban Điều hành Đề án để nhận được tài liệu mong muốn.", function () {

            });
        });
    </script>
}
else
{
    <script>
        $(document).on("click", ".alert", function (e) {
            bootbox.alert("Thank you for your interest!<br>Please contact the Project Steering Committee to get the desired documents.", function () {

            });
        });
    </script>
}

