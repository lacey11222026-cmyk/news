@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}

@{
    List<CATEGORY_FULL> ListCate = ViewBag.CategoryList;
}
@using BIZ.Entity
@using UTILS
@using DATA
@using WebMVC4.Helper
@model Banner
<div class="well">
    <span class="label label-danger">
        Chú ý!
    </span>
    <span>
        Hãy chắc chắn nhập vào đầy đủ thông tin tại các mục bắt buộc đánh dấu (*)
    </span>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-fw fa-user-md"></i><span>@ViewBag.Title </span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel panel-info">
                        <div id="Errordiv" style="margin:20px;color:red;font-size:13pt"><center></center></div><br />
                        @*<div class="panel-heading">
                                <h4 class="panel-title"><i class="fa fa-wrench" style="margin-right:7px"></i>Thông Tin Cơ Bản</h4>
                            </div>*@
                        <div style="padding: 10px 0 0 0;background-color:#fff !important">

                            <div class="col-md-12">
                                <div>
                                    <!-- dành cho UpdateFunction -->
                                    <div class="form-group">
                                        <label for="txtTitle" class="control-label col-md-3">Tên banner :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtTitle" name="title" value="@Model.Name" class="form-control" placeholder="Nhập tiêu đề cho bài viết" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="ddlRegion" class="control-label col-md-3">Vùng :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlRegion">
                                                    @*<option value="4" @(Model.Region == 4 ? "selected='selected'" : "")>Home</option>*@
                                                    <option value="1" @(Model.Region == 1 ? "selected='selected'" : "")>Trên</option>

                                                    <option value="3" @(Model.Region == 3 ? "selected='selected'" : "")>Dưới</option>
                                                    <option value="2" @(Model.Region == 2 ? "selected='selected'" : "")>Phải 1</option>
                                                    @*<option value="5" @(Model.Region == 5 ? "selected='selected'" : "")>Phải 2</option>*@

                                                    <option value="4" @(Model.Region == 4 ? "selected='selected'" : "")>Phải 2</option>

                                                    @*<option value="13" @(Model.Region == 13 ? "selected='selected'" : "")>Botom</option>
                                                    <option value="12" @(Model.Region == 12 ? "selected='selected'" : "")>Right</option>
                                                    <option value="15" @(Model.Region == 15 ? "selected='selected'" : "")>Center</option>*@


                                                </select>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group"  >
                                        <label for="ddlType" class="control-label col-md-3">Slide :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlMainCate">
                                                    <option value="0" @(Model.Type == 0 ? "selected='selected'" : "")>0</option>
                                                    <option value="1" @(Model.Type == 1 ? "selected='selected'" : "")>1</option>
                                                    <option value="2" @(Model.Type == 2 ? "selected='selected'" : "")>2</option>
                                                    <option value="3" @(Model.Type == 3 ? "selected='selected'" : "")>3</option>

                                                </select>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtUrl" class="control-label col-md-3">Liên kết :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtUrl" name="url" value="@Model.Url" class="form-control" placeholder="Nhập liên kết" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="txtData" class="control-label col-md-3">Đường dẫn ảnh:<span class="required">*</span></label>

                                        <div class="col-md-6">
                                            <input type="text" id="txtData" name="data" value="@Model.Data" class="form-control" placeholder="Nhập ảnh đại diện" />
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtData');"><i class="fa fa-file"></i></a>
                                        </div>
                                    </div>

                                    <div class="form-group" >
                                        <label for="txtSummary" class="control-label col-md-3">Ảnh mobile :</label>
                                        <div class="col-md-6">
                                            <input type="text" id="txtSummary" name="data" value="@Model.Description" class="form-control" placeholder="Nhập ảnh đại diện" />
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtSummary');"><i class="fa fa-file"></i></a>
                                        </div>
                                        
                                    </div>
                                    <div class="form-group">
                                        <label for="txtOrder" class="control-label col-md-3">Thứ tự :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="number" min="0" step="1" id="txtOrder" name="order" value="@Model.Order" class="form-control" placeholder="Nhập tiêu đề cho bài viết" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label col-md-3" for="cbxIsActive">Trạng thái :</label>
                                        <div class="col-md-4">
                                            <div class="checkbox">
                                                @if (Model.Status == 1)
                                                {<input type="checkbox" id="cbxIsActive" checked="checked" />}
                                                else
                                                {<input type="checkbox" id="cbxIsActive" />}

                                            </div>
                                        </div>
                                    </div>

                                    <div class="panel-footer form-horizontal">
                                        <div class="form-group submit">


                                            <button type="submit" class="btn btn-primary" id="btsubmit"><i class="fa fa-save"></i>Lưu lại</button>
                                            <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage();"><i class="fa fa-backward"></i>Quay lại</button>
                                        </div>
                                    </div>



                                </div>
                            </div>
                            <div style="clear:both"></div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    $('#menu_addbanner').addClass("active");

</script>
<script>
    function GotoListpage() {
        window.location = '@Url.Action("Index")';
    }
    $(document).ready(function () {



        $("button.close").click(function () {
            $(this).parent().css("display", "none");
        });
        $('#defaultForm').bootstrapValidator({
            message: 'This value is not valid',
            //live: 'submitted',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {

                title: {
                    message: 'Nhập tên banner',
                    validators: {
                        notEmpty: {
                            message: 'tên banner không được bỏ trống'
                        },

                        stringLength: {
                            min: 2,
                            max: 250,
                            message: 'tên banner nhỏ nhất 2 ký tự và nhiều nhất 250 ký tự'
                        },

                    }
                },
                order: {
                    validators: {
                        notEmpty: {
                            message: 'Thứ tự  không được bỏ trống'
                        }
                    }
                },


            }
        })
        .on('success.form.bv', function (e) {
            // Prevent submit form
            e.preventDefault();

            var $form = $(e.target),
                validator = $form.data('bootstrapValidator');
            SaveData();
            $(".close").click(function () {
                $(".alert-success").css("display", "none");
            });
        })
        .on('error.form.bv', function (e) {
            // Active the panel element containing the first invalid element
            e.preventDefault();
            var $form = $(e.target),
            validator = $form.data('bootstrapValidator');
            $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
            $(".alert-danger").css("display", "block");
            $(".close").click(function () {
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
        });

        $("#btnReset").click(function () {
            $('#defaultForm').data('bootstrapValidator').resetForm(true);
            $(".alert-danger").css("display", "none");
            $(".alert-success").css("display", "none");
        });

        //Save Data
        function SaveData() {
            var param = {
                'Id': '@Model.Id',
                'Name': $("#txtTitle").val(),
                'Description': $("#txtSummary").val(),
                'Data': $("#txtData").val(),
                'Url': $("#txtUrl").val(),
                'Type': $("#ddlMainCate").val(),
                'Region': $("#ddlRegion").val(),
                'Order': $("#txtOrder").val(),
                'Status': $("#cbxIsActive").is(":checked") ? 1 : 0

            }
            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "@Url.Action("SaveData")",
                data: addAntiForgeryToken(param),
            async: true,
            success: function (data) {
                Utils.UnLoading();
                if (data.ResponseCode >= 0) {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $(".alert-success").show("slow");
                    $(".alert-danger").hide("slow");
                    setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 500);

                }
                else {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $("#ErrorMessage").text(data.Description);
                    $(".alert-danger").show("slow");
                    $(".alert-success").hide("slow");
                    setTimeout(function () { $(".alert-danger").hide("slow"); }, 2000);
                }
            }
        });
    };
    });
</script>
