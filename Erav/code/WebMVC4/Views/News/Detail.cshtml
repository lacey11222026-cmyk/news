@using BIZ
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.CONTENT_FULL


@if (Model != null)
{

    <div class="chitiet-content01 container mt10">
        <div class="row row-40">
            <div class="col-lg-8 col-mm-12">
                <h2 class="title-cm01 title-inline"><a href="@ViewBag.Url">@Model.CategoryName</a></h2>
                <div class="mt20">
                    <h2 class="newsname-detail">@Model.Title</h2>
                    <span class="date mt30">@Model.PublishDate.ToString("dd/MM/yyyy")</span>
                    <ul class="newslist suggest">
                        @if (ViewBag.lstRef != null)
                        {
                            foreach (var item in ViewBag.lstRef)
                            {
                                <li>
                                    <a href="@Utils.FormatUrlRewrite(item.Id, item.Title, "ArticleDetail")">@item.Title </a>
                                </li>
                            }

                        }
                    </ul>
                    <div class="vneep-icon mt50">
                        <strong>@Model.IntroText</strong>
                    </div>
                    <div class="detail-content mt40">
                        <div class="detail-icon-list sticky">
                            <a href="javascript:void(0);" onclick="openWin('@ViewBag.FacebookShare');">
                                <img src="/Content/images/icon-face02.png">
                            </a>
                            <a href="@Url.Action("Print", "News", new {Id=Model.Id})" target="_blank"><img src="/Content/images/icon-prt.png"></a>
                        </div>
                        <div class="detail-text" id="NewsContent">
                            @Html.Raw(Model.Contents.Replace("font-size: small", ""))
                        </div>
                    </div>
                    <div class="detail-tags mt50">
                        @if (Model.SiteUrl != null)
                        {
                            if (!String.IsNullOrEmpty(Model.SiteUrl.Trim()))
                            {

                                <ul class="float-left mb-0">
                                    <li>Tags:</li>
                                    @foreach (var item in Model.SiteUrl.Split(',').Select((value, i) => new { i, value }))
                                    {
                                        <li>  <a href="@Url.Action("Search", new { q = item.value.Trim() })">@item.value.Trim()</a></li>
                                    }
                                </ul>
                                <div class="face-box">
                                    <div class="fb-like" data-href="@(Model.LinkUrl)" data-layout="button_count" data-action="like" data-show-faces="false" data-share="true"></div>
                                </div>

                            }
                        }

                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-12">
                <div class="sidebar-newsnew mt20">
                    @{Html.RenderAction("LastestNews", "News", new { CategoryId = Model.CategoryId, MaxLastestNews = 5 });}
                </div>
                <div class="content01-right mt30">
                    @{Html.RenderAction("BannerRight", "Home");}
                    @{Html.RenderAction("MenuInfo", "Home");}
                </div>
            </div>
        </div><!-- end row-->
    </div><!-- end content 01 -->

<div class="container mt30">
    @{Html.RenderAction("Banner", "Home");}
</div>

    <div class="pb-3">
        <div class="mt30 detail-content02 container">
            <div class="row row-40">
                <div class="col-lg-8 col-md-12 text-left">
                    <h2 class="title-cm01 title-inline mt20"><a href="#">Cùng chuyên mục</a></h2>
                    @{Html.RenderAction("Relate", "News", new { CategoryId = Model.CategoryId });}
                    

                </div>
                <div class="col-lg-4 col-md-12">
                    @{Html.RenderAction("BannerRight2", "Home");}

                    <div class="mt20">
                        @{Html.RenderAction("Price", "Home");}
                    </div>

                    <div class="mt40 readmore">
                        @{Html.RenderAction("TopViewNews", "News", new { MaxLastestNews = 5, CategoryId = Model.CategoryId });}
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>
        </div><!-- end content 02-->
    </div>


    
}
<script>
    $('.news_detail_img').removeAttr('style');
    $('.news_detail_img').attr('style', 'margin:0 auto;text-align:center');
    $('#NewsContent table').removeAttr('width');
    $('#NewsContent span img').removeAttr('width');
    $('#NewsContent img').removeAttr('width');
    $('#NewsContent img').removeAttr('height');
    $('#NewsContent img').removeAttr('style');

</script>
<style>
    .detail-post-name {
        text-transform: inherit;
    }

    #NewsContent ul {
        display: block;
        list-style-type: disc;
        margin-block-start: 1em;
        margin-block-end: 1em;
        margin-inline-start: 0px;
        margin-inline-end: 0px;
        padding-inline-start: 40px;
    }

    #NewsContent li {
        display: list-item;
        list-style-type: disc;
        text-align: -webkit-match-parent;
    }
</style>
<script type="text/javascript">



    function openWin(url) {
        var myWindow = window.open(url, '', 'width=700,height=500');
        myWindow.focus();
    }
</script>
@section scripts {
    <script type="text/javascript">

        $('#menu_' + '@ViewBag.CurrentCategoryId').addClass("active");

     $('#menu_' + '@ViewBag.ParentCategoryId').addClass("active");
        $('#menu_0').removeClass("active");
    </script>
}