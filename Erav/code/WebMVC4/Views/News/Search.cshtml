@using BIZ
@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel
@{
    var langpage = WorkContext.GetLanguage();
}
@if (Model != null)
{
}
<div class="cap1-content01 container mt10">
    <div class="row row-40">
        <div class="col-lg-8 col-mm-12">
           
            <h2 class="title-cm01 title-inline mt20"> <a href="#">Tìm kiếm</a></h2>
            <div class="list-page">
                <div class="text-center search">
                    <form class="form-inline">
                        <div class="form-group" style="margin-bottom:10px;">
                            <label class="" style="margin-left:10px;">Từ khóa</label>
                            <input id="txtkeyword" class="form-control" type="text" value="@ViewBag.keyword" >
                        </div>
                        <div class="form-group" style="margin-bottom:10px;">
                            <label class="">Chuyên mục</label>
                            @Html.DropDownList("drlCategory", new SelectList(ViewBag.CategoryList as System.Collections.IEnumerable, "Id", "Name", ViewBag.CategoryId), new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            <label>Từ ngày</label>
                            <input id="txtfromdate" placeholder="dd/MM/yyyy" value="@ViewBag.fromdate" class="form-control">
                        </div>
                        <div class="form-group">
                            <label>Đến ngày</label>
                            <input id="txttodate" placeholder="dd/MM/yyyy" value="@ViewBag.todate" class="form-control">
                        </div>

                        <button type="button" onclick="searchnews();" class="btn-search">Tìm kiếm</button>
                    </form>
                </div>
                @if (Model.listdata != null)
                {
            <ul class="mt20 viewmore-list">
                @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                {
                    <li>
                        <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?h=138&w=248&mode=crop"></a>
                        <div>
                            <a href="@item.value.LinkUrl">@item.value.Title</a>
                            <span class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </li>
                }


            </ul>
                }
                else
                {
                    <div class="cap1-news-list mt30">
                        @*<h4>Không có kết quả phù hợp</h4>*@
                    </div>
                }

                <div class="paging ">
                    <ul>
                        @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                            {
                                PageUrl = Url.SetParameter("Page", "!0"),
                                CurrentPage = Model.pageIndex,
                                PageSize = Model.pageSize,
                                TotalItemCount = Model.total,
                            }); }
                    </ul>
                </div>
            </div>

        </div>
        <div class="col-lg-4 col-md-12">
            <div class="sidebar-newsnew mt20">
                @{Html.RenderAction("LastestNews", "News", new { CategoryId = Model.CategoryId, MaxLastestNews = 5 });}
            </div>
        </div>
    </div>
</div>




<script src="~/Scripts/jquery.query.js"></script>
<script type="text/javascript">


    function searchnews() {
        var keyword = $("#txtkeyword").val();
        var fromdate = $("#txtfromdate").val();
        var todate = $("#txttodate").val();
        var cateid = $('#drlCategory option:selected').val();
        window.location = jQuery.query.set("q", keyword).set("fromdate", fromdate).set("todate", todate).set("categoryid", cateid).set("Page", "1");
    }
</script>
    }
<style>
    .form-inline label {
        min-width: 79px;
    }
    .form-group input, .form-group select {
        width: 160px !important;
    }
</style>