@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewModel
@if (Model != null)
{
    if (Model.lstdata != null)
    {

        <div class="title-cm01">
            <a href="#">Đọc nhiều</a>
        </div>
        foreach (var item in Model.lstdata.Take(1).Select((value, i) => new { i, value }))
        {
            <div class="news-big mt30">
                <a href="@item.value.LinkUrl">
                    <img src="@item.value.MainImage?w=470&h=298&mode=crop" alt="">
                </a>
                <p class="mt10">@item.value.Title</p>
                <p class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
            </div>
        }
        <ul class="danhgia-list mt20">
            @foreach (var item in Model.lstdata.Skip(1).Select((value, i) => new { i, value }))
            {
                <li>
                    <a href="@item.value.LinkUrl">
                        <img src="@item.value.MainImage?w=140&h=90&mode=crop">
                        <span>@item.value.Title</span>
                    </a>
                </li>
            }

        </ul>
        <div class="clearfix"></div>
        <a href="#" class="btn-view">Xem thêm</a>




    }
}
