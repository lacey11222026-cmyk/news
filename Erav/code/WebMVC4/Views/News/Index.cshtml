@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.News2Model

@{
    var langpage = WorkContext.GetLanguage();
}
<link rel="stylesheet prefetch" href="/Content/css/datepicker.css">
<link rel="stylesheet" type="text/css" href="/Content/css/animate.css">
<div class="cap1-content01 container mt10">
    <div class="row row-40">
        <div class="col-lg-8 col-mm-12">
            <div class="date-icon-02">
                <label>Xem theo ngày </label>
                <div id="datepicker" class="input-group date" data-date-format="dd-mm-yyyy">
                    <input class="form-control" readonly="" type="text">
                    <span class="input-group-addon"><i class="glyphicon glyphicon-calendar"></i></span>
                </div>
            </div>
            @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = ViewBag.CategoryId });}

            @if (Model.hotnews != null)
            {
                <div class="mt20 row">
                    <div class="col-sm-8 col-xs-12">
                        @foreach (var item in Model.hotnews.Take(1).Select((value, i) => new { i, value }))
                        {
                            <div class="news-big">
                                <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=477&mode=crop" alt="@item.value.Title" /></a>
                                <h3 class="news-name mt15"><a href="@item.value.LinkUrl">@item.value.Title</a></h3>
                                <p class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                                <p class="mt10">@item.value.IntroText</p>
                            </div>
                        }
                    </div>
                    <div class="col-sm-4 col-xs-12 cap1-newslist">
                        <ul class="news-list-03">
                            @foreach (var item in Model.hotnews.Skip(1).Take(2).Select((value, i) => new { i, value }))
                            {
                                <li>
                                    <a href="@item.value.LinkUrl">
                                        <div class="img-wrap">
                                            <img src="@item.value.MainImage?h=144&w=223&mode=crop" alt="">
                                        </div>
                                        <p class="font-weight-bold mt10 mb-0">@item.value.Title</p>
                                        <p class="date mt5">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    @*@if (Model.hotnews.Count > 3)
                        {
                            <div class="col-sm-12 mt20">
                                <ul class="news-list">
                                    @foreach (var item in Model.hotnews.Skip(3).Take(4).Select((value, i) => new { i, value }))
                                    {
                                        <li>
                                            <a href="@item.value.LinkUrl">
                                                <div class="img-wrap"><img src="@item.value.MainImage?h=112&w=168&mode=crop" alt=""></div>
                                                <p class="mt10">@item.value.Title</p>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }*@
                </div>
            }
        </div>
        <div class="col-lg-4 col-md-12">
            <div class="sidebar-newsnew mt40">
                @{Html.RenderAction("LastestNews", "News", new { CategoryId = Model.CategoryId, MaxLastestNews = 3 });}
            </div>
        </div>
    </div><!-- end row-->
</div><!-- end content 01 -->

<div class="container mt30">
    @{Html.RenderAction("Banner", "Home");}
</div>

<div class="pb-3">
    <div class="mt30 cap1-content02 container">
        <div class="row row-40">

            <div class="col-lg-8 col-md-12 text-left">
                @if (Model.articles != null)
                {
                    <h2 class="title-cm01 title-inline"><a href="#">Xem thêm</a></h2>
                    <ul class="mt20 viewmore-list">
                        @foreach (var item in Model.articles.Select((value, i) => new { i, value }))
                        {
                            <li>
                                <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?h=165&w=248&mode=crop"></a>
                                <div>
                                    <a href="@item.value.LinkUrl">@item.value.Title</a>
                                    <p class="date-icon mt10" style="margin-bottom:0px">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                                    <div class="hidden-xs" style="font-size:90%">
                                        @item.value.IntroText
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                    <div class="paging mt60 text-center">
                        <ul>
                            @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                                {
                                    PageUrl = Url.SetParameter("Page", "!0"),
                                    CurrentPage = ViewBag.Page,
                                    PageSize = ViewBag.PageSize,
                                    TotalItemCount = ViewBag.Total,
                                }); }
                        </ul>
                    </div>
                }
            </div>

            <div class="col-lg-4 col-md-12">
                <div class="content01-right">
                    @{Html.RenderAction("BannerRight", "Home");}
                    @{Html.RenderAction("MenuInfo", "Home");}

                </div>


                @{Html.RenderAction("BannerRight2", "Home");}



                <div class="mt20">
                    @{Html.RenderAction("Price", "Home");}
                </div>

                <div class="mt40 readmore">
                    @{Html.RenderAction("TopViewNews", "News", new { MaxLastestNews = 5, CategoryId = ViewBag.CategoryId });}

                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div><!-- end content 02-->
</div>
<script src="~/Content/js/bootstrap-datepicker.js"></script>
@*<script src="/js/bootstrap-datepicker.js"></script>*@
<script type="text/javascript">
    var categoryid = '@ViewBag.CategoryId';
    function getFormattedDate(date) {
        var year = date.getFullYear();

        var month = (1 + date.getMonth()).toString();
        month = month.length > 1 ? month : '0' + month;

        var day = date.getDate().toString();
        day = day.length > 1 ? day : '0' + day;

        return day + '/' +  month+ '/' + year;
    }
    $(function () {
        $("#datepicker").datepicker({

            duration: 'fast',
            showOn: "button",
            dateFormat: "dd/mm/yy",
            todayHighlight: true
        }).datepicker('update', new Date())
            .change(function (e) {

                var date =getFormattedDate( $('#datepicker').data().datepicker.viewDate);
                window.location.href = '@Url.Action("Search", "News")' + '?fromdate=' + date + '&todate=' + date + '&categoryId=' + categoryid;

        });
    });
</script>


@section scripts {
    <script type="text/javascript">

    $('#menu_' + '@ViewBag.CurrentCategoryId').addClass("active");

     $('#menu_' + '@ViewBag.ParentCategoryId').addClass("active");

         $('#menu_0').removeClass("active");

    </script>
}
<style>
    .news-big-02 h3 a {
        text-transform: inherit;
    }
</style>
