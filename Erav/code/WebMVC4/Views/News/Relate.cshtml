@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {

        <div class="row mt20">
            <div class="col-md-6 col-sm-12">
                @foreach (var item in Model.Take(1).Select((value, i) => new { i, value }))
                {
                    <div class="news-big">
                        <a href="@item.value.LinkUrl">
                            <img src="@item.value.MainImage?w=350&h=223&mode=crop" alt=""/>
                        </a>
                        <h3 class="news-big-name mt15"><a href="@item.value.LinkUrl">@item.value.Title</a></h3>
                        <p class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                        <p class="mt10">@item.value.IntroText</p>
                    </div>
                }
                </div>
            <div class="col-md-6 col-sm-12">
                <ul class="newslist04">
                    @foreach (var item in Model.Skip(1).Take(4).Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="@item.value.LinkUrl">@item.value.Title</a>
                            <span class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                        </li>
                    }
                    </ul>
            </div>
        </div>
        if (Model.Count() > 5)
        {
            <ul class="mt20 viewmore-list">
                @foreach (var item in Model.Skip(5).Select((value, i) => new { i, value }))
                {
                    <li>
                        <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=376&h=204&mode=crop"/></a>
                        <div>
                            <a href="@item.value.LinkUrl">@item.value.Title</a>
                            <span class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </li>
                }
            </ul>
        }




    }


}