@model WebMVC4.Models.News2Model
    <a href="/tac-gia/@(Model.author.UserName)">
        <img src="@Model.author.Avatar" alt="" class="authoravt">
        <h3 class="author-name">@Model.author.FullName</h3>
        <span class="author-work">@Model.author.Title</span>
        </a>
        <div class="hidden-480">
            <span class="author" style="margin-left: 0;">Tác giả</span>
            <ul class="author-list">
                @foreach (var user in Model.listUser)
                {
                    <li>
                        <a href="/tac-gia/@(user.UserName)">
                            <div class="author-img"><img src="@user.Avatar" alt=""></div>
                            <p>@user.FullName</p>
                            <div class="clearfix"></div>
                        </a>
                    </li>

                }
            </ul>

        </div>
        <style>
            .authoravt {
                max-width: 100%;
            }

            @@media screen and (max-width: 485px) {
                .authoravt {
                    max-width: 79%;
                }
            }
        </style>