@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.DocumentModel

@{
    var langpage = WorkContext.GetLanguage();
}
<div class="main-content container">
    <div class="row">
        <div class="col-lg-9 col-md-12 pb40">
            @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
            <div class="mt20 bg-gray-02">
                <div class="manage-search-mb">
                    <a href="#">Tìm kiếm quản lý cấp phép</a>
                </div>
                <div class="manage-search-box">
                    <table class="manage-tbl">
                        <tbody>
                            <tr>
                                <td>Lĩnh vực:</td>
                                <td>
                                    <select class="form-control" id="ddlArea">

                                        <option value="-1">--Tất cả--</option>
                                        <option value="25" @if (ViewBag.area == 25) { @Html.Raw("selected='selected'") ; }>Phát điện nhà máy nhiệt điện</option>
                                        <option value="28" @if (ViewBag.area == 28) { @Html.Raw("selected='selected'") ; }>Phát điện nhà máy phong điện </option>
                                        <option value="22" @if (ViewBag.area == 22) { @Html.Raw("selected='selected'") ; }>Phát điện nhà máy thuỷ điện</option>
                                        <option value="18" @if (ViewBag.area == 18) { @Html.Raw("selected='selected'") ; }>Phân phối và bán lẻ điện từ cấp điện áp 0,4 kV trở xuống</option>
                                        <option value="20" @if (ViewBag.area == 20) { @Html.Raw("selected='selected'") ; }>Phân phối và bán lẻ điện từ cấp điện áp 110 kV trở xuống</option>
                                        <option value="19" @if (ViewBag.area == 19) { @Html.Raw("selected='selected'") ; }>Phân phối và bán lẻ điện từ cấp điện áp 22kV trở xuống</option>
                                        <option value="24" @if (ViewBag.area == 24) { @Html.Raw("selected='selected'") ; }>Phân phối và bán lẻ điện từ cấp điện áp 35 kV trở xuống</option>
                                        <option value="21" @if (ViewBag.area == 21) { @Html.Raw("selected='selected'") ; }>Phân phối và bán lẻ điện từ cấp điện áp15 kV trở xuống</option>
                                        <option value="17" @if (ViewBag.area == 17) { @Html.Raw("selected='selected'") ; }>Tư vấn đầu tư xây dựng điện</option>
                                        <option value="16" @if (ViewBag.area == 16) { @Html.Raw("selected='selected'") ; }>Truyền tải điện</option>



                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td>Tình trạng:</td>
                                <td>
                                    <select class="form-control" id="ddlType">

                                        <option value="-1">--Tất cả--</option>

                                        <option value="1" @if (ViewBag.type == 1) { @Html.Raw("selected='selected'") ; }>Cấp mới</option>
                                        <option value="2" @if (ViewBag.type == 2) { @Html.Raw("selected='selected'") ; }>Cấp sửa đổi</option>
                                        <option value="3" @if (ViewBag.type == 3) { @Html.Raw("selected='selected'") ; }>Bổ xung</option>


                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td>Hiệu lực giấy phép:</td>
                                <td>
                                    <select class="form-control" id="ddlHits">
                                        <option value="-1">--Tất cả--</option>
                                        <option value="1" @if (ViewBag.hit == 1) { @Html.Raw("selected='selected'") ; }>Còn hiệu lực</option>
                                        <option value="0" @if (ViewBag.hit == 0) { @Html.Raw("selected='selected'") ; }>Hết liệu lục</option>
                                        <option value="2" @if (ViewBag.hit == 2) { @Html.Raw("selected='selected'") ; }>Chưa có hiệu lực</option>

                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td>Ngày cấp phép:</td>
                                <td>
                                    <div class="manage-date">
                                        <input type="text" class="form-control" id="txtfromdate" placeholder="dd/MM/yyyy" value="@ViewBag.fromdate">
                                        <p>đến:</p>
                                        <input type="text" class="form-control" id="txttodate" placeholder="dd/MM/yyyy" value="@ViewBag.todate">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>Thời hạn giấy phép:</td>
                                <td>
                                    <div class="manage-date">
                                        <input type="text" class="form-control" id="txtfromdate2" placeholder="dd/MM/yyyy" value="@ViewBag.fromdate2">
                                        <p>đến:</p>
                                        <input type="text" class="form-control" id="txttodate2" placeholder="dd/MM/yyyy" value="@ViewBag.todate" placeholder="01/01/2023">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>Từ khoá:</td>
                                <td><input type="text" class="form-control" id="txtkeyword" @ViewBag.keyword " placeholder="Từ khóa"></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="manage-search">
                        <div class="manage-search-btn">
                            <button class="" onclick="searchdoc();">Tìm kiếm</button>
                        </div>
                    </div>
                </div>
            </div><!-- end bg gray-->
            <div class="mt40">

                <p class="text-right">Kết quả tìm kiếm thứ <span class="textgreen">@(Model.pageIndex*15-15)-@(Model.pageIndex*15)</span> trong <span class="textgreen">@Model.total</span> giấy phép </p>
                <div class="tbl-responsive">
                    <table class="download-tbl table-normal">
                        <tbody>
                            <tr>
                                <th>STT</th>
                                <th>Số hiệu</th>
                                <th>Tên giấy phép</th>
                                <th>Ngày cấp phép</th>
                                <th>Thời hạn giấy phép</th>
                                <th>Tải xuống</th>
                            </tr>
                            @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                            {
                                <tr>
                                    <td>@(item.i + 1) </td>
                                    <td>@item.value.Code</td>
                                    <td>
                                        <a href="@item.value.LinkUrl" style="color: #333">
                                            @item.value.Name
                                        </a>
                                        <br />
                                        <span>@item.value.SignedByDesc</span>

                                    </td>
                                    <td> @Convert.ToDateTime(item.value.PublishDate).ToString(@" dd'/'MM'/'yyyy") </td>
                                    <td>
                                        @if (!item.value.EffectiveDate.HasValue)
                                        {

                                            <text>&nbsp;</text>
                                        }
                                        else
                                        {
                                            if (item.value.EffectiveDate.Value.Year < 9000)
                                            {
                                                @Convert.ToDateTime(item.value.EffectiveDate).ToString(@" dd'/'MM'/'yyyy")
                                            }
                                            else
                                            {
                                                <text>&nbsp;</text>
                                            }

                                        }
                                    </td>
                                    <td>  <a href="@Url.Action("DownloadFile", "Document", new {id = item.value.Id})"><img src="/Content/images/download-icon.png" alt="Download"> </a></td>


                                </tr>
                            }


                        </tbody>
                    </table>
                </div>
            </div>
            <div class="paging mt50 text-right mt30">
                <ul>
                    @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                        {
                            PageUrl = Url.SetParameter("Page", "!0"),
                            CurrentPage = Model.pageIndex,
                            PageSize = Model.pageSize,
                            TotalItemCount = Model.total,
                        }); }
                </ul>
            </div>
        </div><!-- end content left-->

        <div class="col-lg-3 col-md-12">
            <div class="content01-right">
                @{Html.RenderAction("BannerRight", "Home");}
                @{Html.RenderAction("MenuInfo", "Home");}
            </div>

            @{Html.RenderAction("BannerRight2", "Home");}
        </div>
    </div>
</div>
<script type="text/javascript">


    function searchdoc() {
        var id = '@Model.CategoryId';
        var keyword = $("#txtkeyword").val();
        var fromdate = $("#txtfromdate").val();
        var todate = $("#txttodate").val();
        var fromdate2 = $("#txtfromdate2").val();
        var todate2 = $("#txttodate2").val();
        var type = $("#ddlType").val();
        var area = $("#ddlArea").val();
        var hit = $("#ddlHits").val();
        window.location = '@ViewBag.Cateurl'+'?keyword=' + keyword + '&fromdate=' + fromdate + '&todate=' + todate + '&fromdate2=' + fromdate2 + '&todate2=' + todate2 + '&type=' + type + '&hit=' + hit + '&area=' + area;
        //window.location = jQuery.query.set("keyword", keyword).set("fromdate", fromdate).set("todate", todate).set("Page", "1");
    }
</script>
<script>
    $(function () {
        $('.manage-search-mb').click(function () {
            $(this).toggleClass('active');
            $('.manage-search-box').toggle();
        });
    });
</script>	