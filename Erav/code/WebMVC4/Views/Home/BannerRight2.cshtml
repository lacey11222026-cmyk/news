<style>
    .bnr-list2 .carousel-indicators {
        bottom: -10px;
    }

        .bnr-list2 .carousel-indicators li {
            width: 10px;
            height: 10px;
            border-radius: 10px;
        }

        .bnr-list2 .carousel-indicators li {
            background-color: #009966;
        }

        .bnr-list2 .carousel-indicators .active {
            background-color: #ffde8c;
        }
</style>