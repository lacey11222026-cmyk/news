@model List<DATA.Banner>

<ul class="bnr-list mt20 hidden-991">
    @if (Model != null)
    {


        foreach (var item in Model.Take(2).Select((value, i) => new { i, value }))
        {
            <li>
                <a href="@item.value.Url" target="_blank"><img src="@item.value.Data" alt="@item.value.Type"></a>
            </li>


        }
        if (Model.Where(x => x.Type == 1).Count() == 1)
        {
            <li>
                <a href="@Model.FirstOrDefault(x => x.Type == 1).Url" target="_blank"><img src="@Model.FirstOrDefault(x => x.Type == 1).Data" alt=""></a>
            </li>
        }
        if (Model.Where(x => x.Type == 2).Count() == 1)
        {
            <li>
                <a href="@Model.FirstOrDefault(x => x.Type == 2).Url" target="_blank"><img src="@Model.FirstOrDefault(x => x.Type == 2).Data" alt=""></a>
            </li>
        }
        if (Model.Where(x => x.Type == 3).Count() == 1)
        {
            <li>
                <a href="@Model.FirstOrDefault(x => x.Type == 3).Url" target="_blank"><img src="@Model.FirstOrDefault(x => x.Type == 3).Data" alt=""></a>
            </li>
        }
    }
</ul>
@if (Model.Where(x => x.Type == 1).Count() > 1)
{
    <div class="bnr-list2">
        <div id="myCarousel01" class="carousel slide" data-ride="carousel">
            <ol class="carousel-indicators">
                @foreach (var item in Model.Where(x => x.Type == 1).Select((value, i) => new { i, value }))
                {
                    <li data-target="#myCarousel01" data-slide-to="@item.i" class="@(item.i==0?" active":"")"></li>
                }
            </ol>
            <!-- Wrapper for slides -->
            <div class="carousel-inner">
                @foreach (var item in Model.Where(x => x.Type == 1).Select((value, i) => new { i, value }))
                {
                    <div class="@(item.i==0?"carousel-item  active":"carousel-item ")">
                        <a href="@item.value.Url" rel="nofollow" target="_blank">
                            <img src="@item.value.Data" alt="@item.value.Name" />
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}
@if (Model.Where(x => x.Type == 2).Count() > 1)
