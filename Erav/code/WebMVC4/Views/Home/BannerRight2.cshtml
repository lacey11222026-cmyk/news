    <div class="bnr-list2">
        <div id="myCarousel02" class="carousel slide" data-ride="carousel">
            <ol class="carousel-indicators">
                @foreach (var item in Model.Where(x => x.Type == 2).Select((value, i) => new { i, value }))
                {
                    <li data-target="#myCarousel02" data-slide-to="@item.i" class="@(item.i==0?" active":"")"></li>
                }
            </ol>
            <!-- Wrapper for slides -->
            <div class="carousel-inner">
                @foreach (var item in Model.Where(x => x.Type == 2).Select((value, i) => new { i, value }))
                {
                    <div class="@(item.i==0?"carousel-item  active":"carousel-item ")">
                        <a href="@item.value.Url" rel="nofollow" target="_blank">
                            <img src="@item.value.Data" alt="@item.value.Name" />
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}
@if (Model.Where(x => x.Type == 3).Count() > 1)
