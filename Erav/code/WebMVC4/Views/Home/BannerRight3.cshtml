@model List<DATA.Banner>

<ul class="bnr-list">
    @if (Model != null)
    {


        foreach (var item in Model.Select((value, i) => new { i, value }))
        {
            <li>
                <a href="@item.value.Url" target="_blank"><img src="@item.value.Data" alt=""></a>
            </li>


        }


    }
</ul>