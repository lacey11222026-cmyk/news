@model List<DATA.Banner>

@if (Model != null)
{
    <div id="carouselExampleIndicators" class="carousel carousel-fade slide" data-ride="carousel">
        <ol class="carousel-indicators">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li data-target="#carouselExampleIndicators" data-slide-to="@item.i" class="@(item.i==0?" active":"")"></li>
            }
        </ol>
        <div class="carousel-inner">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <div class="@(item.i==0?"carousel-item active":"carousel-item")">
                    <a href="@item.value.Url" rel="nofollow" target="_blank">

                        
                        <img src="@item.value.Data" alt="@item.value.Name" class="w-100">
                    </a>
                </div>
            }
          
        </div>
    </div>

  
}


