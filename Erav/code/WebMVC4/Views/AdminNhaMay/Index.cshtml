@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@{
    ViewBag.Title = "Danh sách nhà máy";
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">

                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <select class="form-control" id="ddlCate">



                            <option value="-1">---Hình thức---</option>
                            <option value="0">Tham gia trực tiếp</option>
                            <option value="1">Tham gia gián tiếp</option>
                            <option value="2">Không tham gia</option>


                        </select>

                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <select class="form-control" id="ddlloai">


                            <option value="-1">--Loại nhà máy---</option>
                            <option value="0">Nhà máy thủy điện</option>
                            <option value="1">Nhà máy nhiệt điện than</option>
                            <option value="2">Nhà máy Tua-bin khí</option>
                            <option value="3">Loại nhà máy khác</option>


                        </select>
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <input type="text" id="txtTitle" class="form-control" placeholder="Nhập từ khóa">
                    </div>


                    <div class="form-group submit col-md-3 col-xs-12 col-sm-6">
                        <button type="button" id="btnSearch" class="btn btn-info"><i class="fa fa-search"></i>Tìm Kiếm</button>
                        <a id="btnCreate" href="@Url.Action("GetNhaMayDetail",new {id=0 })" class="btn btn-success"><i class="fa fa-user-plus"></i>Thêm Mới</a>
                    </div>


                </div>
            </div>
            <div class="table-responsive">
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="ListNhaMay">
                        @Html.Action("ListNhaMay")
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#menu_mision').addClass("active");

</script>
<script type="text/javascript">
        $(document).ready(function () {

            var parameters = {
            };
            $("#form").keypress(function (event) {
                if (event.which == 13) {
                    $("#btnSearch").click();
                }
            });
            $("#btnSearch").click(function () {
                GetList(1);
            });

            $("#ddlCate").change(function () {
                GetList(1);
            });
            function GetList(currentPage) {
                parameters = {
                    title: $("#txtTitle").val(),

                    hinhthuc: $('#ddlCate :selected').val(),
                    loai: $('#ddlloai :selected').val(),
                    currentPage: currentPage,
                };
                btnSearch(currentPage);
            };
            function btnSearch(currentPage) {
                Utils.Loading();
                var urlRequestAns = "@Url.Action("ListNhaMay")";
                $.ajax({
                    type: 'GET',
                    url: urlRequestAns,
                    data: parameters,
                    success: function (data) {
                        $("#ListNhaMay").html(data);
                        Utils.UnLoading();
                    },
                    error: function () {
                        Utils.UnLoading();
                    }
                });
            }

        });

</script>