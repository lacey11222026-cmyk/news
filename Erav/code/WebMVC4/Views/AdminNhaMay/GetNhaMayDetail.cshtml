@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model DATA.NhaMay

<div class="well">
    <span class="label label-danger">
        Chú ý!
    </span>
    <span>
        Hãy chắc chắn nhập vào đầy đủ thông tin tại các mục bắt buộc đánh dấu (*)
    </span>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-fw fa-user-md"></i><span>@ViewBag.Title </span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel panel-info">
                        <div id="Errordiv" style="margin:20px;color:red;font-size:13pt"><center></center></div><br />
                        @*<div class="panel-heading">
                                <h4 class="panel-title"><i class="fa fa-wrench" style="margin-right:7px"></i>Thông Tin Cơ Bản</h4>
                            </div>*@
                        <div style="padding: 10px 0 0 0;background-color:#fff !important">

                            <div class="col-md-12">
                                <div>
                                    <!-- dành cho UpdateFunction -->
                                    <div class="form-group">
                                        <label for="txtTitle" class="control-label col-md-3">Tên nhiệm vụ :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtTenNhaMay" name="title" value="@Model.TenNhaMay" class="form-control" placeholder="Nhập tên nhà máy" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtMainCate" class="control-label col-md-3">Loại nhà máy :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlLoaiNhaMay">
                                                    <option value="0" @(Model.LoaiNhaMay == 0 ? "selected='selected'" : "")>Nhà máy thủy điện</option>
                                                    <option value="1" @(Model.LoaiNhaMay == 1 ? "selected='selected'" : "")>Nhà máy nhiệt điện than</option>
                                                    <option value="2" @(Model.LoaiNhaMay == 2 ? "selected='selected'" : "")>Nhà máy Tua-bin khí</option>
                                                    <option value="3" @(Model.LoaiNhaMay == 3 ? "selected='selected'" : "")>Loại nhà máy khác</option>

                                                </select>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="ddlCreatedBy" class="control-label col-md-3">Hình thức :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlLoaiThamGia">
                                                    <option value="0" @(Model.LoaiThamGia == 0 ? "selected='selected'" : "")>Tham gia trực tiếp</option>
                                                    <option value="1" @(Model.LoaiThamGia == 1 ? "selected='selected'" : "")>Tham gia gián tiếp</option>
                                                    <option value="2" @(Model.LoaiThamGia == 2 ? "selected='selected'" : "")>Không tham gia</option>

                                                </select>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtOrgan" class="control-label col-md-3">Công ty phát điện :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtGiamDoc" name="title" value="@Model.GiamDoc" class="form-control" placeholder="" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtCode" class="control-label col-md-3">Địa chỉ  :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtDiaChi" name="code" value="@Model.DiaChi" class="form-control" placeholder="Nhập địa chỉ" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" >
                                        <label for="txtSummary" class="control-label col-md-3">Ghi chú :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtSummary" style="height: 100px;" cols="20" name="description" class="form-control">@Html.Raw(Model.GhiChu)</textarea>

                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="txtOrgan" class="control-label col-md-3">Số điện thoại :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtDienThoai" name="title" value="@Model.DienThoai" class="form-control" placeholder="" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtCode" class="control-label col-md-3">Công suất  :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtCongSuat" name="code" value="@Model.CongSuat" class="form-control" placeholder="Nhập địa chỉ" />
                                            </div>
                                        </div>
                                    </div>


                                    <div class="form-group">
                                        <label for="txtPublicTime" class="control-label col-md-3">Thời gian tham gia :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtPublicTime" data-date-format="DD/MM/YYYY" name="publictime" value="@HtmlHelpers.GetDateDocument(Model.NgayThamGia)" class="form-control" />

                                            </div>
                                        </div>
                                    </div>





                                    <div class="form-group">
                                        <label class="control-label col-md-3" for="cbxIsActive">Trạng thái :</label>
                                        <div class="col-md-4">
                                            <div class="checkbox">
                                                @if (Model.DangThamGia.GetValueOrDefault())
                                                {<input type="checkbox" id="cbxIsActive" checked="checked" />}
                                                else
                                                {<input type="checkbox" id="cbxIsActive" />}

                                            </div>
                                        </div>
                                    </div>

                                    <div class="panel-footer form-horizontal">
                                        <div class="form-group submit">


                                            <button type="submit" class="btn btn-primary" id="btsubmit"><i class="fa fa-save"></i>Lưu lại</button>
                                            <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage();"><i class="fa fa-backward"></i>Quay lại</button>
                                        </div>
                                    </div>



                                </div>
                            </div>
                            <div style="clear:both"></div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    $('#menu_mision').addClass("active");

</script>
<script>
    function GotoListpage() {
        window.location = '@Url.Action("Index")';
    }
    $(document).ready(function () {




        $('#txtPublicTime').datetimepicker({
            //pickTime: false
        });
        $("button.close").click(function () {
            $(this).parent().css("display", "none");
        });
        $('#defaultForm').bootstrapValidator({
            message: 'This value is not valid',
            //live: 'submitted',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {

                title: {
                    message: 'Nhập tên ',
                    validators: {
                        notEmpty: {
                            message: 'tên  không được bỏ trống'
                        },

                        stringLength: {
                            min: 10,
                            max: 250,
                            message: 'tên  nhỏ nhất 10 ký tự và nhiều nhất 250 ký tự'
                        },

                    }
                },

              


            }
        })
        .on('success.form.bv', function (e) {
            // Prevent submit form
            e.preventDefault();

            var $form = $(e.target),
                validator = $form.data('bootstrapValidator');
            SaveData();
            $(".close").click(function () {
                $(".alert-success").css("display", "none");
            });
        })
        .on('error.form.bv', function (e) {
            // Active the panel element containing the first invalid element
            e.preventDefault();
            var $form = $(e.target),
            validator = $form.data('bootstrapValidator');
            $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
            $(".alert-danger").css("display", "block");
            $(".close").click(function () {
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
        });

        $("#btnReset").click(function () {
            $('#defaultForm').data('bootstrapValidator').resetForm(true);
            $(".alert-danger").css("display", "none");
            $(".alert-success").css("display", "none");
        });

        //Save Data
        function SaveData() {
            var param = {
                'Id': '@Model.Id',
                'TenNhaMay': $("#txtTenNhaMay").val(),
                'GhiChu': $("#txtSummary").val(),
                'GiamDoc': $("#txtGiamDoc").val(),
                'LoaiNhaMay': $("#LoaiNhaMay").val(),
                'LoaiThamGia': $("#ddlLoaiThamGia").val(),
                'DiaChi': $("#txtDiaChi").val(),
                'CongSuat': $("#txtCongSuat").val(),
                'SPublishDate': $("#txtPublicTime").val(),
                'DienThoai': $("#txtDienThoai").val(),
                'DangThamGia': $("#cbxIsActive").is(":checked") ? 1 : 0

            }
            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "@Url.Action("SaveData")",
                data: addAntiForgeryToken(param),
            async: true,
            success: function (data) {
                Utils.UnLoading();
                if (data.ResponseCode >= 0) {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $(".alert-success").show("slow");
                    $(".alert-danger").hide("slow");
                    setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 500);

                }
                else {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $("#ErrorMessage").text(data.Description);
                    $(".alert-danger").show("slow");
                    $(".alert-success").hide("slow");
                    setTimeout(function () { $(".alert-danger").hide("slow"); }, 2000);
                }
            }
        });
    };
    });
</script>
<style>
    .input-icon {
        position: relative;
        width: 100%;
    }
</style>