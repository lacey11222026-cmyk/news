@using BIZ.Entity
@using UTILS
@model List<DATA.NhaMay>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>ID</th>

            <th class="texttable">Tên </th>
            <th>Công ty phát điện</th>
            <th>Loại nhà máy</th>
            <th>Hình thức tham gia</th>
         

            
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>
                <td>@obj.Id</td>

                <td class="texttable" style="text-align:left;min-width:150px;">
                    <a href="@Url.Action("GetNhaMayDetail",new {id=obj.Id })" title="Edit">@obj.TenNhaMay</a>
                </td>
                <td>@Html.Raw(obj.GiamDoc)

                

                <td>@HtmlHelpers.GetNhaMayThamGia(obj.LoaiThamGia)</td>
                <td>@HtmlHelpers.GetNhaMayLoai(obj.LoaiNhaMay)</td>

            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            title: $("#txtTitle").val(),
            hinhthuc: $('#ddlCate :selected').val(),
            loai: $('#ddlloai :selected').val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListNhaMay")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListNhaMay").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });



</script>