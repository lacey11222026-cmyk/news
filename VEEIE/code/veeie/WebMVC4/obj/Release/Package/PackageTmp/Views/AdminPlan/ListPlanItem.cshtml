@using DATA
@model List<PlanItem>
@{ var idx = 0; }
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th style="width:39px">STT </th>
            <th>Tiểu dự án </th>
            <th style="width:88px">Trạng thái</th>
            
            <th style="width:88px">Sắp xếp</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            { idx++; }
<tr>
    
    <td>@(idx)</td>
    <td style="text-align:left"><a href="javascript:;" onclick="EditPlanItem(@obj.Id)">@obj.Name</a></td>



    <td class="fun-arrange">
        @if (obj.Status == 1)
        {
            <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatusItem(@obj.Id, 1);"><i class="fa fa-check"></i></a>

        }
        else
        {
            <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatusItem(@obj.Id,0);"><i class="fa fa-ban"></i></a>

        }
    </td>


    <td class="fun-arrange">
        <a href="javascript:;" onclick="UpdateSortOrderItem(@obj.Id,0,@obj.PlanId)"><i class="fa fa-arrow-up"></i></a>

        <a href="javascript:;" onclick="UpdateSortOrderItem(@obj.Id,1,@obj.PlanId)"><i class="fa fa-arrow-down"></i></a>
    </td>


</tr>
        }
    }
</table>
<script type="text/javascript">


    function UpdateSortOrderItem(Id, UpOrder, PlanId) {
        var param = {
            Id: Id,
            SortOrder: UpOrder,
            PlanId: PlanId
        }
        $.ajax({
            type: 'POST',
            url: '/AdminPlan/PlanItemUpdateSortOrder',
            data: JSON.stringify(param),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: true,
            success: function (data) {
                Utils.UnLoading();
                var msg = data.Msg;
                if (data.ResponseCode > 0) {
                    location.reload();
                }
                else {
                    bootbox.alert(msg);
                }
            }
        });
    }
    function UpdateStatusItem(id,status) {
        var type = "Vô hiệu hóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
       bootbox.confirm("Bạn muốn " + type + " nội dung này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/AdminPlan/PlanItemUpdateStatus",
                    data: {
                        'id': id
                    },
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            location.reload();
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }

</script>
