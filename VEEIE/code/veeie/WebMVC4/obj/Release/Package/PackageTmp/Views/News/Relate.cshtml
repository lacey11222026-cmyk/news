@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
<h3 class="title-blue02">@Resources.Global.RelateNews</h3>
        <ul class="news-other-list row">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li class="col-md-4 col-sm-4 col-xs-6">

                    <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=239&h=160&mode=crop" /></a>
                    <a href="@item.value.LinkUrl">@item.value.Title</a>

                </li>

            }
        </ul>




    }


}