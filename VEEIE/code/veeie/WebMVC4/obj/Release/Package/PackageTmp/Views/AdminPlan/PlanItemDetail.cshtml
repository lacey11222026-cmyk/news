<script type="text/javascript">


    $(document).ready(function () {


            $("button.close").click(function () {
                $(this).parent().css("display", "none");
            });
            $('#defaultForm').bootstrapValidator({
                message: 'This value is not valid',
                //live: 'submitted',
                feedbackIcons: {
                    valid: 'glyphicon glyphicon-ok',
                    invalid: 'glyphicon glyphicon-remove',
                    validating: 'glyphicon glyphicon-refresh'
                },
                fields: {



                }
            })
            .on('success.form.bv', function (e) {
                // Prevent submit form
                e.preventDefault();

                var $form = $(e.target),
                    validator = $form.data('bootstrapValidator');
                SaveData();
                $(".close").click(function () {
                    $(".alert-success").css("display", "none");
                });
            })
            .on('error.form.bv', function (e) {
                // Active the panel element containing the first invalid element
                e.preventDefault();
                var $form = $(e.target),
                validator = $form.data('bootstrapValidator');
                $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
                $(".alert-danger").css("display", "block");
                $(".close").click(function () {
                    $(".alert-danger").css("display", "none");
                    $(".alert-success").css("display", "none");
                });
            });

            $("#btnReset").click(function () {
                $('#defaultForm').data('bootstrapValidator').resetForm(true);
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
            //Save Data
            function SaveData() {
                var param = {
                    'Id': '@Model.Id',
                    'PlanId': '@Model.PlanId',
                    'Name': $("#txtName").val(),
                    'Status': $("#cbxIsActive").is(":checked") ? 1 : 0,

                    'Currency1': $("#txtCurrency1").val(),
                    'CurrencyRate1': $("#txtCurrencyRate1").val(),
                    'PlanYear1': $("#txtPlanYear1").val(),
                    'PlanCurrent1': $("#txtPlanCurrent1").val(),
                    'PlanQ1': $("#txtPlanQ1").val(),
                    'BalanceYear1': $("#txtBalanceYear1").val(),
                    'Balance1': $("#txtBalance1").val(),

                    
                    'Currency2': $("#txtCurrency2").val(),
                    'CurrencyRate2': $("#txtCurrencyRate2").val(),
                    'PlanYear2': $("#txtPlanYear2").val(),
                    'PlanCurrent2': $("#txtPlanCurrent2").val(),
                    'PlanQ2': $("#txtPlanQ2").val(),
                    'BalanceYear2': $("#txtBalanceYear2").val(),
                    'Balance2': $("#txtBalance2").val(),

                    
                    'Currency3': $("#txtCurrency3").val(),
                    'CurrencyRate3': $("#txtCurrencyRate3").val(),
                    'PlanYear3': $("#txtPlanYear3").val(),
                    'PlanCurrent3': $("#txtPlanCurrent3").val(),
                    'PlanQ3': $("#txtPlanQ3").val(),
                    'BalanceYear3': $("#txtBalanceYear3").val(),
                    'Balance3': $("#txtBalance3").val(),

                }

                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("PlanItemSaveData")",
                    data: addAntiForgeryToken(param),
                    async: true,
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            $(".alert-success").show("slow");
                            $(".alert-danger").hide("slow");

                            $('.modal ').modal('hide');
                            location.reload();
                        }
                        else {

                            $("#ErrorMessage").text(data.Description);
                            $(".alert-danger").show("slow");
                            $(".alert-success").hide("slow");
                            setTimeout(function () { $(".alert-danger").hide("slow"); }, 5000);
                        }
                    }
                });
            };
        });



</script>
