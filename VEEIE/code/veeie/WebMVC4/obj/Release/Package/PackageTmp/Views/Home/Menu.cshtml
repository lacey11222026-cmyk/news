@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>
@{
    var Date = Utils.formatDateofWeek(DateTime.Now.DayOfWeek) + "," + DateTime.Now.ToString(" dd") + "/" + DateTime.Now.ToString("MM") + "/" + DateTime.Now.Year.ToString() + " | " + DateTime.Now.ToString("HH") + ":" + DateTime.Now.ToString("mm");
    var DateEN = DateTime.Now.DayOfWeek.ToString() + ", " + DateTime.Now.ToString("dd") + "/" + DateTime.Now.ToString("MM") + "/" + DateTime.Now.Year.ToString() + " | " + DateTime.Now.ToString("HH") + ":" + DateTime.Now.ToString("mm");
}

<header>
    <div class="container">
        <a href="/"><img src="@Resources.Global.Logo" alt="dự án tiết kiệm năng lượng cho ngành công nghiệp Việt Nam"></a>
    </div>
    <img src="/Content/images/bnr-top.png" class="bnr-img">
</header>
<nav class="nav_top original" style="visibility: visible;">
    <div class="container">
        <ul class="nav-list pull-left">
            <li class="active"><a href="/"><img src="/Content/images/icon-home.png" alt="Trang chủ"></a></li>
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li>
                    <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name.Replace("Video En", "Video") </a>
                    @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                </li>
            }
        </ul>
        <ul class="link-icon pull-right">
            @if (ViewBag.lang == "vi-vn")
            {
                <li><a href="/Home/Language?lang=en-us"><img src="/Content/images/ico-en.png"></a></li>
            }
            else
            {
                <li><a href="/Home/Language?lang=vi-vn"><img src="/Content/images/ico-vn.png"></a></li>
            }
        </ul>
        <div class="clearfix"></div>
    </div>
</nav>

<div class="nav-mobile">
    <div class="header-m">
        <a href="/"><img src="@Resources.Global.Logo" class="bnr-img-mb"></a>
        <a href="#menu">
            <img src="/Content/images/ico-menu.png" class="ico-menu pull-right">
            <span class="clearfix"></span>
        </a>
    </div>
    <div id="menu">
        <ul>
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li>
                    <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name.Replace("Video En", "Video") </a>
                    @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                </li>
            }
        </ul>
    </div>
</div>
<div class="slide-top">
    <div class="bnr-slide" id="bnr-slide">
      
    </div>
</div>
<div>
    <section class="tool container mt10 hidden_mobile">
        @if (ViewBag.lang == "vi-vn")
        {
            <p class="pull-left">@Date GMT+7</p>
            <div class="pull-right col-md-4 col-sm-6 col-xs-12 pr0">
                <div class=" input-group col-md-7 col-sm-7 col-xs-7 pull-left">
                    <input type="text" class="form-control" id="txtKeyword" placeholder="@Resources.Global.MenuSearch" onkeydown="javascript: return AnyInput_KeyDown(this, event);">
                    <span class="input-group-btn">
                        <button class="btn btn-default" type="button" onclick="search()"><span class="glyphicon glyphicon-search" aria-hidden="true"></span></button>
                    </span>
                </div>
                <form>
                    <div class="form-group col-md-5 col-sm-5 col-xs-5 pr0">
                        <select class="form-control" id="Select1" onchange="window.open(this.options[this.selectedIndex].value,'_blank');this.options[0].selected=true">
                            <option selected="selected">@Resources.Global.Link</option>
                            <option value="http://moit.gov.vn/">Cổng thông tin điện tử Bộ Công Thương </option>
                            <option value="http://www.worldbank.org/">Ngân hàng Thế giới</option>
                            <option value="http://scp.gov.vn/">Văn phòng SXSH và SXTDBV </option>
                            <option value="http://tietkiemnangluong.com.vn//"> Chương trình TKNL quốc gia </option>

                        </select>
                    </div>
                </form>
            </div>
        }
        else
        {
            <p class="pull-left">@DateEN GMT+7</p>
            <div class="pull-right col-md-4 col-sm-6 col-xs-12 pr0">
                <div class=" input-group col-md-7 col-sm-7 col-xs-7 pull-left">
                    <input type="text" class="form-control" id="txtKeyword" placeholder="@Resources.Global.MenuSearch">
                    <span class="input-group-btn">
                        <button class="btn btn-default" type="button" onclick="search()"><span class="glyphicon glyphicon-search" aria-hidden="true"></span></button>
                    </span>
                </div>
                <form>
                    <div class="form-group col-md-5 col-sm-5 col-xs-5 pr0">
                        <select class="form-control" id="Select1" onchange="window.open(this.options[this.selectedIndex].value,'_blank');this.options[0].selected=true">
                            <option selected="selected">@Resources.Global.Link</option>
                            <option value="http://moit.gov.vn/">Ministry of Industry and Trade Portal </option>
                            <option value="http://www.worldbank.org/">World Bank</option>
                            <option value="http://scp.gov.vn/">Cleaner Production and Sustainable Production and Consumption Office </option>
                            <option value="http://tietkiemnangluong.com.vn//"> VNEEP </option>

                        </select>
                    </div>
                </form>
            </div>
        }

    </section><!-- end tool-->
    <div class="tool_mobile block_mobile">
        @if (ViewBag.lang == "vi-vn")
        {
            <div class="date">
                @Date GMT+7
            </div>
        }
        else
        {<div class="date">
                @DateEN GMT+7
            </div>
        }
        <ul>
            <li>
                <div class="search_m">
                    <a class="click" href="#"></a>
                    <input class="submit_m" type="submit" onclick="Msearch()">
                    <input class="text_m" type="text" id="txtKeywordMobile" placeholder="@Resources.Global.MenuSearch" onkeydown="javascript: return MAnyInput_KeyDown(this, event);">
                </div>
            </li>
            @if (ViewBag.lang == "vi-vn")
            {
                <li><a href="/Home/Language?lang=en-us"><img src="/Content/images/ico-en.png" style="margin: 3px 15px 1px 0px;"></a></li>
            }
            else
            {
                <li><a href="/Home/Language?lang=vi-vn"><img src="/Content/images/ico-vn.png" style="margin: 3px 15px 1px 0px;"></a></li>
            }
        </ul>
        <div class="clearfix"></div>
    </div>

</div>




<script type="text/javascript">
    function search() {
        var searchtext = $("#txtKeyword").val();
        window.location = "/News/Search?q=" + searchtext;

    }
    function AnyInput_KeyDown(sender, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            search();

            return false;
        }

        return true;
    }


    function Msearch() {
        var searchtext = $("#txtKeywordMobile").val();
        window.location = "/News/Search?q=" + searchtext;

    }
    function MAnyInput_KeyDown(sender, e) {
        if ((e.which && e.which === 13) || (e.keyCode && e.keyCode === 13)) {
            Msearch();

            return false;
        }

        return true;
    }



</script>