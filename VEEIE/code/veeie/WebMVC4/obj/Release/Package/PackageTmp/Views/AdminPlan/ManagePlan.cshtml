@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper


<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">
                    <div class="col-md-12">


                    
                        <div class="form-group submit" style="text-align:center">
                            <a href="@Url.Action("Info",new {id=0 })" class="btn btn-success"><i class="fa fa-user-plus"></i>Thêm Mới</a>

                        </div>

                    </div>

                </div>
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListPlan">
                            @Html.Action("ListPlan", "AdminPlan")
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var parameters = {
        };
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        $("#ddlActive").change(function () {
            GetList(1);
        });
       
        function GetList(currentPage) {
           
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {
            Utils.Loading();
            var urlRequestAns = "/AdminPlan/ListPlan";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                success: function (data) {
                    $("#ListPlan").html(data);
                    Utils.UnLoading();
                },
                error: function () {
                    Utils.UnLoading();
                }
            });
        }

    });

</script>
<script>
    $('#menu_manageplan').addClass("active");
</script>

