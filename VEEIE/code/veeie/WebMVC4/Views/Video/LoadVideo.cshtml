@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel
@if (Model != null)
{
    <ul class="video-list-item row mt10">
        @if (Model.listdata!=null)
        {
            foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
            {


                <li class="col-md-3 col-sm-4 col-xs-6">
                    <a href="/trang-chu-video.html?VideoId=@(item.value.Id)">
                        @*<img src="/Content2/images/new-list.jpg">*@
                        <img src="@item.value.MainImage?w=197&h=110&mode=crop">
                        <span>@item.value.Title</span>
                    </a>
                </li>
            }
        }



    </ul>

    <div style="clear:both"></div>
    <div class="pagination pull-right mt30">
        <ul>
            @{Html.RenderPartial("PaginationVideo", new WebMVC4.Models.PaginationInfo
                {
                    PageUrl = Url.SetParameter("Page", "!0"),
                    CurrentPage = Model.pageIndex,
                    PageSize = Model.pageSize,
                    TotalItemCount = Model.total,
                }); }
        </ul>
    </div>

    <script>

        function GoVideoPage(page) {
            var VideoId = '@Model.Id';
            var Cateid='@Model.CategoryId'
            if (page > 0) {
                $.ajax({
                    type: "GET",
                    url: "/Video/LoadVideo/?VideoId=" + VideoId + "&page=" + page + "&CategoryId=" + Cateid,
                    success: function (data) {
                        if (data != "null") {
                            $("#lstVideo").html(data);
                        }
                    }
                });
            }

        }

    </script>
}