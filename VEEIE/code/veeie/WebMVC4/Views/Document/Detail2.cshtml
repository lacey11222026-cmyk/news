@using BIZ
@using DATA
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.DOCUMENT_FULL
@{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
<div id="document" class="main-content">
    <div class="list-page">
        <div class="document-table table-responsive mt20">
            <table>
                <tbody>
                    <tr class="bgcolor1">
                        <td width="25%" height="50">
                            @Resources.Global.DocName2

                        </td>
                        <td colspan="3">

                            @Html.Raw(Model.Name)

                        </td>
                    </tr>
                    <tr class="bgcolor1">
                        <td width="25%" height="50">
                            @Resources.Global.DocViewOnline
                        </td>
                        <td colspan="3" class="titledoc2">

                            @*<a href="javascript:;" class="popupitem" data-plink="@Url.Action("ConfirmDownload", new { Id =Model.Id,HeaderTitle= Resources.Global.DocViewOnline})" data-url="@Url.Action("ViewFile", "Document", new {id = Model.Id})">@Resources.Global.DocViewOnline</a>*@
                            <a href="@Url.Action("ViewFile","Document",new { id=Model.Id})" target="_blank">@Resources.Global.DocViewOnline</a>
                        </td>

                    </tr>
                    <tr class="bgcolor1">
                        <td width="25%" height="50" class="titledoc">
                            @Resources.Global.DocDownload
                        </td>
                        <td colspan="3" class="titledoc2">
                            @*<a href="javascript:;"  class="popupitem" data-plink="@Url.Action("ConfirmDownload", new { Id = Model.Id,HeaderTitle= Resources.Global.DocDownload})" data-url="@Url.Action("DownloadFile", "Document", new {id = Model.Id})">@Resources.Global.DocDownload </a>*@
                            <a href="@Url.Action("DownloadFile","Document",new { id=Model.Id})">@Resources.Global.DocDownload </a>


                        </td>

                    </tr>
                    <tr class="bgcolor1">
                        <td height="50" class="titledoc">
                            @Resources.Global.DocDescription
                        </td>
                        <td colspan="3">
                            @Html.Raw(Model.Description)
                        </td>
                    </tr>
                    
                    <tr class="bgcolor1">
                        <td height="50" class="titledoc">
                            @Resources.Global.DocSignedByDesc
                        </td>
                        <td align="center">
                            @Model.SignedByDesc

                        </td>
                        <td class="titledoc">
                            @Resources.Global.DocSignedBy
                        </td>
                        <td align="center">
                            @Model.SignedBy
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
<div class="clear padtop10"></div>
@if (ViewBag.lstRef != null)
{
    <div class="news-other mt30">
        @if (Model.CategoryPathway.Contains(",8,"))
        {
            <h2 class="title-cm mt0"> @Resources.Global.DocRelate2</h2>
        }
        else
        {<h2 class="title-cm mt0"> @Resources.Global.DocRelate</h2>

    }

        <ul class="news-list">


            @foreach (BIZ.Entity.DOCUMENT_FULL item in ViewBag.lstRef)
            {
                if (item.Id != Model.Id)
                {
                    <li><a title="@item.Name" href="@Utils.FormatUrlRewrite(item.Id, "", "DocumentDetail")">@Html.Raw(item.Name) </a></li>
                }

            }



        </ul>


    </div>







}
    <div class="modal fade" id="modal-2" tabindex="-1" role="modal" aria-labelledby="modal-label-2" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content" id="modal-content">
            </div>
        </div>
    </div>
<style>
    .titledoc2 a {
        color: #1f5ecb !important;
    }
</style>
<script type="text/javascript">


   
    $(document).ready(function () {
        $('.popupitem').click(function () {
            var url = $(this).data('url');
            var popupurl = $(this).data('plink');
            $.get(popupurl+'&url='+url, function (data) {
                $('#modal-content').html(data);

                $('#modal-2').modal('show');
            });
        });
    });
</script>