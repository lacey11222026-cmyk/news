@using DATA
@using UTILS
@model List<Plan>
@{ var idx = 0; }
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>STT </th>
            <th>Tên dự án </th>
            <th>Chủ đầu tư </th>
            <th>Tổng mức đầu tư</th>
            <th>Vốn vay(IBRD)</th>
            <th>Vốn vay(PFI)</th>
            <th>Năng lương tiết kiệm</th>
            <th>Trạng thái</th>
            <th>Quản trị</th>
            <th>Sắp xếp</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            { idx++; }
            <tr>
                <td>@(idx+1)</td>
                <td style="text-align:left"><a href="@Url.Action("Info",new { id=obj.Id})">@obj.Name</a></td>
                <td>@obj.Investor</td>
                <td>@obj.Total</td>
                <td>@obj.Total1</td>
                <td>@obj.Total2</td>
                <td>@obj.Power</td>
                <td class="fun-arrange">
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatus(@obj.Id, 1);"><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatus(@obj.Id,0);"><i class="fa fa-ban"></i></a>

                    }
                </td>

                <td style="text-align:center">



                    <a href="@Url.Action("Info",new { id=obj.Id})"><i class="fa fa-edit"></i></a>



                    <a href="@Url.Action("Detail",new { Id=Utils.Base64Encode(obj.Id),Name=obj.Name})">Chi tiết</a>

                </td>
                <td class="fun-arrange">
                    <a href="javascript:;" onclick="UpdateSortOrder(@obj.Id,0)"><i class="fa fa-arrow-up"></i></a>

                    <a href="javascript:;" onclick="UpdateSortOrder(@obj.Id,1)"><i class="fa fa-arrow-down"></i></a>
                </td>



            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            status: $('#ddlActive :selected').val(),
            lang: $('#ddlLang :selected').val(),
            type: $('#ddlType :selected').val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = "/AdminPlan/ListPlan";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListPlan").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });
    function UpdateSortOrder(Id, UpOrder) {
        var param = {
            Id: Id,
            SortOrder: UpOrder
        }
        $.ajax({
            type: 'POST',
            url: '/AdminPlan/UpdateSortOrder',
            data: JSON.stringify(param),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: true,
            success: function (data) {
                Utils.UnLoading();
                var msg = data.Msg;
                if (data.ResponseCode > 0) {
                    BindDataRequest(CurrentPage);
                }
                else {
                    bootbox.alert(msg);
                }
            }
        });
    }
    function UpdateStatus(id,status) {
        var type = "Vô hiệu hóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " dự án này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/AdminPlan/UpdateStatus",
                    data: {
                        'id': id
                    },
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }

</script>
