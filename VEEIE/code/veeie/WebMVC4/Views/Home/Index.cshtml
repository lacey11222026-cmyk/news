@using BIZ
@using UTILS
@using WebMVC4.Helper

@{
    Layout = "~/Views/Shared/_Home.cshtml";
}
<div class="row content01">
    <div class="col-md-8 col-sm-8 col-xs-12">
        @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 3, MaxLastestNews = 7 });}
    </div>
    <div class="col-md-4 col-sm-4 col-xs-12 banklist">
        @{Html.RenderAction("Report", "Home", new { param = "" });}
        <ul class="bnrlogo mt15">
            @{Html.RenderAction("BannerRight1", "Home", new { param = "" });}
        </ul>
    </div>
</div><!-- end row-->

@{Html.RenderAction("Banner", "Home", new { Type = 1 });}
<div class="row mt30">
    <div class="col-md-4 col-sm-4 col-xs-6 box-item maxheight03">
        @{Html.RenderAction("LastestNews2", "Home", new { CateName = "", CategoryId = 29, MaxLastestNews = 3 });}
    </div>

    <div class="col-md-4 col-sm-4 col-xs-6 maxheight03 border-l-gray box-item pull-right">
        @{Html.RenderAction("HomeVideo", "Home", new { CateName = "", CategoryId = 13, MaxLastestNews = 3 });}
    </div>
    <div class="col-md-4 col-sm-4 col-xs-12 border-l-gray maxheight03 pull-left fixmb">
        <div class="row">
            <div class="col-sm-12 col-xs-6 maxheight04">
                @{Html.RenderAction("TopQuestion", "Home", new { CateName = "", CategoryId = 9, MaxLastestNews = 5,param= "maxheight02" });}
            </div>
            <div class="col-sm-12 col-xs-6 maxheight04">
                <div class="maxheight02 mt30"><h2 class="title-cm"><a href="/Document/Index/6">Tài liệu</a></h2></div>
                <ul class="document-list">
                    <li><a href="/Document/Index/11">Văn kiện dự án</a></li>
                    <li><a href="/Document/Index/12">Sổ tay TKNL</a></li>
                    <li><a href="/hoi-dap/c10/don-vi-tu-van.html">Đơn vị tư vấn</a></li>
                    <li><a href="/hoi-dap/c8/mau-ho-so.html">Mẫu hồ sơ</a></li>
                    <li><a href="/Document/Index/38">Tài liệu khác</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<script>

        function loadslide() {
            $.ajax({
                type: "Get",
                url: "@Url.Action("Banner2",new { Type=1})",
                success: function (data) {
                    if (data) {
                        $("#bnr-slide").html(data);
                    }
                }
            });
        }
        setTimeout(function () {
            loadslide();
        }, 2);

</script>