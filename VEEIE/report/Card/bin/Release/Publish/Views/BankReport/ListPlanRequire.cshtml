@using Car.Data
@using Car.Utility
@using Car.CMS.Helper
@model List<PlanRequire>
@{ var idx = 0; }
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th style="width:39px">STT </th>
            <th>
                Tên dự án

            </th>
            <th>
                Địa điểm thực hiện dự án

            </th>
            <th>Loại dự án </th>
            <th>Tổng chi phí đầu tư(triệu VND)</th>
            <th>Tổng vay(triệu VND)</th>
            <th>
                Vốn vay IBRD (triệu VND)
            </th>


            <th>Hiện trạng </th>
            <th style="width:88px;display:none">Trạng thái</th>

            <th style="width:88px">Sắp xếp</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            { idx++; }
            <tr>
                <td>@(idx)</td>
                <td style="text-align:left"><a href="javascript:;" onclick="EditPlanRequire(@obj.Id)">@obj.FinishDate</a></td>
                <td>@obj.Place</td>
                <td>@obj.Description</td>
                <td>@obj.Total</td>
                <td>@obj.Total1</td>
                <td>@obj.Total2</td>
                <td>
                    @if (!obj.Result.Equals("Khác"))
                    {
                        <text>@obj.Result</text>
                    }
                    else
                    {
                        <text>@obj.ResultOther</text>
                    }

                </td>
                <td class="fun-arrange" style="display:none;">
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatusRequire(@obj.Id, 1);"><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatusRequire(@obj.Id,0);"><i class="fa fa-ban"></i></a>

                    }
                </td>


                <td class="fun-arrange">
                    <a href="javascript:;" onclick="UpdateSortOrderRequire(@obj.Id,0,@obj.PlanId)"><i class="fa fa-arrow-up"></i></a>

                    <a href="javascript:;" onclick="UpdateSortOrderRequire(@obj.Id,1,@obj.PlanId)"><i class="fa fa-arrow-down"></i></a>
                </td>



            </tr>
        }
    }
</table>
<script type="text/javascript">


    function UpdateSortOrderRequire(Id, UpOrder, PlanId) {
        var param = {
            Id: Id,
            SortOrder: UpOrder,
            PlanId: PlanId
        }
        $.ajax({
            type: 'POST',
            url: '/BankReport/PlanRequireUpdateSortOrder',
            data: JSON.stringify(param),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: true,
            success: function (data) {
                Utils.UnLoading();
                var msg = data.Msg;
                if (data.ResponseCode > 0) {
                    loadPlanRequire();
                }
                else {
                    bootbox.alert(msg);
                }
            }
        });
    }
    function UpdateStatusRequire(id, status) {
        var type = "Vô hiệu hóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " nội dung này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/BankReport/PlanRequireUpdateStatus",
                    data: {
                        'id': id
                    },
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            loadPlanRequire();
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }

</script>
