<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="box-body">
                <div class="row" id="form">

                    <div class="col-md-12">
                        <div class="form-group col-md-3 col-xs-12 col-sm-6">
                            <select class="form-control" id="ddlYear">
                                @for (var i = DateTime.Now.Year + 5; i >= 2017; i--)
                                {

                                    if (i == DateTime.Now.Year)
                                    {
                                        <option value="@i" selected="selected">Năm @(i)</option>
                                    }
                                    else
                                    {
                                        <option value="@i">Năm @(i)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group submit" style="text-align:center">
                            <a href="@Url.Action("Info",new {id=0 })" class="btn btn-success"><i class="fa fa-user-plus"></i> Thêm Mới</a>
                            <a id="btn_export" href="javascript:;" onclick="Report();" class="btn btn-success"><i class="fa fa-file-excel-o"></i> Tải Excel</a>
                        </div>

                    </div>

                </div>
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListReport">
                            @Html.Action("ListFinance", "Finance",new { year=DateTime.Now.Year})
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    function Report()
     {
          var urlRequestAns = "/Finance/ExportExcel?year=" + $("#ddlYear").val();

                window.location = urlRequestAns;
    }
    $(document).ready(function () {

       
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
         $("#ddlYear").change(function () {
            GetList(1);
        });

        function GetList(currentPage) {

            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {
             var parameters = {
          
            year: $("#ddlYear").val(),
        };
            Utils.Loading();
            var urlRequestAns = "/Finance/ListFinance";
            $.ajax({
                type: 'GET',
                data: parameters,
                url: urlRequestAns,
                success: function (data) {
                    $("#ListReport").html(data);
                    Utils.UnLoading();
                },
                error: function () {
                    Utils.UnLoading();
                }
            });
        }

    });

</script>

