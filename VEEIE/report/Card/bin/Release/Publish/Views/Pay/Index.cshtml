<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="box-body">
                <div class="row" id="form">
                    <div class="col-md-12">
                        
                        <div class="form-group submit" style="text-align:center">
                            <a href="@Url.Action("Info",new {id=0 })" class="btn btn-success"><i class="fa fa-user-plus"></i> Thêm Mới</a>
                            <a id="btn_export" href="@Url.Action("ExportExcel")" target="_blank" class="btn btn-success"><i class="fa fa-file-excel-o"></i> Tải Excel</a>
                        </div>

                    </div>

                </div>
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListReport">
                            @Html.Action("ListPay", "Pay")
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        //var parameters = {
        //    type: $("#ddlType").val(),
        //    bank: $("#ddlBank").val(),
        //    year: $("#ddlYear").val(),
        //};
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
       

        function GetList(currentPage) {

            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {
            Utils.Loading();
            var urlRequestAns = "/Pay/ListPay";
            $.ajax({
                type: 'GET',
                //data: parameters,
                url: urlRequestAns,
                success: function (data) {
                    $("#ListReport").html(data);
                    Utils.UnLoading();
                },
                error: function () {
                    Utils.UnLoading();
                }
            });
        }

    });

</script>

