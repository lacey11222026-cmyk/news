<div class="row">
    <div class="col-lg-12">
        <div class="box box-primary">
            <div class="box-header"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="box-body">
                <div class="row" id="form">
                    <div class="col-md-12">


                        <div class="form-group submit" style="text-align:center">
                            <a href="@Url.Action("Info",new {id=0 })" class="btn btn-success"><i class="fa fa-user-plus"></i> Thêm Mới</a>

                        </div>

                    </div>

                </div>
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListProject">
                            @Html.Action("ListProject", "Project")
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var parameters = {
        };
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btnSearch").click();
            }
        });
        $("#btnSearch").click(function () {
            GetList(1);
        });
        $("#ddlActive").change(function () {
            GetList(1);
        });

        function GetList(currentPage) {

            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {
            Utils.Loading();
            var urlRequestAns = "/Project/ListProject";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                success: function (data) {
                    $("#ListProject").html(data);
                    Utils.UnLoading();
                },
                error: function () {
                    Utils.UnLoading();
                }
            });
        }

    });

</script>


