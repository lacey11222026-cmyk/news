@using Car.Data
@using Car.Utility
@using Car.CMS.Helper
@model List<ProjectReport>
@{ var idx = 0; }
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>STT </th>
            <th>Tên dự án </th>
            <th>Loại báo cáo</th>
            <th>Năm</th>

            @if (ViewBag.IsUpdate)
            {
                <th>Trạng Thái</th>
            }
            <th>Quản trị</th>

        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            { idx++; }
            <tr>
                <td>@(idx )</td>
                <td style="text-align:left">@obj.Name</td>

                <td>@HtmlHelpers.GetReportType(obj.Type.GetValueOrDefault())</td>
                <td>@obj.Year</td>
                @if (ViewBag.IsUpdate)
                {
            <td class="fun-arrange">
                @if (obj.Status == 1)
                {
                    <text>Đã gửi báo cáo</text>

                }
                else
                {
                    <text>Chưa gửi báo cáo </text>

                }
            </td>
                }
                <td style="text-align:right">


                    @if (ViewBag.IsUpdate&&obj.Status==0)
                    {
                        <a href="@Url.Action("Info", new { id = obj.Id })"> Cập nhật</a> <text>&nbsp;</text>
                    }
                    <a href="@Url.Action("Detail",new { id=obj.Id})" target="_blank">Xem chi tiết</a> <text>&nbsp;</text>
                    <a href="javascript:;" onclick="DeleteData(@obj.Id);">Xóa</a>
                </td>




            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            type: $("#ddlType").val(),
            year: $("#ddlYear").val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = "/Report/ListReport";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListReport").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });
    function UpdateSortOrder(Id, UpOrder) {
        var param = {
            Id: Id,
            SortOrder: UpOrder
        }
        $.ajax({
            type: 'POST',
            url: '/Report/UpdateSortOrder',
            data: JSON.stringify(param),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: true,
            success: function (data) {
                Utils.UnLoading();
                var msg = data.Msg;
                if (data.ResponseCode > 0) {
                    BindDataRequest(CurrentPage);
                }
                else {
                    bootbox.alert(msg);
                }
            }
        });
    }
    function DeleteData(id) {
       
        bootbox.confirm("Bạn muốn xóa báo cáo này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Report/Delete",
                    data: {
                        'id': id
                    },
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            location.reload();
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
    function UpdateStatus(id,status) {
        var type = "Vô hiệu hóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " báo cáo này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Report/UpdateStatus",
                    data: {
                        'id': id
                    },
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }

</script>
