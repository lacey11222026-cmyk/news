@using Car.Data
@using Car.Utility
@using Car.CMS.Helper
@model List<Pay>
@{ var idx = 0; }
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th rowspan="2">Năm </th>

            <th rowspan="2">Tổng kế hoạch rút vốn(triệu VND)</th>
            <th colspan="4">Kế hoạch giải ngân</th>
            @*<th rowspan="2">Trạng thái </th>*@
            <th rowspan="2">Quản trị </th>
        </tr>
        <tr>
            <th>Quý 1 (triệu VND)</th>
            <th>Quý 2 (triệu VND)</th>
            <th>Quý 3 (triệu VND)</th>
            <th>Quý 4 (triệu VND)</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            { idx++; }
<tr>


    <td>@obj.Year</td>
    <td>@obj.Total</td>
    <td>@obj.Total1</td>
    <td>@obj.Total2</td>
    <td>@obj.Total3</td>
    <td>@obj.Total4</td>
    @*<td class="fun-arrange">
        @if (obj.Status == 1)
        {
            <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatus(@obj.Id, 1);"><i class="fa fa-check"></i></a>

        }
        else
        {
            <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatus(@obj.Id,0);"><i class="fa fa-ban"></i></a>

        }
    </td>*@

    <td style="text-align:center">

        <a href="@Url.Action("Info", new { id = obj.Id })"> Cập nhật</a> <text>&nbsp;</text>
    </td>




</tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {

            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = "/Pay/ListPay";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListReport").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });
    function UpdateSortOrder(Id, UpOrder) {
        var param = {
            Id: Id,
            SortOrder: UpOrder
        }
        $.ajax({
            type: 'POST',
            url: '/Pay/UpdateSortOrder',
            data: JSON.stringify(param),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: true,
            success: function (data) {
                Utils.UnLoading();
                var msg = data.Msg;
                if (data.ResponseCode > 0) {
                    BindDataRequest(CurrentPage);
                }
                else {
                    bootbox.alert(msg);
                }
            }
        });
    }
    function UpdateStatus(id,status) {
        var type = "Vô hiệu hóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " kế hoạch này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Pay/UpdateStatus",
                    data: {
                        'id': id
                    },
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }

</script>
