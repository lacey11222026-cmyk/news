@using Car.Data
@model Pay
@using Car.Utility

<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header">
                <i class="fa fa-fw fa-user-md"></i><span>@ViewBag.Title </span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel panel-info">

                        <div class="panel-body">
                            <!-- dành cho UpdateFunction -->
                            <div style="padding: 10px 0 0 0;background-color:#fff !important">


                                <div class="col-md-9">
                                    <div class="form-group" style="display:none">
                                        <label for="txtName" class="control-label col-md-4">Tên báo cáo  :<span class="required">*</span></label>
                                        <div class="col-md-6">
                                            <div class="input-icon right">
                                                <input type="text" id="txtName" maxlength="500" name="name" value="@Model.Name" class="form-control" placeholder="Tên báo cáo " />
                                            </div>
                                        </div>
                                    </div>


                                    <div class="form-group">
                                        <label for="ddlYear" class="control-label col-md-4">Năm :<span class="required">*</span></label>
                                        <div class="col-md-6">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlYear">
                                                    @for (var i = DateTime.Now.Year+5; i >= 2017; i--)
                                                    {

                                                        if (i == Model.Year.GetValueOrDefault())
                                                        {
                                                            <option value="@i" selected="selected">Năm @(i)</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@i">Năm @(i)</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">

                                        <label for="txtTotal" class="control-label col-md-4">
                                            Tổng kế hoạch rút vốn (triệu VND)
                                        </label>
                                        <div class="col-md-6">

                                            <div class="input-icon right">
                                                <input type="text" id="txtTotal" maxlength="20" value="@Model.Total" class="form-control" />
                                            </div>
                                        </div>

                                    </div>
                                    <h4 class="box-title" style="border-bottom:1px solid #f4f4f4;padding-bottom:10px">Kế hoạch giải ngân</h4>
                                    <div class="form-group">

                                        <label for="txtTotal1" class="control-label col-md-4">
                                            Quý 1 (triệu VND)
                                        </label>
                                        <div class="col-md-6">

                                            <div class="input-icon right">
                                                <input type="text" id="txtTotal1" maxlength="20" value="@Model.Total1" class="form-control" />
                                            </div>
                                        </div>

                                    </div>
                                    <div class="form-group">

                                        <label for="txtTotal2" class="control-label col-md-4">
                                            Quý 2 (triệu VND)
                                        </label>
                                        <div class="col-md-6">

                                            <div class="input-icon right">
                                                <input type="text" id="txtTotal2" maxlength="20" value="@Model.Total2" class="form-control" />
                                            </div>
                                        </div>

                                    </div>
                                    <div class="form-group">

                                        <label for="txtTotal3" class="control-label col-md-4">
                                            Quý 3 (triệu VND)
                                        </label>
                                        <div class="col-md-6">

                                            <div class="input-icon right">
                                                <input type="text" id="txtTotal3" maxlength="20" value="@Model.Total3" class="form-control" />
                                            </div>
                                        </div>

                                    </div>
                                    <div class="form-group">

                                        <label for="txtTotal3" class="control-label col-md-4">
                                            Quý 4 (triệu VND)
                                        </label>
                                        <div class="col-md-6">

                                            <div class="input-icon right">
                                                <input type="text" id="txtTotal4" maxlength="20" value="@Model.Total4" class="form-control" />
                                            </div>
                                        </div>

                                    </div>
                                    <div class="form-group" style="display:none">
                                        <label class="control-label col-md-4" for="cbxIsActive">Trạng thái :</label>
                                        <div class="col-md-4">
                                            <div class="checkbox">
                                                @if (Model.Status == 1)
                                                {<input type="checkbox" id="cbxIsActive" checked="checked" />}
                                                else
                                                {<input type="checkbox" id="cbxIsActive" />}

                                            </div>
                                        </div>
                                    </div>

                                    <div class="panel-footer form-horizontal">
                                        <div class="form-group submit">
                                            <button type="submit" class="btn btn-primary" id="btnSave"><i class="fa fa-save"></i>Lưu lại</button>

                                            <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage()"><i class="fa fa-backward"></i>Back</button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="clear"></div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<style>
    .input-icon {
        position: relative;
        width: 100%;
    }

    .form-group {
        margin-bottom: 7px;
    }
</style>
<script type="text/javascript">
    function GotoListpage() {
        window.location = "/Pay";
    }
    $(document).ready(function () {



        $("button.close").click(function () {
            $(this).parent().css("display", "none");
        });
        $('#defaultForm').bootstrapValidator({
            message: 'This value is not valid',
            //live: 'submitted',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {

               

            }
        })
        .on('success.form.bv', function (e) {
            // Prevent submit form
            e.preventDefault();

            var $form = $(e.target),
                validator = $form.data('bootstrapValidator');
            SaveData();
            $(".close").click(function () {
                $(".alert-success").css("display", "none");
            });
        })
        .on('error.form.bv', function (e) {
            // Active the panel element containing the first invalid element
            e.preventDefault();
            var $form = $(e.target),
            validator = $form.data('bootstrapValidator');
            $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
            $(".alert-danger").css("display", "block");
            $(".close").click(function () {
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
        });

        $("#btnReset").click(function () {
            $('#defaultForm').data('bootstrapValidator').resetForm(true);
            $(".alert-danger").css("display", "none");
            $(".alert-success").css("display", "none");
        });
        //Save Data
        function SaveData() {
            var param = {
                'Id': '@Model.Id',
                'Name': $("#ddlYear").val(),
                'Investor': $("#ddlYear").val(),
                'Total': $("#txtTotal").val(),
                'Total1':$("#txtTotal1").val(),
                'Year': $("#ddlYear").val(),
                'Total2': $("#txtTotal2").val(),
                'Total3': $("#txtTotal3").val(),
                'Total4': $("#txtTotal4").val(),
                'Status': $("#cbxIsActive").is(":checked") ? 1 : 0,

            };
            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "/Pay/SaveData",
                data: param,
                async: true,
                success: function (data) {
                    Utils.UnLoading();
                    if (data.ResponseCode >= 0) {
                        $(".alert-success").show("slow");
                        $(".alert-danger").hide("slow");
                        setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 2000);
                    }
                    else {

                        $("#ErrorMessage").text(data.NameEn);
                        $(".alert-danger").show("slow");
                        $(".alert-success").hide("slow");
                        setTimeout(function () { $(".alert-danger").hide("slow"); }, 2000);
                    }
                }
            });
        };
    });
</script>
