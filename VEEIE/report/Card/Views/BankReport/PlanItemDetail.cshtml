<script type="text/javascript">
    function formate(input) {
   var dateString = input.substr(6);
var currentTime = new Date(parseInt(dateString ));
var month = currentTime.getMonth() + 1;
var day = currentTime.getDate();
        var year = currentTime.getFullYear();
        if (day < 10)
            day = '0' + day;
          if (month < 10)
            month = '0' + month;
return day + "/" + month + "/" + year;
}
     function LoadProject(rvalue) {
        $('#ddlProject').html('<option value="-1">- Chọn dự án -</option>');
        $.ajax({
            cache: false,
            type: "GET",
            url: '/BankReport/GetReport?year='+$('#ddlYear').val()+'&type='+$('#ddlType').val(),
            data: {},
            success: function (data) {
                //$('#select_manu').html('');
                var html = '';

                $.each(data, function (i, item) {


                    if (rvalue == item.Name) {
                        html = '<option selected="selected" value="' + item.Name + '" title="' + item.Name + '">';
                    }
                    else {
                        html = '<option value="' + item.Name + '" title="' + item.Name + '">';
                    }


                    html += item.Name;
                    html += '</option>';

                    $('#ddlProject').append(html);

                });
            },

        });
    }
