                    'Currency3': $("#txtCurrency3").val(),
                    'CurrencyRate3': $("#txtCurrencyRate3").val(),
                    'PlanYear3': $("#txtPlanYear3").val().replace(/\./g, ''),
                    'PlanCurrent3': $("#txtPlanCurrent3").val().replace(/\./g, ''),
                    'PlanQ3': $("#txtPlanQ3").val().replace(/\./g, ''),
                    'BalanceYear3': $("#txtBalanceYear3").val().replace(/\./g, ''),
                    'Balance3': $("#txtBalance3").val().replace(/\./g, ''),
                    'Total1': $("#txtTotal1").val(),
                    'Total2': $("#txtTotal2").val(),
                      'WomanRate': $("#txtWomanRate").val(),
                'NumberPeople': $("#txtNumberPeople").val(),
                 'STime': $("#txtTime").val(),
                }

                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("PlanItemSaveData")",
                    data: addAntiForgeryToken(param),
                    async: true,
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {

                            $(".defaultForm2.alert-success").show("slow");
                            $(".defaultForm2.alert-danger").hide("slow");

                            $('.modal ').modal('hide');
                             loadPlanItem();
                             loadPlanStuck();
                        }
                        else {

                            $("#ErrorMessage2").text(data.Description);
                            $(".defaultForm2 .alert-danger").show("slow");
                            $(".defaultForm2 .alert-success").hide("slow");
                            setTimeout(function () { $(".defaultForm2 .alert-danger").hide("slow"); }, 5000);
                        }
                    }
                });
            };
        });



</script>
