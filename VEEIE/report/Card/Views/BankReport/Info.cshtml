<input id="hdType" type="hidden" value="@ViewBag.Type">*@

<script>
    function loadPlanItem()
    {
        var params = {
            planId: '@Model.Id',
           
        };
        var urlRequestAns = "/BankReport/ListPlanItem";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListPlanItem").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    }
    function loadPlanStuck()
    {
        var params = {
            planId: '@Model.Id',
           
        };
        var urlRequestAns = "/BankReport/ListPlanStuck";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListPlanStuck").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    }
    function loadPlanRequire()
    {
        var params = {
            planId: '@Model.Id',
           
        };
        var urlRequestAns = "/BankReport/ListPlanRequire";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListPlanRequire").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    }
    function AddPlanItem() {

        var pageurl = "/BankReport/AddPlanItem/?planId=" + "@Model.Id";
        $.ajax({
            type: 'GET',
            url: pageurl,
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "html",
            success: function (data) {
                bootbox.dialog({
                    title: "Thêm mới dự án",
                    message: data,
                    buttons: {
                        success: {
                            label: "Đóng",
                            className: "btn-success",
                            callback: function () {

                                 loadPlanItem()
                            }
                        }
                    }
                });
            }
        });


    }
     function EditPlanItem( Id) {

        var pageurl = "/BankReport/PlanItemDetail/?Id=" + Id;
        $.ajax({
            type: 'GET',
            url: pageurl,
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "html",
            success: function (data) {
                bootbox.dialog({
                    title: "Cập nhật dự án",
                    message: data,
                    buttons: {
                        success: {
                            label: "Đóng",
                            className: "btn-success",
                            callback: function () {

                                 loadPlanItem()
                            }
                        }
                    }
                });
            }
        });


    }
</script>
