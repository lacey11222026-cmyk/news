@model Car.Data.DTO.Users
@{ViewBag.Title = "Home"; }

@{
    ViewBag.Title = "Home Page";
    ViewBag.url1 = "https://docs.google.com/gview?url=http://report.veeie.vn/Upload/congty.docx&embedded=true";
    ViewBag.url2 = "https://docs.google.com/gview?url=http://report.veeie.vn/Upload/nganhang.docx&embedded=true";
    ViewBag.url3 = "https://docs.google.com/gview?url=http://report.veeie.vn/Upload/banquanly.docx&embedded=true";

}
@if (Model.Type <= 2)
{
    <div class="row">
        <div class="col-lg-12">

            <iframe src="@ViewBag.url3" style="width: 100%; height:1000px; border: 0px none;" id="source"></iframe>

        </div>
    </div>

}
@if (Model.Type == 3)
{
    <div class="row">
        <div class="col-lg-12">

            <iframe src="@ViewBag.url2" style="width: 100%; height:1000px; border: 0px none;" id="source"></iframe>

        </div>
    </div>

}
@if (Model.Type == 4)
{
    <div class="row">
        <div class="col-lg-12">

            <iframe src="@ViewBag.url1" style="width: 100%; height:1000px; border: 0px none;" id="source"></iframe>

        </div>
    </div>

}

