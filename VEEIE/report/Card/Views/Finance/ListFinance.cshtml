@using Car.Data
@using Car.Utility
@using Car.CMS.Helper
@model List<Finance>
@{ var idx = 0; }
<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th rowspan="2">STT</th>
            <th rowspan="2">Tên dự án </th>
            <th rowspan="2">Chủ đầu tư </th>
            <th rowspan="2">Tổng mức đầu tư (triệu VND)</th>
            <th colspan="2">Tổng vốn vay (triệu VND)</th>
            <th rowspan="2">Năng lượng tiết kiệm dự kiến MWh </th>
            @*<th rowspan="2">Trạng thái </th>*@
            <th rowspan="2">Quản trị </th>
            <th rowspan="2">Sắp xếp</th>
        </tr>
        <tr>
            <th>Nguồn WB</th>
            <th>Nguồn PFI</th>
            
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        foreach (var obj in Model)
        {
            { idx++; }
<tr>
    <td>@idx</td>

    <td>@obj.Name</td>
    <td>@obj.Investor</td>
    <td>@obj.Total</td>
    <td>@obj.Total1</td>
    <td>@obj.Total2</td>
    <td>@obj.Total3</td>

    @*<td class="fun-arrange">
        @if (obj.Status == 1)
        {
            <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatus(@obj.Id, 1);"><i class="fa fa-check"></i></a>

        }
        else
        {
            <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatus(@obj.Id,0);"><i class="fa fa-ban"></i></a>

        }
    </td>*@

    <td style="text-align:center">

        <a href="@Url.Action("Info", new { id = obj.Id })"> Cập nhật</a> <text>&nbsp;</text>
    </td>
    <td class="fun-arrange">
        <a href="javascript:;" onclick="UpdateSortOrder(@obj.Id,0,'@obj.Year.GetValueOrDefault()')"><i class="fa fa-arrow-up"></i></a>

        <a href="javascript:;" onclick="UpdateSortOrder(@obj.Id,1,'@obj.Year.GetValueOrDefault()')"><i class="fa fa-arrow-down"></i></a>
    </td>



</tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            year: $("#ddlYear").val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = "/Finance/ListFinance";
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListReport").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });
    function UpdateSortOrder(Id, UpOrder,year) {
        var param = {
            Id: Id,
            year:year,
            SortOrder: UpOrder
        }
        $.ajax({
            type: 'POST',
            url: '/Finance/UpdateSortOrder',
            data: JSON.stringify(param),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: true,
            success: function (data) {
                Utils.UnLoading();
                var msg = data.Msg;
                if (data.ResponseCode > 0) {
                    BindDataRequest(CurrentPage);
                }
                else {
                    bootbox.alert(msg);
                }
            }
        });
    }
    function UpdateStatus(id,status) {
        var type = "Vô hiệu hóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " kế hoạch này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "/Finance/UpdateStatus",
                    data: {
                        'id': id
                    },
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }

</script>
