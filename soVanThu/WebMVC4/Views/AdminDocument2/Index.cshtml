@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@{
    ViewBag.Title = "Danh sách sáng kiến";
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">


                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <select class="form-control" id="ddlStatus">
                            <option value="-1">Tình trạng triển khai:</option>
                            <option value="1">Đang triển khai</option>
                            <option value="2">Đã hoàn thành</option>
                            <option value="3">Tạm dừng</option>
                            <option value="4">Huỷ bỏ</option>
                        </select>
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6" style="display:none">
                        <select class="form-control" id="ddlProgress">
                            <option value="-1">Tiến độ đánh giá:</option>
                            <option value="1">Chưa đánh giá</option>
                            <option value="2">Đang đánh giá</option>
                            <option value="3">Đã đánh giá</option>
                          
                        </select>
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <input type="text" id="txtTitle" class="form-control" placeholder="Nhập tên sáng kiến">
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <input type="text" id="txtUnit" class="form-control" placeholder="Nhập đơn vị">
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-12">
                        <select class="form-control" id="ddlYear">
                            <option value="0">Năm triển khai:</option>
                            @for (var i = DateTime.Now.Year+1; i > 2020; i--)
                            {
                                <option value="@i">Năm @(i)</option>

                            }
                        </select>
                    </div>
                    <div class="form-group submit col-md-3 col-xs-12 col-sm-6">
                        <button type="button" id="btnSearch" class="btn btn-info"><i class="fa fa-search"></i>Tìm Kiếm</button>
                        <a id="btnCreate" href="@Url.Action("GetDocumentDetail",new {id=0 })" class="btn btn-success"><i class="fa fa-user-plus"></i>Thêm Mới</a>
                        <a id="" href="@Url.Action("Upload")" class="btn btn-success">Upload</a>
                    </div>


                </div>
            </div>
            <div class="table-responsive">
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="ListDocument">
                        @Html.Action("ListDocument")
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#menu_managedoc').addClass("active");

</script>
<script type="text/javascript">
        $(document).ready(function () {
            
            var parameters = {
            };
            $("#form").keypress(function (event) {
                if (event.which == 13) {
                    $("#btnSearch").click();
                }
            });
            $("#btnSearch").click(function () {
                GetList(1);
            });
            $("#ddlStatus").change(function () {
                GetList(1);
            });
            $("#ddlProgress").change(function () {
                GetList(1);
            });
            $("#ddlYear").change(function () {
                GetList(1);
            });
            function GetList(currentPage) {
                parameters = {
                    title: $("#txtTitle").val(),
                    year: $("#ddlYear").val(),
                    unit: $("#txtUnit").val(),
                    status: $('#ddlStatus :selected').val(),
                    progress: $('#ddlProgress :selected').val(),
                    currentPage: currentPage,
                };
                btnSearch(currentPage);
            };
            function btnSearch(currentPage) {
                Utils.Loading();
                var urlRequestAns = "@Url.Action("ListDocument")";
                $.ajax({
                    type: 'GET',
                    url: urlRequestAns,
                    data: parameters,
                    success: function (data) {
                        $("#ListDocument").html(data);
                        Utils.UnLoading();
                    },
                    error: function () {
                        Utils.UnLoading();
                    }
                });
            }

        });

</script>