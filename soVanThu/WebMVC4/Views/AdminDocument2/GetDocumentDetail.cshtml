@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}

@using WebMVC4.Helper
@using UTILS
@using DATA.ContentDB
@using UTILS
@model Idea

<div class="well">
    <span class="label label-danger">
        Chú ý!
    </span>
    <span>
        Hãy chắc chắn nhập vào đầy đủ thông tin tại các mục bắt buộc đánh dấu (*)
    </span>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-fw fa-user-md"></i><span>@ViewBag.Title </span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel panel-info">
                        <div id="Errordiv" style="margin:20px;color:red;font-size:13pt"><center></center></div><br />
                        @*<div class="panel-heading">
                                <h4 class="panel-title"><i class="fa fa-wrench" style="margin-right:7px"></i>Thông Tin Cơ Bản</h4>
                            </div>*@
                        <div style="padding: 10px 0 0 0;background-color:#fff !important">

                            <div class="col-md-12">
                                <div>
                                    <div class="form-group">
                                        <label for="txtCode" class="control-label col-md-3">Mã sáng kiến :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtCode" name="code" value="@Model.Code" class="form-control" placeholder="Nhập mã sáng kiến" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtTitle" class="control-label col-md-3">Tên sáng kiến :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtTitle" name="title" value="@Model.Name" class="form-control" placeholder="Nhập tên sáng kiến" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtNo" class="control-label col-md-3"> Số quyết định phê duyệt:<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtNo" name="No" value="@Model.No" class="form-control" />

                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="txtProposer" class="control-label col-md-3">Người đề xuất :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtProposer" style="height: 100px;" cols="20" name="Proposer" class="form-control">@Model.Proposer</textarea>

                                            </div>
                                        </div>
                                    </div>
                                   
                                    <div class="form-group">
                                        <label for="txtUnit" class="control-label col-md-3"> Đơn vị thực hiện:<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtUnit" name="Unit" value="@Model.Unit" class="form-control" />

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtPublicTime" class="control-label col-md-3">Ngày ban hành :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtPublicTime" data-date-format="DD/MM/YYYY" name="publictime" value="@HtmlHelpers.GetDateDocument(Model.PublishDate)" class="form-control" />

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="ddlStatus" class="control-label col-md-3">Tình trạng triển khai:<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlStatus">
                                                    <option value="1" @if (Model.Status == 1) { @Html.Raw("selected='selected'") ; }>Đang triển khai</option>
                                                    <option value="2" @if (Model.Status == 2) { @Html.Raw("selected='selected'") ; }>Đã hoàn thành</option>
                                                    <option value="3" @if (Model.Status == 3) { @Html.Raw("selected='selected'") ; }>Tạm dừng</option>
                                                    <option value="4" @if (Model.Status == 4) { @Html.Raw("selected='selected'") ; }>Huỷ bỏ</option>



                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none">
                                        <label for="ddlProgress" class="control-label col-md-3">Tiến độ đánh giá:<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlProgress">

                                                    <option value="1" @if (Model.Progress == 1) { @Html.Raw("selected='selected'") ; }>Chưa đánh giá</option>
                                                    <option value="2" @if (Model.Progress == 2) { @Html.Raw("selected='selected'") ; }>Đang đánh giá</option>
                                                    <option value="3" @if (Model.Progress == 3) { @Html.Raw("selected='selected'") ; }>Đã đánh giá</option>

                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="txtProgressPercent" class="control-label col-md-3"> Tiến độ (%):</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="number" step="5" id="txtProgressPercent" name="ProgressPercent" value="@Model.ProgressPercent" class="form-control" />

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="ddlResult" class="control-label col-md-3">KQ đánh giá:<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlResult">

                                                    <option value="1" @if (Model.Result == 1) { @Html.Raw("selected='selected'") ; }>Đạt</option>
                                                    <option value="2" @if (Model.Result == 2) { @Html.Raw("selected='selected'") ; }>Chưa đánh giá</option>

                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtMark" class="control-label col-md-3"> Điểm đạt được:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtMark" name="Mark" value="@Model.Mark" class="form-control" />

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="ddlRegion" class="control-label col-md-3">Mức độ áp dụng:<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlRegion">

                                                    <option value="1" @if (Model.Region == 1) { @Html.Raw("selected='selected'") ; }>Thí điểm</option>
                                                    <option value="2" @if (Model.Region == 2) { @Html.Raw("selected='selected'") ; }>Chính thức</option>
                                                    <option value="3" @if (Model.Region == 3) { @Html.Raw("selected='selected'") ; }>Nhân rộng</option>

                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtSummary" class="control-label col-md-3">Hiệu quả đem lại: <span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtSummary" style="height: 100px;" cols="20" name="description" class="form-control">@Model.Effective</textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtImgPath" class="control-label col-md-3">File:<span class="required">*</span></label>
                                        <div class="col-md-8">
                                            <input type="text" id="txtFilePath" name="filepath" value="@Model.FilePath" class="form-control" placeholder="Nhập đường dẫn file" />
                                        </div>
                                        <div class="col-md-1">
                                            <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtFilePath');"><i class="fa fa-file"></i></a>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="txtFollowers" class="control-label col-md-3">Người phụ trách theo dõi :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtFollowers" style="height: 100px;" cols="20" name="Followers" class="form-control">@Model.Followers</textarea>

                                            </div>
                                        </div>
                                    </div>







                                    <div class="panel-footer form-horizontal">
                                        <div class="form-group submit">


                                            <button type="submit" class="btn btn-primary" id="btsubmit"><i class="fa fa-save"></i>Lưu lại</button>
                                            <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage();"><i class="fa fa-backward"></i>Quay lại</button>
                                        </div>
                                    </div>



                                </div>
                            </div>
                            <div style="clear:both"></div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    $('#menu_managedoc').addClass("active");

</script>
<script>
    function GotoListpage() {
        window.location = '@Url.Action("Index")';
    }
    $(document).ready(function () {



        $('#txtExpiryDate').datetimepicker({
            //pickTime: false
        });
        $('#txtEffectiveDate').datetimepicker({
            //pickTime: false
        });
        $('#txtPublicTime').datetimepicker({
            //pickTime: false
        });
        $("button.close").click(function () {
            $(this).parent().css("display", "none");
        });
        $('#defaultForm').bootstrapValidator({
            message: 'This value is not valid',
            //live: 'submitted',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {
                code: {
                    message: 'Bạn chưa nhập mã sáng kiến.',
                    validators: {
                        notEmpty: {
                            message: 'Bạn chưa nhập mã sáng kiến'
                        },

                    }
                },
                title: {
                    message: 'Nhập tên sáng kiến',
                    validators: {
                        notEmpty: {
                            message: 'tên sáng kiến không được bỏ trống'
                        },

                        stringLength: {
                            min: 10,
                            max: 250,
                            message: 'tên sáng kiến nhỏ nhất 10 ký tự và nhiều nhất 250 ký tự'
                        },

                    }
                },
               
                No: {
                    message: 'Bạn chưa nhập số quyết định.',
                    validators: {
                        notEmpty: {
                            message: 'Bạn chưa nhập số quyết định'
                        },

                    }
                },
                Proposer: {
                    message: 'Bạn chưa nhập người đề xuất.',
                    validators: {
                        notEmpty: {
                            message: 'Bạn chưa nhập người đề xuất'
                        },

                    }
                },
                Unit: {
                    message: 'Bạn chưa nhập đơn vị thực hiện.',
                    validators: {
                        notEmpty: {
                            message: 'Bạn chưa nhập đơn vị thực hiện'
                        },

                    }
                },
                publictime: {
                    message: 'Bạn chưa nhập ngày ban hành.',
                    validators: {
                        notEmpty: {
                            message: 'Bạn chưa nhập ngày ban hành'
                        },

                    }
                },
                //description: {
                //    message: 'Bạn chưa nhập hiệu quả đem lại.',
                //    validators: {
                //        notEmpty: {
                //            message: 'Bạn chưa nhập hiệu quả đem lại'
                //        },

                //    }
                //},
                //filepath: {
                //    validators: {
                //        notEmpty: {
                //            message: 'File không được bỏ trống'
                //        }
                //    }
                //},
                //Followers: {
                //    message: 'Bạn chưa nhập người phụ trách theo dõi.',
                //    validators: {
                //        notEmpty: {
                //            message: 'Bạn chưa nhập người phụ trách theo dõi'
                //        },

                //    }
                //}
            }
        })
        .on('success.form.bv', function (e) {
            // Prevent submit form
            e.preventDefault();

            var $form = $(e.target),
                validator = $form.data('bootstrapValidator');
            SaveData();
            $(".close").click(function () {
                $(".alert-success").css("display", "none");
            });
        })
        .on('error.form.bv', function (e) {
            // Active the panel element containing the first invalid element
            e.preventDefault();
            var $form = $(e.target),
            validator = $form.data('bootstrapValidator');
            $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
            $(".alert-danger").css("display", "block");
            $(".close").click(function () {
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
        });

        $("#btnReset").click(function () {
            $('#defaultForm').data('bootstrapValidator').resetForm(true);
            $(".alert-danger").css("display", "none");
            $(".alert-success").css("display", "none");
        });

        //Save Data
        function SaveData() {
            var param = {
                'Id': '@Model.Id',
                'Name': $("#txtTitle").val(),
                'Effective': $("#txtSummary").val(),
                'FilePath': $("#txtFilePath").val(),
                'Proposer': $("#txtProposer").val(),
                'Code': $("#txtCode").val(),
                'No': $("#txtNo").val(),
                'Unit': $("#txtUnit").val(),
                'SPublishDate': $('#txtPublicTime').val(),
                'Status': $("#ddlStatus").val(),
                'ProgressPercent': $("#txtProgressPercent").val(),
                'Progress': $("#ddlProgress").val(),
               
                'Result': $("#ddlResult").val(),
                'Mark': $('#txtMark').val(),
                'Region': $('#ddlRegion').val(),
               
                'Effective': $("#txtSummary").val(),
                'Followers': $('#txtFollowers').val(),
                

            }
            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "@Url.Action("SaveData")",
                data: addAntiForgeryToken(param),
            async: true,
            success: function (data) {
                Utils.UnLoading();
                if (data.ResponseCode >= 0) {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $(".alert-success").show("slow");
                    $(".alert-danger").hide("slow");
                    setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 500);

                }
                else {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $("#ErrorMessage").text(data.Description);
                    $(".alert-danger").show("slow");
                    $(".alert-success").hide("slow");
                    setTimeout(function () { $(".alert-danger").hide("slow"); }, 2000);
                }
            }
        });
    };
    });
</script>
<style>
    .input-icon {
        position: relative;
        width: 100%;
    }
</style>