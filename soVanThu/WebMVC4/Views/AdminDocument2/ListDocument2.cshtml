@using DATA.ContentDB
@using UTILS
@model List<IdeaTemp>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>

                <input type="checkbox" name="" onclick="checkAll(this);" />
            </th>
            <th>Mã SK</th>
            <th class="texttable">Tên sáng kiến</th>
            <th class="">Số QĐ</th>

            <th class="">
                Ngày ban hành
            </th>
            <th class="">
                Người đề xuất
            </th>
            @*<th>
                    Người theo dõi
                </th>*@
            <th class="">
                Đơn vị thực hiện
            </th>
            @*<th class="">
                    Tiến độ đánh giá
                </th>*@
            <th class="">
                Tiến độ %
            </th>
            <th>Kết quả đánh giá</th>


            <th>Trạng Thái</th>
            <th class="=">
                Giá trị làm lợi
            </th>
            <th>Tài liệu </th>
            <th>Cảnh báo</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>
                @if (obj.Type != 0)
                {
                    <td><input type="checkbox" class="CheckAll" name="chk_item" value="@obj.Id" /></td>
                }
                else
                {
                    <td><input type="checkbox" class="CheckAll" name="chk_item" checked="checked" value="@obj.Id" /></td>
                }

                <td>@obj.Code</td>
                <td class="texttable" style="text-align:left;min-width:120px;">
                    @obj.Name
                </td>
                <td class="">@obj.No</td>
                <td>@HtmlHelpers.GetDateDocument(obj.PublishDate)</td>
                <td class="texttable" style="text-align:left;min-width:100px;">@Html.Raw(obj.Proposer.Replace("\n", "<br>"))</td>
                @*<td class="texttable" style="text-align: left; min-width: 120px;">@Html.Raw(obj.Followers.Replace("\n", "<br>"))</td>*@
                <td class="">@obj.Unit</td>
                <td>@obj.ProgressPercent</td>
                @*<td class="">@HtmlHelpers.GetSKProgress(obj.Progress)</td>*@
                <td class="">@obj.Result</td>


                <td class="">@obj.Status</td>
                <td class="texttable" style="text-align:left;min-width:100px;">@Html.Raw(obj.Effective.Replace("\n", "<br>"))</td>

                <td><a href="@Url.Action("Download",new {id=obj.Id })" target="_blank">Download</a></td>
                <td style="text-align: center">
                    @if (obj.Type == 0)
                    {
                        <div>Hợp lệ</div>
                    }
                    else
                    {
                        <div style="color:red">@obj.Description</div>
                    }

                </td>

            </tr>
        }
    }
</table>
<script>
    function checkAll(obj1) {
        var returnVal = undefined;
        if (obj1.checked == true) {

            returnVal = confirm("Bạn có muốn chọn tất cả?");
            if (returnVal) {
                $(this).attr("checked", true);
                $('input[type="checkbox"][name="chk_item"]').prop("checked",true);
            }
        }
        else {

            returnVal = confirm("Bạn có muốn Hủy chọn tất cả?");
            if (returnVal) {
                $(this).attr("checked", false);
                $('input[type="checkbox"][name="chk_item"]').prop("checked", false);
            }
        }


    }
    function CheckCanel() {
        var check = 0;
        var joinId = '';
        $('input[type="checkbox"][name="chk_item"]:checked').each(function (i, e) {
            joinId += ',' + $(e).val();
            //arr_checked_items.push();
        });

        if (joinId == '') {

            alert('Vui lòng chọn dữ liệu để xoá');
            return false;
        }
        //return false;
        if (confirm("Bạn có muốn xoá dữ liệu?")) {

            var postdata = {
                'joinId': joinId,

            };
             Utils.Loading();
             $.ajax({
                 type: 'POST',
                 url:"@Url.Action("Delete2")",
                 data: addAntiForgeryToken(postdata),
                 success: function (data) {
                     Utils.UnLoading();
                     if (data.ResponseCode >= 0) {
                        location.reload();
                     }
                     else {
                         alert(data.Description);
                         return;
                     }
                 }
             });
        }

    }
    function CheckApp() {
        var check = 0;
        var joinId = '';
        $('input[type="checkbox"][name="chk_item"]:checked').each(function (i, e) {
            joinId += ',' + $(e).val();
            //arr_checked_items.push();
        });

        if (joinId == '') {

            alert('Vui lòng chọn dữ liệu để chuyển đổi');
            return false;
        }
        if (confirm("Bạn có muốn chuyển đổi các dữ liệu đã chọn?")) {
                    var postdata = {
                        'joinId': joinId,

                    };
                     Utils.Loading();
                     $.ajax({
                         type: 'POST',
                         url:"@Url.Action("Save2")",
                         data: addAntiForgeryToken(postdata),
                         success: function (data) {
                             Utils.UnLoading();
                             if (data.ResponseCode >= 0) {
                                 location.href="@Url.Action("Index")"
                             }
                             else {
                                 alert(data.Description);
                                 return;
                             }
                         }
                     });
        }


    }
</script>
<style>
    .table-responsive {
        overflow-x: auto;
    }

    .table {
        width: 99%;
        max-width: 99%;
    }

        .table > thead > tr > td, .table > thead > tr > th {
            padding: 8px 2px;
        }
</style>