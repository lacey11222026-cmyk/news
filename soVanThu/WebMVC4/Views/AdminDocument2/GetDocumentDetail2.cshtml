                                                <input type="text" id="txtSuspensionDecisionDate" data-date-format="DD/MM/YYYY" name="SuspensionDecisionDate" value="@HtmlHelpers.GetDateDocument(Model.SuspensionDecisionDate)" class="form-control date-field" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkIsDialogue" class="control-label col-md-3">80. Đối thoại:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsDialogue" name="IsDialogue" @if (Model.IsDialogue == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtResolutionDecisionNo" class="control-label col-md-3">81. QĐ giải quyết khiếu nại / KL giải quyết tố cáo - Số:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtResolutionDecisionNo" name="ResolutionDecisionNo" value="@Model.ResolutionDecisionNo" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtResolutionDecisionDate" class="control-label col-md-3">82. QĐ giải quyết khiếu nại / KL giải quyết tố cáo - Ngày tháng:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtResolutionDecisionDate" data-date-format="DD/MM/YYYY" name="ResolutionDecisionDate" value="@HtmlHelpers.GetDateDocument(Model.ResolutionDecisionDate)" class="form-control date-field" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkIsComplaintCorrect" class="control-label col-md-3">83. KNTC, PAKN đúng:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsComplaintCorrect" name="IsComplaintCorrect" @if (Model.IsComplaintCorrect == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkIsComplaintIncorrect" class="control-label col-md-3">84. KNTC, PAKN sai:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsComplaintIncorrect" name="IsComplaintIncorrect" @if (Model.IsComplaintIncorrect == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkIsComplaintPartiallyCorrect" class="control-label col-md-3">85. KNTC, PAKN đúng một phần:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsComplaintPartiallyCorrect" name="IsComplaintPartiallyCorrect" @if (Model.IsComplaintPartiallyCorrect == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtProcessingStatusNote" class="control-label col-md-3">86. Ghi chú rõ trạng thái hồ sơ đang giải quyết:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtProcessingStatusNote" name="ProcessingStatusNote" class="form-control" rows="3">@Model.ProcessingStatusNote</textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="panel-footer form-horizontal">
                                    <div class="form-group submit">
                                        <div class="col-md-offset-3 col-md-9">
                                            <button type="submit" class="btn btn-primary" id="btsubmit"><i class="fa fa-save"></i> Lưu lại</button>
                                            <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage();"><i class="fa fa-backward"></i> Quay lại</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css"
      rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
<script>
    $('#menu_managedoc2').addClass("active");

    function GotoListpage() {
        window.location = '@Url.Action("Index2")';
    }

    $(document).ready(function () {
        $('.date-field').datetimepicker({
            // pickTime: false
        });
        $('#ddlGroupId').select2({
        
            allowClear: true,
            width: '100%'
        });
        $("button.close").click(function () {
            $(this).parent().css("display", "none");
        });

        $('#defaultForm').on('submit', function (e) {
            e.preventDefault();

            var dutyDate = $.trim($('#txtDutyDate').val());
            var dutyLeaderName = $.trim($('#txtDutyLeaderName').val());


            var LeaderName = $.trim($('#txtLeaderName').val());
            
           
            if (dutyDate == '') {
                alert('Vui lòng nhập Ngày trực');
                $('#txtDutyDate').focus();
                return false;
            }

            if (dutyLeaderName == '') {
                alert('Vui lòng nhập Tên Trưởng nhóm trực');
                $('#txtDutyLeaderName').focus();
                return false;
            }

            if (LeaderName == '') {
                alert('Vui lòng chọn lãnh đạo');
                $('#txtDutyLeaderName').focus();
                return false;
            }
            SaveData();
        });

        function SaveData() {
            var param = {
                'Id': '@Model.Id',
                'SDutyDate': $('#txtDutyDate').val(),
                'GroupId': $('#ddlGroupId').val(),
                'DutyLeaderName': $('#txtDutyLeaderName').val(),
                'ClericalOfficerName': $('#txtClericalOfficerName').val(),
                'IncomingSubmissionNo': $('#txtIncomingSubmissionNo').val(),
                'IncomingDocumentType': $('#txtIncomingDocumentType').val(),
                'IncomingDocumentDetail': $('#ddlIncomingDocumentDetail').val(),
                'sReceivedDate': $('#txtReceivedDate').val(),
                'ReceivedNo': $('#txtReceivedNo').val(),
                'Sender': $('#txtSender').val(),
                'IncomingDocumentNo': $('#txtIncomingDocumentNo').val(),
                'SIncomingDocumentDate': $('#txtIncomingDocumentDate').val(),
                'IncomingDocumentSummary': $('#txtIncomingDocumentSummary').val(),
                'LeaderName': $('#txtLeaderName').val(),
                'SLeaderReceivedDate': $('#txtLeaderReceivedDate').val(),
                'AssignedOfficerName': $('#txtAssignedOfficerName').val(),
                'AssignedOfficerSigned': $('#chkAssignedOfficerSigned').prop('checked'),
                'SAssignedOfficerReceivedDate': $('#txtAssignedOfficerReceivedDate').val(),
                'OutgoingDocumentType': $('#txtOutgoingDocumentType').val(),
                'OutgoingDocumentNo': $('#txtOutgoingDocumentNo').val(),
                'SOutgoingDocumentDate': $('#txtOutgoingDocumentDate').val(),
                'OutgoingRecipient': $('#txtOutgoingRecipient').val(),
                'IsDenunciation': $('#chkIsDenunciation').prop('checked'),
                'IsComplaint': $('#chkIsComplaint').prop('checked'),
                'IsFeedbackPetition': $('#chkIsFeedbackPetition').prop('checked'),
                'IsMultiContentPetition': $('#chkIsMultiContentPetition').prop('checked'),
                'PetitionerNameTaxCode': $('#txtPetitionerNameTaxCode').val(),
                'IsRepeatedDenunciation': $('#chkIsRepeatedDenunciation').prop('checked'),
                'IsAuthorizedComplaint': $('#chkIsAuthorizedComplaint').prop('checked'),
                'IsHandledByInspection2': $('#chkIsHandledByInspection2').prop('checked'),
                'ComplaintArea': $('#txtComplaintArea').val(),
                'ComplaintTarget': $('#txtComplaintTarget').val(),
                'PetitionContent': $('#txtPetitionContent').val(),
                'CaseCount': $('#txtCaseCount').val(),
                'IsPreviouslyResolved': $('#chkIsPreviouslyResolved').prop('checked'),
                'FieldPolicy': $('#chkFieldPolicy').prop('checked'),
                'FieldAdministrativeDecision': $('#chkFieldAdministrativeDecision').prop('checked'),
                'FieldOfficialAdministrativeAct': $('#chkFieldOfficialAdministrativeAct').prop('checked'),
                'FieldCorruption': $('#chkFieldCorruption').prop('checked'),
                'FieldTaxEvasion': $('#chkFieldTaxEvasion').prop('checked'),
                'FieldJustice': $('#chkFieldJustice').prop('checked'),
                'FieldPartyOrganization': $('#chkFieldPartyOrganization').prop('checked'),
                'FieldInspection': $('#chkFieldInspection').prop('checked'),
                'FieldOther': $('#chkFieldOther').prop('checked'),
                'DetailTaxRefund': $('#chkDetailTaxRefund').prop('checked'),
                'DetailTaxDebt': $('#chkDetailTaxDebt').prop('checked'),
                'DetailLand': $('#chkDetailLand').prop('checked'),
                'DetailCIT': $('#chkDetailCIT').prop('checked'),
                'DetailVAT': $('#chkDetailVAT').prop('checked'),
                'DetailPIT': $('#chkDetailPIT').prop('checked'),
                'DetailInvoice': $('#chkDetailInvoice').prop('checked'),
                'DetailTaxExemption': $('#chkDetailTaxExemption').prop('checked'),
                'DetailOther': $('#chkDetailOther').prop('checked'),
                'SProposalSubmissionDate': $('#txtProposalSubmissionDate').val(),
                'IsDuplicateResolvedPetition': $('#chkIsDuplicateResolvedPetition').prop('checked'),
                'EligibleCaseCount': $('#txtEligibleCaseCount').val(),
                'IneligibleCaseCount': $('#txtIneligibleCaseCount').val(),
                'WithinAuthorityCaseCount': $('#txtWithinAuthorityCaseCount').val(),
                'OutsideAuthorityCaseCount': $('#txtOutsideAuthorityCaseCount').val(),
                'IsPetitionFiled': $('#chkIsPetitionFiled').prop('checked'),
                'GuidanceDocumentNo': $('#txtGuidanceDocumentNo').val(),
                'SGuidanceDocumentDate': $('#txtGuidanceDocumentDate').val(),
                'TransferSlipNo': $('#txtTransferSlipNo').val(),
                'STransferSlipDate': $('#txtTransferSlipDate').val(),
                'TransferRecipient': $('#txtTransferRecipient').val(),
                'ReminderDocumentNo': $('#txtReminderDocumentNo').val(),
                'SReminderDocumentDate': $('#txtReminderDocumentDate').val(),
                'ReportToInspection2No': $('#txtReportToInspection2No').val(),
                'SReportToInspection2Date': $('#txtReportToInspection2Date').val(),
                'NonAcceptanceNoticeNo': $('#txtNonAcceptanceNoticeNo').val(),
                'SNonAcceptanceNoticeDate': $('#txtNonAcceptanceNoticeDate').val(),
                'AcceptanceDecisionNo': $('#txtAcceptanceDecisionNo').val(),
                'SAcceptanceDecisionDate': $('#txtAcceptanceDecisionDate').val(),
                'VerificationDecisionNo': $('#txtVerificationDecisionNo').val(),
                'SVerificationDecisionDate': $('#txtVerificationDecisionDate').val(),
                'IsComplexCase': $('#chkIsComplexCase').prop('checked'),
                'TemporarySuspensionDecisionNo': $('#txtTemporarySuspensionDecisionNo').val(),
                'STemporarySuspensionDecisionDate': $('#txtTemporarySuspensionDecisionDate').val(),
                'SuspensionDecisionNo': $('#txtSuspensionDecisionNo').val(),
                'SuspensionDecisionDate': $('#txtSuspensionDecisionDate').val(),
                'IsDialogue': $('#chkIsDialogue').prop('checked'),
                'ResolutionDecisionNo': $('#txtResolutionDecisionNo').val(),
                'SResolutionDecisionDate': $('#txtResolutionDecisionDate').val(),
                'IsComplaintCorrect': $('#chkIsComplaintCorrect').prop('checked'),
                'IsComplaintIncorrect': $('#chkIsComplaintIncorrect').prop('checked'),
                'IsComplaintPartiallyCorrect': $('#chkIsComplaintPartiallyCorrect').prop('checked'),
                'ProcessingStatusNote': $('#txtProcessingStatusNote').val()
            };

            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "@Url.Action("SaveData")",
                data: addAntiForgeryToken(param),
                async: true,
                success: function (data) {
                    Utils.UnLoading();
                    if (data.ResponseCode >= 0) {
                        $("html,body").animate({ scrollTop: 0 }, 'fast');
                        $(".alert-success").show("slow");
                        $(".alert-danger").hide("slow");
                        setTimeout(function () {
                            $(".alert-success").hide("slow");
                            GotoListpage();
                        }, 500);
                    }
                    else {
                        $("html,body").animate({ scrollTop: 0 }, 'fast');
                        $("#Errordiv center").text(data.Description || 'Có lỗi xảy ra');
                        $(".alert-danger").show("slow");
                        $(".alert-success").hide("slow");
                        setTimeout(function () {
                            $(".alert-danger").hide("slow");
                        }, 2000);
                    }
                },
                error: function () {
                    Utils.UnLoading();
                    $("html,body").animate({ scrollTop: 0 }, 'fast');
                    $("#Errordiv center").text('Không thể lưu dữ liệu.');
                    $(".alert-danger").show("slow");
                }
            });
        }
    });
</script>

