    .input-icon {
        position: relative;
        width: 100%;
    }

    .tab-content {
        padding: 0 15px;
    }

    .tab-title {
        margin-bottom: 20px;
        font-weight: bold;
        color: #31708f;
    }

    .checkbox {
        margin-top: 7px;
    }

    textarea.form-control {
        resize: vertical;
    }
</style>
