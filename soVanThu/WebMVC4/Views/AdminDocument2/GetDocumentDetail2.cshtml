@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}

@using WebMVC4.Helper
@using UTILS
@using DATA.ContentDB
@model VanThu

<div class="well">
    <span class="label label-info">Thông tin</span>
    <span>Các trường có thể để trống. Các trường ngày nhập theo định dạng ngày tháng giống Ngày trực.</span>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-fw fa-file-text-o"></i><span>@ViewBag.Title</span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có lỗi trong quá trình lưu dữ liệu.</label>
                        </div>
                    </div>
                    <div class="panel panel-info">
                        <div id="Errordiv" style="margin:20px;color:red;font-size:13pt"><center></center></div>
                        <div style="padding:10px 0 0 0;background-color:#fff !important">
                            <ul class="nav nav-tabs">
                                <li class="active"><a href="#tabs-info" data-toggle="tab"><strong>Thông tin chính</strong></a></li>
                                <li class=""><a href="#tabs-outgoing" data-toggle="tab"><strong>Văn bản đi</strong></a></li>
                                <li class=""><a href="#tabs-petition" data-toggle="tab"><strong>Phân loại đơn</strong></a></li>
                                <li class=""><a href="#tabs-field" data-toggle="tab"><strong>Lĩnh vực / Nội dung</strong></a></li>
                                <li class=""><a href="#tabs-process" data-toggle="tab"><strong>Xử lý đơn</strong></a></li>
                                <li class=""><a href="#tabs-resolution" data-toggle="tab"><strong>Giải quyết / Kết quả</strong></a></li>
                            </ul>
                            <div class="tab-content" style="margin-top:30px;">
                                <div class="tab-pane active" id="tabs-info">
                                    <h4 class="tab-title">Thông tin chính</h4>
                                    <div class="form-group">
                                        <label for="ddlIncomingDocumentDetail" class="control-label col-md-3">Địa bàn:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlGroupId" name="GroupId">

                                                    <option value="1" @(Model.GroupId == 1 ? "selected" : "")>Văn phòng</option>
                                                    <option value="2" @(Model.GroupId == 2 ? "selected" : "")>Phòng Tổ chức cán bộ</option>
                                                    <option value="3" @(Model.GroupId == 3 ? "selected" : "")>Phòng Quản trị dữ liệu và quản lý rủi ro</option>
                                                    <option value="4" @(Model.GroupId == 4 ? "selected" : "")>Phòng Thuế cá nhân, hộ kinh doanh và thu khác</option>
                                                    <option value="5" @(Model.GroupId == 5 ? "selected" : "")>Phòng Quản lý các khoản thu từ đất</option>
                                                    <option value="6" @(Model.GroupId == 6 ? "selected" : "")>Phòng Nghiệp vụ, dự toán, pháp chế</option>

                                                    <option value="7" @(Model.GroupId == 7 ? "selected" : "")>Phòng Quản lý, hỗ trợ doanh nghiệp số 1</option>
                                                    <option value="8" @(Model.GroupId == 8 ? "selected" : "")>Phòng Quản lý, hỗ trợ doanh nghiệp số 2</option>
                                                    <option value="9" @(Model.GroupId == 9 ? "selected" : "")>Phòng Quản lý, hỗ trợ doanh nghiệp số 3</option>
                                                    <option value="10" @(Model.GroupId == 10 ? "selected" : "")>Phòng Quản lý, hỗ trợ doanh nghiệp số 4</option>
                                                    <option value="11" @(Model.GroupId == 11 ? "selected" : "")>Phòng Quản lý, hỗ trợ doanh nghiệp số 5</option>

                                                    <option value="12" @(Model.GroupId == 12 ? "selected" : "")>Phòng Kiểm tra số 1</option>
                                                    <option value="13" @(Model.GroupId == 13 ? "selected" : "")>Phòng Kiểm tra số 2</option>
                                                    <option value="14" @(Model.GroupId == 14 ? "selected" : "")>Phòng Kiểm tra số 3</option>
                                                    <option value="15" @(Model.GroupId == 15 ? "selected" : "")>Phòng Kiểm tra số 4</option>
                                                    <option value="16" @(Model.GroupId == 16 ? "selected" : "")>Phòng Kiểm tra số 5</option>

                                                    <option value="17" @(Model.GroupId == 17 ? "selected" : "")>Thuế cơ sở 1 TP Hà Nội</option>
                                                    <option value="18" @(Model.GroupId == 18 ? "selected" : "")>Thuế cơ sở 2 TP Hà Nội</option>
                                                    <option value="19" @(Model.GroupId == 19 ? "selected" : "")>Thuế cơ sở 3 TP Hà Nội</option>
                                                    <option value="20" @(Model.GroupId == 20 ? "selected" : "")>Thuế cơ sở 4 TP Hà Nội</option>
                                                    <option value="21" @(Model.GroupId == 21 ? "selected" : "")>Thuế cơ sở 5 TP Hà Nội</option>
                                                    <option value="22" @(Model.GroupId == 22 ? "selected" : "")>Thuế cơ sở 6 TP Hà Nội</option>
                                                    <option value="23" @(Model.GroupId == 23 ? "selected" : "")>Thuế cơ sở 7 TP Hà Nội</option>
                                                    <option value="24" @(Model.GroupId == 24 ? "selected" : "")>Thuế cơ sở 8 TP Hà Nội</option>
                                                    <option value="25" @(Model.GroupId == 25 ? "selected" : "")>Thuế cơ sở 9 TP Hà Nội</option>
                                                    <option value="26" @(Model.GroupId == 26 ? "selected" : "")>Thuế cơ sở 10 TP Hà Nội</option>
                                                    <option value="27" @(Model.GroupId == 27 ? "selected" : "")>Thuế cơ sở 11 TP Hà Nội</option>
                                                    <option value="28" @(Model.GroupId == 28 ? "selected" : "")>Thuế cơ sở 12 TP Hà Nội</option>
                                                    <option value="29" @(Model.GroupId == 29 ? "selected" : "")>Thuế cơ sở 13 TP Hà Nội</option>
                                                    <option value="30" @(Model.GroupId == 30 ? "selected" : "")>Thuế cơ sở 14 TP Hà Nội</option>
                                                    <option value="31" @(Model.GroupId == 31 ? "selected" : "")>Thuế cơ sở 15 TP Hà Nội</option>
                                                    <option value="32" @(Model.GroupId == 32 ? "selected" : "")>Thuế cơ sở 16 TP Hà Nội</option>
                                                    <option value="33" @(Model.GroupId == 33 ? "selected" : "")>Thuế cơ sở 17 TP Hà Nội</option>
                                                    <option value="34" @(Model.GroupId == 34 ? "selected" : "")>Thuế cơ sở 18 TP Hà Nội</option>
                                                    <option value="35" @(Model.GroupId == 35 ? "selected" : "")>Thuế cơ sở 19 TP Hà Nội</option>
                                                    <option value="36" @(Model.GroupId == 36 ? "selected" : "")>Thuế cơ sở 20 TP Hà Nội</option>
                                                    <option value="37" @(Model.GroupId == 37 ? "selected" : "")>Thuế cơ sở 21 TP Hà Nội</option>
                                                    <option value="38" @(Model.GroupId == 38 ? "selected" : "")>Thuế cơ sở 22 TP Hà Nội</option>
                                                    <option value="39" @(Model.GroupId == 39 ? "selected" : "")>Thuế cơ sở 23 TP Hà Nội</option>
                                                    <option value="40" @(Model.GroupId == 40 ? "selected" : "")>Thuế cơ sở 24 TP Hà Nội</option>
                                                    <option value="41" @(Model.GroupId == 41 ? "selected" : "")>Thuế cơ sở 25 TP Hà Nội</option>

                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtDutyDate" class="control-label col-md-3">1. Ngày trực: <span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtDutyDate" data-date-format="DD/MM/YYYY" name="DutyDate" value="@HtmlHelpers.GetDateDocument(Model.DutyDate)" class="form-control date-field" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtDutyLeaderName" class="control-label col-md-3">2. Tên Trưởng nhóm trực: </label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtDutyLeaderName" name="DutyLeaderName" value="@Model.DutyLeaderName" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtClericalOfficerName" class="control-label col-md-3">3. Tên công chức trực văn thư:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtClericalOfficerName" name="ClericalOfficerName" value="@Model.ClericalOfficerName" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtIncomingSubmissionNo" class="control-label col-md-3">4. Số phiếu trình văn bản đến của Phòng TTKT số 2:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtIncomingSubmissionNo" name="IncomingSubmissionNo" value="@Model.IncomingSubmissionNo" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none">
                                        <label for="txtIncomingDocumentType" class="control-label col-md-3">5. Loại văn bản đến:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="txtIncomingDocumentType" name="IncomingDocumentDetail">

                                                    <option value="1" @if (Model.IncomingDocumentDetail == 1) { @Html.Raw("selected=\"selected\"") }>Đơn thư</option>

                                                </select>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none">
                                        <label for="ddlIncomingDocumentDetail" class="control-label col-md-3">6. Chi tiết phân loại văn bản:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="ddlIncomingDocumentDetail" name="IncomingDocumentDetail">

                                                    <option value="2" @if (Model.IncomingDocumentDetail == 2) { @Html.Raw("selected=\"selected\"") }>Đơn KN</option>

                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtReceivedDate" class="control-label col-md-3">7. Ngày đến văn thư Thuế TP Hà Nội:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtReceivedDate" data-date-format="DD/MM/YYYY" name="ReceivedDate" value="@HtmlHelpers.GetDateDocument(Model.ReceivedDate)" class="form-control date-field" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtReceivedNo" class="control-label col-md-3">8. Số đến Văn thư Thuế TP Hà Nội:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtReceivedNo" name="ReceivedNo" value="@Model.ReceivedNo" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtSender" class="control-label col-md-3">9. Nơi gửi:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtSender" name="Sender" value="@Model.Sender" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtIncomingDocumentNo" class="control-label col-md-3">10. Số và ký hiệu văn bản:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtIncomingDocumentNo" name="IncomingDocumentNo" value="@Model.IncomingDocumentNo" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtIncomingDocumentDate" class="control-label col-md-3">11. Ngày tháng văn bản:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtIncomingDocumentDate" data-date-format="DD/MM/YYYY" name="IncomingDocumentDate" value="@HtmlHelpers.GetDateDocument(Model.IncomingDocumentDate)" class="form-control date-field" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtIncomingDocumentSummary" class="control-label col-md-3">12. Trích yếu văn bản:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtIncomingDocumentSummary" name="IncomingDocumentSummary" class="form-control" rows="3">@Model.IncomingDocumentSummary</textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtLeaderName" class="control-label col-md-3">13. Lãnh đạo phụ trách - Tên:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <select class="form-control" id="txtLeaderName" name="LeaderName">
                                                    <option value="">--Chọn lãnh đạo--</option>
                                                    <option value="Nguyễn Hà Trung" @if (Model.LeaderName == "Nguyễn Hà Trung") { @Html.Raw("selected=\"selected\"") }>Nguyễn Hà Trung</option>
                                                    <option value="Bùi Ngọc Lập" @if (Model.LeaderName == "Bùi Ngọc Lập") { @Html.Raw("selected=\"selected\"") }>Bùi Ngọc Lập</option>
                                                    <option value="Phạm Anh Tuấn" @if (Model.LeaderName == "Phạm Anh Tuấn") { @Html.Raw("selected=\"selected\"") }>Phạm Anh Tuấn</option>

                                                </select>
                                                @*<input type="text" id="txtLeaderName" name="LeaderName" value="@Model.LeaderName" class="form-control" />*@
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtLeaderReceivedDate" class="control-label col-md-3">14. Lãnh đạo phụ trách - Ngày nhận:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtLeaderReceivedDate" data-date-format="DD/MM/YYYY" name="LeaderReceivedDate" value="@HtmlHelpers.GetDateDocument(Model.LeaderReceivedDate)" class="form-control date-field" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtAssignedOfficerName" class="control-label col-md-3">15. CB được giao giải quyết - Tên CB:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtAssignedOfficerName" name="AssignedOfficerName" value="@Model.AssignedOfficerName" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkAssignedOfficerSigned" class="control-label col-md-3">16. CB được giao giải quyết - Ký nhận:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkAssignedOfficerSigned" name="AssignedOfficerSigned" @if (Model.AssignedOfficerSigned == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtAssignedOfficerReceivedDate" class="control-label col-md-3">17. CB được giao giải quyết - Ngày nhận:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtAssignedOfficerReceivedDate" data-date-format="DD/MM/YYYY" name="AssignedOfficerReceivedDate" value="@HtmlHelpers.GetDateDocument(Model.AssignedOfficerReceivedDate)" class="form-control date-field" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-pane " id="tabs-outgoing">
                                    <h4 class="tab-title">Văn bản đi</h4>
                                    <div class="form-group">
                                        <label for="txtOutgoingDocumentType" class="control-label col-md-3">18. Loại văn bản đi:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtOutgoingDocumentType" name="OutgoingDocumentType" value="@Model.OutgoingDocumentType" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtOutgoingDocumentNo" class="control-label col-md-3">19. Số văn bản đi:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtOutgoingDocumentNo" name="OutgoingDocumentNo" value="@Model.OutgoingDocumentNo" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtOutgoingDocumentDate" class="control-label col-md-3">20. Ngày văn bản đi:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtOutgoingDocumentDate" data-date-format="DD/MM/YYYY" name="OutgoingDocumentDate" value="@HtmlHelpers.GetDateDocument(Model.OutgoingDocumentDate)" class="form-control date-field" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtOutgoingRecipient" class="control-label col-md-3">21. Nơi nhận:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtOutgoingRecipient" name="OutgoingRecipient" value="@Model.OutgoingRecipient" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-pane " id="tabs-petition">
                                    <h4 class="tab-title">Phân loại đơn</h4>
                                    <div class="form-group">
                                        <label for="chkIsDenunciation" class="control-label col-md-3">22. Tố cáo:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsDenunciation" name="IsDenunciation" @if (Model.IsDenunciation == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkIsComplaint" class="control-label col-md-3">23. Khiếu nại:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsComplaint" name="IsComplaint" @if (Model.IsComplaint == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkIsFeedbackPetition" class="control-label col-md-3">24. Phản ánh, kiến nghị:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsFeedbackPetition" name="IsFeedbackPetition" @if (Model.IsFeedbackPetition == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkIsMultiContentPetition" class="control-label col-md-3">25. Đơn nhiều nội dung:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsMultiContentPetition" name="IsMultiContentPetition" @if (Model.IsMultiContentPetition == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtPetitionerNameTaxCode" class="control-label col-md-3">26. Tên tổ chức/cá nhân gửi đơn - MST:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtPetitionerNameTaxCode" name="PetitionerNameTaxCode" value="@Model.PetitionerNameTaxCode" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkIsRepeatedDenunciation" class="control-label col-md-3">27. Tố cáo tiếp:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsRepeatedDenunciation" name="IsRepeatedDenunciation" @if (Model.IsRepeatedDenunciation == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkIsAuthorizedComplaint" class="control-label col-md-3">28. Uỷ quyền KN, KNPA:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsAuthorizedComplaint" name="IsAuthorizedComplaint" @if (Model.IsAuthorizedComplaint == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="chkIsHandledByInspection2" class="control-label col-md-3">29. Phòng TTKT2 giải quyết:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <div class="checkbox"><label><input type="checkbox" id="chkIsHandledByInspection2" name="IsHandledByInspection2" @if (Model.IsHandledByInspection2 == true) { @Html.Raw("checked=\"checked\"") }> Có</label></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtComplaintArea" class="control-label col-md-3">30. Địa bàn bị KN, TC, KNPA:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtComplaintArea" name="ComplaintArea" value="@Model.ComplaintArea" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtComplaintTarget" class="control-label col-md-3">31. Đối tượng bị tố cáo / kiến nghị:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtComplaintTarget" name="ComplaintTarget" value="@Model.ComplaintTarget" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
