@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.DocumentModel

@{
    var langpage = WorkContext.GetLanguage();
}
<div class="document-page container mt20">
    <div class="row">
        <div class="col-lg-8 col-md-12 pb40">
            @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
            <div class="mt30">
                <div class="document-search-02">
                    <div class="form-group w-50">
                        <label class="">Số ký hiệu:</label>
                        <input id="txtcode" class="form-control" value="@ViewBag.code" type="text">
                    </div>
                    <div class="form-group w-50">
                        <label class="">Loại văn bản:</label>
                        <select class="form-control" id="ddlType">
                            <option value="0">-- Tất cả --</option>
                            <option value="6" @if (ViewBag.type == 6) { @Html.Raw("selected='selected'") ; }>Nghị định</option>
                            <option value="13" @if (ViewBag.type == 13) { @Html.Raw("selected='selected'") ; }>Thông tư</option>
                            <option value="11" @if (ViewBag.type == 11) { @Html.Raw("selected='selected'") ; }>Quyết định</option>
                            <option value="4" @if (ViewBag.type == 4) { @Html.Raw("selected='selected'") ; }>Hiệp định</option>
                            <option value="7" @if (ViewBag.type == 7) { @Html.Raw("selected='selected'") ; }>Nghị định thư</option>

                            <option value="17" @if (ViewBag.type == 17) { @Html.Raw("selected='selected'") ; }>Bản ghi nhớ</option>
                            <option value="18" @if (ViewBag.type == 18) { @Html.Raw("selected='selected'") ; }>Công điện</option>
                            <option value="19" @if (ViewBag.type == 19) { @Html.Raw("selected='selected'") ; }>Quy định</option>
                            <option value="20" @if (ViewBag.type == 20) { @Html.Raw("selected='selected'") ; }>Thông báo</option>
                        </select>
                    </div>
                    <div class="form-group w-50">
                        <label class="">Ngày ban hành:</label>
                        <input id="txtfromdate" class="form-control" type="text" placeholder="dd/MM/yyyy" value="@ViewBag.fromdate">
                    </div>
                    <div class="form-group w-50">
                        <label class="">Ngày hiệu lực:</label>
                        <input id="txttodate" class="form-control" type="text" value="@ViewBag.todate">
                    </div>
                    <div class="form-group w-50">
                        <label class="">Lĩnh vực:</label>
                        <select class="form-control" id="ddlArea">
                            <option value="0">-- Tất cả --</option>

                            <option value="1" @if (ViewBag.area == 1) { @Html.Raw("selected='selected'") ; }>Công nghiệp nặng</option>
                            <option value="2" @if (ViewBag.area == 2) { @Html.Raw("selected='selected'") ; }>Công nghiệp thực phẩm</option>
                            <option value="3" @if (ViewBag.area == 3) { @Html.Raw("selected='selected'") ; }>Công nghiệp chế biến, chế tạo</option>
                            <option value="4" @if (ViewBag.area == 4) { @Html.Raw("selected='selected'") ; }>Công nghiệp hỗ trợ</option>

                        </select>
                    </div>
                    <div class="form-group w-50">
                        <label class="">Cơ quan ban hành:</label>
                        <select class="form-control" id="ddlAgent">
                            <option value="0">-- Tất cả --</option>
                            <option value="2" @if (ViewBag.agent == 2) { @Html.Raw("selected='selected'") ; }>Bộ Công Thương</option>
                            @*<option value="1" @if (ViewBag.agent == 1) { @Html.Raw("selected='selected'") ; }>Bộ Công nghiệp</option>*@
                            <option value="11" @if (ViewBag.agent == 11) { @Html.Raw("selected='selected'") ; }>Thủ tướng Chính phủ</option>
                            <option value="5" @if (ViewBag.agent == 5) { @Html.Raw("selected='selected'") ; }>Bộ Tài chính</option>
                            <option value="15" @if (ViewBag.agent == 15) { @Html.Raw("selected='selected'") ; }>Cục Công nghiệp</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="">Từ khóa:</label>
                        <input id="txtkeyword" class="form-control" value="@ViewBag.keyword" type="text">
                    </div>
                    <div class="form-group text-center">
                        <a href="javascript:;" onclick="searchdoc();" class="btn btn-primary">Tìm kiếm</a>
                    </div>
                </div>

                <div class="document-table table-responsive mt20">
                    <table>
                        <tbody>
                            <tr>
                                <th>@Resources.Global.DocNumber </th>
                                <th>@Resources.Global.DocCode </th>
                                <th style="width: 320px;">@Resources.Global.DocName </th>
                                <th>@Resources.Global.DocPublishDate </th>
                                <th>@Resources.Global.DocDownload </th>

                            </tr>
                            @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                            {
                                <tr>
                                    <td style="text-align: center" align="center">@(item.i + 1) </td>
                                    <td align="center">@item.value.Code</td>
                                    <td style="width:320px;">
                                        <a href="@Url.Action("Detail","Document",new { id=item.value.Id})">
                                            @item.value.Name
                                        </a>
                                    </td>
                                    <td align="center"> @Convert.ToDateTime(item.value.PublishDate).ToString(@" dd'/'MM'/'yyyy") </td>
                                    <td align="center">
                                        <div style="width: 99px;">
                                            <a href="@Url.Action("DownloadFile", "Document", new {id = item.value.Id})">
                                                <img style="width: 17px;" src="/Content/images/ico-pdf02.png">
                                            </a>
                                            <br />
                                            <a href="@Url.Action("ViewFile", "Document", new {id = item.value.Id})" target="_blank">@Resources.Global.DocViewOnline </a>
                                        </div>

                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="paging mt50 text-center">
                    <ul>
                        @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                            {
                                PageUrl = Url.SetParameter("Page", "!0"),
                                CurrentPage = Model.pageIndex,
                                PageSize = Model.pageSize,
                                TotalItemCount = Model.total,
                            }); }
                    </ul>
                </div>
            </div>
        </div><!-- end content left-->

        <div class="col-lg-4 col-md-12">
            <div class="noti-box">
                @{Html.RenderAction("RightLastestNews2", "News", new { CateName = "", CategoryId = 93, MaxLastestNews = 3, cssClass = "maxheight02" });}

            </div>
            <ul class="link-list mt20">
                @{Html.RenderAction("BannerRight", "Home", new { lang = langpage });}

            </ul>
        </div>
    </div>
</div>
<!-- end content-->
<




<script type="text/javascript">


    function searchdoc() {
        var id = '@Model.CategoryId';
        var keyword = $("#txtkeyword").val();
        var fromdate = $("#txtfromdate").val();
        var todate = $("#txttodate").val();
        var type = $("#ddlType").val();
        var area = $("#ddlArea").val();
        var agent = $("#ddlAgent").val();
        window.location = '/Document/Index/' + id + '/?keyword=' + keyword + '&fromdate=' + fromdate + '&todate=' + todate + '&type=' + type + '&area=' + area + '&agent=' + agent;
        //window.location = jQuery.query.set("keyword", keyword).set("fromdate", fromdate).set("todate", todate).set("Page", "1");
    }
</script>
<script type="text/javascript">

 $('#menu_' + '@ViewBag.CurrentCategoryId').addClass("active");

  $('#menu_' + '@ViewBag.ParentCategoryId').addClass("active");



</script>