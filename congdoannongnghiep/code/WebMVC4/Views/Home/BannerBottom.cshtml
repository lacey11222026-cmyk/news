@model List<DATA.Banner>
<div class="bnr-list-02 bnrSmallSlider02">
    @if (Model != null)
    {

        foreach (var item in Model.Select((value, i) => new { i, value }))
        {
            <div> <a href="@item.value.Url" rel="nofollow" target="_blank"><img src="@item.value.Data" alt="@item.value.Name" /></a></div>

        }


    }
</div>
<script>
    // bnrSmallSlider02
    $('.bnrSmallSlider02').slick({
        autoplay: true,
        infinite: true,
        dots: false,
        arrows: true,
        speed: 300,
        slidesToShow: 4,
        slidesToScroll: 4,
        responsive: [
            {
                breakpoint: 991,
                settings: {
                    slidesToShow: 3,
                    slidesToScroll: 3
                }
            },
            {
                breakpoint: 575,
                settings: {
                    slidesToShow: 2,
                    slidesToScroll: 2
                }
            }
        ]
    });
</script>
