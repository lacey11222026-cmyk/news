@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.DOCUMENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="col-md-6 col-sm-12">
            <ul class="document-02-list mt20">
                @foreach (var item in Model.Take(4).Select((value, i) => new { i, value }))
                {
                    <li>
                        <a href="@Url.Action("Detail","Document",new { id=item.value.Id})"
                           title="@item.value.Name">
                            @item.value.Name
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="col-md-6 col-sm-12">
            <ul class="document-02-list mt20">
                @foreach (var item in Model.Skip(4).Take(4).Select((value, i) => new { i, value }))
                {
                    <li>
                        <a href="@Url.Action("Detail","Document",new { id=item.value.Id})"
                           title="@item.value.Name">
                            @item.value.Name
                        </a>
                    </li>
                }
            </ul>
        </div>
        <div class="text-center mt15">
            <a href="/Document/Index/32" class="btn-blue">Xem thêm</a>
        </div>
    }

}