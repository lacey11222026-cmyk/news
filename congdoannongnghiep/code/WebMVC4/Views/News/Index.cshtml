@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.News2Model

<div class="newspage container mt30">
    @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = ViewBag.CategoryId });}
    @if (Model.hotnews != null)
    {
        <div class="row mt20">
            <div class="col-lg-6 col-md-6 col-sm-12">
                @foreach (var item in Model.hotnews.Take(1).Select((value, i) => new { i, value }))
                {
                    
                    <div class="newsbig-top">
                        <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=650&h=350&mode=crop" alt="" ></a>
                        <a href="@item.value.LinkUrl" class="news-name mt15">@item.value.Title</a>
                        <p class="mt10 news-txt">@item.value.IntroText</p>
                        <span class="newsdate mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                    </div>
                }

            </div>
            <div class="col-lg-6 col-md-6 col-sm-12">
                <ul class="newshot row newspage-newshot">
                    @foreach (var item in Model.hotnews.Skip(1).Select((value, i) => new { i, value }))
                    {
                        <li class="col-md-6 col-sm-12">
                            <a href="@item.value.LinkUrl" class="newshot-item">
                                <img src="@item.value.MainImage?w=300&h=200&mode=crop">
                                <span class="mt15">@item.value.Title</span>
                            </a>
                        </li>
                    }
                    </ul>
            </div>
        </div><!-- end row-->

    }
</div><!-- end content 01 -->

<div class="bnrCenter container mt40">
    <div class="bnrSlider">
        @{Html.RenderAction("BannerCenter1", "Home");}
    </div>
</div>
<div class="container newspage-c2 mt40">
    <div class="row">
        <div class="col-lg-8 col-md-12">
            @if (Model.articles != null)
            {
                <div class="">
                    <h2 class="title-detail"><a href="#">Xem Thêm</a></h2>

                    <div class="newslist-04 mt20">
                        @foreach (var item in Model.articles.Select((value, i) => new { i, value }))
                        {


                            <div>
                                <a href="@item.value.LinkUrl" class="newslist-04-item">
                                    <img src="@item.value.MainImage?w=230&h=153&mode=crop" alt="">
                                    <div>
                                        <p class="news-name">@item.value.Title</p>
                                        <p class="mt10 news-content">@item.value.IntroText</p>
                                        <p class="mt10 newsdate">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                                    </div>
                                </a>
                            </div>
                        }

                    </div>
                    <div class="paging mt50">
                        <ul>
                            @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                                {
                                    PageUrl = Url.SetParameter("Page", "!0"),
                                    CurrentPage = ViewBag.Page,
                                    PageSize = ViewBag.PageSize,
                                    TotalItemCount = ViewBag.Total,
                                }); }
                        </ul>
                    </div>
                </div>
            }
        </div>
        <div class="col-lg-4 col-md-12 sidebar-right">
            @Html.Partial("Site_Right")
        </div>
    </div>
</div>

