@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel
@if (Model != null)
{
    if (Model.listdata!=null)
    {


        <ul class="newshot row">
            @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
            {
                <li class="col-lg-3 col-md-4 col-sm-12">
                    <a href="/trang-chu-video.html?VideoId=@(item.value.Id)" class="newshot-item">
                        <img src="@item.value.MainImage?w=272&h=181&mode=crop">
                        <span class="mt15">@item.value.Title</span>
                    </a>
                </li>
            }
        </ul>
        <div class="paging mt10">
            <ul>
                @{Html.RenderPartial("PaginationVideo", new WebMVC4.Models.PaginationInfo
                    {
                        PageUrl = Url.SetParameter("Page", "!0"),
                        CurrentPage = Model.pageIndex,
                        PageSize = Model.pageSize,
                        TotalItemCount = Model.total,
                    }); }
            </ul>
        </div>
    }

    <script>

        function GoVideoPage(page) {
            var VideoId = '@Model.Id';
            if (page > 0) {
                $.ajax({
                    type: "GET",
                    url: "/Video/LoadVideo/?VideoId=" + VideoId + "&page=" + page,
                    success: function (data) {
                        if (data != "null") {
                            $("#lstVideo").html(data);
                        }
                    }
                });
            }

        }

    </script>
}