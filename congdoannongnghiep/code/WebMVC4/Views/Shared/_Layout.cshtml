<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <title>@ViewBag.Title </title>
    <meta name="description" content="@Html.Raw(ViewBag.Description)" />
    <meta name="keywords" content="@Html.Raw(ViewBag.Keywords)" />
    <meta name="news_keywords" content="@Html.Raw(ViewBag.Keywords)" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="cong doan nong nghiep" />

    <meta content="general" name="rating" />
    <meta content="cong doan nong nghiep Viet Nam" name="copyright" />
    <meta content="never" name="expires" />
    <meta content="global" name="distribution" />
    <meta content="DOCUMENT" name="RESOURCE-TYPE" />
    <meta content="vnubw.org.vn" name="GENERATOR" />
    <meta name="robots" content="index,follow" />
    <meta name="Googlebot" content="index,follow,noarchive" />

    <meta content="@ViewBag.MainImage" property="og:image">
    <link rel="shortcut icon" href="/Content/img/ico-logo.png">
    <link rel="publisher" href="https://www.facebook.com/congdoannongnghiep/" />
    <link rel="author" href="https://www.facebook.com/congdoannongnghiep/" />

    <link rel="stylesheet" href="/Content/css/bootstrap.min.css">
    <link rel="stylesheet" href="/Content/css/common.css">
    <link rel="stylesheet" href="/Content/css/style.css?vs=01">
    <link type="text/css" rel="stylesheet" href="/Content/css/jquery.mmenu.all.css" />
    <link href="/Content/css/slick.min.css" type="text/css" rel="stylesheet" />
    <link href="/Content/css/slick-theme.css" type="text/css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/css/extend.css?vs=06" rel="stylesheet" />
</head>
<body onorientationchange="updateOrientation();">

    <!-- nav mobile --->
    <script src="~/Content/js/jquery.min.js"></script>
    <script src="~/Content/js/bootstrap.min.js"></script>

    <script src="https://kit.fontawesome.com/9d8584fa51.js" crossorigin="anonymous"></script>
    <script src="~/Content/js/slick.min.js"></script>
    @Html.Partial("Site_Header")
    @RenderBody()
    @Html.Partial("Site_Footer")

    <script type="text/javascript" src="~/Content/js/jquery.mmenu.min.all.js"></script>
    <script type="text/javascript" src="~/Content/js/jquery.flexisel.js"></script>

    <script src="~/Content/js/jquery.matchHeight.js"></script>
    <script src="~/Content/js/script.js" type="text/javascript"></script>


    <div id="fb-root"></div>
    <div style="clear:both">
    </div>
    <script>
        function updateOrientation() {
            window.location.reload();
        }
    </script>
</body>


</html>
