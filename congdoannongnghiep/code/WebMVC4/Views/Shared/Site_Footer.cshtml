<div class="mess">
    <button class="btn-mess" style=""></button>
    <div class="mess-inner" style="display: none;">
        <p class="mess-title"><button class="mess-close">x</button></p>
        <div>
            <p >Vui lòng để lại câu hỏi của bạn tại đây! Chúng tôi sẽ liên hệ bạn sớm nhất</p>
            <br />
            <div id="comment-result" style="display:none;" class="status alert alert-success">Gửi câu hỏi thành công </div>
            <div class="col-md-12">
                <p id="msgBox" style="color: #c82e29; font-weight: bold; font-size: 14px"></p>
                @Html.AntiForgeryToken()
            </div>
            <input type="text" class="form-control mt10" id="familyname" placeholder="Họ và tên">
            <input type="email" class="form-control mt10" id="email" placeholder="Email">
            <input type="email" class="form-control mt10" id="question" placeholder="Câu hỏi">
            <textarea class="form-control mt10" id="content" rows="3"></textarea>
            <div class="text-center mt10"><button type="button" onclick="return validateData()" class="btn btn-primary">Gửi</button></div>
        </div>
    </div>
</div>
<p><a href="#top" id="backToTop" class="backTop block"></a></p>
<script src="~/Content/js/formvalidate.js?vs=02"></script>
<script type="text/javascript">

  function validateEmail() {
      if (!ValidateControls("Vui lòng nhập Email", "#email")) {
          return false;
      }
      var mail = $('#email').val();
      if (!isValidEmailAddress(mail)) {

          $("#msgBox").html("Email sai định dạng").show();

          $('#email').focus();
          return false;
      }
      return true;
  }


  function validateData() {
      if (!ValidateControls("Vui lòng nhập họ tên", "#familyname")) {
          return false;
      }
      if (!validateEmail()) {
          return false;
      }
      //if (!validateMobile()) {
      //    return false;
      //}
      if (!ValidateControls("Vui lòng nhập câu hỏi", "#question")) {
           return false;
       }
      if (!ValidateControls("Vui lòng nhập nội dung", "#content")) {
          return false;
      }
      var postdata = {
          Name: $('#familyname').val(),
          Email: $('#email').val(),
          Answer: $('#content').val().replace(/\n/g, '<br />'),
          Question: $('#question').val().replace(/\n/g, '<br />')

      };
      $.ajax({
          type: "post",
          dataType: "html",
          url: '@Url.Action("Feedback", "Intro")',
          data: addAntiForgeryToken(postdata),
          success: function (response) {

              var data = parseInt(response);
              if (data == 1) {

                  $("#comment-result").show();

                  $('#familyname').val("");
                  $('#email').val("");
                  $('#question').val("");
                  $('#content').val("");

              }

              if (data == -99) {
                  $("#msgBox").html("Lỗi hệ thống! Vui lòng quay lại trong giây lát").show();

              }
              if (data == -4) {
                  $("#msgBox").html("Bạn gửi thông tin quá nhiều lần. Vui lòng chờ giây lát").show();

              }

          }
      });

      return true;
  }
</script>
