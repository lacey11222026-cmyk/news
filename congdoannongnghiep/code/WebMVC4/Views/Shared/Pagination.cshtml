@model WebMVC4.Models.PaginationInfo
@using WebMVC4.Helper
@if (Model.Pages.Count() > 1)
{
    if (Model.CurrentPage > 10)
    {
        @*<li><a href="@Url.SetParameter("Page", 1)" ><<</a> </li>*@
    }
    if (Model.HasPrevPage)
    {
        <li class="paging-other"><a href="@Model.PrevPageUrl"><img src="/Content/img/paging-pr.png" alt=""></a></li>
        @*<li><a href="@Model.PrevPageUrl"><</a> </li>*@
    }
    @* else
        {
        <li><a href="#" class="active">Trước</a> </li>      }*@
    foreach (var p in Model.Pages)
    {
        if (p == Model.CurrentPage)
        {
            <li class="active"><a class="currentpage" href="#">@p</a></li>
        }
        else
        {

            <li><a href="@Model.PageUrlFor(p)">@p</a> </li>
        }
    }
    if (Model.HasNextPage)
    {

        @*<li><a href="@Model.NextPageUrl"> > </a></li>*@
        <li class="paging-other"><a href="@Model.NextPageUrl"><img src="/Content/img/paging-next.png" alt=""></a></li>
    }
    @* else
        {
        <li><a href="#" class="active">Sau </a></li>
        }*@

    <div class="clear"></div>
}