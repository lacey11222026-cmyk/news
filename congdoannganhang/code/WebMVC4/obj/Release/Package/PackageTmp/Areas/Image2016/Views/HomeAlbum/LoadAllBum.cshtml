@using WebMVC4
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Areas.Image2016.Models.AlbumImageModel


@if (Model.listdata != null)
{
    if (Model.listdata.Count > 0)
    {



        <div class="postbox pt60 container">
            <div class="postbox-inn">
                <h2 class="title">Tác phẩm tiêu biểu</h2>
                <div class="search-box mt10">
                    <input type="text" id="txtkeyword" placeholder="Tìm kiếm" value="@ViewBag.keyword" class="form-control">
                    <button type="button" class="btn-search" onclick="fillter()"></button>
                </div>
            </div>

            <div class="postlist mt20">
                @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                {
                    <div class="postitem">
                        <div class="main-img">
                            <a href="javascript:;" data-to="1" data-toggle="modal" data-target="#posts@(item.i)">
                                <img src="@item.value.MainImage?w=370&h=248&mode=crop&autorotate=true">
                            </a>
                        </div>
                        <div class="maso">
                            <p class="ms-name">@item.value.Code - @item.value.Author</p>
                            <p class="donvi">@item.value.GroupName</p>
                        </div>
                    </div>
                }
            </div>
            <div class="paging mt50">
                <ul>
                    @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                        {
                            PageUrl = Url.SetParameter("Page", "!0"),
                            CurrentPage = Model.pageIndex,
                            PageSize = Model.pageSize,
                            TotalItemCount = Model.total,
                        }); }
                </ul>
            </div>
        </div>

        foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
        {

            <!-- Post 02 -->
            <div id="posts@(item.i)" class="modal fade" role="dialog">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <div id="images@(item.i)">


                            @foreach (var img in item.value.Album)
                            {
                                if (!string.IsNullOrEmpty(img.Url))
                                {
                                    <div>
                                        <img src="@img.Url?h=@(ViewBag.Height)&mode=crop&autorotate=true" alt="">
                                        <p>
                                            @Html.Raw(img.Description)
                                        </p>
                                    </div>
                                }
                            }


                        </div>
                        <div id="diaporama@(item.i)"></div>
                    </div>
                </div>
            </div>

        }
        <script>
            function fillter() {
                var keyword = $("#txtkeyword").val();

                window.location = '/cuoc-thi-sang-tac-thiep/?keyword=' + keyword;
            }
            $('#txtkeyword').keyup(function (e) {
                if (e.keyCode == 13) {
                    //window.location = jQuery.query.set("keyword", this.value).set("Page", "1");
                    window.location = '/cuoc-thi-sang-tac-thiep/?keyword=' + this.value;
                }
            });
            // Slider 01
            $(function () {
                $('#diaporama0').html($("#images0").html());
