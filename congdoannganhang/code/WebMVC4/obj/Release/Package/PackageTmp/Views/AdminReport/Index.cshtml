@{

    Layout = "~/Views/Shared/_AdminV2.cshtml";
    ViewBag.Title = "Thống kê tin bài";
}
<script src="/Administrator/Scripts/highcharts.js" type="text/javascript"></script>

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">


                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        
						<select class="drl_Year form-control" id="Year" name="Year">
							 @for (var i = DateTime.Now.Year; i >= 2013; i--)
						 {
						 
							if (i.ToString() == ViewBag.Year)
                                    {
                                        <option value="@i" selected="selected">Năm @(i)</option>
                                    }
                                    else
                                    {
                                        <option value="@i">Năm @(i)</option>
                                    }
						 }
							
						</select>
                    </div>



                </div>
            </div>
            <div class="table-responsive">
                <div id="charts" style="text-align: center; padding: 0; margin: auto;">
                    <div id="container" style="padding: 10px 10px 0;">
                    </div>
                </div>
                <div class="clear"></div>
                <div id="table" style="text-align: center; padding: 0; margin: auto;">
                    <div style="padding: 10px 10px 0; width:90%;margin: auto;">
                        <div style="padding-top: 38px; padding-left: 26px; font-weight: 100; color: #3E576F;
                    font-family: 'Lucida Grande','Lucida Sans Unicode',Verdana,Arial,Helvetica,sans-serif;
                    font-size: 16px;">
                            Bảng số liệu đầy đủ của biểu đồ
                        </div>
                       
                        <table class="tablestatistic" cellpadding="0" cellspacing="0" style="float: left;
                    width: 10%; margin-right: 0px;">
                            @Html.Raw(ViewBag.datatb1)
                        </table>
                        <table class="tablestatistic" cellpadding="0" cellspacing="0" style="width: 70%;
                    margin-left: 0px">
                            @Html.Raw(ViewBag.datatb2)
                        </table>
                        <div class="clr">
                        </div>
                    </div>
                </div>
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="ListLog">
                        @Html.Raw(ViewBag.datagrib)
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        var chart;
        $(document).ready(function () {
            chart = new Highcharts.Chart({
                chart: {
                    renderTo: 'container',
                    type: 'column'
                },
                title: {
                    text: 'Biểu đồ thống kê số lượng tin bài theo chuyên mục'
                },
                subtitle: {
                    text: ''
                },
                xAxis: {
                    categories: categorydata
                },
                yAxis: {
                    min: 0,

                    title: {
                        text: 'Tin bài (số lượng)'
                    },
                    lotLines: [{
                        value: 0,
                        width: 0.1,
                        color: '#808080'
                    }],
                    labels: {
                        formatter: function () {
                            return Highcharts.numberFormat(this.value, 0);
                        }
                    }
                },
                legend: {
                    layout: 'vertical',
                    backgroundColor: '#FFFFFF',
                    align: 'right',
                    verticalAlign: 'top',
                    x: 100,
                    y: 70,
                    floating: true,
                    shadow: true
                },
                tooltip: {
                    formatter: function () {
                        return '' +
                    this.series.name + ': ' + this.y + ' tin bài';
                    }
                },
                plotOptions: {
                    column: {
                        pointPadding: 0.2,
                        borderWidth: 0
                    }
                },
                series: dataline
            });
        });

    });

    $(document).ready(function () {
        $('.drl_Year').change(function () {
            window.location = '/AdminReport/?Year=' + this.value;
            //window.location = jQuery.query.set("Year", this.value);
        });
    });


</script>
<style>
    .tablestatistic th, .tablestatistic td {
        height: 32px !important;
    }
</style>
