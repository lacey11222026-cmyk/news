@using BIZ
@{

    Layout = "~/Views/Shared/_AdminV2.cshtml";
    ViewBag.Title = "Thiết lập hệ thống";
}
@{
    var exchangeRate1= new SystemConfigBO().GetValueByKey("ExchangeRate1");
    var exchangeRate2= new SystemConfigBO().GetValueByKey("ExchangeRate2");
    var interestRate1 = new SystemConfigBO().GetValueByKey("InterestRate1");
    var interestRate2 = new SystemConfigBO().GetValueByKey("InterestRate2");
}

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-fw fa-user-md"></i><span>@ViewBag.Title </span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">

                    <div class="panel panel-info">
                        <div id="Errordiv" style="margin:20px;color:red;font-size:13pt"><center></center></div><br />
                        @*<div class="panel-heading">
                                <h4 class="panel-title"><i class="fa fa-wrench" style="margin-right:7px"></i>Thông Tin Cơ Bản</h4>
                            </div>*@
                        <div style="padding: 10px 0 0 0;background-color:#fff !important">

                            <div class="col-md-12">
                                <div>
                                    <!-- dành cho UpdateFunction -->
                                    <div class="form-group">
                                        <label for="ExchangeRate" class="control-label col-md-3">Tỷ giá USD :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="ExchangeRate1" name="appSettings" class="form-control" cols="20" style="height: 90px;font-size: 13px;font-weight: bold">@exchangeRate1</textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="ExchangeRate" class="control-label col-md-3">Tỷ giá EUR :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="ExchangeRate2" name="appSettings" class="form-control" cols="20" style="height: 90px;font-size: 13px;font-weight: bold">@exchangeRate2</textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="InterestRate" class="control-label col-md-3">Lãi suất tái chiết khấu :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="InterestRate1" name="appSettings" class="form-control" style="height: 90px;font-size: 13px;font-weight: bold" cols="20">@interestRate1</textarea>

                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="InterestRate" class="control-label col-md-3">Lãi suất tái cấp vốn:</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="InterestRate2" name="appSettings" class="form-control" style="height: 90px;font-size: 13px;font-weight: bold" cols="20">@interestRate2</textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="panel-footer form-horizontal">
                                        <div class="form-group submit">


                                            <button type="button" class="btn btn-primary" id="btsubmit" onclick="SaveAppSettings()"><i class="fa fa-save"></i>Lưu lại</button>
                                            <button type="button" class="btn btn-primary" id="btsubmit2" onclick="FlushCache()"><i class="fa fa-save"></i>Xóa cache</button>
                                        </div>
                                    </div>


                                </div>
                            </div>
                            <div style="clear:both"></div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="text/javascript">
    $('#menu_config').addClass("active");
    $('#menu_1').addClass("active");
    function FlushCache() {



        $.ajax({
            type: 'POST',
            url: "/Post/SystemService.ashx",
            data: {
                __m: 'flush',

            },
            success: function (data) {
                Utils.UnLoading();
                bootbox.alert("Thành công");
            }
        });


    }

    function SaveAppSettings() {

        var postData = [];
        var values = '';

        $('#defaultForm').find('textarea').each(function (i, e) {

            values = $(e).attr('id') + '|' + $(e).val();
            postData.push(values);
        });
        Utils.Loading();
        
        $.ajax({
            type: 'POST',
            url: "/Post/SystemService.ashx",
            data: {
                __m: 'save_appsettings',
                'data': postData
            },
            success: function (data) {
                Utils.UnLoading();
                bootbox.alert("Lưu thông tin thành công");
            }
        });


    }

</script>
