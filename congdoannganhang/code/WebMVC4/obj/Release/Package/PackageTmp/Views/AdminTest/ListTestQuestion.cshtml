@using BIZ.Entity
@using UTILS
@model List<DATA.TestQuestion>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">

            <th>Mã</th>
            <th class="texttable">Tên câu hỏi</th>

            <th>Loại câu hỏi</th>
            <th>Trạng Thái</th>
            <th>Lĩnh vực</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>

                <td>@obj.Id</td>
                <td class="texttable" style="text-align:left;min-width:150px;">
                    <a href="@Url.Action("TestQuestionDetail",new {id=obj.Id })" title="Edit">@obj.Title</a>
                </td>
               
                <td>
                    @if (obj.Type == 1)
                    {
                        <text>Chọn một đáp án</text>

                    }
                    else
                    {
                       <text>Chọn nhiều đáp án</text>

                    }
                </td> 
                
              
                <td>
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatus('@Utils.Base64Encode(obj.Id)', 1,'@obj.Title');"><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatus('@Utils.Base64Encode(obj.Id)',0,'@obj.Title');"><i class="fa fa-ban"></i></a>

                    }
                </td>
                <td>@obj.Mark</td>
                @*<td style="text-align: center">
                    <a href="javascript:;" title="Delete" onclick="DeleteData('@Utils.Base64Encode(obj.Id)','@obj.Title')"><i class="fa fa-trash-o"></i></a>

                </td>*@

            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            registorId: $("#ddlCate :selected").val(),
            status: $('#ddlStatus :selected').val(),

            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListTestQuestion")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListTestQuestion").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });

   
    function UpdateStatus(id, status, title) {
        var type = "Khóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " câu hỏi này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                var postdata = {
                    '_id': id,
                    'Title': title,
                };
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("TestQuestionUpdateStatus")",
                    data: addAntiForgeryToken(postdata),

                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
</script>