@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using DATA
@using WebMVC4.Helper
@model TestRegistor
<div class="well">
    <span class="label label-danger">
        Chú ý!
    </span>
    <span>
        Hãy chắc chắn nhập vào đầy đủ thông tin tại các mục bắt buộc đánh dấu (*)
    </span>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-fw fa-user-md"></i><span>@ViewBag.Title </span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel panel-info">
                        <div id="Errordiv" style="margin:20px;color:red;font-size:13pt"><center></center></div><br />
                        @*<div class="panel-heading">
                                <h4 class="panel-title"><i class="fa fa-wrench" style="margin-right:7px"></i>Thông Tin Cơ Bản</h4>
                            </div>*@
                        <div style="padding: 10px 0 0 0;background-color:#fff !important">

                            <div class="col-md-12">
                                <div>
                                    <!-- dành cho UpdateFunction -->
                                    <div class="form-group">
                                        <label for="txtTitle" class="control-label col-md-3">Tên đợt thi :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtTitle" name="title" value="@Model.Title" class="form-control" placeholder="Nhập tên đợt thi" />
                                            </div>
                                        </div>
                                    </div>
                                  
                                    <div class="form-group">
                                        <label for="txtSummary" class="control-label col-md-3">Tóm lược :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <textarea id="txtSummary" style="height: 100px;" cols="20" name="description" class="form-control">@Model.Desciption</textarea>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtTestTime" class="control-label col-md-3">Thời gian thi (giây) :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="number" min="0" step="1" id="txtTestTime" name="TestTime" value="@Model.TestTime" class="form-control" placeholder="Nhập thời gian thi" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtTestTime" class="control-label col-md-3">Số lượng câu hỏi :</label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="number" min="0" step="1" id="txtNumberQuestion" name="TestTime" value="@Model.NumberQuestion" class="form-control" placeholder="Nhập số lượng câu hỏi"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="txtStartTime" class="control-label col-md-3">Thời gian bắt đầu :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtStartTime" name="StartTime" data-format="DD/MM/YYYY HH:mm" value="@Model.StartTime.GetValueOrDefault().ToString("dd/MM/yyyy HH:mm")" class="form-control" placeholder="thời gian bắt đầu"/>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="txtEndTime" class="control-label col-md-3">Thời gian kết thúc :<span class="required">*</span></label>
                                        <div class="col-md-9">
                                            <div class="input-icon right">
                                                <input type="text" id="txtEndTime" name="EndTime" data-format="DD/MM/YYYY HH:mm" value="@Model.EndTime.GetValueOrDefault().ToString("dd/MM/yyyy HH:mm")" class="form-control" placeholder="thời gian kết thúc" />

                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label col-md-3" for="cbxIsActive">Trạng thái :</label>
                                        <div class="col-md-4">
                                            <div class="checkbox">
                                                @if (Model.Status == 1)
                                                {<input type="checkbox" id="cbxIsActive" checked="checked" />}
                                                else
                                                {<input type="checkbox" id="cbxIsActive" /> }

                                            </div>
                                        </div>
                                    </div>

                                    <div class="panel-footer form-horizontal">
                                        <div class="form-group submit">


                                            <button type="submit" class="btn btn-primary" id="btsubmit"><i class="fa fa-save"></i>Lưu lại</button>
                                            <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage();"><i class="fa fa-backward"></i>Quay lại</button>
                                        </div>
                                    </div>



                                </div>
                            </div>
                            <div style="clear:both"></div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
   $('#menu_addbanner').addClass("active");

</script>
<script>
    function GotoListpage() {
        window.location = '@Url.Action("TestRegistor")';
    }
    $(document).ready(function () {

        $('#txtStartTime').datetimepicker({
            format: 'DD/MM/YYYY HH:mm'
        });
        $('#txtEndTime').datetimepicker({
            format: 'DD/MM/YYYY HH:mm'
        });
        $("button.close").click(function () {
            $(this).parent().css("display", "none");
        });
        $('#defaultForm').bootstrapValidator({
            message: 'This value is not valid',
            //live: 'submitted',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {

                title: {
                    message: 'Nhập tên đợt thi',
                    validators: {
                        notEmpty: {
                            message: 'tên đợt thi không được bỏ trống'
                        },

                        stringLength: {
                            min: 2,
                            max: 250,
                            message: 'tên đợt thi nhỏ nhất 2 ký tự và nhiều nhất 250 ký tự'
                        },

                    }
                },
              


            }
        })
        .on('success.form.bv', function (e) {
            // Prevent submit form
            e.preventDefault();

            var $form = $(e.target),
                validator = $form.data('bootstrapValidator');
            SaveData();
            $(".close").click(function () {
                $(".alert-success").css("display", "none");
            });
        })
        .on('error.form.bv', function (e) {
            // Active the panel element containing the first invalid element
            e.preventDefault();
            var $form = $(e.target),
            validator = $form.data('bootstrapValidator');
            $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
            $(".alert-danger").css("display", "block");
            $(".close").click(function () {
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
        });

        $("#btnReset").click(function () {
            $('#defaultForm').data('bootstrapValidator').resetForm(true);
            $(".alert-danger").css("display", "none");
            $(".alert-success").css("display", "none");
        });

        //Save Data
        function SaveData() {
            var param = {
                'Id': '@Model.Id',
                'Title': $("#txtTitle").val(),
                'Desciption': $("#txtSummary").val(),
                'NumberQuestion': $("#txtNumberQuestion").val(),
                'TestTime': $("#txtTestTime").val(),
                'sStartTime': $("#txtStartTime").val(),
                'sEndTime': $("#txtEndTime").val(),
                'Status': $("#cbxIsActive").is(":checked") ? 1 : 0

            }
            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "@Url.Action("TestRegistorSaveData")",
                data: addAntiForgeryToken(param),
            async: true,
            success: function (data) {
                Utils.UnLoading();
                if (data.ResponseCode >= 0) {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $(".alert-success").show("slow");
                    $(".alert-danger").hide("slow");
                    setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 500);

                }
                else {
                    $("html,body").animate({ scrollTop: $('#TemplateContent').offset().top }, 'fast');
                    $("#ErrorMessage").text(data.Description);
                    $(".alert-danger").show("slow");
                    $(".alert-success").hide("slow");
                    setTimeout(function () { $(".alert-danger").hide("slow"); }, 2000);
                }
            }
        });
    };
    });
</script>
