<script>
   
    function fillter() {
        var keyword = $("#txtkeyword").val();
        var type = $("#ddlType").val();
        window.location = jQuery.query.set("keyword", keyword).set("type", type).set("Page", "1");
    }
    $('#txtkeyword').keyup(function (e) {
        if (e.keyCode == 13) {
            window.location = jQuery.query.set("keyword", this.value).set("Page", "1");
        }
    });
    function search() {

    }
</script>
