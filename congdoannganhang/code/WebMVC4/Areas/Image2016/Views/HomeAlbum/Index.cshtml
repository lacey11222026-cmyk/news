@{
    Layout = "/Areas/Image2016/Views/Shared/_Layout.cshtml";

}
@using UTILS

<div class="banner">
    <div class="slider bnrSlider">
        <div>
            <a href="#"><img src="~/Areas/Image2016/Content/img/bnr-01.jpg" alt="" class="hidden-767"></a>
            <a href="#"><img src="~/Areas/Image2016/Content/img/bnr-01-mb.jpg" alt="" class="block-767"></a>
        </div>
        <div>
            <a href="#"><img src="~/Areas/Image2016/Content/img/bnr-02.jpg" alt="" class="hidden-767"></a>
            <a href="#"><img src="~/Areas/Image2016/Content/img/bnr-02-mb.jpg" alt="" class="block-767"></a>
        </div>
        <div>
            <a href="#"><img src="~/Areas/Image2016/Content/img/bnr-03.jpg" alt="" class="hidden-767"></a>
            <a href="#"><img src="~/Areas/Image2016/Content/img/bnr-03-mb.jpg" alt="" class="block-767"></a>
        </div>
    </div>
</div>
<script>
    $('.bnrSlider').slick({
        autoplay: true,
        autoplaySpeed: 2000,
        slidesToShow: 1,
        fade: true,
        dots: true,
        arrows: false
    });

</script>
<div class="pt60 pb60 content-01">
    <img src="img/img-01.png" alt="" class="intro-img01">
    <div class="container">
        <div class="row justify-content-start">
            <div class="col-lg-3 col-md-3 col-sm-12 sidebar">
                <ul class="item-list">
                    <li class="active"><span>Giới thiệu</span></li>
                    <li><a href="/cuoc-thi-sang-tac-thiep/the-le">Thể lệ</a></li>
                    <li><a href="/cuoc-thi-sang-tac-thiep#AlbumContent">Tác phẩm tiêu biểu</a></li>
                    <li><a href="#">Kết quả</a></li>
                </ul>
            </div>
            <div class="col-lg-7 col-md-9 col-sm-12 intro-content">
                <p>
                    Thực hiện nhiệm vụ trọng tâm công tác tuyên giáo - nữ công năm 2024 và để tổ chức các hoạt động ý nghĩa cho các cháu thiếu nhi, Công đoàn Ngân hàng Việt Nam tổ chức cuộc thi sáng tác thiệp <span class="textred">“Trao gửi yêu thương”</span> dành cho con cán bộ, đoàn viên, người lao động ngành Ngân hàng (CBĐVNLĐ), nhận bài từ ngày 30 tháng 6 năm 2024 đến hết ngày 15 tháng 7 năm 2024.
                </p>
                <ul class="list-check mt30">
                    <li>Cuộc thi nhằm phát huy hơn nữa vai trò, trách nhiệm của tổ chức công đoàn, nhất là Ban Nữ công công đoàn các cấp trong công tác chăm sóc, giáo dục trẻ em trong ngành Ngân hàng, góp phần xây dựng gia đình no ấm, tiến bộ, hạnh phúc, văn minh gắn chủ đề hoạt động năm 2024 "Gia đình hạnh phúc, quốc gia thịnh vượng".</li>
                    <li>Cuộc thi giúp phát huy khả năng sáng tạo, năng khiếu thẩm mỹ; động viên, khích lệ con em trong Ngành bày tỏ cảm xúc, tình yêu thương chia sẻ đối với bố mẹ, người thân là CBĐVNLĐ ngành Ngân hàng. </li>
                    <li>Cuộc thi tạo sân chơi bổ ích, lý thú, thu hút đông đảo con CBĐVNLĐ trong Ngành tham gia, nhằm hướng tới sự phát triển an toàn, lành mạnh cho trẻ nhỏ; tạo động lực thúc đẩy CBĐVNLĐ tích cực hơn trong công việc cũng như trong cuộc sống, gắn bó hơn với cơ quan, đơn vị, với ngành Ngân hàng.</li>
                </ul>
                <div class="mt50"><a href="/cuoc-thi-sang-tac-thiep/gioi-thieu/" class="btn-view">Xem thêm ></a></div>
            </div>
        </div>
    </div>
</div><!--/ end content 01-->

<div id="AlbumContent">
    @{ Html.RenderAction("LoadAllBum", "HomeAlbum", new { page = ViewBag.page, keyword = ViewBag.keyword, type = ViewBag.type, fromdate = ViewBag.fromdate, todate = ViewBag.todate, status = ViewBag.status }); }
</div>



<div class="container pt80 pb130 intro-detail">
    <div class="row">
        <div class="col-lg-6 col-md-12 col-12">
            <div class="box-cm box-green">
                <img src="~/Areas/Image2016/Content/img/img-03.png" alt="" class="box-green-img01">
                <img src="~/Areas/Image2016/Content/img/img-04.png" alt="" class="box-green-img02">
                <h3 class="box-title">Cách thức dự thi </h3>
                <p class="mt20 font-weight-bold">Các đơn vị gửi tác phẩm dự thi (gồm cả tờ thông tin mẫu 1) + Bản đăng ký (mẫu 2) trực tiếp hoặc qua bưu điện về Công đoàn Ngân hàng Việt Nam – số 6, ngõ 82 phố Dịch Vọng Hậu, quận Cầu Giấy, Hà Nội.</p>
                <p class="mt10" style="font-style: italic;">(Ban Tổ chức cuộc thi chỉ tiếp nhận bài thi theo đơn vị, không nhận trực tiếp từ cá nhân dự thi).</p>
            </div>
        </div>
        <div class="col-lg-6 col-md-12 col-12">
            <div class="box-cm box-orange">
                <img src="~/Areas/Image2016/Content/img/img-05.png" alt="" class="box-orange-img01">
                <img src="~/Areas/Image2016/Content/img/img-06.png" alt="" class="box-orange-img02">
                <h3 class="box-title">Thời gian dự thi</h3>
                <p class="mt50">
                    Thời gian nhận bài dự thi: Từ ngày <strong class="textorange">30/6</strong> đến hết ngày <strong class="textorange">15/7/2024</strong> (tính theo ngày Ban tổ chức cuộc thi nhận trực tiếp, hoặc căn cứ dấu bưu điện ngày gửi đến).
                </p>
            </div>
        </div>
    </div>
</div>

<div class="prize pt60 pb60 mt50">
    <img src="~/Areas/Image2016/Content/img/img-08.png" alt="" class="prize-img">
    <div class="container">
        <h3 class="box-title">Cơ cấu giải thưởng</h3>
        <div class="mt40 row">
            <div class="col-md-4 col-12">
                <img src="~/Areas/Image2016/Content/img/img-07.png" alt="" class="mt20">
            </div>
            <div class="col-md-8 col-12">
                <p class="prize-title">Giải thưởng cuộc thi được cơ cấu cho 2 độ tuổi: Từ 6-10 tuổi và từ 11-15 tuổi,<br> mỗi độ tuổi gồm:</p>
                <div class="mt20">
                    <p class="textorange prize-item"><i class="icon-cup"></i>05 giải A		: 5.000.000đ/giải kèm giấy chứng nhận.</p>
                    <p class="textorange prize-item mt10"><i class="icon-cup"></i>10 Giải B		: 3.000.000đ/giải kèm giấy chứng nhận</p>
                    <p class="textorange prize-item mt10"><i class="icon-cup"></i>20 Giải C		: 1.000.000đ/giải kèm giấy chứng nhận.</p>
                    <p class="textorange prize-item mt10"><i class="icon-cup"></i>30 giải phụ và giải phong trào:	<br>500.000đ/giải kèm giấy chứng nhận.</p>
                </div>
            </div>
        </div>
    </div>
</div>
