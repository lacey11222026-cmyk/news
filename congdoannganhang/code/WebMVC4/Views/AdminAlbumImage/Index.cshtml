@{

    Layout = "~/Views/Shared/_AdminV2.cshtml";
    ViewBag.Title = "Danh sách album";
}
<script src="~/Administrator/Scripts/jquery.table2excel.js"></script>
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">
                  

                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <select class="form-control" id="ddlStatus">
                            <option value="-100">Trạng thái</option>
                            @*<option value="-1">Đợi xuất bản</option>*@
                            <option value="0">Khoá</option>
                            <option value="1">Vòng Dự thi</option>
                            @*<option value="2">Vòng bình chọn</option>*@
                            @*<option value="3">Kết quả chung cuộc</option>*@
                        </select>
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <input type="text" id="txtKeyword" class="form-control" placeholder="Nhập từ khóa">
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6" style="display:none">
                        <select class="form-control" id="ddlType">
                            <option value="-1">--Chủ đề--</option>
                            <option value="1">Công việc</option>
                            <option value="2">Gia đình</option>

                        </select>
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <select class="form-control" id="ddlOrder">
                            <option value="PublishDate DESC">Mới nhất</option>
                            <option value="Point DESC">Điểm</option>
                            <option value="TotalVote DESC">Lượt bình chọn </option>
                            <option value="Point1 DESC">Điểm đoàn viên</option>
                            <option value="TotalVote1 DESC">Lượt bình chọn đoàn viên</option>
                            <option value="Point2 DESC">Điểm công đoàn</option>
                            <option value="TotalVote2 DESC">Lượt bình chọn công đoàn</option>
                        </select>
                    </div>


                    <div class="form-group submit col-md-3 col-xs-12 col-sm-6">
                        <button type="button" id="btnSearch" class="btn btn-info"><i class="fa fa-search"></i>Tìm Kiếm</button>
                        <a id="btnCreate" href="@Url.Action("AddEdit",new {id=0 })" class="btn btn-success"><i class="fa fa-user-plus"></i>Thêm Mới</a>
                        <button type="button" id="btn_export" class="btn btn-success"><i class="fa fa-file-excel-o"></i>Download</button>
                    </div>

                </div>
            </div>
            <div class="table-responsive">
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="ListAlbum">
                        @Html.Action("ListAlbum")
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#menu_albumimage').addClass("active");
    $('#menu_6').addClass("active");
</script>
<script type="text/javascript">
        $(document).ready(function () {
           $("#btn_export").click(function () {
            $("#dataTables").table2excel({
                exclude: ".noExl",
                name: "Album",
                filename: "Album",
                fileext: ".xls",
                exclude_img: true,
                exclude_links: true,
                exclude_inputs: true
            });
            });

            var parameters = {
            };
            $("#form").keypress(function (event) {
                if (event.which == 13) {
                    $("#btnSearch").click();
                }
            });
            $("#btnSearch").click(function () {
                GetList(1);
            });
            $("#ddlStatus").change(function () {
                GetList(1);
            });
            $("#ddlOrder").change(function () {
                GetList(1);
            });
            $("#ddlType").change(function () {
                GetList(1);
            });
            function GetList(currentPage) {
                parameters = {
                    title: $("#txtKeyword").val(),
                    status: $('#ddlStatus :selected').val(),
                    type: $('#ddlType :selected').val(),
                    order: $('#ddlOrder :selected').val(),
                    currentPage: currentPage,
                };
                btnSearch(currentPage);
            };
            function btnSearch(currentPage) {
                Utils.Loading();
                var urlRequestAns = "@Url.Action("ListAlbum")";
                $.ajax({
                    type: 'GET',
                    url: urlRequestAns,
                    data: parameters,
                    success: function (data) {
                        $("#ListAlbum").html(data);
                        Utils.UnLoading();
                    },
                    error: function () {
                        Utils.UnLoading();
                    }
                });
            }

        });

</script>

