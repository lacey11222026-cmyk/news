@using BIZ
@using UTILS
@using WebMVC4.Helper
@model DATA.Album
@if (Model != null)
{
    <link href="/fancybox2.1.5/jquery.fancybox.css" rel="stylesheet" />
    <script src="/fancybox2.1.5/jquery.fancybox.js"></script>


    <div class="container detail-page mt20">
        <div class="row">
            <div class="col-lg-8 col-md-12 col-sm-12">
                @{Html.RenderAction("Breadcrumb", "News", new
                    {
                        CategoryId = Model.CategoryId
                    });}
                <div class="detail-content mt30">
                    <p class="news-name-big">@Model.Title</p>
                    <div class="mt30">
                        @Html.Raw(Model.Description)

                    </div>
                    @if (ViewBag.ImgList != null)
                    {
                        <div id="PnlLightBox" class="mt30">
                            <ul class="newshot row" id="lstlightbox">
                                @foreach (BIZ.Entity.AlbumImage item in ViewBag.ImgList)
                                {
                                    <li class="col-md-4 col-sm-6">
                                        <a href="@(item.Name)?w=0&h=@(ViewBag.Height)&mode=crop" class="chum_anh" title="@item.Text" rel="group">
                                            <img src="@(item.Name)?w=300&h=200&mode=crop" width="236"
                                                 alt="" />
                                        </a>
                                    </li>
                                }

                            </ul>
                            <div class="clear">
                            </div>

                            <script type='text/javascript'>

                                $(document).ready(function () {
                                    $("#lstlightbox a").fancybox({

                                    });
                                });
                            </script>
                        </div>
                    }



                </div>





            </div><!--/End content left-->
            <div class="col-lg-4 col-md-12 col-sm-12 sidebar-right">

                @Html.Partial("Site_Right")

            </div><!-- end col-lg-4-->
        </div>
    </div>

}
<style>
    @@media (max-width: 675px) {
        .newshot li {
            margin-bottom: 20px;
        }
    }
</style>