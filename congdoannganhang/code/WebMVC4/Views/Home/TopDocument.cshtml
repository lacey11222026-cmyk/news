@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.DOCUMENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="">
            <div class="title-tabs">
                <a href="/Document/Index/3" class="active"><span>VĂN BẢN / TRA CỨU</span></a>
            </div>
            <div class="mt20">
                <ul class="document-02-list mt20">
                    @foreach (var item in Model.Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="@Url.Action("ViewFile","Document",new { id=item.value.Id})"
                               title="@item.value.Name">
                                @item.value.Name
                            </a>
                        </li>
                    }
                </ul>
                <div class="text-center mt15">
                    <a href="/Document/Index/3" class="btn-yellow">Xem thêm</a>
                </div>
            </div>
        </div>
        
   
  
    
    
    }

}