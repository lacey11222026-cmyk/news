@using BIZ
@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel

@if (Model != null)
{
    <div class="container news-page mt20">
        <div class="row">
            <div class="col-lg-8 col-md-12 col-sm-12">
                <h2 class="title-cm"><a href="#">Tìm kiếm</a></h2>
                <div class="text-center document-search">

                    <div class="form-group">
                        <label class="">Từ khóa</label>
                        <input id="txtkeyword" class="form-control" type="text" value="@ViewBag.keyword" width="190">
                    </div>

                    <div class="form-group">
                        <label style="width:75px;">Từ ngày</label>
                        <input id="txtfromdate" placeholder="dd/MM/yyyy" value="@ViewBag.fromdate" class="form-control" style="width:120px !important">
                    </div>
                    <div class="form-group">
                        <label style="width:75px;">Đến ngày</label>
                        <input id="txttodate" placeholder="dd/MM/yyyy" value="@ViewBag.todate" class="form-control" style="width:120px !important">
                    </div>
                    <div class="form-group" style="display: none">
                        <label class="">Chuyên mục</label>
                        @Html.DropDownList("drlCategory", new SelectList(ViewBag.CategoryList as System.Collections.IEnumerable, "Id", "Name", ViewBag.CategoryId), new { @class = "form-control" })
                    </div>
                    <div>
                        <a href="javascript:;" onclick="searchnews();" class="btn-green">Tìm kiếm</a>
                    </div>


                </div>
                @if (Model.listdata != null)
                {
                    <div class="mt30">


                        <div class="newslist-04 mt20">
                            @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                            {


                                <div>
                                    <a href="@item.value.LinkUrl" class="newslist-04-item">
                                        <img src="@item.value.MainImage?w=230&h=153&mode=crop" alt="">
                                        <div>
                                            <p class="news-name">@item.value.Title</p>
                                            <p class="mt10 news-content">@item.value.IntroText</p>
                                            <p class="mt10 newsdate">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                                        </div>
                                    </a>
                                </div>
                            }

                        </div>
                        <div class="paging mt50">
                            <ul>
                                @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                                    {
                                        PageUrl = Url.SetParameter("Page", "!0"),
                                        CurrentPage = Model.pageIndex,
                                        PageSize = Model.pageSize,
                                        TotalItemCount = Model.total,
                                    }); }
                            </ul>
                        </div>
                    </div>
                }

            </div><!--/End content left-->
            <div class="col-lg-4 col-md-12 col-sm-12 sidebar-right">
                @Html.Partial("Site_Right")
            </div><!-- end col-lg-4-->
        </div>


    </div>


    <script src="~/Scripts/jquery.query.js"></script>
    <script type="text/javascript">


        function searchnews() {
            var keyword = $("#txtkeyword").val();
            var fromdate = $("#txtfromdate").val();
            var todate = $("#txttodate").val();
            var cateid = $('#drlCategory option:selected').val();
            window.location = jQuery.query.set("q", keyword).set("fromdate", fromdate).set("todate", todate).set("categoryid", cateid).set("Page", "1");
        }
    </script>
}

