@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.News2Model

<div class="container news-page mt20">
    @if(Model!=null)
            {

           
    <div class="newspage-big">
        @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = ViewBag.CategoryId });}

        @if (Model.hotnews != null)
        {
            <div class="mt30 row newspage-big-content">
                <div class="col-md-6 col-sm-12">
                    @foreach (var item in Model.hotnews.Take(1).Select((value, i) => new { i, value }))
                    {
                        <div class="newsbig">
                            <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=568&h=362&mode=crop" alt="" class="w-100"></a>
                            <div class="newsbig-content">
                                <a href="@item.value.LinkUrl" class="news-name mt15">@item.value.Title</a>
                                <p class="newsdate mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                                <p class="news-content mt15">@item.value.IntroText</p>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-3 col-sm-12">
                    <div class="newshot-list">
                        @foreach (var item in Model.hotnews.Skip(1).Take(2).Select((value, i) => new { i, value }))
                        {


                            <div class="maxheight01">
                                <a href="@item.value.LinkUrl" class="newshot-item" style="font-weight: bold;">
                                    <img src="@item.value.MainImage?w=272&h=182&mode=crop">
                                    <span class="mt15 news-content">@item.value.Title</span>
                                </a>
                            </div>
                        }

                    </div>
                </div>
                <div class="col-md-3 col-sm-12">
                    <div class="newshot-list">
                        @foreach (var item in Model.hotnews.Skip(3).Take(2).Select((value, i) => new { i, value }))
                        {

                            <div class="maxheight01">
                                <a href="@item.value.LinkUrl" class="newshot-item" style="font-weight: bold;">
                                    <img src="@item.value.MainImage?w=272&h=182&mode=crop">
                                    <span class="mt15 news-content">@item.value.Title</span>
                                </a>
                            </div>
                        }

                    </div>
                </div>
            </div>
        }

    </div>

    <div class="bnrCenter mt40" >
        <div class="bnrSlider">
            @{Html.RenderAction("BannerCenter2", "Home");}
        </div>
    </div>


    <div class="row">
        <div class="col-lg-8 col-md-12 col-sm-12">
            @if (Model.articles != null)
            {
                <div class="mt30">
                    <h2 class="title-cm"><a href="#">Xem thêm</a></h2>

                    <div class="newslist-04 mt20">
                        @foreach (var item in Model.articles.Select((value, i) => new { i, value }))
                        {


                            <div>
                                <a href="@item.value.LinkUrl" class="newslist-04-item">
                                    <img src="@item.value.MainImage?w=230&h=153&mode=crop" alt="">
                                    <div>
                                        <p class="news-name">@item.value.Title</p>
                                        <p class="mt10 news-content">@item.value.IntroText</p>
                                        <p class="mt10 newsdate">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                                    </div>
                                </a>
                            </div>
                        }

                    </div>
                    <div class="paging mt50">
                        <ul>
                            @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                                {
                                    PageUrl = Url.SetParameter("Page", "!0"),
                                    CurrentPage = ViewBag.Page,
                                    PageSize = ViewBag.PageSize,
                                    TotalItemCount = ViewBag.Total,
                                }); }
                        </ul>
                    </div>
                </div>
            }
        </div><!--/End content left-->
        <div class="col-lg-4 col-md-12 col-sm-12 sidebar-right">
            <div class="mt30"></div>
            @Html.Partial("Site_Right")
        </div><!-- end col-lg-4-->
    </div>

                                }

</div><!-- end content-->



