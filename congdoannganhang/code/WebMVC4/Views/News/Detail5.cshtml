@using BIZ
@using BIZ.Entity
@using UTILS
@using WebMVC4
@using WebMVC4.Helper
@model BIZ.Entity.CONTENT_FULL
@{
    Layout = "~/Views/Shared/_Temp5.cshtml";
}

<div class="t-header">
    <div class="t-header-content">
        <div class="header-c01">
            <a href="/" class="btn-back"><img src="/img/icon-back.svg" alt="Back" width="55"></a>
            <a href="/" class="t-logo-02"><img src="/img/logo.svg" alt="" width="400"></a>
        </div>
        <div class="btn-like">
            <div class="fb-like" data-href="@(Model.LinkUrl)" data-layout="button_count" data-action="like" data-show-faces="false" data-share="true"></div>
        </div>
    </div>
    <a href="/" class="t-logo"><img src="/img/e-logo.svg" alt="e-magazine" width="250"></a>
</div><!--/ End header-->
@Html.Raw(Model.Contents.Replace("<div class=\"temp-05\">", "<div>").Replace("<a data-cke-saved-href=\"#\" href=\"#\" class=\"mt20 disblock\"><img data-cke-saved-src=\"/img/like-face.jpg\" src=\"/img/like-face.jpg\" alt=\"\"></a>", "<div class=\"mt20 disblock\">" + ViewBag.FacebookLike + "</div>"
    ))
@*<div class="temp">
    <a id="backToTopBtn" href="#" class="backToTopBtn shown"><img src="/img/to-top.png" alt="Top"></a>
</div>*@
