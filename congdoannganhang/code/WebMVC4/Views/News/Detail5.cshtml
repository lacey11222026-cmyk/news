    @{ Html.RenderAction("Relate5", "News", new { CategoryId = 7, Id = Model.Id, PageNextShow = false, pageNext = 2 }); }

</div>*@

<script>
        $('#NewsContent .news_detail_img').removeAttr('style');

        $('.temp  img').removeAttr('style');
        $('.temp  img').removeAttr('width');
        $('.temp  table').removeAttr('style');
        $('#date').html('@Model.PublishDate.ToString("dd/MM/yyyy")');
</script>



<style>
    #date {
        text-align: center;
        font-style: italic;
        margin-top: 30px;
    }

    img {
        height: auto !important;
    }
    em {
        font-style: italic;
    }

</style>