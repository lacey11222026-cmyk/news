    <meta name="description" content="@Html.Raw(ViewBag.Description)" />
    <meta name="keywords" content="@Html.Raw(ViewBag.Keywords)" />
    <meta name="news_keywords" content="@Html.Raw(ViewBag.Keywords)" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="cong doan ngan hang" />
    <meta name="google-site-verification" content="kunYSencvCeqCCNmrPIs2-sdgUKplCPKspCOzxD2yTY" />
