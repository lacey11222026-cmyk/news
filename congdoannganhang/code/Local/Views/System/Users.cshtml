@{
   
    Layout = "~/Views/Shared/_Admin.cshtml";
    
}
@using BIZ
@using UTILS
@using Local.Helper
@model Local.Models.UserModel
<div id="toolbar-box">
    <div class="t">
        <div class="t">
            <div class="t">
            </div>
        </div>
    </div>
    <div class="m">
        <div class="toolbar" id="toolbar">
            <table class="toolbar">
                <tr>

                    <td class="button" id="toolbar-new">
                        <a id="lbtnUsersAddNew" href="@Url.Action("UserAdd", "System")"><span class="icon-32-new" title="New"></span>Tạo mới</a>
                    </td>
                </tr>
            </table>
        </div>
        <div class="header icon-48-user">
            Quản lý người dùng
        </div>
        <div class="clr">
        </div>
    </div>
    <div class="b">
        <div class="b">
            <div class="b">
            </div>
        </div>
    </div>
</div>
<div class="clr">
</div>
<div id="element-box">
    <div class="t">
        <div class="t">
            <div class="t">
            </div>
        </div>
    </div>
    <div class="m">
        <table>
            <tr>
                <td width="100%">
                    <form method="get" action="@Url.Action("Users", "System")" >
                        Tìm:
                        @Html.TextBox("searchtext", Model.searchtext)
                        <input type="submit" value="Tìm kiếm" class="btnSearchUser" />
                    </form>
                    
                </td>
                <td nowrap="nowrap"></td>
            </tr>
        </table>
        <table class="adminlist" cellpadding="1">
            <thead>
                <tr>
                    <th width="1%" class="title">#
                    </th>
                    <th width="1%" class="title">
                        <input type="checkbox" onclick="javascript: CheckAll(this);" />
                    </th>
                    <th width="15%" class="title">Tên đăng nhập
                    </th>
                    <th width="15%" class="title">E-Mail
                    </th>
                    <th width="20%" class="title" nowrap="nowrap">Vai trò
                    </th>
                    <th width="7%" class="title" nowrap="nowrap">Ngày tạo
                    </th>
                    <th width="7%" class="title">Giờ đăng nhập trước
                    </th>
                    <th width="5%" class="title">Đang Online?
                    </th>
                    <th width="5%" class="title">Kích hoạt
                    </th>
                    <th width="5%" class="title">Xóa
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (MembershipUser item in Model.listuser)
                {
                    <tr id="tr_@item.UserName">
                        <td></td>
                        <td></td>
                        <td>
                            <a id="lbtnUserName"  href='@Url.Action("UserEdit", "System", new {username=item.UserName})'>
                                @item.UserName</a>
                            
                        </td>
                        <td align="left">
                            @item.Email
                        </td>
                        <td align="left">@HtmlHelpers.GetRolesByUserName(@item.UserName)</td>
                        <td align="center">
                            @item.CreationDate.ToString("dd/MM/yyyy hh:mm")
                        </td>
                        <td align="center">
                            @item.LastActivityDate.ToString("dd/MM/yyyy hh:mm")
                        </td>
                        <td align="center">
                            @if (item.IsOnline)
                            {
                                <img alt="" src="/Administrator/Images/online.png" />
                            }
                            else
                            {
                                <img alt="" src="/Administrator/Images/offline.png" />
                            }

                        </td>
                        <td align="center">
                            @if (item.IsApproved)
                            {
                                <input type="checkbox" onclick="return setApprove('@item.UserName    ');"  checked="checked"  class="chkApprove" /> 
                            }
                            else
                            {
                           
                                <input type="checkbox"   onclick="return setApprove('@item.UserName    ');" class="chkApprove" />                                                                                               
                            }
                        </td>
                        <td class="alt">
                            <a onclick="return userdelete('@item.UserName');" href='javascript:void(0);'>Xóa</a>
                        </td>
                    </tr>
                }


            </tbody>
        </table>
        <div class="clr">
        </div>
    </div>
    <div class="b">
        <div class="b">
            <div class="b">
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function userdelete(username) {
        if(confirm("Bạn có chắc chắn muốn xóa người dùng này không?"))
        {
            $.post('@Url.Action("UserDelete", "System")', { "username": username },
                function (data) {
                    if(data=="1")
                    {
                        $("#tr_"+username).hide();
                    }
                    else
                    {

                    }
                });
        }
    }
    function setApprove(username) 
    {
        if(confirm("Bạn có chắc chắn muốn kích hoạt/bỏ kích hoạt người dùng này không?"))
        {
            $.post('@Url.Action("UserAppproved", "System")', { "username": username },
                function (data) {
                    alert(data);
                });
        }
    }
</script>
