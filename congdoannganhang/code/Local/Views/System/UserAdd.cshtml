@{
   
    Layout = "~/Views/Shared/_Admin.cshtml";
    
}
@using BIZ
@using UTILS
@using Local.Helper
@model String[]


<div id="toolbar-box">
    <div class="t">
        <div class="t">
            <div class="t">
            </div>
        </div>
    </div>
    <div class="m">
        <div class="toolbar" id="toolbar">
            <table class="toolbar">
                <tr>
                  <td id="toolbar-save" class="button">
                            <a href="javascript:void(0);" onclick="SubmitForm();" class="toolbar" id="lbtnUserEditSave"><span title="Save" class="icon-32-save"></span>Tạo mới</a>
                        </td>
                    <td class="button" id="toolbar-cancel">
                        <a href="javascript:void(0);" id="lbtnClose" onclick="Close();"><span title="Close" class="icon-32-cancel"></span>Đóng</a>
                    </td>
                </tr>
            </table>
        </div>
        <div class="header icon-48-user">
            Người dùng: <small><small>[Tạo mới]</small></small>
        </div>
        <div class="clr">
        </div>
    </div>
    <div class="b">
        <div class="b">
            <div class="b">
            </div>
        </div>
    </div>
</div>
<div class="clr">
</div>
<div id="element-box">
    <div class="t">
        <div class="t">
            <div class="t">
            </div>
        </div>
    </div>
    <div class="m">
        <div class="col width-45">

            <div class="clr">
            </div>
            <fieldset class="adminform">
                <legend>Thông tin chi tiết người dùng</legend>
                <table class="admintable" cellspacing="1">
                    <tr>
                        <td width="150" class="key">
                            <label for="username">
                                Tên đăng nhập
                            </label>
                        </td>
                        <td>

                            @Html.TextBox("UserName")
                        </td>
                    </tr>
                    <tr>
                        <td class="key">
                            <label for="password">
                                Mật khẩu
                            </label>
                        </td>
                        <td>
                            @Html.Password("NewPassword")

                        </td>
                    </tr>
                    <tr>
                        <td class="key">
                            <label for="password2">
                                Xác nhận mật khẩu
                            </label>
                        </td>
                        <td>
                            @Html.Password("ConfirmPassword")
                            
                        </td>
                    </tr>
                    <tr>
                        <td width="150" class="key">
                            <label for="email">
                                E-mail
                            </label>
                        </td>
                        <td>
                            @Html.TextBox("Email")

                        </td>
                    </tr>
                    @*<tr>
                            <td class="key">
                                Kích hoạt
                            </td>
                            <td>
                                <input type="checkbox" name="ActiveUser" id="chkActiveUser">
                            </td>
                        </tr>*@
                   
                   
                </table>
            </fieldset>
        </div>
        <div class="col width-55">
            <fieldset class="adminform" style="width: 180px !important;">
                <legend>Vai trò</legend>
                <table class="admintable">
                    <tr>
                        <td>
                            <span class="note">
                                <table id="ctl00_ContentPlaceHolder1_chklUserRoles" border="0">

                                    @foreach (string role in Model)
                                    {
                                         <tr>
                                             <td>
                                           
                                            
                                                <input type="checkbox"  value="@role" name ="chkRole" class="chkRole" />  @role
                                           
                                                 </td>
                                        </tr>
                                    }
                                </table>
                            </span>
                        </td>
                    </tr>
                </table>
            </fieldset>
        </div>
        <div class="clr">
        </div>
    </div>
    <div class="b">
        <div class="b">
            <div class="b">
            </div>
        </div>
    </div>
</div>



<script type="text/javascript">
    function Close() {
        window.location.href = "@Url.Action("Users","System")";
    }
    

    function SubmitForm() {
       
        if (confirm("Bạn có chắc chắn muốn tạo mới người dùng")) {
            validateForm();
            var Username = $('#UserName').val();
            var NewPassword = $('#NewPassword').val();
            var Email = $('#Email').val();
            
            var roles = "";
            var lstrole = $('input[type="checkbox"][name="chkRole"]:checked');
            $.each(lstrole, function (i, role) {

                roles += $(role).val()+"|";

            });
            $.post('@Url.Action("UserAdd", "System")',
                {
                    "username": Encoder.urlEndcode(Username),
                    "newPassword": Encoder.urlEndcode(NewPassword),
                    "email": Encoder.urlEndcode(Email),
                    
                    "lstrole": Encoder.urlEndcode(roles)
                },
                function (data) {
                    if (data == "1") {
                        Close();
                    }
                    else {
                        alert(data);
                    }
                    
                });

        }
    }
    function validateForm() {
        var Username = $('#Username').val();
        var NewPassword = $('#NewPassword').val();
        var ConfirmPassword = $('#ConfirmPassword').val();
        var Email = $('#Email').val();
        if (Username == "") {
            alert('Tên không được trống');
            $('#Username').focus();
            return false;
        }
        if (Email == "") {
            alert('Tên không được trống');
            $('#Email').focus();
            return false;
        }
        if (NewPassword == "") {
            alert('Mật khẩu không được trống');
            $('#NewPassword').focus();
            return false;
        }
        if (NewPassword.length < 6) {
            alert('Mật khẩu phải trên 6 kí tự');
            $('#NewPassword').focus();
            return false;
        }
        if (NewPassword != ConfirmPassword) {
            alert('Mật khẩu không hợp lệ');
            $('#ConfirmPassword').focus();
            return false;
        }

        return true;

    }
</script>