@{
   
    Layout = "~/Views/Shared/_Admin.cshtml";
    
}
    <div id="toolbar-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m">
            <div class="toolbar" id="toolbar">
            </div>
            <div class="header icon-48-addedit">
                Thiết lập hệ thống
            </div>
            <div class="clr">
            </div>
        </div>
        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
    <div class="clr">
    </div>
    <div id="element-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m" id="all_item_info_container">
            <div id="jalert_notification">
                &nbsp;</div>
            <div class="col width-30">
                <fieldset>
                    <legend>Thiết lập cache</legend>
                    <table class="admintable" cellspacing="1">
                        <tr>
                            <td width="100%">
                                <input id="btnFlushCache" type="button" value="Xóa toàn bộ cache" onclick="SetCache('flush')" />
                            </td>
                        </tr>
                        <tr>
                            <td width="100%">
                                <input id="Button1" type="button" value="Xóa cache chuyên mục" onclick="SetCache('category')" />
                            </td>
                        </tr>
                        <tr>
                            <td width="100%">
                                <input id="Button2" type="button" value="Xóa cache sản phẩm" onclick="SetCache('product')" />
                            </td>
                        </tr>
                        <tr>
                            <td width="100%">
                                <input id="Button3" type="button" value="Xóa cache bài viết" onclick="SetCache('article')" />
                            </td>
                        </tr>
                         <tr>
                            <td width="100%">
                                <input id="Button4" type="button" value="Xóa cache album ảnh" onclick="SetCache('album')" />
                            </td>
                        </tr>
                        <tr>
                            <td width="100%">
                                <input id="Button5" type="button" value="Xóa cache bình luận" onclick="SetCache('comment')" />
                            </td>
                        </tr>
                    </table>
                </fieldset>
            </div>
           
            <div class="clr">
            </div>
        </div>
        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        function SetCache(method) {
            $.Services({
                isCrossDomain: false,
                url: POST_URL + 'SystemService.ashx',
                data: {
                    __m: method
                }
            });
        }

        function SaveAppSettings() {

            var postData = [];
            var values = '';

            $('#appSettingsCont').find('input[name="appSettings"]').each(function (i, e) {

                values = $(e).attr('id') + '|' + $(e).val();
                postData.push(values);
            });

            $('#appSettingsCont').find('textarea').each(function (i, e) {

                values = $(e).attr('id') + '|' + $(e).val();
                postData.push(values);
            });

            $.Services({
                isCrossDomain: false,
                url: POST_URL + 'SystemService.ashx',
                data: {
                    __m: 'save_appsettings',
                    'data[]': postData
                }
            });

        }

        </script>