@using BIZ
@using UTILS
@using Local.Helper
@{
    
    Layout = "~/Views/Shared/_Admin.cshtml";
}
@model List<DATA.ContentLog>


<script type="text/javascript" language="javascript">
    


</script>

<div id="content-box">
    <div class="border">
        <div class="padding">

            <div class="clr">
            </div>
            <div class="clr">
            </div>
            <div id="element-box">
                <div class="t">
                    <div class="t">
                        <div class="t">
                        </div>
                    </div>
                </div>
                <div class="m">
                    <div id="filepanel" style="display: block;">
                        <div style="margin-left: 10px;">
                            <label>@ViewBag.ItemName</label><br />
                            <br />
                            
                        </div>
                        <br />
                        <div style="width: 100%; height: 538px; overflow-y: scroll; display: block;">
                            <table class="adminlist" cellpadding="1">
                                <thead>
                                    <tr>
                                        <td align="center" width="1%"></td>
                                        <td align="center" width="15%">UserName
                                        </td>
                                        <td align="center" width="25%">Hành động
                                        </td>
                                        <td align="center" width="15%">Thời gian
                                        </td>
                                        

                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <td colspan="8"></td>
                                    </tr>
                                </tfoot>
                                @if (Model != null)
                                {

                                    foreach (var item in Model)
                                    {
                                    <tr id="tr_@item.UserName">
                                        <td align="center" width="1%"></td>
                                        <td align="center" width="15%">
                                            @item.UserName
                                        </td>
                                        <td align="center" width="25%">
                                            @item.Note
                                        </td>
                                        <td align="center" width="15%">
                                            @item.CreateTime.Value.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                       
                                    </tr>
                                             
                                    }

                                }

                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="b">
                <div class="b">
                    <div class="b">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



