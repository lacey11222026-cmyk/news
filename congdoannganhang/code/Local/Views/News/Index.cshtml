@using BIZ
@using UTILS
@using Local.Helper
@model Local.Models.NewsModel
@if (Model != null)
{
    if (Model.listdata!=null)
    {
    <div class="n_border i_content_bottom">
        @{ Html.RenderAction("Breadcrumb", "News", new { CategoryId = ViewBag.CategoryId }); }
        <div class="noidung">
            <div class="pad7">
                <ul class="listbc">

                    @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                    {
                        <li><a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")"
                                   title="@item.value.Title">@item.value.Title
                        </a></li>
                    }
                </ul>
                <div class="clear"></div>
            </div>
            <div class="clear"></div>
        </div>
        <div class="ctpaging">

            <ul class="paging">
                @{ Html.RenderPartial("Pagination", new Local.Models.PaginationInfo
                                                            {
                                                                PageUrl = Url.SetParameter("Page", "!0"),
                                                                CurrentPage = Model.pageIndex,
                                                                PageSize = Model.pageSize,
                                                                TotalItemCount = Model.total,
                                                            }); }
            </ul>

        </div>
        <div class="clear"></div>
    </div>
    }


}
