@using BIZ.Entity
@using UTILS
@model List<DOCUMENT_FULL>
@using Local.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            @*<th>ID</th>*@
            <th>Mã</th>
            <th class="texttable">Tên tài liệu</th>
            <th class="hidemobile">Chuyên mục</th>
            @*<th>File đính kèm</th>*@
            <th class="hidemobile">
                Người tạo
            </th>
            @*<th class="hidemobile">
                Ngày tạo
            </th>*@
            <th >
                Ngày ban hành
            </th>
            @*<th class="hidemobile">
                Ngày có hiệu lực
            </th>
            <th class="hidemobile">
                Ngày hết hiệu lực
            </th>*@
            <th class="hidemobile">
                Cơ quan ban hành
            </th>
            <th class="hidemobile">
                Người ký
            </th>
           
            <th>Trạng Thái</th>
            <th>Thao Tác</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>
                @*<td>@obj.Id</td>*@
                <td>@obj.Code</td>
                <td class="texttable" style="text-align:left;min-width:150px;" >
                    <a href="@Url.Action("GetDocumentDetail",new {id=obj.Id })" title="Edit">@obj.Name</a>
                </td>
                <td class="hidemobile">@HtmlHelpers.GetNewsCategoryName(obj.CategoryId, ViewBag.CategoryList)</td>
                @*<td>@obj.FileName</td>*@
                <td class="hidemobile">@obj.CreatedBy</td>
                @*<td class="hidemobile">@HtmlHelpers.GetDateDocument(obj.CreatedDate)</td>*@
                <td>@HtmlHelpers.GetDateDocument(obj.PublishDate)</td>
                @*<td class="hidemobile">@HtmlHelpers.GetDateDocument(obj.EffectiveDate)</td>
                <td class="hidemobile">@HtmlHelpers.GetDateDocument(obj.ExpiryDate)</td>*@
                <td class="hidemobile" style="text-align:left;">@obj.SignedByDesc</td>
                <td class="hidemobile" style="text-align:left;">@obj.SignedBy</td>
                <td>
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatus('@Utils.Base64Encode(obj.Id)', 1,'@obj.Name');"><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatus('@Utils.Base64Encode(obj.Id)',0,'@obj.Name');"><i class="fa fa-ban"></i></a>

                    }
                </td>

                <td style="text-align: center">
                    <a href="javascript:;" title="Delete" onclick="DeleteData('@Utils.Base64Encode(obj.Id)','@obj.Name')"><i class="fa fa-trash-o"></i></a>

                </td>

            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            title: $("#txtTitle").val(),
            fromdate: $("#fromDate").val(),
            todate: $("#toDate").val(),
            status: $('#ddlStatus :selected').val(),
            cateId: $('#ddlCate :selected').val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListDocument")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListDocument").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });

    function DeleteData(id,title) {
       
        bootbox.confirm("Bạn chắc chắn muốn xóa văn bản này ??? ", function (result) {
            if (result == true) {
                var postdata= {
                    '_id': id,
                    'Title': title,
                };
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url:"@Url.Action("Delete")",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
    function UpdateStatus(id, status,title) {
        var type = "Khóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " văn bản này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                var postdata = {
                    '_id': id,
                    'Title': title,
                };
                $.ajax({
                    type: 'POST',
                    url:"@Url.Action("UpdateStatus")",
                    data: addAntiForgeryToken(postdata),
                   
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
</script>
<script>
    $("#qnmb").remove();
</script>