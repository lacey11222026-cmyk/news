            <table width="100%">
                <tr>
                    <td>
                        Tên bài viết:
                        <input id="txt_filterbyname" type="text" style="width: 250px;" />
                        <input id="btn_search" type="button" value="Lọc" onclick="Filter(1);" />
                        <input id="btn_clear" type="button" value="Làm lại" onclick="Reset();" />
                    </td>
                    <td nowrap="nowrap">
                        Chuyên mục:
                        <select id="select_filterbycategory" onchange="Filter(1);">
                        </select>&nbsp;&nbsp;&nbsp;&nbsp; Trạng thái
                        <select id="select_filterbytype" onchange="Filter(1);">
                            @*<option value="1,2,3,4">--Tất cả--</option>
                            <option value="1">Đang biên tập</option>
                            <option value="2">Đợi xuất bản</option>
                            <option value="3">Biên tập lại</option>
                            <option value="4">Xuất bản</option>*@
                        </select>
