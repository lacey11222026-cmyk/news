<script type="text/javascript">
    var redirectUrl = '@Url.Action("AddEdit", "Contact")';
    var page_index = 1;
    var page_size = 100;

    $(document).ready(function () {

        BindCategoriesToSelectBox();
        OnLoad();
    });
    $('#select_filterbycategory').change(function () {
        window.location = jQuery.query.set("Id", this.value);
    });
    function OnLoad() {

        Filter();
    }
    function SendSMS() {
        var arr_checked_items = [];
        $('input[type="checkbox"][name="chk_item"]:checked').each(function (i, e) {
            arr_checked_items.push($(e).attr('Title'));
        });
        var content = $.trim(Encoder.urlEndcode($('#txtContent').val()));
        if (arr_checked_items.length > 0) {
            var confirmFunc = function () {

                $.Services({
                    isCrossDomain: false,
                    url: POST_URL + 'ContactService.ashx',
                    data: {
                        __m: "send_listsms",
                        content: content,
                        'phone': arr_checked_items
                    },
                    success: function (data) {
                        if (data != undefined && data != null && data != '') {
                            var json_data = eval('(' + data + ')');

                            if (json_data.Success) {

                                var jalert_type = "info";

                                $('#jalert_notification').jAlert(json_data.Text, jalert_type, "edit", 400);
                            }

                        }
                    }
                });
            };

            OpenConfirmDialog('Bạn có muốn gửi sms không ?', confirmFunc);

        }
        else {
            $('#jalert_notification').jAlert('Bạn phải chọn ít nhất 1 sản phâm ', "warning", "edit", 400);
        }
    }
    function BindCategoriesToSelectBox() {

        $('#select_filterbycategory').html('<option value="0">- Tất cả  -</option>');
        $.Services({
            serviceName: 'CategoryService.ashx',
            data: {
                __m: 'get_all_categories',
                ctype: 6
            },
            success: function (data) {
                html = '';
                if (data != undefined && data != null && data != '') {
                    $.each(data, function (i, item) {
                        if (i > 0) {
                                
                            html = '<option value="' + item.Id + '">';
                            if (item.NodeLevel != 0) {
                                html += "";
                                for (var i = 1; i < item.NodeLevel; i++) {
                                    html += '-+&nbsp;';
                                }
                            }

                            html += item.Name;
                            html += '</option>';
                            if (item.ParentId != 0) {
                                if ($('#select_filterbycategory option[value=' + item.ParentId + ']').length)
                                    $('#select_filterbycategory option[value=' + item.ParentId + ']').after(html);
                                else
                                    $('#select_filterbycategory').append(html);
                            }
                            else
                                $('#select_filterbycategory').append(html);
                        }
                            
                    });
                    var categoryId = @ViewBag.Id;
                    $('#select_filterbycategory option[value=' + categoryId + ']').attr('selected', 'selected');
                }

            }
        });
    }
    function Filter() {
        // var categoryid = $('#select_filterbycategory option:selected').val();
        var categoryid = @ViewBag.Id;
            var status = $('#select_filterbystatus option:selected').val();

            $.Services({
                element: $('#grid_items'),
                loadingImg: '<tr><td colspan="7">Đang tải dữ liệu ...</td><tr>',
                serviceName: 'ContactService.ashx',
                data: {
                    __m: 'get_contacts_bycategory',
                    cid: categoryid,
                    status: status
                },
                success: function (data) {
                    var html = '<tr><td colspan="7">Không có dữ liệu</td><tr>';
                    if (data != undefined && data != null && data != '') {
                        var items = data;
                        html = BindData(items);
                    }

                    $('#grid_items').html(html);
                }

            });
        }

        function BindData(data) {
            var html = '';
            $.each(data, function (index, item) {
                html += '<tr id="item' + item.Id + '">';
                html += '<td align="center">';
                html += '<input type="checkbox" name="chk_item" value="' + item.Id + '" title="' + item.Mobile + '" />';
                html += '</td>';

                html += '<td>';
                html += '<a href="' + redirectUrl + '?id=' + item.Id + '" alt="' + item.Name + '">';
                html += item.Name;
                html += '</a>';
                html += '</td>';
                html += '<td>';
                html += item.CategoryName;
                html += '</td>';
                html += '<td>';
                html += item.Role;
                html += '</td>';
                html += '<td>';
                html += item.Mail;
                html += '</td>';
                html += '<td>';
                html += item.Mobile;
                html += '</td>';

                html += '<td align="center">';
                if (item.Published == 1)
                    html += "Hoạt động";
                else
                    html += "Khóa";
                html += '</td>';
                html += '</tr>';
            });

            return html;
        }





        function New() {
            window.location.href = redirectUrl;
        }

        function Delete() {
            var arr_checked_items = [];
            $('input[type="checkbox"][name="chk_item"]:checked').each(function (i, e) {
                arr_checked_items.push($(e).val());
            });

            if (arr_checked_items.length > 0) {
                var confirmFunc = function () {

                    $.Services({
                        isCrossDomain: false,
                        url: POST_URL + 'ContactService.ashx',
                        data: {
                            __m: "delete",
                            'id': arr_checked_items
                        },
                        success: function (data) {
                            if (data != undefined && data != null && data != '') {
                                var json_data = eval('(' + data + ')');

                                if (json_data.Success) {

                                    OnLoad();
                                }
                                var jalert_type = "info";
                                if (!json_data.Success)
                                    jalert_type = "fatal";
                                else {
                                    $.each(arr_checked_items, function (index, item) {
                                        $("grid_items").find('tr#item' + item).hide();
                                    });

                                }
                                $('#jalert_notification').jAlert(json_data.Text, jalert_type, "edit", 400);
                            }
                        }
                    });
                };

                OpenConfirmDialog('Bạn có muốn xóa sản phẩm này không ?', confirmFunc);

            }
            else {
                $('#jalert_notification').jAlert('Bạn phải chọn ít nhất 1 sản phâm ', "warning", "edit", 400);
            }
        }


        



        function checkAll(obj1) {

            $('input[type="checkbox"][name="chk_item"]').each(function (i, e) {

                if (obj1.checked == true) {
                    $(e).removeAttr('checked');
                    $(e).attr('checked', 'checked');
                }
                else {
                    $(e).removeAttr('checked');

                }


            });


        } 
       
</script>
