@using BIZ
@using UTILS
@using Local.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
   <span class="hot_new">TIN MỚI:</span>
   <marquee class="hot" width="620" direction="Left" onmouseover="this.stop()" onmouseout="this.start()"
    scrolldelay="200" scrollamount="10" align="center">
         @foreach (var item in Model.Select((value, i) => new { i, value }))
         {
             <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "ArticleDetail")"
                                                        title="@item.value.Title">@item.value.Title
                        </a>
         }
      </marquee>

    }

}