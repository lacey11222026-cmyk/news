@using BIZ
@using UTILS
@using Local.Helper
@model List<BIZ.Entity.CATEGORY_FULL>

<nav class="vitri2">
    <ul>
        <li><a href="http://vnubw.org.vn" target="_blank">Trang chủ</a></li>
        <li><a href="/" >Trang chủ nội bộ</a></li>
        <li><a href="http://webmail.vnubw.org.vn/" target="_blank">Thư điện tử</a></li>
        @if (Model != null)
        {

            if (Model.Count > 0)
            {
                foreach (var item in Model.Select((value, i) => new { i, value }))
                {
            <li><a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name</a></li> 
               
                }
            }
        }

    </ul>
</nav>
<div class="clear"></div>



