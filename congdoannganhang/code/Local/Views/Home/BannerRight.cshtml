@model List<DATA.Banner>
@if (Model != null)
{
    <div class="padtop">
        <div class="qc">
             @foreach (var item in Model.Select((value, i) => new { i, value }))
        {
            <a href="@item.value.Url" rel="nofollow">
                <img width="270" src="@item.value.Data" alt="@item.value.Name" /></a>
        }
           
        </div>
    </div>
}