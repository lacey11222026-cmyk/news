@model List<BIZ.Entity.TestRegister_Full>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<div class="menu wow bounceInDown center">
    @*<div class="wrapper">
        <img src="/Content2/images/name-small.png" alt="cuộc thi nét đẹp văn hóa ngàng ngân hàng" class="name float-left">
    </div>*@
</div>
<div class="screen2">
    <div class="container">
        <div class="screen2-content">
            <ul class="row qaa-list d-flex justify-content-center">
                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
                    if (item.i == 0)
                    {
                        <li class="col-lg-4 col-md-4 qaa-item " >
                            <p id="group_@(item.i+1)" rel="@item.value.Id">Bộ câu hỏi <span>Số @(item.i+1)</span></p>
                        </li>
                    }

                    if (item.i == 1)
                    {
                        <li class="col-lg-4 col-md-4 qaa-item " >
                            <p id="group_@(item.i+1)" rel="@item.value.Id">Bộ câu hỏi <span>Số @(item.i+1)</span></p>
                        </li>
                    }
                    if (item.i == 2)
                    {
                        <li class="col-lg-4 col-md-4 qaa-item " >
                            <p id="group_@(item.i+1)" rel="@item.value.Id">Bộ câu hỏi <span>Số @(item.i+1)</span></p>
                        </li>
                    }
                    if (item.i == 3)
                    {
                        <li class="col-lg-4 col-md-4 qaa-item " >
                            <p id="group_@(item.i+1)" rel="@item.value.Id">Bộ câu hỏi <span>Số @(item.i+1)</span></p>
                        </li>
                    }
                    if (item.i == 4)
                    {
                        <li class="col-lg-4 col-md-4 qaa-item " >
                            <p id="group_@(item.i+1)" rel="@item.value.Id">Bộ câu hỏi <span>Số @(item.i+1)</span></p>
                        </li>
                    }
                    if (item.i == 5)
                    {
                        <li class="col-lg-4 col-md-4 qaa-item " >
                            <p id="group_@(item.i+1)" rel="@item.value.Id">Bộ câu hỏi <span>Số @(item.i+1)</span></p>
                        </li>
                    }
                    if (item.i > 5)
                    {
                        <li  class="col-lg-4 col-md-4 qaa-item " >
                            <p id="group_@(item.i+1)" rel="@item.value.Id">Bộ câu hỏi <span>Số @(item.i+1)</span></p>
                        </li>
                    }
                }

            </ul>

        </div>
    </div>
</div>
<div class="tbl-s2 wow bounceInUp center">
    <table>
        <tr>
            <td class="line-top"></td>
            <td class="line-text container">
                <div>
                    <img src="/Content2/images/text-phanthi-small.png">
                </div>
            </td>
            <td class="line-bottom"></td>
        </tr>
    </table>
</div>

<script>
    $(".qaa-item").hide();
    $(".qaa-item").show(700);

    function getRandomInt(min, max) {
        min = Math.ceil(min);
        max = Math.floor(max);
        return Math.floor(Math.random() * (max - min) + min); //The maximum is exclusive and the minimum is inclusive
    }
    $(document).keydown(function (event) {
        //proper indentiation of keycode and which to be equal to 13.
        console.log(event.which);
        switch (event.which) {
            case 49:
                event.preventDefault();
                goToQuestion(1);
                break
            case 50:
                event.preventDefault();
                goToQuestion(2);
                break;
            case 51:
                event.preventDefault();
                goToQuestion(3);
                break;
            case 52:
                event.preventDefault();
                goToQuestion(4);
                break;
            case 53:
                event.preventDefault();
                goToQuestion(5);
                break;
            case 54:
                event.preventDefault();
                goToQuestion(6);
                break;
            case 55:
                event.preventDefault();
                goToQuestion(7);
                break;
            case 56:
                event.preventDefault();
                goToQuestion(8);
                break;
            case 72:
                event.preventDefault();
                window.location = "/Event";
                break;
        }

        //call function, trigger events and everything tou want to dd . ex : Trigger the button element with a click


    });
    function goToQuestion(index) {
        var ran = getRandomInt(1, 8);
        
        for (var i = 1; i < 9; i++)
        {
            if (i != ran) {
                $("#group_" + i).hide(1000);
            }
        }
        
        var id = $("#group_" + index).attr("rel");
        setTimeout(function () {
            window.location = "/Event/Question/?Id=" + id;
        }, 3000);
        
    }
    //localStorage.removeItem('as1');
    //localStorage.removeItem('as2');
    //localStorage.removeItem('as3');
</script>
