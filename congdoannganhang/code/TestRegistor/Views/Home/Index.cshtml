                        <li>Bước 2: Click vào banner/pop-up cuộc thi</li>
                    </ul>
                </div>
            </div>
        </div>
    </div><!-- end content 2-->
    <div class="screen04-content-03 pt60 pb60">
        <div class="container">
            <div class="text-center"><h2 class="title-cm"><i class="icon-giaithuong"></i>Cơ cấu giải thưởng</h2></div>
            <div class="row mt20">
                <div class="col-lg-4 col-md-6 col-sm-12 wow bounceInLeft" data-wow-duration="1s">
                    <div class="item-ittle">
                        <img src="/Content/images/icon-user-02.png" alt="">
                    </div>
                    <div class="item-content">
                        <p class="textblue">- Mỗi kỳ <span>10</span> giải thưởng</p>
                        <p class="textblue mt-2">- Giá trị giải thưởng: <span>1.000.000</span>đ/giải + Giấy chứng nhận của Công đoàn NHVN.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12 wow bounceInLeft" data-wow-duration="1.5s">
                    <div class="item-ittle">
                        <img src="/Content/images/icon-user-03.png" alt="">
                    </div>
                    <div class="item-content">
                        <p class="textblue">- <span>03</span> giải tập thể cho 03 đơn vị có số lượng người tham gia nhiều nhất.</p>
                        <p class="textblue mt-2">- Giá trị giải thưởng: <span>5.000.000</span>đ/giải + Bằng khen của Ban chấp hành Công đoàn NHVN.</p>
                    </div>
                </div>
            </div>
            <div class="text-center">
                <img src="/Content/images/img-01.png" alt="" width="300">
            </div>
        </div>
    </div><!-- end content 3-->
    <div class="screen04-content-04">
        <div class="container">
            <div class="qr-box">
                <div class="qr-title"><img src="/Content/images/title-02.png" alt=""></div>
                <div class="qr-code">
                    <img src="/Content/images/qr.png" alt="" width="200">
                </div>
            </div>
        </div>
    </div><!-- end content 4-->
</div><!-- end main content-->


<footer>
    <p class="container font-weight-bold textblue">Bản quyền thuộc <a href="/"><img src="/Content/images/logo.png" alt="" style="width: 400px; max-width: 85%; display: inline-block;margin-left: 20px;"></a></p>
</footer>

<script>

    function JoinTest(id) {
        bootbox.confirm("Bạn muốn tham dự cuộc thi này?",
            function(result) {
                if (result === true) {
                    var postdata = {
                        'id': id

                    };
                    ShowProgress();
                    $.ajax({
                        type: 'POST',
                        url: "@Url.Action("Start")",
                        data: postdata,
                        success: function(data) {
                            HideProgress();
                            if (data.ResponseCode >= 0) {
                                window.location.href = '@Url.Action("Exam")';

                                return;
                            } else {
                                if (data.ResponseCode === -101) {
                                    window.location.href = '@Url.Action("Logon")';
                                    return;
                                }
                                //Kết quả
                                if (data.ResponseCode === -102) {
                                    window.location.href = '@Url.Action("ResultExam")?id=' + id;
                                    return;
                                }
                                bootbox.alert(data.Description);
                                return;
                            }
                        }
                    });
                }
            });
    }
</script>


@if (!String.IsNullOrEmpty(ViewBag.Test))
{
    <script>
        //return;
         var postdata = {
