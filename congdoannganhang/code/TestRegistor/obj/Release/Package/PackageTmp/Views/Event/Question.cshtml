@using UTILS;
@model BIZ.Entity.TestQuestion_Full
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<div class="menu">
    @*<div class="wrapper">
        <img src="/Content2/images/name-small.png" alt="cuộc thi nét đẹp văn hóa ngàng ngân hàng" class="name float-left">
    </div>*@
</div>
<div class="screen3">
    <div class="wrapper">
        <div class="row">
            <div class="col-lg-5 col-md-4">
                <div class="num-box">
                    <ul>
                        <li class="wow slideInLeft @(1 == ViewBag.Index ? "active" : "")" data-wow-delay="0.2s">
                            <p>Câu<span>1</span></p>
                        </li>
                        <li class="wow slideInLeft @(2 == ViewBag.Index ? "active" : "")" data-wow-delay="0.4s">
                            <p>Câu<span>2</span></p>
                        </li>
                        <li class="wow slideInLeft @(3 == ViewBag.Index ? "active" : "")" data-wow-delay="0.5s">
                            <p>Câu<span>3</span></p>
                        </li>
                        <li class="wow slideInLeft @(4 == ViewBag.Index ? "active" : "")" data-wow-delay="0.6s">
                            <p>Câu<span>4</span></p>
                        </li>
                        <li class="wow slideInLeft @(5 == ViewBag.Index ? "active" : "")" data-wow-delay="0.7s">
                            <p>Câu<span>5</span></p>
                        </li>


                    </ul>
                </div>
                <div id="DivContent" class="faq-content wow bounceInDown center" style="display:none" data-wow-duration="2.0s" data-wow-delay="0.4s">
                    @Html.Raw(Model.Contents)
                </div>



            </div>
            <div class="col-lg-7 col-md-7">
                <ul id="an1">

                    @foreach (var itemA in Model.AnswersInfo.Select((value, i) => new { i, value }))
                    {

                        <li class="btn-faq wow slideInDown" id="A@(itemA.i+1)" style="display:none" data-wow-delay="0.2s">
                            <div class="btn-faq-info">
                                <div class="btn-faq-info">
                                    <p>@Utils.IntToLetters(itemA.value.Order)</p>
                                    <p>@itemA.value.Name</p>
                                </div>
                            </div>
                        </li>

                    }


                </ul>
                <ul id="an2" style="display:none">

                    @foreach (var itemA in Model.AnswersInfo.Select((value, i) => new { i, value }))
                    {

                        if (itemA.value.IsCheck)
                        {
                            <li class="btn-faq active wow fadeIn" data-wow-duration="1s"  data-wow-iteration="3">
                                <div class="btn-faq-info">
                                    <p>@Utils.IntToLetters(itemA.value.Order)</p>
                                    <p>@itemA.value.Name</p>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="btn-faq">
                                <div class="btn-faq-info">
                                    <p>@Utils.IntToLetters(itemA.value.Order)</p>
                                    <p>@itemA.value.Name</p>
                                </div>
                            </li>
                        }



                    }



                </ul>
            </div>
        </div>



    </div>

</div>
<div style="display:none">

    <audio controls="controls" id="myaudio">
        <source src="~/Content2/video/chucmung.mp3" type="audio/mpeg" />
    </audio>
</div>

