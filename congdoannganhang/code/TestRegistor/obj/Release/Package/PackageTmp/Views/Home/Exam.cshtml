@using UTILS;
@model List<BIZ.Entity.TestQuestionArchive>


<div class="maincontent screen03-content pt60 container">
    <h1><img src="/Content/images/title.png" alt="" class="question-title"></h1>
    <div class="question-info">
        <div class="wow fadeInDown" data-wow-offset="100">
            <div class="time-content btn btn-orange">
                <span class="time-ico"></span>
                <p>Thời gian còn lại <span class="text-bold" id="time"> </span></p>
            </div>
        </div>
        <input type="hidden" id="hdIndex" value="1" />
        <div id="DivQuestion">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                if (item.i == 0)
                {
                    <div class="question-content" id="questionitem-@(item.i+1)">

                        <h3 class="textgreen question-num mt30 wow bounceInLeft" data-wow-offset="100">Câu số <strong>@(item.i + 1)/@ViewBag.NumberQuestion</strong> </h3>
                        <div class="textblue font-weight-bold mt10 wow bounceInLeft" data-wow-offset="100">
                            @Html.Raw(item.value.Contents)
                        </div>
                        <div class="answer mt30">
                            <form action="" class="lb_question">
                                @if (item.value.Type == 1)
                                {
                                    foreach (var itemA in item.value.AnswerArchiveInfo.Select((value, i) => new { i, value }))
                                    {
                                        <label class="textblue"><input type="radio" name="anwswer_@(item.i)" value="@itemA.value.Order"> <span onclick="return selectCard(this);">@itemA.value.Name</span></label><br>
                                    }
                                }
                                else
                                {
                                    foreach (var itemA in item.value.AnswerArchiveInfo.Select((value, i) => new { i, value }))
                                    {
                                        <label  class="textblue"><input type="checkbox" name="anwswer_@(item.i)" value="@itemA.value.Order"> <span onclick="return selectCard(this);">@itemA.value.Name</span></label><br>
                                    }
                                }

                            </form>
                            @if (item.i < Model.Count - 1)
                            {
                                <a  href="javascript:;" onclick="gotoQuestion(@(item.i+1),@(item.i+2));" class="btn btn-blue mt30 ">TIẾP THEO</a>

                            }
                            else
                            {
                                <a href="javascript:;"  onclick="saveGame();" class="btn btn-blue mt30">KẾT THÚC</a>
                            }

                        </div>
                    </div>

                }

            }
        </div>
    </div>
</div>
<footer class="bg-gradient-03">
    <p class="container">Bản quyền thuộc <strong>Công đoàn Ngân hàng Việt Nam</strong></p>
</footer>
<script>
    $('#body').addClass("question-bg");
</script>

<script language="JavaScript">
    $(window).bind('beforeunload', function () {
        return 'Are you sure you want to leave?';
    });

    $(document).on({
        "contextmenu": function (e) {
            console.log("ctx menu button:", e.which);

            // Stop the context menu
            e.preventDefault();
        },
        "mousedown": function (e) {
            console.log("normal mouse down:", e.which);
            // Stop the context menu
            e.preventDefault();
        },
        "mouseup": function (e) {
            console.log("normal mouse up:", e.which);
            // Stop the context menu
            e.preventDefault();
        }
    });
    // -->

    // Chặn tấn công CSRF (XSRF)
    function addAntiForgeryToken(data) {
        if (!data) {
            data = {};
        }
        var tokenInput = $('input[name=__RequestVerificationToken]');
        if (tokenInput.length) {
            data.__RequestVerificationToken = tokenInput.val();
        }
        return data;
    };
</script>
<script>


    //$('#questionitem-1').show("slow");
    function gotoQuestion(current,qnumber) {

        $.each($('.lb_question'), function (i, question) {
            var inputa = $(question).find("input");
            ans = ',';
            $.each($(inputa), function (ix, answer) {
                if ($(answer).is(":checked")) {

                    ans += $(answer).val() + ',';
                }

            });
            localStorage.setItem('as' + current, ans);

        });
        $('#hdIndex').val(qnumber);
        $.ajax({
            type: 'GET',
            url: "/Home/LoadExam/?index="+qnumber,

            success: function (data) {
                $("#DivQuestion").html(data);
                $('#numberquestiontitle').html(qnumber + ' / ' + '@ViewBag.NumberQuestion' + ' câu');
            },
            error: function () {

            }
        });

    }


</script>
<script>
    function saveGame2() {
        ShowProgress();
        var archive = '';
        var ans = '';

        for (var id = 1; id <=@(ViewBag.NumberQuestion); id++)
        {

            if (parseInt($('#hdIndex').val()) == id) {
                $.each($('.lb_question'), function (i, question) {
                    var inputa = $(question).find("input");
                    ans = ',';
                    $.each($(inputa), function (ix, answer) {
                        if ($(answer).is(":checked")) {
                            //alert($(answer).val());
                            ans += $(answer).val() + ',';
                        }

                    });

                    archive += ans + '|';
                });
            }
            else {
                var as = localStorage.getItem('as' + id, ans);
                if (as == null || as == undefined) {
                    archive += '|';
                }
                else {
                    archive += as + '|';
                }
            }

        }




        var postdata = {
            'result': archive

        };
        $.ajax({
            type: 'POST',
            url: "/Home/End",
            data: addAntiForgeryToken(postdata),
            success: function (data) {
                HideProgress();
                $(window).unbind('beforeunload');
                if (data.ResponseCode >= 0) {
                    window.location.href = "/Home/Result";

                    return;
                }
                else {
                    if (data.ResponseCode === -101) {
                        window.location.href = "/";
                        return;
                    }
                    //Kết quả
                    if (data.ResponseCode === -102) {
                        window.location.href = "/Home/Result";
                        return;
                    }
                    bootbox.alert(data.Description);
                    return;
                }
            }
        });



    }
    function saveGame() {
        bootbox.confirm("Bạn muốn kết thúc bài thi?", function (result) {
            if (result === true) {
                ShowProgress();
                var archive = '';

                for (var  i = 1; i <@(ViewBag.NumberQuestion); i++)
                {
                    archive += localStorage.getItem('as' + i, ans) + '|';
                }
                var ans = '';

                $.each($('.lb_question'), function (i, question) {
                    var inputa = $(question).find("input");
                    ans = ',';
                    $.each($(inputa), function (ix, answer) {
                        if ($(answer).is(":checked")) {
                            //alert($(answer).val());
                            ans += $(answer).val() + ',';
                        }

                    });

                    archive += ans + '|';
                });


                var postdata = {
                    'result': archive

                };
                $.ajax({
                    type: 'POST',
                    url: "/Home/End",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {
                        HideProgress();
                        $(window).unbind('beforeunload');
                        if (data.ResponseCode >= 0) {
                            window.location.href = "/Home/Result";

                            return;
                        }
                        else {
                            if (data.ResponseCode === -101) {
                                window.location.href = '/';
                                return;
                            }
                            //Kết quả
                            if (data.ResponseCode === -102) {
                                window.location.href = "/Home/Result";
                                return;
                            }
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });


    }
    function selectCard(obj) {

        var o = $(obj).parent().find("input");
        if (o.prop('checked')) {
            o.prop('checked', false);
        }
        else {
            o.prop('checked', true);
        }


    }
</script>
