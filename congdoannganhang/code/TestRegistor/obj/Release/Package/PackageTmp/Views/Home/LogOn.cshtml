@using UTILS;

@model List<DATA.TestLocation>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link href="//cdnjs.cloudflare.com/ajax/libs/select2/4.0.0/css/select2.min.css" rel="stylesheet" />
<script src="//cdnjs.cloudflare.com/ajax/libs/select2/4.0.0/js/select2.min.js"></script>
<style>

    .select2-container .select2-selection--single {
        height: 34px;
        border-radius: 12px;
    }
</style>
<script>

    $(document).ready(function () {
        $('.ddlLocation').select2({

        });
    });
</script>
<style>
    .select2-container {
        width:100% !important;
    }
</style>
<div class="maincontent screen02-content">
    <div class="container">
        <h1 data-wow-iteration="5" data-wow-duration="0.1s" class="wow shake"><img src="/Content/images/title-03.png" alt=""></h1>
        <div class="blue-box bg-gradient mt50 wow bounceInLeft">
            <div class="form-box">
                <lable>Họ và tên:</lable>
                <input type="text" id="txtFullname" class="form-control" placeholder="Mai Thu A">
            </div>
            <div class="form-box mt10">
                <lable>Số điện thoại:</lable>
                <input type="tel" value="@ViewBag.Mobile" id="txtMobile" class="form-control" placeholder="Nhập số điện thoại">
            </div>
            <div class="form-box mt10">
                <lable>Đơn vị:</lable>
                <select class="form-control ddlLocation" id="ddlLocation" >
                    <option value="">Chọn đơn vị</option>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var obj in Model)
                        {
                            if (obj.Name.Equals(ViewBag.Location))
                            {
                                <option value="@obj.Name" selected>@obj.Name</option>
                            }
                            else
                            {
                                <option value="@obj.Name">@obj.Name</option>
                            }

                        }
                    }
                </select>
            </div>
            <div class="form-box mt10">
                <lable>Ghi chú:</lable>
                <input type="text" id="txtNote" value="@ViewBag.Note" class="form-control" placeholder="Ghi rõ cơ quan công tác">
            </div>
            <div class="form-box">
                <p style="color: red;text-align: left; margin-top:10px;font-size:17px" id="msgBox"></p>
            </div>
            <div class="text-center"><a href="javascript:;" onclick="validateData()" class="btn-cm mt20">Đăng nhập</a></div>
        </div>
    </div>
</div>
<footer class="bg-gradient-03">
    <p class="container">Bản quyền thuộc <strong>Công đoàn Ngân hàng Việt Nam</strong></p>
</footer>

