<script>
    function validatePhone() {
        if (!ValidateControls("Vui lòng nhập số điện thoại !", "#txtMobile")) {
            return false;
        }

        var phone = $('#txtMobile').val();

        if (phone.length < 9 || phone.length > 12) {

            $("#msgBox").html("Số điện thoại không hợp lệ.").show();
            $('#txtMobile').focus();
            return false;
        }
        if (!isInteger(phone)) {

            $("#msgBox").html("Số điện thoại không hợp lệ.").show();

            $('#txtMobile').focus();
            return false;
        }
        return true;

    }

    function validateData() {

        if (!validatePhone()) {
            return false;
        }
        if (!ValidateControls("Vui lòng nhập họ và tên !", "#txtFullname", '#msgBox')) {
            return false;
        }
        if (!ValidateControls("Vui lòng nhập đơn vị !", "#ddlLocation", '#msgBox')) {
            return false;
        }

        if (!ValidateControls("Vui lòng nhập cơ quan công tác !", "#txtNote", '#msgBox')) {
            return false;
        }
        var param = {
            Mobile: $("#txtMobile").val(),
            FullName: $("#txtFullname").val(),
            Location: $("#ddlLocation").val(),
			 Role: 'person',
            Note: $("#txtNote").val(),
        };
        $.ajax({
            type: 'POST',
            url: "@Url.Action("LogOn")",
            data: addAntiForgeryToken(param),
            async: true,
            success: function (data) {

                if (data.success === true) {
                     location.href = '@Url.Action("Index")';
                } else {

                    $("#msgBox").text(data.msg).show();
                    return;
                }
            }
        });
    }

    
</script>
