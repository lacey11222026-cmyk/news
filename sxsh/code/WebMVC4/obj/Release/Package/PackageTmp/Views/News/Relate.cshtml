@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <h2 class="title-cm"><a href="@ViewBag.CategoryUrl">@Resources.Global.RelateNews</a></h2>
        <ul class="newshot row mt20">
            @foreach (var item in Model.Take(8).Select((value, i) => new { i, value }))
            {
                <li class="col-lg-3 col-sm-4 col-12">
                    <a href="@item.value.LinkUrl" class="newshot-item">
                        <img src="@item.value.MainImage2?w=280&h=160&mode=crop">
                        <span class="mt15">@item.value.Title</span>
                    </a>
                </li>
            }
            </ul>
       




    }


}