@model List<DATA.City>
@{
    Layout = "~/Views/Shared/_Home.cshtml";
}
<div class="ketqua-page container">
    <h2 class="title-detail"><a href="#">KẾT QUẢ TRIỂN KHAI</a></h2>
    <h3 class="title-blue02 mt40">Khu vực miền Bắc</h3>
    <ul class="ketqua-list">
        @foreach (var item in Model.Where(x => x.Type == 1).Select((value, i) => new { i, value }))
        {


            <li><a href="@Url.Action("ViewFile",  new {id = item.value.Id})">@item.value.Name</a></li>
        }
    </ul>
    <div class="clearfix"></div>
    <h3 class="title-blue02 mt40">Khu vực miền Trung</h3>
    <ul class="ketqua-list">
        @foreach (var item in Model.Where(x => x.Type == 2).Select((value, i) => new { i, value }))
        {


            <li><a href="@Url.Action("ViewFile",  new {id = item.value.Id})">@item.value.Name</a></li>
        }
    </ul>
    <div class="clearfix"></div>
    <h3 class="title-blue02 mt40">Khu vực miền Nam</h3>
    <ul class="ketqua-list">
        @foreach (var item in Model.Where(x => x.Type == 3).Select((value, i) => new { i, value }))
        {


            <li><a href="@Url.Action("ViewFile",  new {id = item.value.Id})">@item.value.Name</a></li>
        }
    </ul>
</div><!-- end main-->
