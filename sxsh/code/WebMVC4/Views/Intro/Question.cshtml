@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.QAModel


<div class="qaa-page container">
    <div class="row">
        <div class="col-lg-8 col-md-12 maxheight">
            <h3 class="title-detail03 mt10"><a href="#">@Resources.Global.FAQ</a></h3>
            <div class="qaa mt20">
                <div id="faq">
                    @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                    {
                        <div class="faq-item">
                            <button class="btn btn-link collapsed item-question" data-toggle="collapse" data-target="#collapse0@(item.i+1)" aria-expanded="true" aria-controls="collapse0@(item.i+1)">
                                @item.value.Question
                            </button>
                            <div id="collapse0@(item.i+1)" class="faq-content collapse" data-parent="#faq">
                                @Html.Raw(item.value.Answer)
                            </div>
                        </div>

                    }

                    
                </div>

            </div><!-- end qaa page-->

            <div class="pagination pull-right mt30">
                <ul>
                    @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                        {
                            PageUrl = Url.SetParameter("Page", "!0"),
                            CurrentPage = Model.pageIndex,
                            PageSize = Model.pageSize,
                            TotalItemCount = Model.total,
                        }); }
                </ul>
            </div>

        </div>
        <div class="col-lg-4 col-md-12 maxheight sidebar">
            @if (WorkContext.GetLanguage() == "vi-vn")
            {
                @Html.Partial("Site_Right")

            }
            else
            {
                @Html.Partial("Site_RightEn")
            }
        </div><!-- end side bar-->
    </div><!-- end row-->
</div><!-- end main-->




