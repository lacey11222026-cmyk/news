@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    <ul class="newshot row">
        @foreach (var item in Model.Skip(1).Select((value, i) => new { i, value }))
        {
            <li class="col-sm-4 col-xs-12">
                <a href="@item.value.LinkUrl" class="newshot-item">
                    <img src="@item.value.MainImage2?w=240&h=160&mode=crop">
                    <span class="mt15">@item.value.Title</span>
                </a>
            </li>
        }
    </ul>
}