@using BIZ
@using UTILS
@using DATA
@using WebMVC4.Helper
@model List<HotNews>
@if (Model != null)
{
    if (Model.Count > 0)
    {

        <ul class="tags-list">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
            <li>
                <a href="@item.value.Url"
                     title="@item.value.Title" @(item.value.IsBlank.GetValueOrDefault() == 1 ? " target='_blank'" : "")>
                    @item.value.Title
                </a>
            </li>
            }
        </ul>
       
    }

}
