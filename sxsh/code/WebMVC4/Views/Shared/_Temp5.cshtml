@using WebMVC4
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html>
<head>
    @Html.Partial("MetaData")




    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css?vs=1">
    <link rel="stylesheet" href="/css/extend.css?vs=11">




</head>
<body onorientationchange="updateOrientation();" class="temp-05">
    <!-- nav mobile --->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>

    @RenderBody()
    <footer class="mt40">
        <div class="nav_top">
            <div class="container">
                @{Html.RenderAction("MenuBottom", "Home", new { lang = "vi-vn" });}
            </div>
        </div>
        <div class="f-content">
            <div class="mt30 f-content container">
                @Html.Partial("Site_Footer")
            </div>
        </div><!-- end container-->
    </footer>
    <script type="">
        $(document).ready(function () {
            if ($('#backToTopBtn').length) {
                var scrollTrigger = 500, // px
                    backToTop = function () {
                        var scrollTop = $(window).scrollTop();
                        if (scrollTop > scrollTrigger) {
                            $('#backToTopBtn').addClass('shown');
                        } else {
                            $('#backToTopBtn').removeClass('shown');
                        }
                    };
                backToTop();
                $(window).on('scroll', function () {
                    backToTop();
                });
                $('#backToTopBtn').on('click', function (e) {
                    e.preventDefault();
                    $('html,body').animate({
                        scrollTop: 0
                    }, 700);
                });
            }
        });
    </script>
   
    <script src="/js/script.js" type="text/javascript"></script>
    <style>
        .nav_top nav li a {
            padding: 10px 9px;
        }
    </style>


    <script>

        (function (d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
            js = d.createElement(s); js.id = id;
            js.src = "//connect.facebook.net/vi_VN/sdk.js#xfbml=1&version=v2.8&appId=275786053207358";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));
    </script>
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-36352862-2"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
            dataLayer.push(arguments);
        }

        gtag('js', new Date());

        gtag('config', 'UA-36352862-2');
    </script>
</body>


</html>
