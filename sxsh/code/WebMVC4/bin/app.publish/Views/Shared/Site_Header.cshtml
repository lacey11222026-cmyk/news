@using UTILS
@using WebMVC4.Helper
@{
    var Date = Utils.formatDateofWeek(DateTime.Now.DayOfWeek) + ", " + DateTime.Now.ToString("dd/MM/yyy ") + "| " + DateTime.Now.ToString("HH:mm") ;

    var DateEN = DateTime.Now.DayOfWeek.ToString() + ", " + DateTime.Now.ToString("dd/MM/yyy ") + "| " + DateTime.Now.ToString("HH:mm") ;
}
@{
    var langpage = WorkContext.GetLanguage();
}
<div class="container tool mt10">

    @if (langpage == "vi-vn")
    {
        <p>@Date GMT+7</p>
    }
    else
    {
        <p>@DateEN GMT+7</p>
    }
    <div class="search-box-pc-small">
        <div class="search-box">
            <button class="search-icon" ></button>
            <input type="text" class="form-control">
        </div>
        @if (langpage == "vi-vn")
        {
            <a href="/Home/Language?lang=en-us"><img src="/Content/img/icon-en.png"></a>
        }
        else
        {
            <a href="/Home/Language?lang=vi-vn"><img src="/Content/img/icon-vn.png"></a>
        }
    </div>
</div>


<script type="text/javascript">
    function search() {
        var searchtext = $("#txtKeyword").val();
        window.location = "/News/Search?q=" + searchtext;

    }
    function AnyInput_KeyDown(sender, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            search();

            return false;
        }

        return true;
    }


    function Msearch() {
        var searchtext = $("#txtKeywordMobile").val();
        window.location = "/News/Search?q=" + searchtext;

    }
    function MAnyInput_KeyDown(sender, e) {
        if ((e.which && e.which === 13) || (e.keyCode && e.keyCode === 13)) {
            Msearch();

            return false;
        }

        return true;
    }



</script>