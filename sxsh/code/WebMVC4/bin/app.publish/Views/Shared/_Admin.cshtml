    <script type="text/javascript" language="javascript" src="/Administrator/Scripts/menu.js"></script>
    <script type="text/javascript" language="javascript" src="/Administrator/Scripts/index.js"></script>
    <script src="/Administrator/Scripts/highcharts.js" type="text/javascript"></script>
    <script type="text/javascript">
        //var EditorUploadUrl = '<%= UploadUrl %>';
    </script>
    <style type="text/css">
        #jalert_notification {
            padding-bottom: 20px;
            text-align: left;
        }
    </style>
</head>
<body id="body">
    @{
        var UploadUrl = " ";

        var IsCategory = false;
        var IsAlbum = false;
        var IsSale = false;
        var IsContact = false;
        var IsDocument = false;
        var IsNews = false;
        var IsAdmin = false;
        var IsReport = false;
        var IsComment = false;
        var IsMark = false;
        if (HttpContext.Current.User.IsInRole("Administrator") || HttpContext.Current.User.IsInRole("Category"))
        {
            IsCategory = true;
        }
        if (HttpContext.Current.User.IsInRole("Administrator") || HttpContext.Current.User.IsInRole("Album"))
        {
            IsAlbum = true;
        }
        if (HttpContext.Current.User.IsInRole("Administrator") || HttpContext.Current.User.IsInRole("Sale"))
        {
            IsSale = true;
        }

        if (HttpContext.Current.User.IsInRole("Administrator") || HttpContext.Current.User.IsInRole("Comment"))
        {
            IsComment = true;
        }
        if (HttpContext.Current.User.IsInRole("Administrator") || HttpContext.Current.User.IsInRole("Contact"))
        {
            IsContact = true;
        }
        if (HttpContext.Current.User.IsInRole("Administrator") || HttpContext.Current.User.IsInRole("Report"))
        {
            IsReport = true;
        }

        if (HttpContext.Current.User.IsInRole("Administrator") || HttpContext.Current.User.IsInRole("Document"))
        {
            IsDocument = true;
        }

        if (HttpContext.Current.User.IsInRole("Administrator"))
        {
            IsAdmin = true;
        }

        if (HttpContext.Current.User.IsInRole("Administrator") || HttpContext.Current.User.IsInRole("NewsEdit") || HttpContext.Current.User.IsInRole("NewsPublish"))
        {
            IsNews = true;
        }
        if (HttpContext.Current.User.IsInRole("Mark"))
        {
            IsMark = true;
        }
    }
    <script type="text/javascript">


        $(document).ready(function () {

            var IsCategory = '@IsCategory';
            var IsAlbum = '@IsAlbum';
            var IsSale = '@IsSale';
            var IsAdmin = '@IsAdmin';
            var IsNews = '@IsNews';
            var IsComment = '@IsComment';
            var IsReport = '@IsReport';
            var IsContact = '@IsContact';
            var IsDocument = '@IsDocument';
            var IsMark = '@IsMark';
            if (IsAdmin == 'False') {
                $(".display_admin").hide();
            }
            if (IsCategory == 'False') {
                $(".display_category").hide();
            }
            if (IsAlbum == 'False') {
                $(".display_album").hide();
            }

            if (IsNews == 'False') {
                $(".display_news").hide();
            }
            if (IsComment == 'False') {
                $(".display_comment").hide();
            }
            if (IsReport == 'False') {
                $(".display_report").hide();
            }
            if (IsContact == 'False') {
                $(".display_contact").hide();
            }
            if (IsDocument == 'False') {
                $(".display_document").hide();
            }
            $(".header").click(function () {
                window.location = '/Admin';
            });
            if (IsMark == 'False') {
                $(".display_mark").hide();
            }
        });

    </script>
    <div id="border-top" class="h_green">
        <div>
            <div>
                <span class="title" style="padding-left: 20px;">Quản trị nội dung</span>
            </div>
        </div>
    </div>
    <div id="header-box">

        @if (Request.IsAuthenticated)
        {
            <div id="module-status">
                @{UploadUrl = "User/" + HttpContext.Current.User.Identity.Name + "/" + DateTime.Now.Year.ToString() + "/" + DateTime.Now.Month.ToString(); }
       
                        
                <span id="lblMenuTopWelcome">Xin chào, @Context.User.Identity.Name</span>
                <span class="loggedin-users" id="lblMenuTopOnlineUser">2</span>
                <a href="@Url.Action("LogOff", "Account")" id="lbtnMenuLogout"><span class="logout">Thoát ra</span></a>
            </div>
            <script type="text/javascript">
                var EditorUploadUrl = '@UploadUrl';
            </script>
            {Html.RenderAction("MenuBar", "Admin");}
        }


    </div>
    <div id="content-box">
        <div class="border">
            <div class="padding">
                @RenderBody()
                <noscript>
                    Warning! JavaScript must be enabled for proper operation of the Administrator back-end.
                </noscript>
                <div class="clr">
                </div>
            </div>
            <div class="clr">
            </div>
        </div>
    </div>
    <div id="border-bottom">
        <div>
            <div>
            </div>
        </div>
    </div>
    <div id="footer">
        <p class="copyright">
            Copyright &copy; 2011 Bản quyền thuộc về công ty VTK Media
        </p>
    </div>

</body>
</html>
