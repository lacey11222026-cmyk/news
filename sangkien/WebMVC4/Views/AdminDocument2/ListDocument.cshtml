@using DATA.ContentDB
@using UTILS
@model List<Idea>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            @*<th>ID</th>*@
            <th>Mã SK</th>
            <th class="texttable">Tên sáng kiến</th>
            <th class="">Số QĐ</th>

            <th class="">
                Ngày ban hành
            </th>
            <th class="">
                Người đề xuất
            </th>
            <th>
                Người theo dõi
            </th>
            <th class="">
                Đơn vị thực hiện
            </th>
            @*<th class="">
                Tiến độ đánh giá
            </th>*@
            <th class="">
                Tiến độ %
            </th>
            <th class="">
                KQ đánh giá
            </th>
            <th class="">
                Mức độ áp dụng
            </th>

            <th>Trạng Thái</th>
            <th class="=">
                Giá trị làm lợi
            </th>
            <th>Tài liệu </th>
            <th>Thao Tác</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>
                @*<td>@obj.Id</td>*@
                <td>@obj.Code</td>
                <td class="texttable" style="text-align:left;min-width:150px;">
                    <a href="@Url.Action("GetDocumentDetail",new {id=obj.Id })" title="Edit">@obj.Name</a>
                </td>
                <td class="">@obj.No</td>
                <td>@HtmlHelpers.GetDateDocument(obj.PublishDate)</td>
                <td class="texttable" style="text-align:left;min-width:120px;">@Html.Raw(obj.Proposer.Replace("\n", "<br>"))</td>
                <td class="texttable" style="text-align: left; min-width: 120px;">@Html.Raw(obj.Followers.Replace("\n", "<br>"))</td>
                <td class="">@obj.Unit</td>

                @*<td class="">@HtmlHelpers.GetSKProgress(obj.Progress)</td>*@
                @if (obj.ProgressPercent > 0)
                {
                    <td>  @obj.ProgressPercent <text>%</text></td>
                }
                else
                {
                    <td class=""></td>
                }
                @if (!string.IsNullOrEmpty(obj.Mark.Trim()))
                {
                    <td class="">@HtmlHelpers.GetSKResult(obj.Result)  (@obj.Mark)</td>
                }
                else
                {
                    <td class="">@HtmlHelpers.GetSKResult(obj.Result)</td>
                }
                <td class="">@HtmlHelpers.GetSKRegion(obj.Region)</td>
                <td class="">@HtmlHelpers.GetSKStatus(obj.Status)</td>
                <td class="texttable" style="text-align:left;min-width:150px;">@Html.Raw(obj.Effective.Replace("\n", "<br>"))</td>

                <td><a href="@Url.Action("Download",new {id=obj.Id })" target="_blank">Download</a></td>
                <td style="text-align: center">
                    <a href="javascript:;" title="Delete" onclick="DeleteData('@Utils.Base64Encode(obj.Id)','@obj.Name')"><i class="fa fa-trash-o"></i></a>

                </td>

            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            title: $("#txtTitle").val(),
            year: $("#ddlYear").val(),
            unit: $("#txtUnit").val(),
            status: $('#ddlStatus :selected').val(),
            progress: $('#ddlProgress :selected').val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListDocument")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListDocument").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });

    function DeleteData(id,title) {

        bootbox.confirm("Bạn chắc chắn muốn xóa sáng kiến này ??? ", function (result) {
            if (result == true) {
                var postdata= {
                    '_id': id,
                    'Title': title,
                };
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url:"@Url.Action("Delete")",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }

</script>
<style>
    .table-responsive {
        overflow-x: auto;
    }

    .table {
        width: 99%;
        max-width: 99%;
    }

        .table > thead > tr > td, .table > thead > tr > th {
            padding: 8px 2px;
        }
</style>