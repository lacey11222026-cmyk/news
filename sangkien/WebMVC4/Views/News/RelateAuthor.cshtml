@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <h2 class="title-cm title-cm-inline"><a href="#">@ViewBag.HeaderTitle</a></h2>
        <ul>
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
               
                <li>
                    <p><a title="@item.value.Title" href="@item.value.LinkUrl" style="color:#626060">@item.value.Title</a></p>
                    <span>@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                </li>
            }


        </ul>
       




    }


}