@model List<DATA.Notifi>
<table class="table table-striped table-bordered" id="dataTables">
    <thead>
        <tr class="rowsao">

            <th>Nội dung</th>
            <th>Ngày tạo</th>
        </tr>
    </thead>

    @if (Model != null && Model.Count > 0)
    {
        for (var i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            <tr>
                <td class="texttable" style="text-align:left">
                    <a href="@item.Link">
                        @Html.Raw(item.Title)
                    </a>
                </td>
                <td>@item.CreatedTime.GetValueOrDefault().ToString("dd/MM/yyyy")</td>

            </tr>
        }
    }
</table>

<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListNotify")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListNotify").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });



</script>