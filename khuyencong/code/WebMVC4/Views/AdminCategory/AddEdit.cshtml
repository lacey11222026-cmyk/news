@{
   
    Layout = "~/Views/Shared/_AdminV2.cshtml";
    
}
    <div id="toolbar-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m">
            <div class="toolbar" id="toolbar">
                <table class="toolbar">
                    <tr>
                        <td class="button" id="toolbar-save">
                            <a id="lnkSave" class="toolbar" href="javascript:void(0);" onclick="Save('close');">
                                <span class="icon-32-save" title="Save"></span>Lưu lại</a>
                        </td>
                        <td class="button" id="toolbar-apply">
                            <a id="lnkApply" class="toolbar" href="javascript:void(0);" onclick="Save();"><span
                                class="icon-32-apply" title="Apply"></span>Áp dụng</a>
                        </td>
                        <td class="button" id="toolbar-cancel">
                            <a id="lnkClose" class="toolbar" href="javascript:void(0);" onclick="Close();"><span
                                class="icon-32-cancel" title="Close"></span>Đóng</a>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="header icon-48-addedit">
                chuyên mục: <small><span id="spDetailTitle"></span></small>
            </div>
            <div class="clr">
            </div>
        </div>
        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
    <div class="clr">
    </div>
    <div id="element-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m" id="all_item_info_container">
            <div id="jalert_notification">
                &nbsp;</div>
            <div id="tabs">
                <ul>
                    <li><a href="#tabs-1">Thông tin cơ bản</a></li>
                   
                    <li><a href="#tabs-5">Thiết lập hệ thống</a></li>
                </ul>
                <div class="col width-50" id="tabs-1">
                    <fieldset>
                        <legend>Thông tin chi tiết chuyên mục</legend>
                        <table class="admintable" cellspacing="1">
                            <tr>
                                <td width="250" class="key">
                                    <label for="">
                                        Tên
                                    </label>
                                </td>
                                <td>
                                    <input id="txtTitle" type="text" class="inputbox" maxlength="250" style="width: 350px" />
                                </td>
                            </tr>
                            <tr>
                                <td width="250" class="key">
                                    <label for="">
                                        Mô tả
                                    </label>
                                </td>
                                <td>
                                    <textarea id="txtDescription" cols="20" class="inputbox" style="width: 350px; height: 50px;"></textarea>
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Chuyên mục cha
                                    </label>
                                </td>
                                <td>
                                    <select id="selectbox_category" name="selectbox_category">
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Phân loại
                                    </label>
                                </td>
                                <td>
                                    <select id="select_type" name="select_type">
                                        <option value="2">Tin tức</option>
                                        <option value="1">Giới thiệu</option>
                                        <option value="5">Văn bản</option>
                                        <option value="4">Album Ảnh</option>
                                         
                                        <option value="0">Cuộc thi ảnh</option>
                                       
                                        
                                        <option value="6">Danh bạ</option>
                                        <option value="3">Khác</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Ngôn ngữ
                                    </label>
                                </td>
                                <td>
                                    <select id="select_language" name="select_language">
                                        <option value="vi-vn">Tiếng Việt</option>
                                        <option value="en-us">Tiếng Anh</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Liên kết &nbsp;
                                    </label>
                                </td>
                                <td>
                                    <input id="txtLink" type="text" class="inputbox" maxlength="250" style="width: 250px" />
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Tình trạng
                                    </label>
                                </td>
                                <td>
                                    <input name="radPublished" type="radio" value="1" checked="checked" />
                                    Hoạt động
                                    <input name="radPublished" type="radio" value="0" />
                                    Khóa
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Thứ tự
                                    </label>
                                </td>
                                <td>
                                    <input id="txtOrdering" type="text" class="inputbox" style="width: 50px" title="Thứ tự"
                                        value="0" />
                                </td>
                            </tr>
                        </table>
                    </fieldset>
                </div>
                <div id="tabs-5" class="col width-45" style="padding-left: 5px !important; width: 98%;">
                    <fieldset>
                        <legend>Thiết lập hiển thị</legend>
                        <table class="admintable">
                            <tr style="display: none;">
                                <td>
                                    <input id="chkIsHomepage" type="checkbox" />
                                    Hiển thị trên <b>Trang chủ</b>
                                </td>
                            </tr>
                            <tr style="display: none;">
                                <td>
                                    <input id="chkIsRightCol" type="checkbox" />
                                    Hiển thị trên <b>Cột phải</b>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <input id="chkIsMainMenu" type="checkbox" />
                                    Hiển thị trên <b>Menu chính</b>
                                </td>
                            </tr>
                            <tr style="display: none;">
                                <td>
                                    <input id="chkIsTopMenu" type="checkbox" />
                                    Hiển thị trên <b>Menu trên cùng</b>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <input id="chkIsFooter" type="checkbox" />
                                    Hiển thị trên <b>Footer</b>
                                </td>
                            </tr>
                        </table>
                    </fieldset>
                </div>
                <div class="clr">
                </div>
            </div>
        </div>
        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">

        var categoryId = '@ViewBag.CategoryId';
        var redirectUrl = '@Url.Action("Index","AdminCategory")';
        var imageUrl = '@ViewBag.ImageUrl';
        var entityName = 'Category';


        $(document).ready(function () {

            BindCategoriesToSelectBox();



            $("#tabs").tabs({ selected: 0 });
        });

        function OnLoad() {

            if (categoryId != 0) {

                $('#spDetailTitle').text('Sửa chữa');

                $.Services({
                    serviceName: 'CategoryService.ashx',
                    data: {
                        __m: 'get_category',
                        _id: categoryId
                    },
                    success: function (data) {

                        if (data != undefined && data != null && data != '')
                            BindData(data);
                        else
                            $('#all_item_info_container').html("Chuyên mục không tồn tại hoặc đã bị xóa");

                        DestroyDialog();
                    }
                });
            }
            else {

                $('#spDetailTitle').text('Tạo mới');
                DestroyDialog();
            }
        }

        function BindData(data) {

            $('#txtTitle').val(data.Name);

            $('#txtDescription').val(data.Description);

            $('#selectbox_category option[value=' + data.ParentId + ']').attr('selected', 'selected');

            $('#select_language option[value=' + data.Language + ']').attr('selected', 'selected');
            $('#select_type option[value=' + data.Type + ']').attr('selected', 'selected');

            $('input[name="radPublished"]').each(function (i, e) {
                if ($(e).val() == data.Published)
                    $(e).attr('checked', 'checked');
                else
                    $(e).removeAttr('checked');
            });

            $('#txtLink').val(data.Link);
            $('#txtOrdering').val(data.Ordering);
            if (data.Params != '' && data.Params != undefined && data.Params != null) {
                var params = eval('(' + data.Params + ')');




                if (params.IsHomepage == 1)
                    $('#chkIsHomepage').attr('checked', 'checked');
                else
                    $('#chkIsHomepage').removeAttr('checked');

                if (params.IsRightCol == 1)
                    $('#chkIsRightCol').attr('checked', 'checked');
                else
                    $('#chkIsRightCol').removeAttr('checked');

                if (params.IsMainMenu == 1)
                    $('#chkIsMainMenu').attr('checked', 'checked');
                else
                    $('#chkIsMainMenu').removeAttr('checked');

                if (params.IsTopMenu == 1)
                    $('#chkIsTopMenu').attr('checked', 'checked');
                else
                    $('#chkIsTopMenu').removeAttr('checked');

                if (params.IsFooter == 1)
                    $('#chkIsFooter').attr('checked', 'checked');
                else
                    $('#chkIsFooter').removeAttr('checked');

            }


        }

        function FormValidate() {
            var title = $.trim($('#txtTitle').val());
            if (title == '') {
                $('#jalert_notification').jAlert('Tên sản phẩm không được để trống', 'warning', "edit", 400);
                $('#txtTitle').focus();
                return false;
            }

            var regex = '[^0-9]';

            var ordering = $.trim($('#txtOrdering').val());
            if (ordering.match(regex) != null) {
                $('#jalert_notification').jAlert('Thứ tự phải ở dạng số', 'warning', "edit", 400);
                $('#txtPrice').focus();
                return false;
            }

            return true;
        }

        function PostObj(method) {
            var title = $.trim(Encoder.urlEndcode($('#txtTitle').val()));
            var parentId = $('#selectbox_category option:selected').val();
            var type = $('#select_type option:selected').val();
            var language = $('#select_language option:selected').val();
            var description = $.trim(Encoder.urlEndcode($('#txtDescription').val()));

            var link = Encoder.urlEndcode($('#txtLink').val());

            var published = 0;
            published = $('input[name="radPublished"]:checked').val();
            var ordering = $('#txtOrdering').val();


            var isHomepage = 0;
            if ($('#chkIsHomepage').attr('checked'))
                isHomepage = 1;

            var isRightCol = 0;
            if ($('#chkIsRightCol').attr('checked'))
                isRightCol = 1;

            var isMainMenu = 0;
            if ($('#chkIsMainMenu').attr('checked'))
                isMainMenu = 1;

            var isTopMenu = 0;
            if ($('#chkIsTopMenu').attr('checked'))
                isTopMenu = 1;

            var isFooter = 0;
            if ($('#chkIsFooter').attr('checked'))
                isFooter = 1;


            var params = [];


            params.push(isHomepage);
            params.push(isRightCol);
            params.push(isMainMenu);
            params.push(isTopMenu);
            params.push(isFooter);

            var post_data = {
                __m: method,
                id: categoryId,
                parentid: parentId,
                type: type,
                title: title,
                link: link,
                description: description,
                published: published,
                ordering: ordering,
                language: language,
                'params': params

            }

            return post_data;
        }

        function Save(type) {

            DestroyJAlert();

            if (!FormValidate())
                return;

            OpenAlertDialog('Đang xử lý ...');

            $.Services({

                isCrossDomain: false,
                url: POST_URL + 'CategoryService.ashx',
                data: PostObj('save'),
                success: function (data) {

                    if (data != undefined && data != null && data != '') {

                        //var json_data = eval('(' + data + ')');
                        var json_data = $.parseJSON(data.substring(data.indexOf("{"), data.lastIndexOf("}") + 1));
                        if (json_data.Success) {

                            if (json_data.Value != 0 && json_data.Value != null && json_data.Value != undefined && json_data.Value != '') {
                                categoryId = json_data.Value;

                            }

                            //OnLoad();
                        }
                    }

                    if (type != undefined && type != null && type != '' && type == 'close')
                        Close();

                    DestroyDialog();

                    var jalert_type = "info";
                    if (!json_data.Success)
                        jalert_type = "fatal";

                    $('#jalert_notification').jAlert(json_data.Text, jalert_type, "edit", 400);
                }
            });
        }

        function Close() {
            window.location.href = redirectUrl;
        }

        function BindCategoriesToSelectBox() {

            $('#selectbox_category').html('<option value="0">- Nhóm gốc -</option>');

            $.Services({

                serviceName: 'CategoryService.ashx',
                data: {
                    __m: 'get_all_categories'
                },
                success: function (data) {
                    html = '';
                    if (data != undefined && data != null && data != '') {
                        $.each(data, function (i, item) {
                            if (item.Id != categoryId) {
                                html = '<option value="' + item.Id + '">';
                                if (item.NodeLevel != 0) {
                                    for (var i = 1; i < item.NodeLevel; i++) {
                                        html += '-+&nbsp;';
                                    }
                                }

                                html += item.Name;
                                html += '</option>';
                                if (item.ParentId != 0)
                                    $('#selectbox_category option[value=' + item.ParentId + ']').after(html);
                                else
                                    $('#selectbox_category').append(html);
                            }
                        });

                        OnLoad();
                    }

                }
            });
        }


        function openWin() {
            myWindow = window.open('/Administrator/Components/Upload/MultiUpload.aspx', '', 'width=868,height=668');

            myWindow.focus();
        }


       

    </script>
