@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewModel
@if (Model != null)
{
    if (Model.lstdata.Count > 0)
    {

        <h2 class="title-line maxheight02"><a href="@Model.Url">@Html.Raw(Model.HeaderTitle)</a></h2>
        <div class="newsbox-cm">
            <div class="newsbig mt20 maxheight01">
                @foreach (var item in Model.lstdata.Take(1).Select((value, i) => new { i, value }))
                {
                    <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=306&h=203&mode=crop" alt=""></a>
                    <div class="newsbig-content">
                        <a href="@item.value.LinkUrl" class="news-name mt15">@item.value.Title</a>
                        <p class="newsdate mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</p>
                        <p class="news-content mt15">@item.value.IntroText</p>
                    </div>
                }
            </div>

            <div class="mt20">
                <ul class="newslist-arrow">
                    @foreach (var item in Model.lstdata.Skip(1).Select((value, i) => new { i, value }))
                    {
                        <li><a href="@item.value.LinkUrl">@item.value.Title</a></li>
                    }
                </ul>
            </div>
            <div class="mt30">
                <a href="@Model.Url" class="btn-viewmore">Xem thêm</a>
            </div>
        </div>

    }
}