@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.DOCUMENT_FULL>
@if (Model != null)
{
    <div class="title-cm01">
        <a href="/Document/Index/@ViewBag.CateId">@ViewBag.CateName</a>
    </div>
    if (Model.Count > 0)
    {

        <ul class="document-list">


            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li>
                    <a href="@Url.Action("Detail","Document",new { id=item.value.Id})"
                       title="@item.value.Name">
                        @item.value.Name
                    </a>
                </li>
            }
        </ul>
        <a href="/Document/Index/@ViewBag.CateId" class="btn-viewmore mt20">@Resources.Global.More <span>+</span></a>

    }

}