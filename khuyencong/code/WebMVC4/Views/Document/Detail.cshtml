@using BIZ
@using DATA
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.DOCUMENT_FULL
@{
    var langpage = WorkContext.GetLanguage();
}

<div class="intro-page container mt20 pb70">
    <div class="row">
        <div class="col-lg-8 col-md-12 pb40">
            @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
            <div class="mt40 manage-detail-page">
                <table>
                    <tbody>
                        <tr>
                            <th>Tên văn bản</th>
                            <td colspan="3">@Html.Raw(Model.Name)</td>
                        </tr>
                        <tr>
                            <th>Số hiệu</th>
                            <td>@Model.Code</td>
                            <th>Ngày ban hành</th>
                            <td>
                                @if (!Model.PublishDate.HasValue)
                                {

                                    <text>&nbsp;</text>
                                }
                                else
                                {
                                    if (Model.PublishDate.Value.Year < 9000)
                                    {
                                        @Convert.ToDateTime(Model.PublishDate).ToString(@" dd'/'MM'/'yyyy")
                                    }
                                    else
                                    {
                                        <text>&nbsp;</text>
                                    }

                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Ngày có hiệu lực</th>
                            <td>
                                @if (!Model.EffectiveDate.HasValue)
                                {

                                    <text>&nbsp;</text>
                                }
                                else
                                {
                                    if (Model.EffectiveDate.Value.Year < 9000)
                                    {
                                        @Convert.ToDateTime(Model.EffectiveDate).ToString(@" dd'/'MM'/'yyyy")
                                    }
                                    else
                                    {
                                        <text>&nbsp;</text>
                                    }

                                }
                            </td>
                            <th>Ngày hết hiệu lực</th>
                            <td>
                                @if (!Model.ExpiryDate.HasValue)
                                {

                                    <text>&nbsp;</text>
                                }
                                else
                                {
                                    if (Model.ExpiryDate.Value.Year < 9000)
                                    {
                                        @Convert.ToDateTime(Model.ExpiryDate).ToString(@" dd'/'MM'/'yyyy")
                                    }
                                    else
                                    {
                                        <text>&nbsp;</text>
                                    }

                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Mô tả</th>
                            <td colspan="3" @Html.Raw(Model.Description)<</td>
                        </tr>
                        <tr>
                            <th>Lĩnh vực</th>
                            <td>@HtmlHelpers.GetAreaName(Model.Area)</td>
                            <th>Loại văn bản</th>
                            <td>@HtmlHelpers.GetDocumentTypeName(Model.Type)</td>
                        </tr>
                        <tr>
                            <th>Cơ quan ban hành</th>
                            <td>@HtmlHelpers.GetDocAgent(Model.Agent)</td>
                            <th>Người ký</th>
                            <td>
                                <div style="max-width:180px;margin:0 0"> @Model.SignedBy</div>
                           </td>
                        </tr>
                        <tr>
                            <th>Xem online</th>
                            <td><a href="@Url.Action("ViewFile","Document",new { id=Model.Id})" target="_blank" class="btn-read">Read Online</a></td>
                            <th>Tải về</th>
                            <td><a href="@Url.Action("DownloadFile","Document",new { id=Model.Id})" class="btn-download">Download</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
        </div><!-- end content left-->

        <div class="col-md-12 col-lg-4">
            @Html.Partial("Site_Right")
        </div>
    </div>
</div>

