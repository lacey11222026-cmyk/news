@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@{
    ViewBag.Title = "Danh sách tin tức";
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">
                    <div class="form-group col-md-3 col-xs-12 col-sm-6" >
                        <div class="row">
                            <label for="txtEmail" class="control-label">Nguồn</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                                <select class="form-control" id="ddlStatus">
                                    <option value="1">Công Nghiệp Cao</option>

                                    <option value="2">Công nghệ sinh học</option>

                                </select>
                            </div>
                        </div>
                    </div>
                  



                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <input type="text" id="txtTitle" class="form-control" placeholder="Nhập từ khóa">
                    </div>
                    <div class="form-group submit col-md-3 col-xs-12 col-sm-6">
                        <button type="button" id="btnSearch" class="btn btn-info"><i class="fa fa-search"></i>Tìm Kiếm</button>
                       
                    </div>

                </div>
            </div>
            <div class="table-responsive">
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="ListNews">
                        
                    </div>

                   
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#menu_cnews').addClass("active");

</script>
<script type="text/javascript">
        $(document).ready(function () {
            
            var parameters = {
            };
            $("#form").keypress(function (event) {
                if (event.which == 13) {
                    $("#btnSearch").click();
                }
            });
            $("#btnSearch").click(function () {
                GetList(1);
            });
            $("#ddlStatus").change(function () {
                GetList(1);
            });
            
            function GetList(currentPage) {
                parameters = {
                    title: $("#txtTitle").val(),
                    Type: $("#ddlStatus").val(),
                };
                btnSearch(currentPage);
            };
            function btnSearch(currentPage) {
                Utils.Loading();
                var urlRequestAns = "@Url.Action("ListCrawl")";
                $.ajax({
                    type: 'GET',
                    url: urlRequestAns,
                    data: parameters,
                    success: function (data) {
                        $("#ListNews").html(data);
                        Utils.UnLoading();
                    },
                    error: function () {
                        Utils.UnLoading();
                    }
                });
            }
             GetList(1);
        });

</script>