    <script type="text/javascript">

        var articleId = '@ViewBag.Id';
        var redirectUrl = '@Url.Action("Index","AdminNews")';
        var imageUrl = '@ViewBag.ImageUrl';
        var entityName = 'Article';

        var IsNewsEdit = '@ViewBag.IsNewsEdit';
        var IsNewsPublish = '@ViewBag.IsNewsPublish';
        var Currentcreatedby = '@ViewBag.Createdby';
       

        $(document).ready(function () {
            BindUsersToSelectBox();
           
            
            RenderAjaxUpload('btnImagesUpload');

            LoadImages();

            $("#tabs").tabs({ selected: 0 });

        });
        function InitButton(data) {
            $(".button").hide();
            $("#toolbar-cancel").show();

            if (IsNewsEdit == 'True') {
                //tin đang biên tập:lưu,gửi xuất bản,xóa
                if (data.Status == 1) {
                    $("#toolbar-save").show();
                    $("#toolbar-send").show();
                    $("#toolbar-del").show();
                }
                //tin biên tập lại:lưu,gửi xuất bản,xóa
                if (data.Status == 3) {
                    $("#toolbar-save").show();
                    $("#toolbar-send").show();
                    //$("#toolbar-del").show();
                }
            }

            if (IsNewsPublish == 'True') {
                //tin chờ xuất bản:lưu,xuất bản,trả lại
                if (data.Status == 2) {
                    $("#toolbar-save").show();
                    $("#toolbar-reject").show();
                    $("#toolbar-publish").show();
                    $("#toolbar-del").show();
                }
                //tin  xuất bản:lưu,trả lại
                if (data.Status == 4) {
                    $("#toolbar-save").show();
                    $("#toolbar-reject").show();
                    $("#toolbar-del").show();
                }
            }



        }

        function OnLoad() {

           
            if (articleId != 0) {
               
                $('#spDetailTitle').text('Sửa chữa');

                $.Services({
                    serviceName: 'ArticleService.ashx',
                    data: {
                        __m: 'get_article',
                        _id: articleId
                    },
                    success: function (data) {

                        if (data != undefined && data != null && data != '') {
                            if (CheckPermission(data)) {
                                BindData(data);
                                Filter();
                                InitButton(data);
                            }
                            else {
                                $('#all_item_info_container').html("Bài viết không tồn tại hoặc đã bị xóa hoặc không có quyền truy cập");
                            }

                        }

                        else {
                            $('#all_item_info_container').html("Bài viết không tồn tại hoặc đã bị xóa");
                            $(".button").hide();
                        }

                        DestroyDialog();
                    }
                });
            }
            else {
                
                var Createdby = '@ViewBag.Createdby';
               
                $('#select_user option[value=' + Createdby + ']').attr('selected', 'selected');
                $('#spDetailTitle').text('Tạo mới');
                
                $('#li_tabimage').hide();
                
                $('#li_tabsetting').hide();


                $("#tr_status").hide();
                $("#tr_PublishDate").hide();

                $(".button").hide();
                $("#toolbar-cancel").show();
                $("#toolbar-apply").show();
                LoadRichTextEditor('txt_content', 900, 600, null, null, "ajaxupload,media");
                DestroyDialog();
                
            }

        }

        function CheckPermission(data) {
            if (IsNewsPublish == 'True') {

                if (data.Status == 2 || data.Status == 4) {

                    return true;
                }
            }

            if (IsNewsEdit == 'True') {
                if (data.Status == 1 || data.Status == 3) {
                    
                    if (data.CreatedBy == Currentcreatedby)
                        return true;
                }

            }
            return false;
        }
        function BindData(data) {

            $('#txtTitle').val(data.Title);
            $('#txtUrl').val(data.Url);
            $('#select_category option[value=' + data.CategoryId + ']').attr('selected', 'selected');
            $('#select_user option[value=' + data.Alias + ']').attr('selected', 'selected');
            $('#select_type option[value=' + data.Type + ']').attr('selected', 'selected');

            if (data.Image != null && data.Image != undefined && data.Image != '') {
                var images = data.Image;
                var arr_images = images.split(',');

                $.each(arr_images, function (index, item) {
                    if (index == 0) {
                        $('#images_container').find('input[type="radio"][name="main_image"][value="' + item + '"]').attr('checked', 'checked');
                    }
                    $('#images_container').find('input[type="checkbox"][name="image_name"][value="' + item + '"]').attr('checked', 'checked');
                });
            }


            $('#txtIntro').val(data.IntroText);

            $('#hd_status option[value=' + data.Status + ']').attr('selected', 'selected');

            $('#hd_createdby').val(data.CreatedBy);
            $('#txtPublishDate').val(dateFormat(data.PublishDate, 'dd/mm/yyyy HH:MM'));
            //alert(data.Createdby);

            $('#txt_content').text(data.Contents);

            LoadRichTextEditor('txt_content', 900, 600, null, null, "ajaxupload,media");
            BinDataSelectedNews(data.Params);



        }

        function FormValidate() {

            var title = $.trim($('#txtTitle').val());
            if (title == '') {
                $('#jalert_notification').jAlert('Tên bài viết không được để trống', 'warning', "edit", 400);
                $('#txtTitle').focus();
                return false;
            }



            return true;
        }
        function BinDataSelectedNews(lstid) {


            var tit = $('#txt_filterbyname').val();
            var cid = $('#select_filterbycategory option:selected').val();


            $.Services({
                element: $('#AvailableNews'),
                loadingImg: '',
                serviceName: 'ArticleService.ashx',
                data: {
                    __m: 'get_article_byids',
                    _lstid: lstid
                },
                success: function (data) {

                    if (data != undefined && data != null && data != '') {
                        var html = '';
                        $.each(data, function (index, item) {
                            html += '<option value="' + item.Id + '">' + item.Title + '</option>';
                        });
                        $("#SelectedNews").html(html);

                    }


                }

            });
        }

        function PostObj(method, func) {

            var title = Encoder.urlEndcode($.trim($('#txtTitle').val()));
            var linkmedia = Encoder.urlEndcode($.trim($('#txtUrl').val()));
            var cateogryId = $('#select_category option:selected').val();
            var categorypathway = $('#select_category option:selected').attr('title');
            var intro = Encoder.urlEndcode($('#txtIntro').val());
            var alias = $('#select_user option:selected').val();
            var status = $('#hd_status option:selected').val();
            var createdby = $('#hd_createdby').val();
            var type = $('#select_type option:selected').val();

            var publishdate = Encoder.urlEndcode($('#txtPublishDate').val());

            //alert(publishdate);

            tinyMCE.triggerSave();
            var content = Encoder.urlEndcode(tinyMCE.get('txt_content').getContent());

            //main_image
            var main_image = $('input[type="radio"][name="main_image"]:checked').val();
            if (main_image == undefined || main_image == null || main_image == '')
                main_image = '';

            var image_name = [];
            var images = $('input[type="checkbox"][name="image_name"]:checked');
            $.each(images, function (i, image) {
                image_name.push($(image).val());
            });
            var params = "";
            $("#SelectedNews option").each(function () {
                params = params + $(this).val() + ",";

            });
            var post_data = {
                __m: method,
                func: func,
                id: articleId,
                title: title,
                linkmedia: linkmedia,
                categoryid: cateogryId,
                categoryPathway: categorypathway,
                intro: intro,
                status: status,
                createdby: createdby,
                type: type,
                alias:alias,
                publishdate: publishdate,
                contents: content,
                'image': image_name,
                mainimage: main_image,
                params: params
            }

            return post_data;
        }

        function Save(type, func) {

            DestroyJAlert();

            if (!FormValidate())
                return;

            OpenAlertDialog('Đang xử lý ...');

            $.Services({

                isCrossDomain: false,

                url: POST_URL + 'ArticleService.ashx',

                data: PostObj('save', func),

                success: function (data) {

                    if (data != undefined && data != null && data != '') {
                        //var json_data = eval('(' + data + ')');
                        var json_data = $.parseJSON(data.substring(data.indexOf("{"), data.lastIndexOf("}") + 1));
                        if (json_data.Success) {

                            if (json_data.Value != 0 && json_data.Value != null && json_data.Value != undefined && json_data.Value != '') {
                                articleId = json_data.Value;
                                imageUrl = GetImageUrl(articleId, "Article", false);
                                Log(imageUrl);
                                RenderAjaxUpload('btnImagesUpload');

                            }
                            //OnLoad();
                        }

                    }

                    if (type != undefined && type != null && type != '' && type == 'close')
                        Close();
                    if (func == 'add')
                        window.location.href = window.location.href + '?id=' + articleId;

                    DestroyDialog();

                    var jalert_type = "info";
                    if (!json_data.Success)
                        jalert_type = "fatal";

                    $('#jalert_notification').jAlert(json_data.Text, jalert_type, "edit", 400);

                }
            });
        }

        function Close() {
            window.location.href = redirectUrl;
        }

        function BindCategoriesToSelectBox() {

            $('#select_filterbycategory').html('<option value="0">- Tất cả các chuyên mục -</option>');

            $.Services({

                serviceName: 'CategoryService.ashx',
                data: {
                    __m: 'get_all_categories',
                    ctype: 2
                },
                success: function (data) {

                    html = '';

                    if (data != undefined && data != null && data != '') {

                        $.each(data, function (i, item) {

                            if (articleId == 0) {
                                if (item.Published == 0)
                                {
                                    return true;
                                }
                                    
                            }
                            html = '<option value="' + item.Id + '" title="' + item.Pathway + '">';
                            if (item.NodeLevel != 0) {
                                for (var i = 1; i < item.NodeLevel; i++) {
                                    html += '-+&nbsp;';
                                }
                            }

                            html += item.Name;
                            html += '</option>';


                            if (item.ParentId != 0) {
                                if ($('#select_category option[value=' + item.ParentId + ']').length) {
                                    $('#select_category option[value=' + item.ParentId + ']').after(html);
                                    $('#select_filterbycategory option[value=' + item.ParentId + ']').after(html);

                                }
                                else {
                                    $('#select_category').append(html);
                                    $('#select_filterbycategory').append(html);
                                }
                            }
                            else {
                                $('#select_category').append(html);
                                $('#select_filterbycategory').append(html);
                            }





                        });

                        OnLoad();
                    }

                }
            });

        }
        function BindUsersToSelectBox() {

            

            $.Services({

                serviceName: 'User.ashx',
                data: {
                    __m: 'get_all_users',
                },
                success: function (data) {

                    html = '';

                    if (data != undefined && data != null && data != '') {

                        $.each(data, function (i, item) {
                            html = '<option value="' + item.Value + '" title="' + item.Value + '">';
                            html += item.Value;
                            html += '</option>';

                            $('#select_user').append(html);





                        });

                        BindCategoriesToSelectBox();
                    }

                }
            });

        }
        function RenderAjaxUpload(eid) {

            if (articleId > 0) {

                new AjaxUpload(eid, {
                    action: POST_URL + 'ImageService.ashx',
                    data: {
                        __m: 'upl',
                        _id: articleId,
                        _en: entityName,
                        ext: ''
                    },
                    autoSubmit: false,
                    onChange: function (file, ext) {
                        DestroyJAlert();
                        var ajaxupload = this;
                        ajaxupload._settings.data.ext = ext;
                        ajaxupload.submit();
                    },
                    onSubmit: function (file, ext) {
                        DestroyJAlert();
                        if (!(ext && /^(jpg|png|jpeg|gif|bmp)$/.test(ext))) {
                            OpenAlertDialog('File ảnh chỉ cho phép định dạng có đuôi mở rộng là: .jpg, .png, .jpeg, .gif, .bmp');
                            return false;
                        }

                        this.disable();
                    },
                    onComplete: function (file, response) {
                        DestroyJAlert();
                        var responseJson = $.parseJSON(response.substring(response.indexOf("{"), response.lastIndexOf("}") + 1));

                        if (responseJson.Success) {
                            //$('#images_container').text('');
                            var html = '<img src="' + imageUrl + responseJson.Value + '"  height="100" />';
                            html += '<input type="radio" checked="true" value="' + responseJson.Value + '" name="main_image"  />';
                            html += '<input type="button" value="Xóa" onclick="DeleteImage(\'' + responseJson.Value + '\',this)" />';
                            html += '<input name="image_name" type="checkbox" checked="true"  value="' + responseJson.Value + '" style="top: -78px; left: -19px; position: relative;" />';
                            $('#images_container').append(html);
                        }
                        else
                            $('#jalert_notification').jAlert(responseJson.Text, 'fatal', 'edit', 400);
                        this.enable();
                    }
                });
            }
            else {
                $('#' + eid).click(function () {
                    $('#jalert_notification').jAlert('Phải lưu thông tin bài viết mới có thể tải ảnh từ máy tính', 'warning', 'edit', 400);
                });

            }
        }



        function LoadImages() {

            $.Services({
                serviceName: 'ImageService.ashx',
                data: {
                    __m: 'article',
                    _id: articleId
                },
                success: function (data) {
                    if (data != undefined && data != null && data != '') {

                        $.each(data, function (i, item) {
                            var html = '<img src="' + imageUrl + item + '"  height="100" />';
                            html += '<input type="radio" value="' + item + '" name="main_image"  />';
                            html += '<input type="button" value="Xóa" onclick="DeleteImage(\'' + item + '\',this)" />';
                            html += '<input name="image_name" type="checkbox" value="' + item + '" style="top: -78px; left: -19px; position: relative;" />';
                            $('#images_container').append(html);

                        });
                    }

                },
                jCacheKey: 'LIST_IMAGES'

            });
        }

        function DeleteImage(image, elm) {
            DestroyJAlert();
            if ($(elm).prev().attr('checked') == true) {
                $('#jalert_notification').jAlert('Hiện tại ảnh này đang được đưa làm ảnh đại diện không thể xóa', 'fatal', 'edit', 400);
                return;
            }

            var confirmFunc = function () {
                $.Services({
                    isCrossDomain: false,
                    url: POST_URL + 'ImageService.ashx',
                    data: {
                        __m: 'del',
                        _id: articleId,
                        _en: entityName,
                        fna: image
                    },
                    success: function (data) {
                        if (data != undefined && data != null && data != '') {
                            //var json_data = eval('(' + data + ')');
                            var json_data = $.parseJSON(data.substring(data.indexOf("{"), data.lastIndexOf("}") + 1));
                            if (json_data.Success) {
                                $(elm).prev().remove();
                                $(elm).prev().remove();
                                $(elm).next().remove();
                                $(elm).remove();
                            }
                            else {
                                $('#jalert_notification').jAlert(json_data.Text, 'fatal', 'edit', 400);
                            }

                        }
                    }
                });
            };

            OpenConfirmDialog('Bạn có muốn xóa ảnh này không', confirmFunc);
        }

    </script>
