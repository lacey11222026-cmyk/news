@using BIZ
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
    <div class="tinkhac">
      
         
        
        <div class="title5"><a href="#">Các bài khác</a></div>
        <ul class="list">

            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li><a class="frist_child" title="@item.value.Name" href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Name, "Intro")">@item.value.Name </a>
                    <span class="last_child">&nbsp;</span></li>
            }


        </ul>
       
        <div class="clear"></div>
       
    </div>
   

    }


}