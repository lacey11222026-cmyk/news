@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.ProductModel
<link href="~/Content2/product.css" rel="stylesheet" />
@if (Model != null)
{
    <script>
        function loadmenu(categoryId, categoryName, manuId) {
            $.ajax({
                type: "Get",
                url: "@Url.Action("TopManu")?CategoryId=" + categoryId + "&CateName=" + categoryName + "&ManuId=" + manuId,
                success: function (data) {
                    if (data) {
                        $("#menu-manu").html(data);
                    }
                }
            });
        }
        function loadrange(type) {
            $.ajax({
                type: "Get",
                url: "@Url.Action("Range")?type=" + type,
                success: function (data) {
                    if (data) {
                        $("#menu-range").html(data);
                    }
                }
            });
        }
        setTimeout(function () {
            loadrange('@ViewBag.Type');
        }, 1000);

    </script>
    <section id="breadcrumb-wrapper2" class="breadcrumb-w-img">
        <div class="breadcrumb-overlay"></div>
        <div class="breadcrumb-content">
            <div class="wrapper">
                <div class="inner text-center">
                    <div class="breadcrumb-big">
                        <span class="h2">@Model.Cate.Name</span>
                    </div>
                    <div class="breadcrumb-small">
                        <a href="/" title="Trang chủ">Trang chủ</a> <span aria-hidden="true">/</span>
                        @if (Model.Cate.ParentId == 15)
                        {

                            <script>

                        setTimeout(function () {
                            $('#menu-@Model.Cate.Id').addClass('active');
                        }, 1000);
                        loadmenu('@Model.Cate.Id', '@Model.Cate.Name', '@ViewBag.ManuId');
                            </script>
                        }
                        else
                        {
                            <a href="@Model.CateParrent.Url" title="@Model.CateParrent.Name">@Model.CateParrent.Name</a> <span aria-hidden="true">/</span>
                            <script>
                        setTimeout(function () {
                            $('#submenu-@Model.Cate.Id a').addClass('active');
                            $('#menu-@Model.CateParrent.Id').addClass('active');
                        }, 1000);

                        loadmenu('@Model.CateParrent.Id', '@Model.CateParrent.Name', '@ViewBag.ManuId');
                            </script>
                        }
                    <span>@Model.Cate.Name</span>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <div id="PageContainer" class="is-moved-by-drawer">
        <main class="main-content" role="main">
            <section id="collection-wrapper">
                <div class="wrapper">
                    <div class="inner">
                        <div class="grid">
                            <div class="grid__item large--three-quarters medium--one-whole small--one-whole float-right">
                                <div class="collection-content-wrapper">
                                    <div class="collection-head">
                                        <div class="grid">
                                            <div class="grid__item large--seven-twelfths medium--one-whole small--one-whole">
                                                <div class="collection-title"><h1>@Model.Cate.Description</h1></div>
                                            </div>
                                            <div class="grid__item large--five-twelfths medium--one-whole small--one-whole">
                                                <div class="collection-sorting-wrapper pt15">
                                                    <div class="form-horizontal text-right">
                                                        <label for="SortBy">Sắp xếp</label>
                                                        <select name="orderby" class="orderby" id="drlOrder">
                                                            <option value="0" @(ViewBag.OrderType == 1 ? "selected='selected'" : "")>Thứ tự theo sản phẩm mới</option>
                                                            <option value="1" @(ViewBag.OrderType == 2 ? "selected='selected'" : "")>Thứ tự theo giá: thấp đến cao</option>
                                                            <option value="2" @(ViewBag.OrderType == 3 ? "selected='selected'" : "")>Thứ tự theo giá: cao xuống thấp</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="collection-body">
                                        <div class="grid-uniform product-list mg-left-15">
                                            @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                                            {


                                                <div class="grid__item large--one-quarter medium--one-third small--one-half pd-left15">
                                                    <div class="product-item">
                                                        <div class="product-img">
                                                            <a href="@UTILS.Utils.FormatUrlRewrite(item.value.Id,item.value.Name,"ProductDetail")" title="item.value.Name"> <img src="@item.value.DescriptImage?h=400&w=400&mode=crop" alt="item.value.Name"> </a>

                                                        </div>
                                                        <div class="product-item-info text-center">
                                                            <div class="product-title">
                                                                <a href="@UTILS.Utils.FormatUrlRewrite(item.value.Id,item.value.Name,"ProductDetail")" title="@item.value.Name">@item.value.Name</a>
                                                            </div>
                                                            <div class="product-price clearfix">
                                                                @if (item.value.Price > 0)
                                                                {

                                                                    <span class="current-price">@Utils.InsertCommaNoStyle(item.value.Price.ToString()) đ</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="current-price">Giá liên hệ</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>


                                            }
                                        </div>
                                            <div class="pagination not-filter">
                                                <div id="pagination-" class="text-center clear-left">
                                                    @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                                                        {
                                                            PageUrl = Url.SetParameter("Page", "!0"),
                                                            CurrentPage = Model.pageIndex,
                                                            PageSize = Model.pageSize,
                                                            TotalItemCount = Model.total,
                                                        }); }
                                                </div>
                                            </div>
                                        </div>
                                </div>
                            </div>
                            <div class="grid__item large--one-quarter medium--one-whole small--one-whole">
                                @Html.Partial("Site_Right")
                               

                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>
    <script>

        var updateQueryStringParam = function (key, value) {
            var baseUrl = [location.protocol, '//', location.host, location.pathname].join(''),
                urlQueryString = document.location.search,
                newParam = key + '=' + value,
                params = '?' + newParam;

            // If the "search" string exists, then build params from it
            if (urlQueryString) {
                var keyRegex = new RegExp('([\?&])' + key + '[^&]*');

                // If param exists already, update it
                if (urlQueryString.match(keyRegex) !== null) {
                    params = urlQueryString.replace(keyRegex, "$1" + newParam);
                } else { // Otherwise, add it to end of query string
                    params = urlQueryString + '&' + newParam;
                }
            }
            window.history.replaceState({}, "", baseUrl + params);
        };
        $('#drlOrder').change(function () {
            updateQueryStringParam('orderType', this.value);
            location.reload();

        });
    </script>
    
}
