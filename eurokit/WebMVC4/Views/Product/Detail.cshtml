        });
    </script>*@
    <style>
        #NewsContent img, #NewsContent table {
            height: auto !important;
            max-width: 100% !important;
        }

        #NewsContent iframe {
            max-width: 100% !important;
        }

        #NewsContent p, #NewsContent div {
            margin: 12px 0 !important;
        }

        #NewsIntro {
            float: left;
            margin-left: 0px;
            width: 100%;
        }
    </style>

}
