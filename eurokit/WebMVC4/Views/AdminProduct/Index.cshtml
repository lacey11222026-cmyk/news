@{

    Layout = "~/Views/Shared/_AdminV2.cshtml";
    ViewBag.Title = "Quản trị sản phẩm";
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">
                    <div class="col-md-12">

                        <div class="form-group col-md-4 col-xs-12 col-sm-6" style="display:none">
                            <label class="control-label"><i class="fa fa-flag"></i>Ngôn ngữ</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">

                                <select id="select_language" name="select_language" class="form-control">
                                    <option value="0">Tất cả</option>
                                    <option value="vi-vn">Tiếng Việt</option>
                                    <option value="en-us">Tiếng Anh</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group col-md-4 col-xs-12 col-sm-6">
                            <label class="control-label"><i class="fa fa-flag"></i>Chuyên mục</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">

                                <select id="select_category" class="form-control"></select>
                            </div>
                        </div>
                        <div class="form-group col-md-4 col-xs-12 col-sm-6" >
                            <label class="control-label"><i class="fa fa-flag"></i>Hãng</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">

                                <select id="select_manu" class="form-control"></select>
                            </div>
                        </div>
                        <div class="form-group col-md-4 col-xs-12 col-sm-6">
                            <label class="control-label"><i class="fa fa-flag"></i>Trạng thái</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">

                                <select class="form-control" id="ddlActive">
                                    <option value="-1">Lấy tất cả</option>
                                    <option value="1">Hoạt Động</option>
                                    <option value="0">Không Hoạt Động</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group col-md-5 col-xs-12 col-sm-6">
                            <label for="txtKeyword" class="control-label"><i class="fa fa-pencil"></i>Từ Khóa</label>
                            <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
                                <input type="text" id="txtKeyword" class="form-control" placeholder="Nhập từ khóa">
                            </div>
                        </div>
                        <div class="form-group submit" style="text-align:center">
                            <button type="button" id="btnSearch" class="btn btn-info"><i class="fa fa-search"></i>Tìm Kiếm</button>
                            <a href="@Url.Action("AddEdit",new {id=0 })" class="btn btn-success"><i class="fa fa-user-plus"></i>Thêm Mới</a>

                        </div>
                    </div>

                </div>
                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListProduct">
                            @Html.Action("ListProduct", "AdminProduct")
                        </div>
                        <div class="dataTables_paginate" id="pager">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#menu_manageproduct').addClass("active");

</script>

<script type="text/javascript">
    function LoadManu(rvalue, cateid) {
        $('#select_manu').html('<option value="-1">- Model -</option>');
        $.ajax({
            cache: false,
            type: "GET",
            url: "/AdminProduct/GetListManu?CategoryId=" + cateid,
            data: {},
            success: function (data) {
                //$('#select_manu').html('');
                var html = '';
                $.each(data, function (id, item) {

                    if (rvalue == item.Id) {
                        html = '<option selected="selected" value="' + item.Id + '" title="' + item.Title + '">';
                    }
                    else {
                        html = '<option value="' + item.Id + '" title="' + item.Title + '">';
                    }


                    html += item.Title;
                    html += '</option>';

                    $('#select_manu').append(html);



                });
            },

        });
    }
    function LoadCate(rvalue, lang) {
        $('#select_category').html('<option value="-1">- Hãng -</option>');
        $.ajax({
            cache: false,
            type: "GET",
            url:  "/AdminProduct/GetListCate?lang=" + lang,
            data: {},
            success: function (data) {

                var html = '';
                $.each(data, function (id, item) {

                    html = '<option value="' + item.Id + '" title="' + item.Pathway + '">';
                    if (item.NodeLevel != 0) {
                        for (var i = 1; i < item.NodeLevel; i++) {
                            html += '-+&nbsp;';
                        }
                    }

                    html += item.Name;
                    html += '</option>';

                    if (item.ParentId != 0) {
                        if ($('#select_category option[value=' + item.ParentId + ']').length)
                            $('#select_category option[value=' + item.ParentId + ']').after(html);
                        else
                            $('#select_category').append(html);
                    }
                    else
                    {
                        $('#select_category').append(html);

                    }



                });
            },

        });
    }
    $(document).ready(function () {
        LoadCate('0', '');
        LoadManu('0', '-1');
        var parameters = {
        };
        $("#form").keypress(function (event) {
            if (event.which == 13) {
                $("#btn_search").click();
            }
        });
        $("#btn_search").click(function () {
            GetList(1);
        });
        $("#select_filterbystatus").change(function () {
            GetList(1);
        });
        $("#select_category").change(function () {
            LoadManu('0', $(this).val())
            setTimeout(function () { GetList(1); }, 1000);
        });
        $("#select_manu").change(function () {
           
            setTimeout(function () { GetList(1); }, 500);
        });
        $("#select_language").change(function () {
            LoadCate('0', $(this).val())
            setTimeout(function () { GetList(1); }, 1000);
        });
        function GetList(currentPage) {
            parameters = {
                status: $('#select_filterbystatus :selected').val(),
                lang: $('#select_language :selected').val(),
                categoryId: $('#select_category :selected').val(),
                manufactoryId: $('#select_manu :selected').val(),
                name: $("#txtKeyword").val(),
                currentPage: currentPage
            };
            btnSearch(currentPage);
        };
        function btnSearch(currentPage) {

            var urlRequestAns = "/AdminProduct/ListProduct";
            $.ajax({
                type: 'GET',
                url: urlRequestAns,
                data: parameters,
                success: function (data) {
                    $("#ListProduct").html(data);

                },

            });
        }

    });

</script>