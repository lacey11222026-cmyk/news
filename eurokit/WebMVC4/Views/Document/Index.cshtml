@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.DocumentModel

<section id="breadcrumb-wrapper2" class="breadcrumb-w-img">
    <div class="breadcrumb-overlay"></div>
    <div class="breadcrumb-content">
        <div class="wrapper">
            <div class="inner text-center">
                <div class="breadcrumb-big">
                    <span class="h2">Catalog</span>
                </div>
                <div class="breadcrumb-small">
                    <a href="/" title="Trang chủ">Trang chủ</a> <span aria-hidden="true">/</span>
                    <span>Catalog</span>

                </div>
            </div>
        </div>
    </div>
</section>
<div id="PageContainer" class="is-moved-by-drawer">
    <main class="main-content" role="main">
        <section id="blog-wrapper">
            <div class="wrapper">
                <div class="inner">
                    <div class="grid">
                        <div class="grid__item large--nine-twelfths medium--one-whole small--one-whole float-left">
                            <div class="blog-content">
                                <div class="blog-content-wrapper">
                                    <div class="document-table table-responsive mt20">
                                        <table>
                                            <tbody>
                                                <tr>
                                                    <th>STT </th>

                                                    <th>Tên  </th>

                                                    <th>Download </th>
                                                </tr>
                                                @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                                                {
                                                    <tr>
                                                        <td>@(item.i + 1) </td>

                                                        <td>
                                                            <a href="@Url.Action("ViewFile","Document",new { id=item.value.Id})" target="_blank">
                                                                @item.value.Name
                                                            </a>
                                                        </td>

                                                        <td align="center">
                                                            <a href="@Url.Action("DownloadFile","Document",new { id=item.value.Id})">
                                                                <img style="width: 23px;" src="/Content/images/ico-pdf.png" />
                                                            </a> &nbsp; &nbsp;
                                                            <a href="@Url.Action("DownloadFile","Document",new { id=item.value.Id})" target="_blank">Download</a>
                                                        </td>

                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="grid__item large--three-twelfths medium--one-whole small--one-whole">
                            <div class="blog-sidebar">

                                <div class="featured-post">
                                    <div class="blog-sb-title clearfix"><h3>Tin mới nhất</h3> </div>
                                    <ul class="featured-list">

                                        @{ Html.RenderAction("RightLastestNews", "News", new { MaxLastestNews = 6, CategoryId = 90, CateName = "Tin tức" }); }
                                    </ul>
                                </div>


                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

