@using WebMVC4.Models
@using UTILS
@model ShoppingCartModel
@if (Model.ListProduct.Count() > 0)
{
    <div class="shop-cart">
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th class="text-center border-right-0"></th>
                        <th class="text-center border-right-0"></th>
                        <th class="text-center border-right-0">@Resources.Order.Product</th>
                        <th class="cart-product-quantity">@Resources.Order.Count</th>

                        <th class="text-right">@Resources.Order.Price</th>

                        <th class="text-right">@Resources.Order.Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ListProduct)
                    {
                        <tr>
                            <td class="text-center border-right-0">
                                <a href="javascript:;" onclick="cartproductdelete('@item.ProductId')"><i class="fa fa-close"></i></a>
                            </td>
                            <td class="text-center border-right-0">
                                <img src="@item.ProductImage" width="50" alt="@item.ProductName" title="@item.ProductName" class="img-thumbnail">
                            </td>
                            <td class="text-left border-right-0">

                                <div class="cart-product-thumbnail-name">@item.ProductName</div>
                            </td>
                            <td class="text-center">
                                <div class="quantity" style="width:200px">
                                    @Html.AntiForgeryToken()
                                    <input type="button" value="-" class="minus" onclick="downnumberv2(@item.ProductId);" style="display:none">
                                    <input id="txtAmount_@(item.ProductId)" type="text" class="form-control qty"  readonly="readonly" name="quantity" value="@item.Amount" >
                                    <input type="button" value="+" class="plus" onclick="upnumberv2(@item.ProductId);" style="display:none">
                                </div>
                            </td>
                            <td class="text-right price">
                                <span class="amount">@Utils.InsertCommaNoStyle(item.Price.ToString()) đ</span>
                            </td>

                            <td class="text-right total">
                                <span class="amount">@Utils.InsertCommaNoStyle((item.Price * item.Amount).ToString()) đ</span>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
            <div style="border-bottom: 2px solid #ddd;">

            </div>
        </div>

        @using (Html.BeginForm("ShoppingCart", "Order", FormMethod.Post, new { id = "formbilling" }))
        {

            <div class="row">
                @*<hr class="space">*@
                <div class="col-md-6" id="billinginfo">
                    <h4>@Resources.Order.HeaderAddress</h4>
                    <div class="row">
                        <div class="col-md-12">
                            <p id="msgBox" style="color: #c82e29; font-weight: bold; font-size: 13px"></p>

                        </div>
                        <div class="col-md-12 m-b-10">
                            <label for="OderItem_FullName" class="control-label col-md-4">@Resources.Order.FullName :<span class="required">*</span></label>
                            <div class="col-md-8">

                                @Html.TextBoxFor(model => model.OderItem.FullName, new { @class = "form-control" })
                                @Html.AntiForgeryToken()
                            </div>

                        </div>
                        <div class="col-md-12 m-b-10">
                            <label for="OderItem_Email" class="control-label col-md-4">Email :<span class="required">*</span></label>
                            <div class="col-md-8">

                                @Html.TextBoxFor(model => model.OderItem.Email, new { @class = "form-control" })

                            </div>

                        </div>
                        <div class="col-md-12 m-b-10">
                            <label for="OderItem_Mobile" class="control-label col-md-4">@Resources.Order.Mobile :<span class="required">*</span></label>
                            <div class="col-md-8">

                                @Html.TextBoxFor(model => model.OderItem.Mobile, new { @class = "form-control" })

                            </div>

                        </div>

                        <div class="col-md-12 m-b-10">
                            <label for="OderItem_CustomerAddress" class="control-label col-md-4">@Resources.Order.Address :<span class="required">*</span></label>
                            <div class="col-md-8">

                                @Html.TextBoxFor(model => model.OderItem.CustomerAddress, new { @class = "form-control" })

                            </div>

                        </div>
                        <div class="col-md-12 m-b-10">
                            <label for="OderItem_CustomerComment" class="control-label col-md-4">@Resources.Order.Note :</label>
                            <div class="col-md-8">

                                @Html.TextAreaFor(model => model.OderItem.CustomerComment, new { @class = "form-control", @rows = "4" })

                            </div>

                        </div>

                    </div>
                </div>
                <div class="col-md-6 p-r-10 ">
                    <div class="table-responsive">
                        <h4>@Resources.Order.HeaderCartInfo</h4>
                        <table class="table">
                            <tbody>
                                <tr>
                                    <td class="cart-product-name">
                                        @Resources.Order.OrderPrice
                                    </td>
                                    <td class="text-right">
                                        <span class="amount">@Utils.InsertCommaNoStyle(Model.ExtraData.OrderPrice.ToString())đ</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="cart-product-name">
                                        @Resources.Order.Total
                                    </td>
                                    <td class="cart-product-name text-right">
                                        <span class="amount color lead"><strong>@Utils.InsertCommaNoStyle(Model.ExtraData.OrderBilling.ToString())đ</strong></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="buttons">
                        <div class="pull-right">
                            <a class="btn btn-primary" href="javascript:;" onclick="validateData();"><span>@Resources.Order.ConfirmOrder</span></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div style="height:500px">

    </div>
    <script>
        window.location = '@Url.Action("CartEmpty")';
    </script>
}
<style>
    .cart-product-name {
        width: 100px;
    }

    #billinginfo label {
        font-weight: normal !important;
    }
</style>
<script src="~/Content/js/formvalidate.js?vs=161111"></script>
<script>
    $('#billinginfo input[type="text"]').change(function () {

        cartproductupdateinfo();
    });
    function cartproductupdateinfo() {

        var postdata = {
            FullName: $('#OderItem_FullName').val(),
            Email: $('#OderItem_Email').val(),
            Mobile: $("#OderItem_Mobile").val(),
            CustomerRegion: '1',
            CustomerCity: ' ',
            CustomerComment: $('#OderItem_CustomerComment').val(),
            CustomerAddress: $('#OderItem_CustomerAddress').val()

        };
        $.ajax({
            type: "post",
            dataType: "html",
            url: '@Url.Action("CartProductUpdateInfo", "Order")',
            data: addAntiForgeryToken(postdata),
            success: function (response) {


            }
        });
    }
    function cartproductdelete(productid) {

        var postdata = {
            productid: productid
        };
        $.ajax({
            type: "post",
            dataType: "html",
            url: '@Url.Action("cartproductdelete", "Order")',
            data: addAntiForgeryToken(postdata),
            success: function (response) {

                loadCart();

            }
        });
        //$('#formcartcouponadd').submit();

    }
    function cartcoupondelete(id) {

        var postdata = {
            id: id
        };
        $.ajax({
            type: "post",
            dataType: "html",
            url: '@Url.Action("CartCouponDelete", "Order")',
            data: addAntiForgeryToken(postdata),
            success: function (response) {

                loadCart();

            }
        });
        //$('#formcartcouponadd').submit();

    }
    function cartcouponadd() {
        var code = $("#txtCouponCode").val();
        if (code != '') {
            var postdata = {
                code: code
            };
            $.ajax({
                type: "post",
                dataType: "html",
                url: '@Url.Action("CartCouponAdd", "Order")',
                data: addAntiForgeryToken(postdata),
                success: function (response) {

                    var data = jQuery.parseJSON(response);
                    if (data.ResponseCode >= 1) {
                        loadCart();

                    } else {

                        $("#messagecoupoun").html(data.Description).show();
                    }

                }
            });
            //$('#formcartcouponadd').submit();
        }
        return false;
    }
    function cartproductupdate(productid, count) {
        var postdata = {
            productId: productid,
            count: count,


        };
        $.ajax({
            type: "post",
            dataType: "html",
            url: '@Url.Action("CartProductUpdate", "Order")',
            data: addAntiForgeryToken(postdata),
            success: function (response) {

                loadCart();
            }
        });

    }

</script>

<script>
    function loadCart() {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("_ShoppingCart")',
            //data: parameters,
            success: function (data) {
                $("#divcart").html(data);

            },

        });
    }
    function upnumberv2(productid) {
        var amount = parseInt($("#txtAmount_" + productid).val());
        amount = amount + 1;
        cartproductupdate(productid, amount);
    }
    function downnumberv2(productid) {
        var amount = parseInt($("#txtAmount_" + productid).val());
        amount = amount - 1;
        if (amount <= 0)
            amount = 1;
        cartproductupdate(productid, amount);

    }
</script>

<script type="text/javascript">

    function validateEmail() {

        if (!ValidateControls("@Resources.Order.EmailValidateEmpty", "#OderItem_Email")) {
            return false;
        }
        var mail = $('#OderItem_Email').val();
        if (!isValidEmailAddress(mail)) {

            $("#msgBox").html("@Resources.Order.EmailValidateFormat").show();

            $('#OderItem_Email').focus();
            return false;
        }
        return true;
    }
    function validatePhone() {
        if (!ValidateControls("@Resources.Order.MobileValidateEmpty", "#OderItem_Mobile")) {
            return false;
        }
        var CMTND = $('#OderItem_Mobile').val();

        if (CMTND.length < 9 || CMTND.length > 12) {

            $("#msgBox").html("@Resources.Order.MobileValidateLenght").show();

            $('#OderItem_Mobile').focus();
            return false;
        }
        if (!isInteger(CMTND)) {

            $("#msgBox").html("@Resources.Order.MobileValidateType").show();

            $('#OderItem_Mobile').focus();
            return false;
        }
        return true;

    }

    function validateData() {
        if (!ValidateControls("@Resources.Order.FullNameEmpty", "#OderItem_FullName")) {
            return false;
        }
        if (!validateEmail()) {
            return false;
        }
        if (!validatePhone()) {
            return false;
        }
        if (!ValidateControls("@Resources.Order.AddressEmpty", "#OderItem_CustomerAddress")) {
            return false;
        }

        $('#formbilling').submit();
        return true;
    }


</script>