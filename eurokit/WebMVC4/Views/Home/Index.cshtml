<div id="main-slider">
    <div class="wrapper">
        <div class="inner">
            <div class="grid-uniform">
                <div class="grid__item large--nine-twelfths medium--one-whole small--one-whole mg-bottom-10">
                    @Html.Action("BannerHome", "Home")

                </div>
                <div class="grid__item large--three-twelfths">
                    @Html.Action("BannerRight", "Home")
                </div>
            </div>
        </div>
    </div>
</div>
<div id="PageContainer" class="is-moved-by-drawer">
    <main class="main-content" role="main">
        <div id="home-policy">
            <div class="wrapper">
                <div class="inner">
                    <div class="grid">
                        <div class="grid__item wow fadeInUp large--one-third medium--one-third small--one-whole" data-wow-delay="0.2s" data-wow-duration="0.75s" style="visibility: visible; animation-duration: 0.75s; animation-delay: 0.2s; animation-name: fadeInUp;">
                            <div class="hservice-item">
                                <div class="hservice-img">
                                    <img src="/Content2/hservice_icon11601050051.png" alt="miễn phí ">
                                </div>
                                <div class="hservice-item-content">
                                    <div class="hservice-title">
                                        <a href="" title="miễn phí ">miễn phí </a>
                                    </div>
                                    <div class="hservice-desc">
                                        <div>tư vấn và khảo sát tại nhà</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="grid__item wow fadeInUp large--one-third medium--one-third small--one-whole" data-wow-delay="0.2s" data-wow-duration="0.75s" style="visibility: visible; animation-duration: 0.75s; animation-delay: 0.2s; animation-name: fadeInUp;">
                            <div class="hservice-item">
                                <div class="hservice-img">
                                    <img src="/Content2/hservice_icon21601050072.png" alt="uy tín">
                                </div>
                                <div class="hservice-item-content">
                                    <div class="hservice-title">
                                        <a href="" title="uy tín">uy tín</a>
                                    </div>
                                    <div class="hservice-desc">
                                        Cam kết nguồn gốc gỗ
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="grid__item wow fadeInUp large--one-third medium--one-third small--one-whole" data-wow-delay="0.2s" data-wow-duration="0.75s" style="visibility: visible; animation-duration: 0.75s; animation-delay: 0.2s; animation-name: fadeInUp;">
                            <div class="hservice-item">
                                <div class="hservice-img">
                                    <img src="/Content2/hservice_icon31601050090.png" alt="Khuyến mãi lớn">
                                </div>
                                <div class="hservice-item-content">
                                    <div class="hservice-title">
                                        <a href="" title="Khuyến mãi lớn">Khuyến mãi lớn</a>
                                    </div>
                                    <div class="hservice-desc">
                                        Cho khách hàng tới lần 2
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <section id="home-collection-tabs12" class="home-collection-tabs2">
            <div class="wrapper">
                @{ Html.RenderAction("TopProduct", "Product", new { top = 8, categoryId = 26, manufactoryId = -1, ishot = true }); }
            </div>
        </section>
        <section id="home-collection-tabs159" class="home-collection-tabs2">
            <div class="wrapper">
                @{ Html.RenderAction("TopProduct", "Product", new { top = 8, categoryId = 27, manufactoryId = -1, ishot = true }); }
            </div>
        </section>
        @*<section id="home-collection-tabs117" class="home-collection-tabs2">
            <div class="wrapper">
                @{ Html.RenderAction("TopProduct", "Product", new { top = 8, categoryId = 16, manufactoryId = -1, ishot = true }); }
            </div>
        </section>*@
        <section id="home-collection-tabs" class="home-collection-tabs2">
            <div class="wrapper">
                @{ Html.RenderAction("TopProduct2", "Product", new { top = 8, categoryId = 15 }); }
            </div>
        </section>
        <section id="home-collection-tabs159" class="home-collection-tabs2">
            <div class="wrapper">
                @{ Html.RenderAction("IntroVideo", "Home", new { CategoryId = 125}); }
            </div>
        </section>
        <section id="home-articles">
            <div class="wrapper">
                <div class="inner">
                    @{ Html.RenderAction("LastestNews", "Home", new { MaxLastestNews = 6, CategoryId = 90, IsMobile = ViewBag.IsMobile }); }
                </div>
            </div>
        </section>

        <section id="home-brands">
            <div class="wrapper">
                <div class="inner">
                    <div class="grid">
                        <div id="owl-brands-slider" class="owl-carousel owl-theme" style="opacity: 1; display: block;">
                            <div class="owl-wrapper-outer">
                                <div class="owl-wrapper" style="width: 2340px; left: 0px; display: block; transition: all 1000ms ease 0s; transform: translate3d(0px, 0px, 0px);">

                                    @Html.Action("BannerBottom", "Home")
                                </div>
                            </div>





                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>