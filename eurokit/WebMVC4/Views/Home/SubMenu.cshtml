@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model List<CATEGORY_FULL>
@if (Model != null)
{

    if (Model.Count > 0)
    {
        foreach (var item in Model.Where(x => x.NodeLevel == 2).Select((value, i) => new { i, value }))
        {
            if (Model.Exists(x => x.ParentId == item.value.Id))
            {
                <li class="has-child">

                    <a href="@item.value.Url" title="@item.value.Name">@item.value.Name <i class="fa fa-angle-right"></i></a>
                    <ul class="no-bullets">
                        @foreach (var sub in Model.Where(x => x.ParentId == item.value.Id).Select((value, i) => new { i, value }))
                        {
                            <li>
                                <i class="fa fa-caret-right"></i>
                                <a href="@sub.value.Url" title="@sub.value.Name">@sub.value.Name </a>
                            </li>
                        }
                    </ul>
                </li>
            }
            else
            {
                <li class="has-child">

                    <a href="@item.value.Url" title="@item.value.Name">@item.value.Name </a>
                    
                </li>
            }

        }
    }
}