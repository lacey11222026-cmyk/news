                success: function (data) {
                    if (data.indexOf("RUN:") > 0) {
                        jQuery("#wait_layer").hide();
                        var script = data.replace("--RUN:", "");
                        jQuery("#return-script").html(script);
                    } else {
                        modal({
                            type: 'alert',
                            title: 'Thông báo',
                            text: data
                        });
                    }
                    jQuery("#wait_layer").hide();
                }
            });
            return false;
        };
