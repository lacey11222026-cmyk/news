                url: "/index.php?a=getcart",
                success: function (data) {
                    jQuery("#header-cart").html(data);
                    $('.desktop-cart-wrapper .quickview-cart').show();
                }
            });
        }
        function loadPrice() {
            jQuery.ajax({
                type: "POST",
                url: "/ajax/load-price/",
                data: jQuery("#addcartForm").serialize(),
                success: function (data) {
                    jQuery("#priceUpdate").html(data);
                }
            });
        }
        function delCart(cartid) {
            jQuery.ajax({
                type: "GET",
                url: "/ajax_action.php?act=delcart&cartid=" + cartid,
                success: function (data) {
                    if (data.indexOf("RUN:") > 0) {
                        var script = data.replace("--RUN:", "");
                        jQuery("#return-script").html(script);
                    } else {
                        modal({
                            type: 'alert',
                            title: 'Thông báo',
                            text: data
                        });
                    }
                }
            });
        }
        function addList(proid) {
            jQuery.ajax({
                type: "GET",
                url: "/ajax_action.php?act=addlist&proid=" + proid,
                success: function (data) {
                    if (data.indexOf("RUN:") > 0) {
                        var script = data.replace("--RUN:", "");
                        jQuery("#return-script").html(script);
                    } else { alert(data); }
                }
            });
        }

        function addCom(proid) {
            jQuery.ajax({
                type: "GET",
                url: "/ajax_action.php?act=addcom&proid=" + proid,
                success: function (data) {
                    alert(data);
                    getCom();
                }
            });
        }
        function getCom() {
            jQuery.ajax({
                type: "GET",
                url: "/ajax_action.php?act=getcom",
                success: function (data) {
                    jQuery("#compare-items").html(data);
                }
            });
        }

        function removeCom(proid) {
            jQuery.ajax({
                type: "GET",
                url: "/ajax_action.php?act=removecom&proid=" + proid,
                success: function (data) {
                    jQuery("#liCom-" + proid).hide();
                }
            });
        }
        function removeAllCom() {
            if (confirm('Are you sure you would like to remove all products from your comparison?')) {
                jQuery.ajax({
                    type: "GET",
                    url: "/ajax_action.php?act=removeallcom",
                    success: function (data) {
                        jQuery("#compare-items").hide();
                    }
                });
            }
        }
        function load_payment() {
            jQuery.ajax({
                type: "GET",
                url: "/?a=ajax&q=load_payment&tinhid=" + jQuery("#city").val() + "&huyenid=" + jQuery("#suburb").val(),
                success: function (data) {
                    jQuery("#checkout-payment-method-load").html(data);
                }
            });
        }
        load_payment();
        function load_huyen(tinh_id) {
            jQuery.ajax({
                type: "GET",
                url: "/?a=ajax&q=gethuyen&tinhid=" + tinh_id,
                success: function (data) {
                    jQuery("#suburb").html(data);
                    load_payment();
                }
            });
        }
        function load_fee() {
            jQuery.ajax({
                type: "POST",
                url: "/?a=ajax&q=getfee",
                data: jQuery("#checkout_form").serialize(),
                success: function (data) {
                    if (data.indexOf("RUN:") > 0) {
                        var script = data.replace("--RUN:", "");
                        jQuery("#return-script").html(script);
                    } else { jQuery("#cart-total-review").html(data); }

                }
            });
        }
        function load_fee_free() {
            jQuery.ajax({
                type: "GET",
                url: "/?a=ajax&q=getfee&tinhid=0&huyenid=0&total=&pro=",
                success: function (data) {
                    jQuery("#cart-total-review").html(data);
                }
            });
        }
