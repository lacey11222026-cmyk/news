@model List<DATA.Banner>
@if (Model != null)
{
    <section id = "home-main-slider" >
        <div id="owl-home-main-slider" class="owl-carousel owl-theme">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                
                    <div class="item">
                        <a href="@item.value.Url" title="Banner 1"><img src="@item.value.Data" alt="@item.value.Name"></a>
                    </div>
               
            }
          
        </div>
</section>
