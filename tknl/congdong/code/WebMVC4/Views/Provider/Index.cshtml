@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.ProviderModel
@using DATA.ContentDB
@{
    List<TestLocation> ListCate = ViewBag.listLocation;
}



<div class="bnr-detail">
    <img src="/Content/images/bg-title-blue.jpg" alt="">
    <div class="bnr-detail-inner">
        <div class="container">
            <p class="bnr-detail-title">Cơ sở dữ liệu</p>
            <p class="bnr-detail-title-big">ĐƠN VỊ CUNG CẤP DỊCH VỤ, ĐƠN VỊ TƯ VẤN</p>
        </div>
    </div>
</div>
<div class="search-page mt50 pb100 box-search-company">
    <div class="container">
        <div class="title-search-wap">
            <h2 class="title-search">TÌM KIẾM ĐƠN VỊ CUNG CẤP DỊCH VỤ, ĐƠN VỊ TƯ VẤN</h2>
        </div>
        @*<div class="form-search mt30">
                <div class="form-group">
                    <input class="form-control form-radius" id="txtkeyword" value="@ViewBag.keyword" type="text" placeholder="*Nhập từ khóa tìm kiếm">
                </div>
                <div class="form-group">
                    <select class="form-control form-radius" id="province">
                        <option value="">Tỉnh/thành phố</option>
                        @if (ListCate != null && ListCate.Count > 0)
                        {

                            foreach (var obj in ListCate)
                            {
                                <option value="@obj.Name" title="@obj.Name" @if (obj.Name.ToString() == ViewBag.province) { @Html.Raw("selected='selected'") ; }>@obj.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group text-center"> <a href="javascript:;" onclick="searchdoc();" class="btn-red form-radius"><i class="icon-search"></i> Tìm kiếm</a> </div>
            </div>*@
    </div>
    <div class="box-attention mt30">
        <p class="text-danger">
            Nếu bạn là Đơn vị cung cấp dịch vụ, đơn vị tư vấn, tổ chức kiểm toán năng lượng, ESCO,… nhưng chưa có tên trong Cơ sở dữ liệu Đơn vị cung cấp dịch vụ, đơn vị tư vấn của Bộ Công Thương, vui lòng gửi thông tin về email: <a href="mailto:vneec.gov@gmail.com">vneec.gov@gmail.com</a> hoặc số điện thoại <a href="tel:0915612489">0915612489</a> (zalo) để được cập nhật vào hệ thống.<br>Nội dung thông tin cần cung cấp bao gồm: Tên đơn vị, Địa chỉ, Số điện thoại, Email, Ngành nghề kinh doanh, Bản chụp giấy đăng ký kinh doanh.
        </p>
    </div>

    <div class="mt50">
        <p class="title-search text-center">
            KẾT QUẢ TÌM KIẾM<br>
            <span>Có tổng số <span class="textred font-weight-bold">@Model.total</span> kết quả được tìm thấy </span>
        </p>
        <div class="search-result">
            <ul class="search-result-list mt30">
                @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                {
                    <li>
                        <div class="search-result-item-wrap">
                            <div class="search-result-item">
                                <div class="search-result-img"><a href="/don-vi-cung-cap/don-vi-@(item.value.Id)"><img src="@item.value.Images" alt="" width="75"></a></div>
                                <div class="search-result-content">
                                    <h3><a href="/don-vi-cung-cap/don-vi-@(item.value.Id)">@item.value.Name</a></h3>
                                    <div>@Html.Raw(item.value.Contact)</div>
                                </div>
                            </div>
                        </div>

                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="paging mt50">
        <ul>
            @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                {
                    PageUrl = Url.SetParameter("Page", "!0"),
                    CurrentPage = Model.pageIndex,
                    PageSize = Model.pageSize,
                    TotalItemCount = Model.total,
                }); }
        </ul>
    </div>
</div>
</div>
<script type="text/javascript">


    function searchdoc() {

        var keyword = $("#txtkeyword").val();
        var province = $("#province").val();

        window.location = '/don-vi-cung-cap/?keyword=' + keyword + '&province=' + province;

    }
</script>
<style>
    .search-result-list li > a {
       color:#333;
    }
    .search-result-content ul {
        display: block;
        list-style-type: disc;
        padding-left:15px;
    }
</style>