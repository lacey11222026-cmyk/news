@using BIZ.Entity
@using UTILS
@using DATA
@using WebMVC4.Helper
@using DATA.ContentDB
@model AuditorFull

<div class="bnr-detail">
    <img src="/Content/images/bg-title-red.jpg" alt="">
    <div class="bnr-detail-inner">
        <div class="container">
            <p class="bnr-detail-title">Cơ sở dữ liệu</p>
            <p class="bnr-detail-title-big">NGƯỜI QUẢN LÝ NĂNG LƯỢNG</p>
        </div>
    </div>
</div>

