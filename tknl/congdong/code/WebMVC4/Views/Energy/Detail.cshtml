                                <td>Địa chỉ công tác</td>
                                <td>@Model.Address</td>
                            </tr>
                            @*<tr>
                                <td>Điện thoại</td>
                                <td>@Model.ProjectConfig.MobileOffice</td>
                            </tr>
                            <tr>
                                <td>Đơn vị đào tạo</td>
                                <td>@Model.Group</td>
                            </tr>
                            <tr>
                                <td>Thời gian đào tạo</td>
                                <td>@Model.ProjectConfig.TrainingTime</td>
