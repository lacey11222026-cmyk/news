                                    </tr>
                                    <tr>
                                        <th>Ngày sinh:</th>
                                        <td>@Model.BirthDay</td>
                                    </tr>
                                    <tr>
                                        <th>Quốc tịch:</th>
                                        <td>@Model.Nation</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="mt30">
                    <table class="tbl-sub">
