                            </tr>
                            @*<tr>
                                <td>Mã số doanh nghiệp</td>
                                <td>@Model.MSDN</td>
                            </tr>
                            <tr>
                                <td>Chức danh</td>
                                <td>@Model.Role</td>
                            </tr>*@
