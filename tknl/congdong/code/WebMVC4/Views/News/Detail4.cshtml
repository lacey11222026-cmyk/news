@using BIZ
@using BIZ.Entity
@using UTILS
@using WebMVC4
@using WebMVC4.Helper
@model BIZ.Entity.CONTENT_FULL
@{
    Layout = "~/Views/Shared/_Temp4.cshtml";
}

<div class="t-header">
    <div class="t-header-content">
        <div class="header-c01">
            <div><a href="/" class="btn-back"><img src="/img/icon-back.svg" alt="Back" width="55"></a></div>
            <a href="/" class="t-logo-top"><img src="/img/logo.svg" alt="" width="300"></a>
        </div>
        <div class="btn-like">
            <div class="fb-like" data-href="@(Model.LinkUrl)" data-layout="button_count" data-action="like" data-show-faces="false" data-share="true"></div>
        </div>
    </div>
    <a href="/" class="t-logo"><img src="/img/logo.png" alt="e-magazine"></a>
</div><!--/ End header-->
@Html.Raw(Model.Contents.Replace("<div class=\"temp-04\">", "<div>").Replace("<a data-cke-saved-href=\"#\" href=\"#\" class=\"mt20 disblock\"><img data-cke-saved-src=\"/img/like-face.jpg\" src=\"/img/like-face.jpg\" alt=\"\"></a>", "<div style='clear:both;margin-top:20px'></div>"+ViewBag.FacebookLike))
<div class="temp">
    @{ Html.RenderAction("Relate4", "News", new { CategoryId = 5, Id = Model.Id, PageNextShow = false, pageNext = 2 }); }

</div>

<script>
        $('#NewsContent .news_detail_img').removeAttr('style');

        $('.temp  img').removeAttr('style');
        $('.temp  img').removeAttr('width');
        $('.temp  table').removeAttr('style');
        $('#date').html('@Model.PublishDate.ToString("dd/MM/yyyy")');
</script>


<style>
    .title-t4-txt
    {
        text-align:center;
        width:100%;
        padding-left:0px;
    }
</style>
<style>
    #date {
        text-align: center;
        font-style: italic;
        margin-top: 30px;
    }
    img {
        height: auto !important;
    }
    em {
        font-style: italic;
    }
</style>