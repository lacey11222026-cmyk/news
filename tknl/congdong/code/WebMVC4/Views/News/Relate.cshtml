@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <h2 class="title-cm"><a href="#">TIN CÙNG CHUYÊN MỤC</a></h2>
        <ul class="col-2-item news-other-list news-hz">
            @foreach (var item in Model.Take(4).Select((value, i) => new { i, value }))
            {
                <li>
                    <div class="new-content">
                        <a href="@item.value.LinkUrl" class="news-name mt15">@item.value.Title</a>
                        <span class="dategray mt15">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="img-wrap"><a href="@item.value.LinkUrl"><img src="@item.value.MainImage2?w=238&h=146&mode=crop" alt=""></a></div>
                </li>
            }
               
            </ul>
       





    }


}