@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@using DATA.ContentDB
@model List<TestLocation>

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">

                <div class="table-responsive">
                    <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                        <div id="ListShop">
                            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                                <thead>
                                    <tr class="rowsao">

                                        <th>Tỉnh </th>
                                        
                                        <th>Số kiểm toán viên năng lượng</th>
                                        <th>Số người quản lý năng lượng</th>
                                        <th>Số đơn vị cung cấp dịch vụ</th>
                                    </tr>
                                </thead>
                                @if (Model != null && Model.Count > 0)
                                {
                                    foreach (var obj in Model)
                                    {
                                        <tr>

                                            <td style="text-align:left"><a href="@Url.Action("Info",new { name=obj.Name})">@obj.Name</a></td>
                                            <td>@obj.Number1</td>
                                            <td>@obj.Number2</td>
                                            <td>@obj.Number3</td>
                                           



                                        </tr>
                                    }
                                }
                            </table>
                        </div>
                        <div class="dataTables_paginate" id="pager">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $('#menu_managelocation').addClass("active");
</script>

