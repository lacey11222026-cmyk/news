@model WebMVC4.Models.PaginationInfo
@using WebMVC4.Helper
@if (Model.Pages.Count() > 1)
{
   
    if (Model.HasPrevPage)
    {
    
    <li class="paging-prev"><a href="javascript:void(0)" onclick="GoVideoPage(@(Model.CurrentPage-1));" > < </a> </li> 
    }
@* else
    {
    <li><a href="#" class="active">Trước</a> </li>      }*@
    foreach (var p in Model.Pages)
    {
        if (p == Model.CurrentPage)
        {
    <li class="active"><a class="currentpage" href="#">@p</a></li>
        }
        else
        {
    
    <li><a href="javascript:void(0)" onclick="GoVideoPage(@(p));" >@p</a> </li>
        }
    }
    if (Model.HasNextPage)
    { 

    <li class="paging-next"><a href="javascript:void(0)" onclick="GoVideoPage(@(Model.CurrentPage+1));" > ></a></li>
    }
   @* else
    {
    <li><a href="#" class="active">Sau </a></li>
    }*@

    <div class="clear"></div>
}
<style>
    .paging li > a::before {
        display: none !important;
    }
</style>