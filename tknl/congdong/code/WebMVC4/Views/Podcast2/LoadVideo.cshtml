@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel
@if (Model != null)
{

    <ul class="podcast-list">

        @foreach (var item in Model.listdata.Select((value, i) => new
        {
            i,
            value
        }))
        {

           
            <li>
                <div class="img-wrap"><a href="/cau-chuyen-tknl/@(item.value.Id)"><img src="@item.value.MainImage?w=300&h=300&mode=crop" alt=""></a></div>
                <div class="new-content">
                    <a href="/cau-chuyen-tknl/@(item.value.Id)" class="news-name mt15">@item.value.Title</a>
                    <span class="dategray mt15">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                    <a href="/cau-chuyen-tknl/@(item.value.Id)" class="icon-play"></a>
                </div>
            </li>
        }

    </ul>
    <div class="paging pt60">
        <ul>
            @{Html.RenderPartial("PaginationVideo", new WebMVC4.Models.PaginationInfo
                {
                    PageUrl = Url.SetParameter("Page", "!0"),
                    CurrentPage = Model.pageIndex,
                    PageSize = Model.pageSize,
                    TotalItemCount = Model.total,
                }); }
        </ul>
    </div>
    

    <script>

        function GoVideoPage(page) {
            var VideoId = '@Model.Id';
            if (page > 0) {
                $.ajax({
                    type: "GET",
                    url: "/Podcast2/LoadVideo/?VideoId=" + VideoId + "&page=" + page,
                    success: function (data) {
                        if (data != "null") {
                            $("#lstVideo").html(data);
                        }
                    }
                });
            }

        }

    </script>
}