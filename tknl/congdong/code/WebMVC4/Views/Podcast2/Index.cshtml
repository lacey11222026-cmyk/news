@using BIZ
@using UTILS
@using WebMVC4.Helper
@model BIZ.Entity.CONTENT_FULL


<div class="container mt30">
    <div class="">
        <h2 class="title-cm text-center"><a href="#">Câu chuyện TKNL</a></h2>
        <div class="box-gray">
            <div class="podcast-bignew">
                <div class="img-wrap"><a href="#"><img src="@Model.MainImage?w=407&mode=crop" alt=""></a></div>
                <div class="podcast-bignew-content">
                    <p class="dategray">@Model.PublishDate.ToString("dd/MM/yyyy")</p>
                    <h3 class="news-name mt15">@Model.Title</h3>
                    <p class="mt20">
                        @Model.IntroText
                    </p>
                    <div class="mp3 mt50">
                        <div class="audio-player">
                            <audio id="audioFile" src="@Model.Url"></audio>
                            <div class="audio-progress-bar" id="audioProgressBar">
                                <div class="audio-progress" id="audioProgress"></div>
                            </div>
                            <div class="audio-nav mt30">
                                <div class="volume-controls">
                                    <button onclick="changeVolume(-0.1)"><img src="/Content/images/speaker-01.svg" alt="" width="22"></button>
                                    <input type="range" id="volumeSlider" min="0" max="1" step="0.01" value="1">
                                    <button onclick="changeVolume(0.1)"><img src="/Content/images/speaker-02.svg" alt="" width="25"></button>
                                </div>
                                <div class="audio-time">
                                    <button onclick="skipTime(-10)" class="audio-back">10s</button>
                                    <button id="playPauseButton" onclick="togglePlayPause()"></button>
                                    <button onclick="skipTime(10)" class="audio-next">10s</button>
                                </div>
                                <div class="speed-controls">
                                    <label for="speedSelect">Tốc độ phát:</label>
                                    <select id="speedSelect" onchange="changeSpeed(this.value)">
                                        <option value="0.5">0.5x</option>
                                        <option value="1" selected>1x</option>
                                        <option value="1.5">1.5x</option>
                                        <option value="2">2x</option>
                                    </select>
                                </div>
                            </div>
                            <!--                <span id="currentTime">0:00</span>-->
                            <!--                <span id="totalTime">0:00</span>-->
                        </div>
                    </div>
                    <div class="mt50">
                        <ul class="network">
                            <li><a href="javascript:void(0);" onclick="openWin('@ViewBag.FacebookShare');" class="icon-small"><img src="/Content/images/icon-like.svg" alt="" width="18">Thích</a></li>
                            <li><a href="javascript:void(0);" onclick="openWin('@ViewBag.FacebookShare');" class="icon-small"><img src="/Content/images/icon-share.svg" alt="" width="18">Chia sẻ</a></li>
                            <li><a href="javascript:void(0);" onclick="copyFromElement()" class="icon-small"><img src="/Content/images/icon-link.svg" alt="" width="18">Copy link</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div><!-- end container -->
<div class="container pt60 pb100">
    <h2 class="title-cm text-center"><a href="#">PODCAST MỚI NHẤT</a></h2>
    <div id="lstVideo">
        @Html.Action("LoadVideo", new { VideoId = Model.Id, page = 1 })
    </div>
    
</div>


<script>
    function copyFromElement() {
        const text = "@ViewBag.Url"
        navigator.clipboard.writeText(text)
            .then(() => alert("Đã copy: " + text));
    }
</script>
<script type="text/javascript">

    function openWin(url) {
        var myWindow = window.open(url, '', 'width=700,height=500');
        myWindow.focus();
    }
</script>
<script src="/Content/js/audio.js" type="text/javascript"></script>