@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel
@if (Model != null)
{

    <ul class="col-2-item video-list">
        
        @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
        {
            <li>
                <div class="img-wrap"><a href="/chuyen-de-cong-nghe?VideoId=@(item.value.Id)"><img src="@item.value.MainImage?w=570&h=371&mode=crop" alt=""></a></div>
                <div class="new-content">
                    <a href="/chuyen-de-cong-nghe?VideoId=@(item.value.Id)" class="news-name mt15">@item.value.Title</a>
                    <span class="dategray mt15">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                </div>
            </li>
           
        }
    </ul>
    <div class="paging pt60">
        <ul>
            @{Html.RenderPartial("PaginationVideo", new WebMVC4.Models.PaginationInfo
                {
                    PageUrl = Url.SetParameter("Page", "!0"),
                    CurrentPage = Model.pageIndex,
                    PageSize = Model.pageSize,
                    TotalItemCount = Model.total,
                }); }
        </ul>
    </div>
   


    <script>

        function GoVideoPage(page) {
            var VideoId = '@Model.Id';
            var Cateid='@Model.CategoryId'
            if (page > 0) {
                $.ajax({
                    type: "GET",
                    url: "/Video/LoadVideo/?VideoId=" + VideoId + "&page=" + page + "&CategoryId=" + Cateid,
                    success: function (data) {
                        if (data != "null") {
                            $("#lstVideo").html(data);
                        }
                    }
                });
            }

        }

    </script>
}