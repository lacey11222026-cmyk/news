@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewModel
@if (Model != null)
{
    

    <div class="grid-cols-4 m-grid-cols-1">
        @foreach (var item in Model.lstdata.Select((value, i) => new { i, value }))
        {
            <div class="news-item-small">
                <div class="img-wrap"><a href="/cau-chuyen-tknl/@(item.value.Id)"><img src="@item.value.MainImage?w=260&h=260&mode=crop" alt=""></a></div>
                <div class="new-content">
                    <a href="/cau-chuyen-tknl/@(item.value.Id)" class="news-name mt15">@item.value.Title</a>
                    <span class="dategray mt15">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                    <p class="mt15 news-txt">@item.value.IntroText</p>
                </div>
            </div>
        }
    </div>
    <div class="text-center btn-tab"><a href="/cau-chuyen-tknl" class="btn-view">Xem thêm</a></div>
}