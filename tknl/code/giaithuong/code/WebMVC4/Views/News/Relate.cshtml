@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <h3 class="title-blue">CÁC TIN KHÁC</h3>
        <ul class="news-list">
            @foreach (var item in Model.Select((value, i) => new {i, value}))
            {
                <li><a title="@item.value.Title" href="@item.value.LinkUrl">@item.value.Title </a></li>
            }
        </ul>

      
   

    }


}