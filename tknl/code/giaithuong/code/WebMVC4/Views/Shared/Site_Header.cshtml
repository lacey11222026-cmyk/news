@using UTILS
@using BIZ

<div class="header">
    <div class="top-content01">
        <div class="container">
            <ul class="list-inline">
                <li>
                    <input id="txtQ" type="text" onkeydown="javascript: return AnyInput_KeyDown(this, event);" placeholder="Tìm kiếm">
                </li>
                <li><a href="#">Đối tác</a></li>
                <li><a href="https://tietkiemnangluong.com.vn/top-runner/gioi-thieu/c42/lien-he.html">Liên hệ</a></li>
            </ul>
        </div>
    </div>
    <div class="top-content02">
        <div class="container">
            <div class="head-content">
                <a href="@(Config.Domain)" class="logo"><img src="@(Config.Domain)/Content/images/logo.png" alt="Sản phẩm hiệu suất năng lượng cao nhất"></a>
                <div class="pull-right">
                    <nav class="nav-top">
                        <ul>
                            <li><a href="@(Config.Domain)">Trang chủ</a></li>
                            @{Html.RenderAction("Menu", "Home");}
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
        <div class="nav-mobile">
            <div class="header-m">
                <a href="#menu">
                    <img src="@(Config.Domain)/Content/images/ico-menu.png" class="ico-menu pull-right" alt="">
                </a>
            </div>
            <div id="menu">
                <ul>
                    <li>
                        <input  id="txtmQ" type="text" onkeydown="javascript: return MAnyInput_KeyDown(this, event);" type="text" placeholder="Tìm kiếm" class="m-search">
                    </li>
                    <li><a href="@(Config.Domain)">Trang chủ</a></li>
                    @{Html.RenderAction("Menu", "Home");}

                </ul>
            </div>
        </div>
    </div>
</div><!-- end header-->
<div class="clearfix"></div>
<script type="text/javascript">

    function msearch() {

        var keyword = $("#txtmQ").val();


        window.location = '/top-runner/Product/Search/' + '?q=' + keyword;
        //window.location = jQuery.query.set("keyword", keyword).set("fromdate", fromdate).set("todate", todate).set("Page", "1");
    }
    function search() {

        var keyword = $("#txtQ").val();
       

        window.location = '/top-runner/Product/Search/' + '?q=' + keyword ;
        //window.location = jQuery.query.set("keyword", keyword).set("fromdate", fromdate).set("todate", todate).set("Page", "1");
    }
    function AnyInput_KeyDown(sender, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            search();

            return false;
        }

        return true;
    }
    function mAnyInput_KeyDown(sender, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            msearch();

            return false;
        }

        return true;
    }
</script>