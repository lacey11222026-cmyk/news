@model List<DATA.Banner>

@if (Model != null)
{
    <div id="bnrSlide" class="carousel slide" data-ride="carousel">
        <ul class="carousel-indicators">
           
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li data-target="#bnrSlide" data-slide-to="@item.i" class="@(item.i==0?" active":"")"></li>
            }
        </ul>
        <div class="carousel-inner">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <div class="@(item.i==0?"item active":"item")">
                    <a href="@item.value.Url" rel="nofollow" target="_blank">
                        <img src="@item.value.Data" alt="@item.value.Name" />
                    </a>
                </div>
            }
            
        </div>
    </div>
    

}


