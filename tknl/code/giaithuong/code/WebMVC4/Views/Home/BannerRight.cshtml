@model List<DATA.Banner>
@if (Model != null)
{
    <div id="bnrSlide02" class="carousel slide" data-ride="carousel">
        <div class="carousel-inner">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <div class="@(item.i==0?"item active":"item")">
                    <a href="@item.value.Url" rel="nofollow" target="_blank">
                        <img src="@item.value.Data" alt="@item.value.Name" />
                    </a>
                </div>
            }
        </div>
        <a class="left carousel-control" href="#bnrSlide02" data-slide="prev">
            <span class="glyphicon glyphicon-chevron-left"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="right carousel-control" href="#bnrSlide02" data-slide="next">
            <span class="glyphicon glyphicon-chevron-right"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>

   


}