@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewModel
@if (Model != null)
{
    if (Model.lstdata.Count > 0)
    {
        <h2 class="title-cm"><a href="@Model.Url">@Model.HeaderTitle</a></h2>
        <div class="row ">


            <div class="col-md-7 col-sm-7 col-xs-12 news-big">
                @foreach (var item in Model.lstdata.Take(1).Select((value, i) => new { i, value }))
                {
                    <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=425&h=275&mode=crop"></a>
                    <h3><a href="@item.value.LinkUrl">@item.value.Title</a></h3>
                    <p>@item.value.IntroText</p>


                }
            </div>
            <div class="col-md-5 col-sm-5 col-xs-12">
                <ul class="news-list">
                    @foreach (var item in Model.lstdata.Skip(1).Select((value, i) => new { i, value }))
                    {
                        <li><a href="@item.value.LinkUrl">@item.value.Title</a></li>
                    }
                </ul>
            </div>
            <div class="clearfix"></div>

        </div><!-- end big news-->



    }
}