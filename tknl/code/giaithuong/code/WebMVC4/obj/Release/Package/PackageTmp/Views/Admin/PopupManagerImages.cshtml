

<div class="row" id="ContentPopUp">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon"></span>Danh sách thư mục ảnh</div>
            <div class="panel-body">
               
                <div class="col-md-7 col-xs-12">
                    <div class="row" id="form">


                        <div class="form-group col-md-4 col-xs-12 col-sm-12">
                            <select class="form-control" id="ddlMonth" onchange="CommonCtrl.ListImages()">
                                @for (var i = 1; i <= 12; i++)
                                {
                                    if (i == ViewBag.Month)
                                    {
                                        <option value="@i" selected="selected">Tháng @(i)</option>
                                    }
                                    else
                                    {
                                        <option value="@i">Tháng @(i)</option>
                                    }

                                }
                            </select>
                        </div>


                    </div>
                    <div class="table-responsive">
                        <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                            <div id="ListImages">
                                @Html.Action("ListImages", "Admin")
                            </div>

                        </div>
                    </div>
                </div>
                <div class="col-md-5 col-xs-12">
                    
                    <div id="ChooseImages">
                        <div>
                            @{Html.RenderAction("PopUpFileInfo");}
                        </div>
                        <div style="clear:both;"></div>
                        <form id="imagesForm" method="post" class="form-horizontal">
                            <div class="panel-group" id="steps">
                                <div class="panel panel-primary">
                                    <div class="panel-body col-md-12">
                                        <div class="form-group col-md-12">
                                            <label for="srcImage" class="control-label col-md-4">Ảnh :</label>
                                            <div class="col-md-8">
                                                <div class="input-icon ">
                                                    <img height="50" id="srcImage" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="clear">
                                            <br />
                                        </div>
                                        <div class="form-group col-md-12">
                                            <label for="txtImageUrl" class="control-label col-md-4">Đường dẫn :</label>
                                            <div class="col-md-8">
                                                <input type="text" id="txtImageUrl" name="ImageUrl" style="width:100%" />
                                            </div>
                                        </div>


                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                
                
            </div>
        </div>
    </div>
</div>

<style type="text/css">
    .modal-dialog {
        width: 90% !important;
        height: 90% !important;
    }
</style>

