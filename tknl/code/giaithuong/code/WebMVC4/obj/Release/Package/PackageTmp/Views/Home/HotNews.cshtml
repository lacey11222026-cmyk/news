@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        <ul class="box-newhot">

            @foreach (var item in Model.Take(7).Select((value, i) => new { i, value }))
            {
                <li>
                    <div class="maxheight04 number"><span>@(item.i+1)</span></div>
                    <div class="maxheight04 newhot"><a href="@item.value.LinkUrl">@item.value.Title</a></div>
                    <div class="clearfix"></div>
                </li>
            }
        </ul>
    }


}
