                    <th>Nhãn hiệu</th>
                    <th>Xuất xứ</th>

                   

                </tr>
                @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                {
                    <tr>
                        <td style="text-align:left"><a href="@item.value.Description">@item.value.Name</a></td>
                        <td>@item.value.ProductParam.Model</td>
                        <td>@item.value.ProductParam.Manuface</td>
                        <td>@item.value.ProductParam.MadeIn</td>
                      

