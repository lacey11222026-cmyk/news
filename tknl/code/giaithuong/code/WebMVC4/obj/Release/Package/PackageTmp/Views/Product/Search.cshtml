    </div>
    <div class="pagination">
        <ul>
            @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                {
                    PageUrl = Url.SetParameter("Page", "!0"),
                    CurrentPage = Model.pageIndex,
                    PageSize = Model.pageSize,
                    TotalItemCount = Model.total,
                }); }
        </ul>
    </div>
</div>


<div class="experience container mt90">
    <h2 class="title-cm02"><a href="https://tietkiemnangluong.com.vn/tin-tuc/c10/meo-tknl.html" target="_blank">Kinh nghiệm hay</a></h2>
    @{ Html.RenderAction("LastestNewsAPI", "Home", new { MaxLastestNews = 4, CategoryId = 10 }); }
</div>
<script type="text/javascript">


    function searchdoc() {

        var keyword = $("#txtkeyword").val();
        var Category = $("#ddlCategory").val();
        
        window.location = '/top-runner/Product/Search/' + '?q=' + keyword + '&categoryId=' + Category;
        //window.location = jQuery.query.set("keyword", keyword).set("fromdate", fromdate).set("todate", todate).set("Page", "1");
    }
    function XAnyInput_KeyDown(sender, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            searchdoc();

            return false;
        }

        return true;
    }

</script>