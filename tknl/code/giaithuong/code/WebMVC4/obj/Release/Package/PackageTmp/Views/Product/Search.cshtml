@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.ProductModel
<div class="container main-content-page">
    <div class="search-box pt90 border-top-orange">
        <select class="form-control" id="ddlCategory" >
            <option value="-1">--Chọn sản phẩm</option>
            @foreach (var obj in Model.listcate)
            {
                
                <option value="@obj.Id" @if (obj.Id == Model.CategoryId) { @Html.Raw("selected='selected'") ; }>@obj.Name</option>
            }
        </select>
        <div class="keyword">
            <input type="text" id="txtkeyword" class="form-control" placeholder="Từ khóa" onkeydown="javascript: return XAnyInput_KeyDown(this, event);" value="@ViewBag.Keyword">
            <button class="ico-search" onclick="searchdoc()"></button>
        </div>
    </div>
    <div class="mt60 table-responsive">
