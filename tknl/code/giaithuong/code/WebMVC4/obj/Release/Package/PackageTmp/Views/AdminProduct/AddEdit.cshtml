@using UTILS
@using DATA
@using BIZ.Entity
@{

    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@model Product_Full
<div class="well">
    <span class="label label-danger">
        Chú ý!
    </span>
    <span>
        Hãy chắc chắn nhập vào đầy đủ thông tin tại các mục bắt buộc đánh dấu (*)
    </span>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <i class="fa fa-fw fa-user-md"></i><span>@ViewBag.Title</span>
            </div>
            <form id="defaultForm" method="post" class="form-horizontal">
                <div class="panel-group" id="steps">
                    <div class="messager-body">
                        <div class="alert alert-success display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-ok"></span>
                            <label>Đã lưu dữ liệu thành công !!!</label>
                        </div>
                        <div class="alert alert-danger display-hide alert-dismissable">
                            <button type="button" class="close" data-close="alert" aria-hidden="true">×</button>
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <label>Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại</label>
                        </div>
                    </div>
                    <div class="panel panel-info">

                        <div class="panel-body">
                            <!-- dành cho UpdateFunction -->
                            <div style="padding: 10px 0 0 0; background-color: #fff !important" class="nav-tabs-custom">
                                <ul class="nav nav-tabs">
                                    <li class="active"><a href="#tabs-info" data-toggle="tab"><strong>Thông tin chính</strong></a></li>

                                    <li><a href="#tabs-image" data-toggle="tab"><strong>Ảnh</strong></a></li>
                                    <li><a href="#tabs-config" data-toggle="tab"><strong>Thông số</strong></a></li>
                                    <li><a href="#tabs-sub" data-toggle="tab"><strong>Thông tin giới thiệu</strong></a></li>

                                </ul>
                                <div class="tab-content" style="margin-top: 30px;">
                                    <div class="col-md-12 tab-pane" id="tabs-sub">
                                        <div class="form-group">

                                            <div class="col-md-12">
                                                <div class="input-icon right">
                                                    <textarea id="txtIntro" style="height: 500px;" cols="20" name="intro" class="form-control" placeholder="Nhập giới thiệu chung">@Model.Intro</textarea>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 tab-pane active" id="tabs-info">
                                        <div class="form-group">
                                            <label for="txtName" class="control-label col-md-3">Tên sản phẩm :<span class="required">*</span></label>
                                            <div class="col-md-9">
                                                <div class="input-icon right">
                                                    <input type="text" id="txtName" maxlength="200" name="title" value="@Model.Name" class="form-control" placeholder="Nhập tên sản phẩm" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group" style="display: none">
                                            <label for="select_language" class="control-label col-md-3">Ngôn ngữ :<span class="required">*</span></label>
                                            <div class="col-md-9">
                                                <div class="input-icon right">
                                                    <select id="select_language" name="select_language" class="form-control">
                                                        <option value="vi-vn">Tiếng Việt</option>
                                                        <option value="en-us">Tiếng Anh</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="select_category" class="control-label col-md-3">Loại sản phẩm :<span class="required">*</span></label>
                                            <div class="col-md-9">
                                                <div class="input-icon right">
                                                    <select id="select_category" name="select_category" class="form-control"></select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="txtImgPath" class="control-label col-md-3">Ảnh đại diện  :</label>
                                            <div class="col-md-6">
                                                <input type="text" id="txtDescriptImage" name="txtDescriptImage" value="@Model.DescriptImage" class="form-control" placeholder="Nhập ảnh đại diện" />
                                            </div>
                                            <div class="col-md-1">
                                                <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtDescriptImage');"><i class="fa fa-file"></i></a>
                                            </div>
                                        </div>
                                        @if (!String.IsNullOrEmpty(Model.Description))
                                        {
                                            <div class="form-group">
                                                <label for="txtName" class="control-label col-md-3">Link sản phẩm :<span class="required">*</span></label>
                                                <div class="col-md-9">
                                                    <div class="input-icon right">
                                                        <input type="text" id="txtDescription" value="@Model.Description" class="form-control" readonly />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="txtImgPath" class="control-label col-md-3">Ảnh QR  :</label>
                                                <div class="col-md-6">
                                                    <input type="text" id="txtImgPath" name="imgPath" value="@Model.QRImage" class="form-control" placeholder="Nhập ảnh QR" />
                                                </div>
                                                <div class="col-md-1">
                                                    <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtImgPath');"><i class="fa fa-file"></i></a>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="form-group" style="display:none">
                                                <label for="txtImgPath" class="control-label col-md-3">Ảnh QR  :</label>
                                                <div class="col-md-6">
                                                    <input type="text" id="txtImgPath" name="imgPath" value="@Model.QRImage" class="form-control" placeholder="Nhập ảnh QR" />
                                                </div>
                                                <div class="col-md-1">
                                                    <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtImgPath');"><i class="fa fa-file"></i></a>
                                                </div>
                                            </div>
                                        }

                                        <div class="form-group">
                                            <label for="txtYear" class="control-label col-md-3"> Năm đạt giải  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtYear" name="txtYear" value="@Model.ProductParam.Year" class="form-control" />
                                            </div>

                                        </div>


                                        <div class="form-group">
                                            <label class="control-label col-md-3" for="cbxIsActive">Sản phẩm Hot :</label>
                                            <div class="col-md-4">
                                                <div class="checkbox">
                                                    @if (Model.IsHot.GetValueOrDefault())
                                                    {<input type="checkbox" id="cbxIsHot" checked="checked" />}
                                                    else
                                                    {<input type="checkbox" id="cbxIsHot" />
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group" style="display: none">
                                            <label class="control-label col-md-3" for="cbxIsActive">Sản phẩm mới :</label>
                                            <div class="col-md-4">
                                                <div class="checkbox">
                                                    @if (Model.IsNew.GetValueOrDefault())
                                                    {<input type="checkbox" id="cbxIsNew" checked="checked" />}
                                                    else
                                                    {<input type="checkbox" id="cbxIsNew" />
                                                    }

                                                </div>
                                            </div>
                                        </div>


                                        <div class="form-group">
                                            <label class="control-label col-md-3" for="cbxIsActive1">Trạng thái :</label>
                                            <div class="col-md-4">
                                                <div class="checkbox">
                                                    @if (Model.Status.GetValueOrDefault() == 1)
                                                    {
                                                        <input type="checkbox" id="cbxIsActive1" checked="checked" />
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" id="cbxIsActive1" />
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 tab-pane" id="tabs-config">
                                        <div class="form-group">
                                            <label for="txtModel" class="control-label col-md-3">Model  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtModel" name="txtModel" value="@Model.ProductParam.Model" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtNumber" class="control-label col-md-3">Số chứng nhận  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtNumber" name="txtNumber" value="@Model.ProductParam.Number" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtManuface" class="control-label col-md-3">Nhãn hiệu  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtManuface" name="txtManuface" value="@Model.ProductParam.Manuface" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtLogo" class="control-label col-md-3">Logo  :</label>
                                            <div class="col-md-6">
                                                <input type="text" id="txtLogo" name="txtLogo" value="@Model.ProductParam.Logo" class="form-control" />
                                            </div>
                                            <div class="col-md-1">
                                                <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtLogo');"><i class="fa fa-file"></i></a>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="txtMadeIn" class="control-label col-md-3">Xuất xứ  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtMadeIn" name="txtMadeIn" value="@Model.ProductParam.MadeIn" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtWattage" class="control-label col-md-3">Công suất danh định  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtWattage" name="txtWattage" value="@Model.ProductParam.Wattage" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtEfficiency" class="control-label col-md-3">Hiệu suất năng lượng  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtEfficiency" name="txtEfficiency" value="@Model.ProductParam.Efficiency" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtGroupCert" class="control-label col-md-3">Đơn vị đăng ký chứng nhận  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtGroupCert" name="txtGroupCert" value="@Model.ProductParam.GroupCert" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtRule" class="control-label col-md-3">Tiêu chuẩn áp dụng  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtRule" name="txtRule" value="@Model.ProductParam.Rule" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtVolumn" class="control-label col-md-3">Dung tích  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtVolumn" name="txtVolumn" value="@Model.ProductParam.Volumn" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtV" class="control-label col-md-3">Điện áp danh định  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtV" name="txtV" value="@Model.ProductParam.V" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtMadeby" class="control-label col-md-3">Nhà máy sản xuất  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtMadeby" name="txtMadeby" value="@Model.ProductParam.Madeby" class="form-control" />
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <label for="txtGroupExp" class="control-label col-md-3">Đơn vị thử nghiệm  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtGroupExp" name="txtGroupExp" value="@Model.ProductParam.GroupExp" class="form-control" />
                                            </div>

                                        </div>
                                        @*dieu hoa*@
                                        <div class="cateitem" id="cateitem_38">

                                        </div>
                                        @*tu lanh*@
                                        <div class="cateitem" id="cateitem_39">

                                            <div class="form-group">
                                                <label for="txtElectric" class="control-label col-md-3">Điện năng tiêu thụ năm  :</label>
                                                <div class="col-md-7">
                                                    <input type="text" id="txtElectric" name="txtElectric" value="@Model.ProductParam.Electric" class="form-control" />
                                                </div>

                                            </div>

                                        </div>
                                        @*Bình nước nóng*@
                                        <div class="cateitem" id="cateitem_40">

                                        </div>
                                        @*Đèn Led*@
                                        <div class="cateitem" id="cateitem_41">
                                            <div class="form-group">
                                                <label for="txtHZ" class="control-label col-md-3">Tần số  :</label>
                                                <div class="col-md-7">
                                                    <input type="text" id="txtHZ" name="txtHZ" value="@Model.ProductParam.HZ" class="form-control" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="txtLM" class="control-label col-md-3">Quang thông ban đầu  :</label>
                                                <div class="col-md-7">
                                                    <input type="text" id="txtLM" name="txtLM" value="@Model.ProductParam.LM" class="form-control" />
                                                </div>

                                            </div>
                                            
                                            <div class="form-group">
                                                <label for="txtColor" class="control-label col-md-3">Nhiệt độ màu  :</label>
                                                <div class="col-md-7">
                                                    <input type="text" id="txtColor" name="txtColor" value="@Model.ProductParam.Color" class="form-control" />
                                                </div>

                                            </div>
                                           
                                            <div class="form-group">
                                                <label for="txtAge" class="control-label col-md-3">Tuổi thọ công bố  :</label>
                                                <div class="col-md-7">
                                                    <input type="text" id="txtAge" name="txtAge" value="@Model.ProductParam.Age" class="form-control" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="txtCRI" class="control-label col-md-3">Chỉ số thể hiện màu  :</label>
                                                <div class="col-md-7">
                                                    <input type="text" id="txtCRI" name="txtCRI" value="@Model.ProductParam.CRI" class="form-control" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="txtBH" class="control-label col-md-3">Thời gian bảo hành  :</label>
                                                <div class="col-md-7">
                                                    <input type="text" id="txtBH" name="txtBH" value="@Model.ProductParam.BH" class="form-control" />
                                                </div>

                                            </div>
                                            <div class="form-group">
                                                <label for="txtW1000" class="control-label col-md-3">Điện năng sau 1.000h   :</label>
                                                <div class="col-md-7">
                                                    <input type="text" id="txtW1000" name="txtW1000" value="@Model.ProductParam.W1000" class="form-control" />
                                                </div>

                                            </div>
                                        </div>
                                        @*Khác*@
                                    <div class="cateitem" id="cateitem_15">
                                        <div class="form-group">
                                            <label for="txtOther" class="control-label col-md-3">Thông số kỹ thuật khác  :</label>
                                            <div class="col-md-7">
                                                <input type="text" id="txtOther" name="txtOther" value="@Model.ProductParam.Other" class="form-control" />
                                            </div>

                                        </div>
                                    </div>
                                        <div class="form-group">
                                            <label for="txtTracking" class="control-label col-md-3">Mã tracking  :</label>
                                            <div class="col-md-7">
                                                @*<input type="text" id="txtTracking" name="txtTracking" value="@Model.ProductParam.Tracking" class="form-control" />*@
                                                <textarea id="txtTracking" style="height: 100px;" cols="20" name="intro" class="form-control">@Model.ProductParam.Tracking</textarea>
                                            </div>

                                        </div>
                                    </div>
                                    <div class="col-md-12 tab-pane" id="tabs-image">
                                        @for (var index = 1; index <= 5; index++)
                                        {
                                            if (index - 1 < Model.ImageParam.Count)
                                            {
                                                <div class="form-group">
                                                    <div class="col-md-5">
                                                        <input type="text" id="txtFileParamName_@(index)" value="@Model.ImageParam[index-1].Name" class="form-control" placeholder="Nhập tên ảnh" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <input type="text" id="txtFileParamPath_@(index)" value="@Model.ImageParam[index-1].Path" class="form-control" placeholder="Nhập đường dẫn ảnh" />
                                                    </div>
                                                    <div class="col-md-1">
                                                        <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtFileParamPath_@(index)');"><i class="fa fa-file"></i></a>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="form-group">
                                                    <div class="col-md-5">
                                                        <input type="text" id="txtFileParamName_@(index)" value="" class="form-control" placeholder="Nhập tên ảnh" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <input type="text" id="txtFileParamPath_@(index)" value="" class="form-control" placeholder="Nhập đường dẫn ảnh" />
                                                    </div>
                                                    <div class="col-md-1">
                                                        <a href="javascript:;" onclick="CommonCtrl.PopupManagerImages('txtFileParamPath_@(index)');"><i class="fa fa-file"></i></a>
                                                    </div>
                                                </div>
                                            }

                                        }
                                    </div>


                                    <div class="col-md-12">
                                        <div class="panel-footer form-horizontal">
                                            <div class="form-group submit">
                                                <button type="submit" class="btn btn-primary" id="btnSave"><i class="fa fa-save"></i>Lưu lại</button>

                                                <button type="button" class="btn btn-default" id="btnBack" onclick="GotoListpage()"><i class="fa fa-backward"></i>Quay lại</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script>

</script>
<script>
    $('#menu_addproduct').addClass("active");

</script>

<script type="text/javascript">
    $(document).ready(function () {

        var editor = CKEDITOR.instances['txtIntro'];
        if (editor) {
            CKEDITOR.remove(editor);
        }
        CKEDITOR.replace('txtIntro',
            {
                filebrowserBrowseUrl: "/AdminImages/ManageImage",
                filebrowserWindowWidth: '1000',
                filebrowserWindowHeight: '800',
                uiColor: '#FAFAFA',
                allowedContent: true,
                extraAllowedContent: '*(*)',
                extraPlugins: 'youtube',
                toolbar: [
                    {
                        name: 'document',
                        items: ['Source', '-', 'NewPage', 'Preview', '-']
                    },
                    [
                        'Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord',
                        '-',
                        'Undo', 'Redo'
                    ],
                    { name: 'styles', items: ['Font', 'FontSize'] },
                    {
                        name: 'basicstyles',
                        items:
                            [
                                'Bold', 'Italic', 'Underline', 'Strike',
                                'Subscript',
                                'Superscript', '-', 'RemoveFormat'
                            ]
                    },
                    '/',
                    { name: 'colors', items: ['TextColor', 'BGColor'] },
                    {
                        name: 'paragraph',
                        items:
                            [
                                'NumberedList', 'BulletedList', '-', 'Outdent',
                                'Indent', '-', 'Blockquote', '-', 'JustifyLeft',
                                'JustifyCenter', 'JustifyRight', 'JustifyBlock'
                            ]
                    },
                    {
                        name: 'insert',
                        items:
                            [
                                'Image', 'Youtube', 'Flash', 'Table',
                                'HorizontalRule',
                                'Smiley', 'SpecialChar', 'PageBreak', 'Iframe'
                            ]
                    },
                    { name: 'links', items: ['Link', 'Unlink', 'Maximize'] }
                ],
                height: 500
            });


        $('#defaultForm').bootstrapValidator({
            message: 'This value is not valid',
            //live: 'submitted',
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                invalid: 'glyphicon glyphicon-remove',
                validating: 'glyphicon glyphicon-refresh'
            },
            fields: {

                title: {
                    message: 'Nhập tên sản phẩm',
                    validators: {
                        notEmpty: {
                            message: 'tên sản phẩm không được bỏ trống'
                        },

                        stringLength: {
                            min: 5,
                            max: 200,
                            message: 'tên sản phẩm nhỏ nhất 5 ký tự và nhiều nhất 200 ký tự'
                        },

                    }
                },


            }
        })
        .on('success.form.bv', function (e) {
            // Prevent submit form
            e.preventDefault();

            var $form = $(e.target),
                        validator = $form.data('bootstrapValidator');
            SaveData();
            $(".close").click(function () {
                $(".alert-success").css("display", "none");
            });
        })
        .on('error.form.bv', function (e) {
            // Active the panel element containing the first invalid element
            e.preventDefault();
            var $form = $(e.target),
                    validator = $form.data('bootstrapValidator');
            $(".alert-danger label").text("Có một vài lỗi trong khung nhập liệu dưới đây ! kiểm tra lại");
            $(".alert-danger").css("display", "block");
            $(".close").click(function () {
                $(".alert-danger").css("display", "none");
                $(".alert-success").css("display", "none");
            });
        });

        function SaveData() {
            //var content = tinyMCE.get('txtIntro').getContent();
            var img_json = [];
            for (i = 1; i <= 10; i++) {
                if ($("#txtFileParamPath_" + i).val() != '' && $("#txtFileParamPath_" + i).val() != undefined) {
                    var item = {
                        'Path': $("#txtFileParamPath_" + i).val(),
                        'Name': $("#txtFileParamName_" + i).val(),
                    };
                    img_json.push(item);
                }

            }
            var param = {
                'Id': '@Model.Id',
                'Name': $("#txtName").val(),
                'Price': 0,
                'PriceReal': 0,
                'Intro': CKEDITOR.instances['txtIntro'].getSnapshot(),
                'DescriptImage': $("#txtDescriptImage").val(),
                'QRImage': $("#txtImgPath").val(),
                'Description': '',
                'CategoryId': $("#select_category").val(),
                'ManufactoryId': 0,
                'Language': $("#select_language").val(),
                'CategoryPathway': $("#select_category option:selected").attr('title'),
                'IsHot': $("#cbxIsHot").is(":checked") ? true : false,
                'IsNew': $("#cbxIsNew").is(":checked") ? true : false,
                'AvailableSell': $("#cbxAvailableSell ").is(":checked") ? true : false,
                'Status': $("#cbxIsActive1").is(":checked") ? 1 : 0,
                'Album': JSON.stringify(img_json),
                'ProductParam.Model': $("#txtModel").val(),
                'ProductParam.Number': $("#txtNumber").val(),
                'ProductParam.Manuface': $("#txtManuface").val(),
                'ProductParam.Logo': $("#txtLogo").val(),
                'ProductParam.MadeIn': $("#txtMadeIn").val(),
                'ProductParam.Wattage': $("#txtWattage").val(),
                'ProductParam.Efficiency': $("#txtEfficiency").val(),
                'ProductParam.GroupCert': $("#txtGroupCert").val(),
                'ProductParam.Rule': $("#txtRule").val(),
                'ProductParam.GroupExp': $("#txtGroupExp").val(),
                'ProductParam.Tracking': $("#txtTracking").val(),
                'ProductParam.Madeby': $("#txtMadeby").val(),
                'ProductParam.Volumn': $("#txtVolumn").val(),
                'ProductParam.V': $("#txtV").val(),
                'ProductParam.HZ': $("#txtHZ").val(),
                'ProductParam.LM': $("#txtLM").val(),
                'ProductParam.K': $("#txtK").val(),
                'ProductParam.Age': $("#txtAge").val(),
                'ProductParam.Color': $("#txtColor").val(),
                'ProductParam.CRI': $("#txtCRI").val(),
                'ProductParam.BH': $("#txtBH").val(),
                'ProductParam.W1000': $("#txtW1000").val(),
                'ProductParam.Electric': $("#txtElectric").val(),
                'ProductParam.Other': $("#txtOther").val(),
                'ProductParam.Year': $("#txtYear").val(),
            }
            Utils.Loading();
            $.ajax({
                type: 'POST',
                url: "/AdminProduct/SaveData",
                data: addAntiForgeryToken(param),
                async: true,
                success: function (data) {

                    Utils.UnLoading();
                    if (data.ResponseCode == 0) {
                        setTimeout(function () { $(".alert-success").hide("slow"); GotoListpage(); }, 500);
                    }
                    else {

                        setTimeout(function () { $(".alert-success").hide("slow"); window.location = '/AdminProduct/AddEdit/' + data.ResponseCode; }, 500);
                    }
                }
            });
        }
    });

    function LoadCate(rvalue, lang) {
        $.ajax({
            cache: false,
            type: "GET",
            url: "/AdminProduct/GetListCate?lang=" + lang,
            data: {},
            success: function (data) {
                $('#select_category').html('');
                var html = '';
                $.each(data, function (id, item) {

                    if (rvalue == item.Id) {
                        html = '<option selected="selected" value="' + item.Id + '" title="' + item.Pathway + '">';
                    }
                    else {
                        html = '<option value="' + item.Id + '" title="' + item.Pathway + '">';
                    }
                    if (item.NodeLevel != 0) {
                        for (var i = 1; i < item.NodeLevel; i++) {
                            html += '-+&nbsp;';
                        }
                    }

                    html += item.Name;
                    html += '</option>';

                    if (item.ParentId != 0) {
                        if ($('#select_category option[value=' + item.ParentId + ']').length)
                            $('#select_category option[value=' + item.ParentId + ']').after(html);
                        else
                            $('#select_category').append(html);
                    }
                    else
                        $('#select_category').append(html);


                });

            },

        });
    }

    LoadCate('@Model.CategoryId', 'vi-vn');


    $("#select_language").change(function () {
        LoadCate('0', $(this).val())

    });

    function GotoListpage() {
        window.location.href = '/AdminProduct/';
    }




</script>

<script>
    var cate = '@Model.CategoryId';
    $(".cateitem").hide();
    $("#cateitem_" + cate).show();

    $('#select_category').on('change', function () {
        
        $(".cateitem").hide();
        $("#cateitem_" + this.value).show();

    });

</script>