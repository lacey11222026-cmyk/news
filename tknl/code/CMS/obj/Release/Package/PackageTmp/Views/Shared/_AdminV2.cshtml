                Copyright © 2014 VTK<br />

            </div>
            <!-- End footer -->
        </div>
        <div class="loading" align="center">
            <img alt="Đang tải dữ liệu" src="/images/ajax-loader.gif" />
        </div>

        <div id="TB_overlay" class="TB_overlayBG fullscreenFF" style="z-index: 999;">&nbsp;</div>
        <!-- End content -->
    </div>
</body>
