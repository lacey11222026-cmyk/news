   @* @Scripts.Render("~/scripts/site")*@
    <script stype="text/javascript">
        function ShowProgress() {
            setTimeout(function () {
                var modal = $('<div />');
                modal.addClass("modal");
                $('body').append(modal);
                var loading = $(".loading");
                loading.show();
                var top = Math.max($(window).height() / 2 - loading[0].offsetHeight / 2, 0);
                var left = Math.max($(window).width() / 2 - loading[0].offsetWidth / 2, 0);
                loading.css({ top: top, left: left });
                $(".fullscreenFF").css({ height: $(document).height() });
                $(".TB_overlayBG").show();
                $('.content').css({ opacity: 0.4 });
            }, 200);
        }
    </script>
    <style>
        .moxman-thumb img { margin-top: 0 !important; }
        .mce-content-body blockquote { background: none repeat scroll 0 0 #EEEEEE; border: 1px solid #D6DCE8; margin: 10px auto; padding: 3px; min-width: 300px; min-height: 30px; border-collapse: inherit; }
    </style>
</head>
<body>
    <div class="content_wrapper">
        <!-- Begin header -->
        @Html.Partial("Admin_Header")

        <!-- End header -->
        <!-- Begin left panel -->
        <a href="javascript:;" id="show_menu">&raquo;</a>
        <div id="left_menu">
            <a href="javascript:;" id="hide_menu">&laquo;</a>
            @Html.Partial("Admin_MenuLeft")
            <br class="clear" />
            <!-- Begin left panel calendar -->
            @* <div id="calendar">
                </div>*@
