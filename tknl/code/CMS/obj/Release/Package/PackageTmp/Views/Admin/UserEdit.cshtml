@{
   
    Layout = "~/Views/Shared/_AdminV2.cshtml";
    
}
@using BIZ
@using UTILS
@using CMS.Helper
@model CMS.Models.ViewUserDetail

<div class="onecolumn">
    <div class="header">
        <span>@ViewBag.Title</span>

    </div>
    <br class="clear">
    <div class="content">
        <div class="login" style="float: left">
            <div class="login-left">
                @Html.Label("Tên đăng nhập:")
            </div>
            <div class="login-right">
                @Html.Label("UserName", Model.user.UserName)
            </div>
            <div class="clear">
            </div>
            <div class="login-left">
                @Html.Label("Mật khẩu:")
            </div>
            <div class="login-right">
                @Html.Password("NewPassword")
            </div>
            <div class="clear">
            </div>
            <div class="login-left">
                @Html.Label("Xác nhận mật khẩu:")
            </div>
            <div class="login-right">
                @Html.Password("ConfirmPassword")
            </div>
            <div class="clear">
            </div>
            
            <div class="button_login">

                <input type="button" onclick="changepass('@Model.user.UserName')" value="Đổi mật khẩu">
            </div>
            <br class="clear" />
          
            <div class="login-left">
                @Html.Label("Email:")
            </div>
            <div class="login-right">
                 @Html.TextBox("Email", Model.user.Email)
            </div>
            <div class="clear">
            </div>
            <div class="login-left">
                @Html.Label("Ngày tạo:")
            </div>
            <div class="login-right">
                 @Model.user.CreationDate
            </div>
            <div class="clear">
            </div>
            <div class="login-left">
                @Html.Label("Lần đăng nhập trước:")
            </div>
            <div class="login-right">
                 @Model.user.LastLoginDate
            </div>
            <div class="clear">
            </div>
            <div class="login-left">
                @Html.Label("Lần đăng thay mật khẩu trước:")
            </div>
             <div class="login-right">
                 @Model.user.LastPasswordChangedDate
            </div>
            <div class="clear">
            </div>
        </div>
        <div class="login" style="float: right; margin-right: 150px;">
              @foreach (string role in Model.rolenames)
                                    {
                                        <div>
                                                @if (Model.user_roles.Contains(role))
                                                {
                                                    <input type="checkbox"  checked="checked" class="chkRole" /> @role
                                                }
                                                else
                                                {
                                                    <input type="checkbox"  value="@role" class="chkRole" />  @role
                                                }
                                          </div>
                                    }
        </div>
        <br class="clear" />
    </div>
</div>



<script type="text/javascript">
    function Close() {
        window.location.href = "@Url.Action("Index", "Admin")";
    }
    $(document).ready(function () {
        $('#menu_generate').click();
    });
    function changepass(username) {
        if(confirm("Bạn có chắc chắn muốn đổi mật khẩu"))
        {
            var newPassword = $('#NewPassword').val();
            validateForm();
            $.post('@Url.Action("UserChangPass", "Admin")',
                { "username": username, "newPassword": newPassword },
                function (data) {
                    Close();
                });

        }
    }
    
    function validateForm() {
        var NewPassword = $('#NewPassword').val();
        var ConfirmPassword = $('#ConfirmPassword').val();

        if (NewPassword == "") {
            alert('Mật khẩu không được trống');
            $('#NewPassword').focus();
            return false;
        }
        if (NewPassword.length < 6) {
            alert('Mật khẩu phải trên 6 kí tự');
            $('#NewPassword').focus();
            return false;
        }
        if (NewPassword != ConfirmPassword) {
            alert('Mật khẩu không hợp lệ');
            $('#ConfirmPassword').focus();
            return false;
        }

        return true;

    }
</script>
