@using STATS
@model IEnumerable<OverviewByHour>

@{
    ViewBag.Title = "Thống kê lưu lượng truy cập theo giờ";
    Layout = "~/Views/Shared/_AdminV2.cshtml";

    var categories = String.Format("[{0}]", String.Join(",", (List<int>)ViewBag.CategoriesData));
    var sessions = String.Format("[{0}]", String.Join(",", (List<int>)ViewBag.SessionsData));
    var users = String.Format("[{0}]", String.Join(",", (List<int>)ViewBag.UsersData));
    var pageviews = String.Format("[{0}]", String.Join(",", (List<int>)ViewBag.PageviewsData));
}

<div class="onecolumn" id="product-tabs">
    <div class="header">
        <span>@ViewBag.Title</span>
    </div>

    <br class="clear">
    <div class="content">
        <p style="text-align:right;">
            <b>Từ ngày:</b>&nbsp;
            <input name="fromdate" id="txtFromdate" value="@ViewBag.StartDate" />&nbsp;&nbsp;&nbsp;
            <b>Đến ngày</b>:&nbsp;
            <input name="todate" id="txtTodate" value="@ViewBag.EndDate" />&nbsp;&nbsp;&nbsp;
            <button onclick="fillter();">Xem thống kê</button>
        </p>
        <div class="clear"></div>
        <div id="charts">
            <div id="container">
            </div>
        </div>
        <div style="padding-top: 38px; padding-left: 26px; font-weight: 100; color: #3E576F; font-family: 'Lucida Grande','Lucida Sans Unicode',Verdana,Arial,Helvetica,sans-serif; font-size: 16px;">
            Bảng số liệu đầy đủ của biểu đồ
        </div>
        <table class="tablestatistic" cellpadding="0" cellspacing="0" style="float: left; width: 90%; margin-right: 0px;">
            <tr class="tableheader">
                <td>Tiêu chí/Giờ</td>
                @foreach (var item in ViewBag.CategoriesData)
                {
                    <td>@item</td>
                }
            </tr>
            <tr>
                <td>Lượt truy cập</td>
                @foreach (var item in ViewBag.SessionsData)
                {
                    <td>@item</td>
                }
            </tr>
            <tr>
                <td>Người dùng</td>
                @foreach (var item in ViewBag.UsersData)
                {
                    <td>@item</td>
                }
            </tr>
            <tr>
                <td>Số lần xem trang</td>
                @foreach (var item in ViewBag.PageviewsData)
                {
                    <td>@item</td>
                }
            </tr>
        </table>
        <div class="clear"></div>
    </div>
    <div class="clear"></div>
    <script type="text/javascript">
        $(function(){
            $("#txtFromdate").datepicker({ dateFormat: "dd/mm/yy" });
            $("#txtTodate").datepicker({ dateFormat: "dd/mm/yy" });
            $('#menu_report').click();
        });

        function fillter() {
            var fromdate = $("#txtFromdate").val();
            var todate = $("#txtTodate").val();
            window.location = jQuery.query.set("Start", fromdate).set("End", todate);
        }

        $(function () {
            var chart;
            $(document).ready(function () {
                chart = new Highcharts.Chart({
                    chart: {
                        renderTo: 'container',
                        type: 'line'
                    },
                    title: {
                        text: '@Html.Raw(ViewBag.Title)',
                        x: -20 //center
                    },
                    subtitle: {
                        text: '',
                        x: -20
                    },
                    xAxis: {
                        categories: @categories
                        },
                    yAxis: {
                        title: {
                            text: 'Số lượng'
                        },
                        plotLines: [{
                            value: 0,
                            width: 1,
                            color: '#808080'
                        }]
                    },
                    tooltip: {
                        valueSuffix: ''
                    },
                    legend: {
                        layout: 'vertical',
                        align: 'right',
                        verticalAlign: 'middle',
                        borderWidth: 0
                    },
                    series: [{
                        name: 'Lượt truy cập',
                        data: @sessions
                        }, {
                            name: 'Người dùng',
                            data: @users
                            }, {
                                name: 'Số lần xem trang',
                                data: @pageviews
                                }]
                });
            });
        });
    </script>
    <style type="text/css">
        .tablestatistic { margin-left: 26px; border-top: 1px solid #CCCCCC; border-left: 1px solid #CCCCCC; }
            .tablestatistic td { padding: 3px 2px; border-bottom: 1px solid #CCCCCC; border-right: 1px solid #CCCCCC; text-align: center; }
        .tableheader { background: #eee; font-weight: bold; }
    </style>
</div>
