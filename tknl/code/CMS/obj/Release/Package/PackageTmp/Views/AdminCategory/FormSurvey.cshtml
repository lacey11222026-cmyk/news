@model DATA.Survey

<script type="text/javascript">


    $(document).ready(function () {

        $("#SBeginDate").datepicker({ dateFormat: "dd/mm/yy" });
        $("#SEndDate").datepicker({ dateFormat: "dd/mm/yy" });
    });

    function validateForm() {
        var name = $('#Title').val();
        if (name == "") {

            alert('Tên không được trống');
            $('#Title').focus();
            return false;
        }
        var description = $('#Content').val();
        if (description == "") {

            alert('Content không được trống');
            $('#Content').focus();
            return false;
        }
        //var params = "";
        //$("#SelectedNews option").each(function () {
        //    params = params + $(this).val() + ",";

        //});
        //$('#CategoryPath').val(params);
        ShowProgress();
        return true;

    }

</script>

