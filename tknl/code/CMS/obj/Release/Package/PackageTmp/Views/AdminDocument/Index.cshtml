@{
   
    Layout = "~/Views/Shared/_AdminV2.cshtml";
    
}
@using UTILS
@using CMS.Models
@using CMS.Helper
@model CMS.Models.DocumentModel

<div class="onecolumn">
    <div class="header">
        <span>@ViewBag.Title</span>
    </div>
    <br class="clear">
    <div class="content">
        <b>Trạng thái: </b>@Html.DropDownList("drlStatus", new SelectList(ViewBag.StatusList, "Value", "Text", ViewBag.Status), new { @class = "drl_Group" }) &nbsp;&nbsp;
        <b>Chuyên mục: </b>@Html.DropDownList("drlCategory", new SelectList(ViewBag.CategoryList as System.Collections.IEnumerable, "Id", "Name", ViewBag.CategoryId), new { @class = "drl_Group", @style = "width:180px" }) &nbsp;&nbsp;
     
       
      
        
        <br />
        <br />

        <button onclick="fillter();">Tra cứu</button>
        <br />
        <br />
        @if (Model != null)
        {
            
            <table width="100%" cellspacing="0" cellpadding="0" class="data" id="mytable">
                <tbody>
                    <tr id="rowheader">
                        @* <th scope="col">ID
                        </th>*@
                        <th scope="col">Mã
                        </th>
                        <th scope="col">Tiêu đề
                        </th>


                        <th scope="col">Chuyên mục
                        </th>
                        <th scope="col">File đính kèm
                        </th>

                        <th scope="col">Người tạo
                        </th>
                        <th scope="col">Ngày tạo
                        </th>
                        <th scope="col">Ngày ban hành
                        </th>
                        @*<th scope="col">Ngày có hiệu lực
                        </th>
                        <th scope="col">Ngày hết hiệu lực
                        </th>*@
                        <th scope="col">Cơ quan ban hành
                        </th>
                        <th scope="col">Người ký
                        </th>
                        <th scope="col">Trạng thái
                        </th>



                        <th scope="col">Quản trị
                        </th>
                    </tr>
                    @if (Model.listdata != null)
                    {
                        if (Model.listdata.Count > 0)
                        {
                            foreach (var item in Model.listdata)
                            {
                        <tr id="row_@(item.Id)">
                            @*<td>
                                @item.Id
                            </td>*@
                            <td>
                                @item.Code
                            </td>
                            <td style="width: 333px;">
                                <a href='@Url.Action("AddEdit", "AdminDocument", new { Id = item.Id })'>@item.Name</a>

                            </td>

                            <td>

                                @HtmlHelpers.GetNewsCategoryName(item.CategoryId.Value, ViewBag.CategoryList)
                            </td>
                            <td>
                                @item.FileName
                            </td>
                            <td>
                                @item.CreatedBy
                            </td>
                            <td>
                                @Utils.FormatDateForDocument(item.CreatedDate)
                            </td>
                            <td>
                                @Utils.FormatDateForDocument(item.PublishDate)
                            </td>
                            @*<td>
                                @item.EffectiveDate
                            </td>
                            <td>
                                @item.ExpiryDate
                            </td>*@

                            <td>
                                @item.SignedByDesc
                            </td>
                            <td>
                                @item.SignedBy
                            </td>
                            <td>
                                @HtmlHelpers.GetNewsStatusName(item.Status.Value, ViewBag.StatusList)

                            </td>
                            <td>
                                <a onclick="return deletedoc('@item.Id ');" href="javascript:void(0);">
                                            <img class="help" alt="delete" src="/Styles/admin/images/icon_delete.png">
                                        </a>
                            </td>




                        </tr>
                            }
                        }
                    }
                </tbody>
            </table>
            <div class="pagination">
                @{Html.RenderPartial("AdminPagination", new PaginationInfo
                  {
                      PageUrl = Url.SetParameter("page", "!0"),
                      CurrentPage = Model.pageIndex,
                      PageSize = Model.pageSize,
                      TotalItemCount = Model.total,
                  }); }
            </div>

        }
        <br />
        <a  class="adminbutton" href='@Url.Action("AddEdit", "AdminDocument")'>Thêm mới </a>

    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#menu_news').click();


    });
    function deletedoc(Id) {
        if (confirm("Bạn có chắc chắn muốn xóa?")) {
            $.post('@Url.Action("Delete", "AdminDocument")', { "Id": Id },
                function (data) {
                    $('#row_' + Id).hide();
                });
        }
    }
    function fillter() {
        var title = $("#Keyword").val();

        window.location = jQuery.query.set("title", title).set("page", "1");
    }

    $('#drlStatus').change(function () {
        window.location = jQuery.query.set("Status", this.value).set("page", "1");
    });
    $('#drlCategory').change(function () {
        window.location = jQuery.query.set("CategoryId", this.value).set("page", "1");
    });
    $('#drlAccount').change(function () {
        window.location = jQuery.query.set("author", this.value).set("page", "1");
    });

    $('#Keyword').keyup(function (e) {
        if (e.keyCode == 13) {
            window.location = jQuery.query.set("title", this.value).set("page", "1");
        }
    });
    function openWin(url) {
        myWindow = window.open(url, '', 'width=868,height=668');
        myWindow.focus();
    }

</script>

