@{
   
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}


    <div id="toolbar-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m">
            <div class="toolbar" id="toolbar">
                <table class="toolbar">
                    <tr>
                        <td class="button" id="toolbar-save">
                            <a id="lnkSave" class="toolbar" href="javascript:void(0);" onclick="Save('close');">
                                <span class="icon-32-save" title="Save"></span>Lưu lại</a>
                        </td>
                        <td class="button" id="toolbar-apply">
                            <a id="lnkApply" class="toolbar" href="javascript:void(0);" onclick="Save();"><span
                                class="icon-32-apply" title="Apply"></span>Áp dụng</a>
                        </td>
                        <td class="button" id="toolbar-cancel">
                            <a id="lnkClose" class="toolbar" href="javascript:void(0);" onclick="Close();"><span
                                class="icon-32-cancel" title="Close"></span>Đóng</a>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="header icon-48-addedit">
                Hỗ trợ: <small><span id="spDetailTitle"></span></small>
            </div>
            <div class="clr">
            </div>
        </div>
        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
    <div class="clr">
    </div>
    <div id="element-box">
        <div class="t">
            <div class="t">
                <div class="t">
                </div>
            </div>
        </div>
        <div class="m" id="all_item_info_container">
            <div id="jalert_notification">
                &nbsp;</div>
            <div id="tabs">
                <div class="col width-40" id="tabs-1">
                    <fieldset>
                        <legend>Thông tin chi tiết hỗ trợ</legend>
                        <table class="admintable" cellspacing="1">
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Tên người hỗ trợ
                                    </label>
                                </td>
                                <td>
                                    <input id="txtContacter" type="text" class="inputbox" maxlength="100" style="width: 250px" />
                                </td>
                            </tr>
                           
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Yahoo
                                    </label>
                                </td>
                                <td>
                                    <input id="txtYahoo" type="text" class="inputbox" maxlength="100" style="width: 150px" />
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Skype
                                    </label>
                                </td>
                                <td>
                                    <input id="txtSkype" type="text" class="inputbox" maxlength="100" style="width: 150px" />
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Mail
                                    </label>
                                </td>
                                <td>
                                    <input id="txtMail" type="text" class="inputbox" maxlength="100" style="width: 250px;
                                        margin-bottom: 0px;" />
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Phone
                                    </label>
                                </td>
                                <td>
                                    <input id="txtPhone" type="text" class="inputbox" maxlength="100" style="width: 150px" />
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Mobile
                                    </label>
                                </td>
                                <td>
                                    <input id="txtMobile" type="text" class="inputbox" maxlength="100" style="width: 100px" />
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Tình trạng
                                    </label>
                                </td>
                                <td>
                                    <input name="radPublished" type="radio" value="0" checked="checked" />
                                    Khóa
                                    <input name="radPublished" type="radio" value="1" />
                                    Hoạt động
                                </td>
                            </tr>
                            <tr>
                                <td class="key">
                                    <label for="">
                                        Ordering
                                    </label>
                                </td>
                                <td>
                                    <input id="txtOrdering" type="text" class="inputbox" maxlength="100" style="width: 50px"
                                        value="0" />
                                </td>
                            </tr>
                        </table>
                    </fieldset>
                </div>
                <div class="clr">
                </div>
            </div>
        </div>
        <div class="b">
            <div class="b">
                <div class="b">
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        var SupportId = '@ViewBag.Id';
        var redirectUrl = '@Url.Action("Support","AdminCategory")';

        $(document).ready(function () {
            //alert(redirectUrl);
            //            BindCategoriesToSelectBox();            
            OnLoad();
        });

        function OnLoad() {

            if (SupportId != 0) {

                $('#spDetailTitle').text('Sửa chữa');

                $.Services({
                    serviceName: 'SupportService.ashx',
                    data: {
                        __m: 'get_Support',
                        _id: SupportId
                    },
                    success: function (data) {

                        if (data != undefined && data != null && data != '')
                            BindData(data);
                        else
                            $('#all_item_info_container').html("Thông tin hỗ trợ không tồn tại hoặc đã bị xóa");

                        DestroyDialog();
                    }
                });
            }
            else {
                $('#spDetailTitle').text('Tạo mới');
                DestroyDialog();
            }
        }

        function BindData(data) {

            $('#txtContacter').val(data.Supporter);
            //            $('#select_category option[value=' + data.CategoryId + ']').attr('selected', 'selected');

            $('#txtYahoo').val(data.Yahoo);
            $('#txtSkype').val(data.Skype);
            $('#txtMail').val(data.Mail);
            $('#txtPhone').val(data.Phone);
            $('#txtMobile').val(data.Mobile);
            $('#txtOrdering').val(data.Ordering);

            $('input[name="radPublished"]').each(function (i, e) {
                if ($(e).val() == data.Published)
                    $(e).prop('checked', true); 
                else
                    $(e).prop('checked', false); 
            });



        }

        function FormValidate() {
            var Contacter = $.trim($('#txtContacter').val());
            if (Contacter == '') {
                $('#jalert_notification').jAlert('họ tên không được để trống', 'warning', "edit", 400);
                $('#txtCode').focus();
                return false;
            }

          

            return true;
        }
        
        function PostObj(method) {

            if (!FormValidate())
                return;

            var Contacter = Encoder.urlEndcode($.trim($('#txtContacter').val()));
            var categoryId = 0;


            var yahoo = $('#txtYahoo').val();
            var skype = $('#txtSkype').val();
            var mail = $('#txtMail').val();
            var phone = $('#txtPhone').val();
            var mobile = $('#txtMobile').val();
            var ordering = $('#txtOrdering').val();

            var published = 0;
            published = $('input[name="radPublished"]:checked').val();

            var post_data = {
                __m: method,
                id: SupportId,
                categoryid: categoryId,
                Contacter: Contacter,
                yahoo: yahoo,
                skype: skype,
                mail: mail,
                phone: phone,
                mobile: mobile,
                ordering: ordering,
                published: published

            }

            return post_data;
        }

        function Save(type) {

            DestroyJAlert();

            OpenAlertDialog('Đang xử lý ...');

            $.Services({
                isCrossDomain: false,
                url: POST_URL + 'SupportService.ashx',
                data: PostObj('save'),
                success: function (data) {

                    if (data != undefined && data != null && data != '') {
                        var json_data = eval('(' + data + ')');

                        if (json_data.Success) {

                            if (json_data.Value != 0 && json_data.Value != null && json_data.Value != undefined && json_data.Value != '') {
                                SupportId = json_data.Value;
                            }

                            //OnLoad();
                        }
                    }

                    if (type != undefined && type != null && type != '' && type == 'close')
                        Close();

                    DestroyDialog();

                    var jalert_type = "info";
                    if (!json_data.Success)
                        jalert_type = "fatal";

                    $('#jalert_notification').jAlert(json_data.Text, jalert_type, "edit", 400);
                }
            });
        }

        function Close() {
            window.location.href = redirectUrl;
        }
       

       
        
    </script>


