@model IEnumerable<STATS.TopContentByDay>

@{
    ViewBag.Title = "Thống kê lượt truy cập theo bài viết";
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}

<div class="onecolumn" id="product-tabs">
    <div class="header">
        <span>@ViewBag.Title</span>
    </div>

    <br class="clear">
    <div class="content">
        <p style="text-align:right;">
            <b>Từ ngày:</b>&nbsp;
            <input name="fromdate" id="txtFromdate" value="@ViewBag.StartDate" />&nbsp;&nbsp;&nbsp;
            <b>Đến ngày</b>:&nbsp;
            <input name="todate" id="txtTodate" value="@ViewBag.EndDate" />&nbsp;&nbsp;&nbsp;
            <button onclick="fillter();">Xem thống kê</button>
        </p>
        <div class="clear"></div>
        <div id="charts">
            <div id="container">
            </div>
        </div>
        <div style="padding-top: 38px; padding-left: 26px; font-weight: 100; color: #3E576F; font-family: 'Lucida Grande','Lucida Sans Unicode',Verdana,Arial,Helvetica,sans-serif; font-size: 16px;">
            Top bài viết được xem nhiều nhất
        </div>
        <table class="tablestatistic" cellpadding="0" cellspacing="0" style="float: left; width: 90%; margin-right: 0px;">
            <tr class="tableheader">
                <td>STT</td>
                <td>Bài viết</td>
                <td>Trang web</td>
                <td>Lượt xem trang</td>
                <td>Người dùng</td>
            </tr>
            @{ var index = 1;}
            @foreach (var item in Model)
            {
                <tr>
                    <td>@index</td>
                    <td>@item.Title</td>
                    <td>@item.SiteName</td>
                    <td>@item.Pageviews</td>
                    <td>@item.Users</td>
                </tr>
                index++;
            }

        </table>
        <div class="clear"></div>
    </div>
    <div class="clear"></div>
    <script type="text/javascript">
        $(function () {
            $("#txtFromdate").datepicker({ dateFormat: "dd/mm/yy" });
            $("#txtTodate").datepicker({ dateFormat: "dd/mm/yy" });
            $('#menu_report').click();
        });

        function fillter() {
            var fromdate = $("#txtFromdate").val();
            var todate = $("#txtTodate").val();
            window.location = jQuery.query.set("Start", fromdate).set("End", todate);
        }
    </script>
    <style type="text/css">
        .tablestatistic { margin-left: 26px; border-top: 1px solid #CCCCCC; border-left: 1px solid #CCCCCC; }
            .tablestatistic td { padding: 3px 2px; border-bottom: 1px solid #CCCCCC; border-right: 1px solid #CCCCCC; text-align: center; }
        .tableheader { background: #eee; font-weight: bold; }
    </style>
</div>
