@{
   
    Layout = "~/Views/Shared/_AdminV2.cshtml";
    
}
<link href="/Styles/admin/css/blue/tab.css" rel="stylesheet" type="text/css" />
<script type="text/javascript">
    $(document).ready(function () {
        $('#menu_category').click();

    });

    function doStart() {
        if(validateForm()) {
            var Password = $('#Password').val();
            var NewsPassword = $('#NewsPassword').val();
            $.post('@Url.Action("UserUserChangePassword", "Account")', { "Password": Password, "NewsPassword": NewsPassword },
               function (data) {
                   alert(data);
               });
        }
    }
    function validateForm() {
        var Password = $('#Password').val();
        if (Password == "") {

            alert('Mật khẩu không được trống');
            $('#Password').focus();
            return false;
        }
        var NewsPassword = $('#NewsPassword').val();
        if (NewsPassword == "") {

            alert('Mật khẩu mới không được trống');
            $('#NewsPassword').focus();
            return false;
        }
        if (NewsPassword.length<6) {

            alert('Mật khẩu có độ dài tối thiểu 6 ký tự');
            $('#NewsPassword').focus();
            return false;
        }
        var RePassword = $('#RePassword').val();
        if (NewsPassword != RePassword) {
            alert('Mật khẩu không giống nhau');
            $('#NewsPassword').focus();
            return false;
        }
        return true;

    }


</script>
<div class="onecolumn" id="product-tabs">
    <div class="header">
        <span>Đổi mật khẩu</span>
        
    </div>
    <br class="clear">
    <div class="content">
       
            <div class="login" id="tabs-info">


                <div class="login-left">
                    @Html.Label("Mật khẩu hiện tại:")
                </div>
                <div class="login-right">
                   <input type="text" class = "textbox" name="Password" id="Password"/>
                   
                </div>
                <div class="clear">
                </div>
                <div class="login-left">
                    @Html.Label("Mật khẩu mới:")
                </div>
                <div class="login-right">
                     <input type="text" class = "textbox" name="NewsPassword" id="NewsPassword"/>
                </div>
                <div class="clear">
                </div>
                <div class="login-left">
                    @Html.Label("Gõ lại mật khẩu:")
                </div>
                 <div class="login-right">
                     <input type="text" class = "textbox" name="RePassword" id="RePassword"/>
                </div>
                <div class="clear">
                </div>

            </div>
            <div class="button_login">
                <div>

                    <input type="button" value="Cập nhật" onclick="doStart(); return false;" />


                    &nbsp;
                    <input type="button" value="Quay lại" onclick="javascript: history.go(-1);" />
                </div>
            </div>
            <div class="clear">
            </div>
            
        
        
    </div>
</div>
