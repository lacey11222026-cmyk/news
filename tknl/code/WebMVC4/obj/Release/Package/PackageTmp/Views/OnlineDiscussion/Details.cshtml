    $(document).ready(function () {
        $(".paddetail img").each(function (i) {
            if ($(this).width() > 640) {
                $(this).css('width', '640px');
            }
        });
    });



    $("#loading").hide();
    //$("#btnReg").show();
    function regQuestion() {
        var _name = $('#txtName').val();
        var _age = $('#txtAge').val();
        var _sex = $('#ddlSex').val();
        var _location = $('#txtLocation').val();
        var _question = $('#txtQuestion1').val();

        if (_name == "" || _age == "" || _location == "" || _question == "") {
            alert("Bạn vui lòng điền đầy đủ thông tin");
            return;
        }
        $("#loading").show();
        $.post('@(Url.Action("RegisterAdd", "OnlineDiscussion") + "")', { name: _name, age: _age, sex: _sex, location: _location, ques : _question }, function (data) {
            if (data > 0) {
                window.location = "/";
                return;
            }
            alert(data);
            $("#loading").hide();
        });
    };

</script>


<script type="text/javascript">
    var currPage = 1;
    var pageCount = 1;
    var discussID = @(ViewBag.DiscussID);
        var readerID =  @(ViewBag.ReaderID);
    var isAuto = false;
    function getDisscuss(page) {
        loading();

        $.getJSON('@(Url.Action("GetDiscuss", "OnlineDiscussion"))', { 'id': discussID, 'p': page, 'd': $("#hdfCurrentDate").val() }, function(data) {
                currPage = page;
                pageCount = parseInt(data.totalPage);

                $("#div_discuss").html(data.items);
                $("#div_discuss_loading").html("");
                $("#pager").pager({ pagenumber: page, pagecount: pageCount, buttonClickCallback: PageClick });

                if(isAuto)
                    setTimeout(function(){
                        getDisscuss(pageCount);
                    }, 60000);
            });
        }

        ;

        PageClick = function(pageclickednumber) {
            $("#pager").pager({ pagenumber: pageclickednumber, pagecount: pageCount, buttonClickCallback: PageClick });
            if (pageclickednumber == pageCount)
                isAuto = true;
            else
                isAuto = false;
            getDisscuss(pageclickednumber);
        };

        function postQuestion() {
            if (validRequireField($("#txtQuestion").val(), "Câu hỏi")) {
                $("#btnPost").attr('disabled', 'disabled');

                var dataString = "id=" + discussID + "&r=" + readerID+ "&q=" + $("#txtQuestion").val() + "&g=" + $('#dllGuest').val();
                $.ajax({
                    type: "POST",
                    url: "@(Url.Action("PostQuestion", "OnlineDiscussion") + "")",
                    data: dataString,
                    cache: false,
                    success: function(data) {
                        if (data == "-1") {
                            alert("Bạn hãy điền đầy đủ thông tin.");
                            return;
                        } else if (data == "-2") {
                            alert("Bạn hãy chờ 10 giây để tiếp tục đưa ý kiến.");
                            return;
                        } else {
                            $("#txtQuestion").val("");

                            alert("Thông tin của bạn đã được gửi.");
                        }

                        $("#btnPost").attr('disabled', '');
                    }
                });
            }
        }

        ;

        function validRequireField(str, name) {

            if ($.trim(str) == "" || $.trim(str) == name) {
                alert(name + " không được để trống.");
                return false;
            }

            return true;
        }

        function loading() {
            $("#div_discuss_loading").html("<div style='margin: 0px auto;'>Loading ...</div>");
        }

        $(document).ready(function() {
            $("#btnPost").click(postQuestion);
            $("#btnReg").click(regQuestion);
            getDisscuss(1);

        });

</script>