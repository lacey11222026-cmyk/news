@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewModel
@if (Model != null)
{
    if (Model.lstdata.Count > 0)
    {


        <div class="title-cm01">
            <a href="@Model.Url">@Model.HeaderTitle</a>
        </div>
        <div class="row mt30">
            <div class="col-sm-6 col-xs-12">
                @foreach (var item in Model.lstdata.Take(1).Select((value, i) => new { i, value }))
                {
                    <div class="newsbig">
                        <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=367&h=206&mode=crop" alt=""></a>
                        <h2 class="mt10"><a href="@item.value.LinkUrl">@item.value.Title</a></h2>
                        <span class="newsdate mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                        <p class="mt10">@item.value.IntroText</p>
                    </div>
                }

            </div>
            <div class="col-sm-6 col-xs-12">
                <ul class="newslist02">
                    @foreach (var item in Model.lstdata.Skip(1).Select((value, i) => new { i, value }))
                    {

                        <li>
                            <a href="@item.value.LinkUrl">
                                <img src="@item.value.MainImage?w=110&h=73&mode=crop">
                                <span>@item.value.Title</span>
                            </a>
                        </li>
                    }


                </ul>
                @*<a href="@Model.Url" class="btn-viewmore mt20">Xem thêm <span>+</span></a>*@
            </div>
        </div>

       


}
}