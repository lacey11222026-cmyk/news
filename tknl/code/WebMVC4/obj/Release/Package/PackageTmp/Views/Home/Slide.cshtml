@using BIZ
@using BIZ.Entity
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.SlideModel
@if (Model != null)
{

    <div class="row maxheight05">
        <div class="col-sm-8">
            @foreach (var item in Model.LstHotNews.Take(1).Select((value, i) => new { i, value }))
            {
                if (ViewBag.IsMobile)
                {
                    <div class="newsbig" id="newsbig">
                        <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=367&mode=crop" alt=""></a>
                        <h2 class="mt10"><a href="@item.value.LinkUrl">@item.value.Title</a></h2>
                        <span class="newsdate mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                        <p class="mt10">@item.value.IntroText</p>
                    </div>
                }
                else
                {
                    <div class="newsbig" id="newsbig">
                        <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=500&h=281&mode=crop" alt=""></a>
                        <h2 class="mt10"><a href="@item.value.LinkUrl">@item.value.Title</a></h2>
                        <span class="newsdate mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                        <p class="mt10">@item.value.IntroText</p>
                    </div>
                }
            }

        </div>
        <div class="col-sm-4 newsnew">
            <div class="">
                <ul class="title-cm01">
                    <li class="active"><a href="#newsnew" data-toggle="tab">Tin mới</a> |</li>
                    <li><a href="#newsmore" data-toggle="tab">Đọc nhiều</a></li>
                </ul>
            </div>
            <div class="tab-content">
                <div class="tab-pane active" id="newsnew">
                    <ul class="newslist">
                        @foreach (var item in Model.LstLastestNews.Select((value, i) => new { i, value }))
                        {
                            if (item.i < 6)
                            {
                                if (item.value.CategoryId == 56)
                                {
                                    <li><a href="@item.value.LinkUrl">@item.value.Title <i class="fa fa-microphone" aria-hidden="true"></i></a></li>
                                }
                                else
                                {
                                    if (item.value.CategoryId == 14)
                                    {
                                        <li><a href="@item.value.LinkUrl">@item.value.Title <i class="fa fa-video-camera" aria-hidden="true"></i></a></li>
                                    }
                                    else
                                    {
                                        if (item.value.CategoryId == 55)
                                        {
                                            <li><a href="@item.value.LinkUrl">@item.value.Title <i class="icon-eM" aria-hidden="true"></i></a></li>
                                        }
                                        else
                                        {
                                            <li><a href="@item.value.LinkUrl">@item.value.Title</a></li>
                                        }
                                    }
                                }


                            }

                        }
                    </ul>
                </div>
                <div class="tab-pane" id="newsmore">
                    <ul class="newslist">
                        @foreach (var item in Model.LstTopViewNews.Select((value, i) => new { i, value }))
                        {
                            if (item.i < 6)
                            {
                                if (item.value.CategoryId == 56)
                                {
                                    <li><a href="@item.value.LinkUrl">@item.value.Title <i class="fa fa-microphone" aria-hidden="true"></i></a></li>
                                }
                                else
                                {
                                    if (item.value.CategoryId == 14)
                                    {
                                        <li><a href="@item.value.LinkUrl">@item.value.Title <i class="fa fa-video-camera" aria-hidden="true"></i></a></li>
                                    }
                                    else
                                    {
                                        if (item.value.CategoryId == 55)
                                        {
                                            <li><a href="@item.value.LinkUrl">@item.value.Title <i class="icon-eM" aria-hidden="true"></i></a></li>
                                        }
                                        else
                                        {
                                            <li><a href="@item.value.LinkUrl">@item.value.Title</a></li>
                                        }
                                    }
                                }


                            }

                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="mt10">
        <ul class="newshot row">
            @foreach (var item in Model.LstHotNews.Skip(1).Take(3).Select((value, i) => new { i, value }))
            {
                <li class="col-sm-4 col-xs-12">
                    <a href="@item.value.LinkUrl">
                        <img src="@item.value.MainImage?w=234&h=156&mode=crop">
                        <span class="mt10">@item.value.Title</span>
                    </a>
                </li>

            }


        </ul>
    </div>



}