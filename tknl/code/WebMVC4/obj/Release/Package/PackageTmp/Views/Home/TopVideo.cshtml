@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>

@if (Model != null)
{
    if (Model.Count > 0)
    {
        <div class="row">
            <div class="col-md-8 col-sm-7 xol-xs-12">
                @foreach (var item in Model.Take(1).Select((value, i) => new { i, value }))
                {
                    if (ViewBag.IsMobile)
                    {
                        <div class="movie">
                            <a href="/trang-chu-video/?VideoId=@(@item.value.Id)"> <img src="@item.value.MainImage?w=367&h=206&mode=crop"></a>
                        </div>
                    }
                    else
                    {
                        <div class="movie">
                            <iframe src="@(item.value.Url.Replace("watch?v=", "embed/"))" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position: absolute; top: 0px; right: 0px; bottom: 0px; left: 0px; width: 100%; height: 100%;"></iframe>
                        </div>
                    }

                    <h3 class="mt20 movie-text"><a href="/trang-chu-video.html?VideoId=@(@item.value.Id)">@item.value.Title</a></h3>
                }
            </div>
            <div class="col-md-4 col-sm-5 xol-xs-12">
                <ul class="videolist">
                    @foreach (var item in Model.Skip(1).Take(5).Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="/trang-chu-video/?VideoId=@(@item.value.Id)" class="video-img">
                                <img src="@item.value.MainImage?w=367&h=206&mode=crop">

                            </a>
                            <a href="/trang-chu-video/?VideoId=@(@item.value.Id)" class="video-text">@item.value.Title</a>
                        </li>
                    }
                </ul>
                <a href="/trang-chu-video" class="btn-viewmore mt20">Xem thêm <span>+</span></a>
            </div>
        </div>

    }



}
