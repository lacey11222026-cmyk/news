@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {

        <div class="danhgia">
            <div class="title-cm01">
                <a href="@ViewBag.Url">@ViewBag.CateName</a>
            </div>
            @foreach (var item in Model.Take(1).Select((value, i) => new { i, value }))
            {
                <a href="@item.value.LinkUrl" class="danhgia-content mt10">
                    <img src="@item.value.MainImage?w=367&h=206&mode=crop">
                    <div class="danhgia-text">
                        <div class="danhgia-text-box">
                            <span>@item.value.Title</span>
                        </div>
                    </div>
                </a>
            }
            <ul class="danhgia-list mt20">
                @foreach (var item in Model.Skip(1).Select((value, i) => new { i, value }))
                {
                    <li>
                        <a href="@item.value.LinkUrl">
                            <img src="@item.value.MainImage?w=147&h=97&mode=crop">
                            <span>@item.value.Title</span>
                        </a>
                    </li>
                }
            </ul>
            <a href="@ViewBag.Url" class="btn-viewmore">Xem thêm <span>+</span></a>
        </div>


    }


}