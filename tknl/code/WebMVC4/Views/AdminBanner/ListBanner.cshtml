@using BIZ.Entity
@using UTILS
@using DATA
@model List<Banner>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">
            <th>ID</th>
           
            <th>Tên </th>
            <th> Vùng</th>
            <th>
                Ảnh
            </th>
            <th class="texttable">Liên kết</th>
           
           
            <th>Trạng Thái</th>
            <th>Thao Tác</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>
                <td>@obj.Id</td>
                <td style="text-align: left;">
                    <a href="@Url.Action("GetBannerDetail",new {id=obj.Id })" title="Edit">@obj.Name</a>
                </td>
                <td>@HtmlHelpers.GetRegionName(obj.Region)</td>
                <td> <img height="30" width="30" src="@obj.Data"/></td>
                <td class="texttable">@obj.Url</td>
               
                <td>
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái không hoạt động" onclick="UpdateStatus('@Utils.Base64Encode(obj.Id)', 1,'@obj.Name');"><i class="fa fa-check"></i></a>

                    }
                    else
                    {
                        <a href="javascript:;" title="Kích hoạt trạng thái hoạt động" onclick="UpdateStatus('@Utils.Base64Encode(obj.Id)',0,'@obj.Name');"><i class="fa fa-ban"></i></a>

                    }
                </td>
                <td style="text-align: center">
                    <a href="javascript:;" title="Delete" onclick="DeleteData('@Utils.Base64Encode(obj.Id)','@obj.Name')"><i class="fa fa-trash-o"></i></a>

                </td>

            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            status: $('#ddlStatus :selected').val(),
            regionId: $('#ddlRegion:selected').val(),
            categoryId: $('#ddlCate :selected').val(),
            //currentPage: currentPage,
            //pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListBanner")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListBanner").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {


        @*$("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });*@


    });

    function DeleteData(id,title) {
      
        bootbox.confirm("Bạn chắc chắn muốn xóa banner này ??? ", function (result) {
            if (result == true) {
                var postdata= {
                    '_id': id,
                    'Title': title,
                };
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url:"@Url.Action("Delete")",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
    function UpdateStatus(id, status,title) {
        var type = "Khóa";
        if (status == 0) {
            type = "Kích hoạt";
        }
        bootbox.confirm("Bạn muốn " + type + " banner này ?", function (result) {
            if (result == true) {
                Utils.Loading();
                var postdata = {
                    '_id': id,
                    'Title': title,
                };
                $.ajax({
                    type: 'POST',
                    url:"@Url.Action("UpdateStatus")",
                    data: addAntiForgeryToken(postdata),

                    success: function (data) {
                        Utils.UnLoading();
                        if (data.ResponseCode >= 0) {
                            bootbox.alert(data.Description);
                            BindDataRequest(CurrentPage);
                        }
                        else {
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });

    }
</script>