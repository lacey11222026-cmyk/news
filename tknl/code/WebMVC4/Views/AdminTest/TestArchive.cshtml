@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@{
    ViewBag.Title = "Danh sách người chơi";
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">
                <div class="row" id="form">


                    <div class="form-group col-md-2 col-xs-12 col-sm-6">
                        @Html.DropDownList("ddlCate", new SelectList(ViewBag.RegistorList as System.Collections.IEnumerable, "Id", "Title", ViewBag.registorId), new { @class = "form-control", })
                    </div>
                    <div class="form-group col-md-3 col-xs-12 col-sm-6">
                        <input type="text" id="txtTitle" class="form-control" placeholder="Nhập số điện thoại hoặc đơn vị">
                    </div>
                    <div class="form-group col-md-2 col-xs-12 col-sm-6">
                        <select class="form-control" id="ddlStatus">
                            <option value="-1">Trạng thái</option>
                            <option value="1">Hoàn thành</option>
                            <option value="0">Đang thi</option>
                        </select>
                    </div>
                    <div class="form-group col-md-2 col-xs-12 col-sm-6">
                        <select class="form-control" id="ddlType">

                            <option value="1">Mới nhất</option>
                            <option value="2">Điểm thi</option>
                        </select>
                    </div>
                    <div class="form-group submit col-md-3 col-xs-12 col-sm-6">
                        <button type="button" id="btnSearch" class="btn btn-info"><i class="fa fa-search"></i>Tìm Kiếm</button>
                        &nbsp;
                        <button type="button" id="btn_export" class="btn btn-success"><i class="fa fa-file-excel-o"></i>Download</button>

                    </div>


                </div>
            </div>
            <div class="table-responsive">
                <div style="float: right; margin-right: 10px;">
                    <h5 id="lbtotal" style="font-weight: bold"></h5>
                </div>
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="ListTestArchive">
                        @Html.Action("ListTestArchive")
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#menu_manageregistor').addClass("active");

</script>
<script type="text/javascript">
        $(document).ready(function () {

            var parameters = {
            };
            $("#form").keypress(function (event) {
                if (event.which == 13) {
                    $("#btnSearch").click();
                }
            });
            $("#btnSearch").click(function () {
                GetList(1);
            });
            $("#ddlStatus").change(function () {
                GetList(1);
            });
            $("#ddlType").change(function () {
                GetList(1);
            });
            $("#ddlCate").change(function () {
                window.location.href = '/AdminTest/TestArchive?registorId=' + $("#ddlCate :selected").val();
            });
            function GetList(currentPage) {
                parameters = {
                    orderType: $('#ddlType :selected').val(),
                    status: $('#ddlStatus :selected').val(),
                    keyword: $("#txtTitle").val(),
                    registorId: $("#ddlCate :selected").val(),
                    currentPage: currentPage,
                };
                btnSearch(currentPage);
            };
            function btnSearch(currentPage) {
                Utils.Loading();
                var urlRequestAns = "@Url.Action("ListTestArchive")";
                $.ajax({
                    type: 'GET',
                    url: urlRequestAns,
                    data: parameters,
                    success: function (data) {
                        $("#ListTestArchive").html(data);
                        Utils.UnLoading();
                    },
                    error: function () {
                        Utils.UnLoading();
                    }
                });
            }

        });

</script>
<script src="//cdn.rawgit.com/rainabba/jquery-table2excel/1.1.0/dist/jquery.table2excel.min.js"></script>
<script>
    $(document).ready(function () {
        $("#btn_export").click(function () {
            $("#dataTables").table2excel({
                exclude: ".noExl",
                name: "kythi",
                filename: "kythi",
                fileext: ".xls",
                exclude_img: true,
                exclude_links: true,
                exclude_inputs: true
            });
        });

    });
</script>