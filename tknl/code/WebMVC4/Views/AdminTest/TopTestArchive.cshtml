@using BIZ.Entity
@using UTILS
@model List<DATA.TestArchiveTop>
@using WebMVC4.Helper

@{
    Layout = "~/Views/Shared/_AdminV2.cshtml";
}
@{
    ViewBag.Title = "Top người thi";
}
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-primary">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span>@ViewBag.Title</div>
            <div class="panel-body">

            </div>
            <div class="table-responsive">
                <div style="float: right; margin-right: 10px;">
                    <h5 id="lbtotal" style="font-weight: bold"></h5>
                </div>
                <div id="dgrid" class="dataTables_wrapper form-inline" role="grid">
                    <div id="ListTestArchive">
                        <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
                            <thead>
                                <tr class="rowsao">
                                   
                                    <th>Số điện thoại</th>
                                    <th>Họ và Tên</th>
                                    <th>Đơn vị</th>
                                    <th>Thời gian thi</th>

                                    <th>Điểm</th>
                                 
                                </tr>
                            </thead>
                            @if (Model != null && Model.Count > 0)
                            {
                                for (int i = 0; i < Model.Count; i++)
                                {
                                    var obj = Model[i];
                                    <tr>

                                       
                                        <td class="texttable">
                                            @obj.Mobile
                                        </td>
                                        <td>
                                            @obj.FullName
                                        </td>
                                        <td>
                                            @obj.Location
                                        </td>
                                        <td>
                                            @((float)obj.TestTime / 1000) 
                                        </td>

                                        <td>@(obj.Mark * 10)</td>






                                    </tr>
                                }
                            }
                        </table>
                    </div>

                    <div class="dataTables_paginate" id="pager">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#menu_topregistor').addClass("active");

</script>
