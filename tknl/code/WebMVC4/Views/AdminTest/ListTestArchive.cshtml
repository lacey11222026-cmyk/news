@using BIZ.Entity
@using UTILS
@model List<DATA.TestArchive>
@using WebMVC4.Helper

<table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables">
    <thead>
        <tr class="rowsao">

            <th>Mã bài thi</th>
            <th>Số điện thoại</th>
            <th>Họ và Tên</th>
            <th>Tình Thành</th>
            <th>Đơn vị</th>
            @*

                <th>Chức vụ</th>*@
            <th>Thời gian thi</th>
            <th>Thời gian bắt đầu</th>
            <th>Thời gian kết thúc</th>

            <th>Điểm</th>
            <th>Số dự đoán</th>
            <th class="noExl">Độ lệch</th>
            <th class="noExl" >Trạng Thái</th>

            <th class="noExl">Thao Tác</th>
        </tr>
    </thead>
    @if (Model != null && Model.Count > 0)
    {
        for (int i = 0; i < Model.Count; i++)
        {
            var obj = Model[i];
            <tr>

                <td>@obj.Id</td>
                <td class="texttable">
                    @obj.Mobile
                </td>
                <td>
                    @obj.FulName
                </td>
                <td>
                    @obj.Location
                </td>
                <td>
                    @obj.Role
                </td>
                @*

                    <td>
                        @obj.Role
                    </td>*@
                <td>
                    @if (obj.EndTime != null)
                    {
                        <text>@((float)obj.TestTime / 1000)</text>
                    }
                </td>
                <td>@obj.StartTime.GetValueOrDefault().ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>
                    @if (obj.EndTime != null)
                    {
                        <text> @obj.EndTime.GetValueOrDefault().ToString("dd/MM/yyyy HH:mm:ss")  </text>
                    }
                </td>
                <td>@(obj.Mark * 10)</td>
                <td>@obj.Note.GetValueOrDefault()</td>
                @if (obj.RegistorId == 4)
                {
                    <td class="noExl">@(obj.Note.GetValueOrDefault()- 16615)</td>
                }
                @if (obj.RegistorId == 5)
                {
                    <td class="noExl">@(obj.Note.GetValueOrDefault()- 42278)</td>
                }
                @if (obj.RegistorId > 6)
                {
                    <td class="noExl"></td>
                }
                <td class="noExl">
                    @if (obj.Status == 1)
                    {
                        <text>Hoàn thành</text>

                    }
                    else
                    {
                        if (obj.StartTime.GetValueOrDefault().AddMinutes(30) < DateTime.Now)
                        {
                            <text>Không hoàn thành</text>
                        }
                        else
                        {
                            <text>Đang thi</text>
                        }

                    }
                </td>



                <td style="text-align: center" class="noExl">
                    <a href="javascript:;" title="Delete" onclick="DeleteData('@Utils.Base64Encode(obj.Id)','@obj.Mobile')"><i class="fa fa-trash-o"></i></a>
                    @if (obj.Status == 1)
                    {
                        <a href="javascript:;" onclick="CommonCtrl.PopupArchive('@obj.Id');"> Chi tiết</a>

                    }
                </td>

            </tr>
        }
    }
</table>
<script type="text/javascript">
    var PageOnSize = '@ViewBag.PageSize';
    var CurrentPage = '@ViewBag.CurrentPage';
    function BindDataRequest(currentPage) {
        var params = {
            registorId: $("#ddlCate :selected").val(),
            keyword: $("#txtTitle").val(),
            status: $('#ddlStatus :selected').val(),
            orderType: $('#ddlType :selected').val(),
            currentPage: currentPage,
            pageSize: PageOnSize
        };
        var urlRequestAns = '@Url.Action("ListTestArchive")';
        Utils.Loading();
        $.ajax({
            type: 'GET',
            url: urlRequestAns,
            data: params,
            success: function (data) {
                $("#ListTestArchive").html(data);
                Utils.UnLoading();
            },
            error: function () {
                Utils.UnLoading();
            }
        });
    };
    $(document).ready(function () {
        $("#lbtotal").html("Tổng số : @(ViewBag.TotalRecord)");

        $("#pager").pager({
            pagenumber: CurrentPage,
            pagecount: Math.ceil('@ViewBag.TotalRecord' / PageOnSize),
            buttonClickCallback: function (page) { BindDataRequest(page); }
        });


    });

    function DeleteData(id, title) {

        bootbox.confirm("Bạn chắc chắn muốn xóa bài thi này ??? ", function (result) {
            if (result == true) {
                var postdata = {
                    '_id': id,
                    'Title': title,
                };
                Utils.Loading();
                $.ajax({
                    type: 'POST',
                    url: "@Url.Action("TestArchiveDelete")",
                    data: addAntiForgeryToken(postdata),
                success: function (data) {
                    Utils.UnLoading();
                    if (data.ResponseCode >= 0) {
                        bootbox.alert(data.Description);
                        BindDataRequest(CurrentPage);
                    }
                    else {
                        bootbox.alert(data.Description);
                        return;
                    }
                }
            });
        }
        });

    }

</script>