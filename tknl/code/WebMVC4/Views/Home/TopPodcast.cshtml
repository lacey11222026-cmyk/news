@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>


@if (Model != null)
{
    if (Model.Count > 0)
    {


        foreach (var item in Model.Select((value, i) => new { i, value }))
        {
            <div class="col-md-4 col-sm-4 col-xs-12">
                <a href="/Podcast/@(item.value.Id)">
                    <img src="@item.value.MainImage?w=320&h=446&mode=crop" alt="" class="w100">
                    <span class="mt10 disblock">@item.value.Title</span>
                </a>
            </div>




        }
        <a href="/podcast" class="btn-viewmore mt20">Xem thêm <span>+</span></a>




    }
}
