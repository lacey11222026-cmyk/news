<div class="header">


    <div class="container top-content-inner">
        <div class="logo top-content_left"><a href="/"><img src="/Content/images/logo-top.png" alt="Sử dụng năng lượng tiết kiệm và hiệu quả" width="600"></a></div>
        <div class="top-content_right">


            @if (Session["Mobile"] != null && Session["Fullname"] != null)
            {
                <div class="top-content">
                    <div class="user-info"><p>Xin chào: <span>@Session["Mobile"].ToString() <img src="/Content/images/icon-dropdown.svg" alt="Thoát" width="13"></span></p></div>
                    <ul class="dropdown-content">
                        <li><a href="@Url.Action("Logout", "Home")"><img src="/Content/images/icon-logout-white.svg" alt="Thoát" width="18" height="18"> Thoát</a></li>
                    </ul>
                </div><!-- end top content-->

            }

            <ul class="top-nav">
                <li><a href="/"><img src="/Content/images/home-icon.png" alt="Trang chủ" style="margin-bottom: 3px;"></a></li>
                <li class="active"><a href="/tin-tuc/t53653/gioi-thieu">Giới thiệu</a></li>
                <li><a href="/tin-tuc/t53654/the-le">Thể lệ</a></li>
                <li><a href="/tin-tuc/t53655/tai-lieu#">Tài liệu</a></li>
                <li><a href="https://tietkiemnangluong.com.vn/">Kết quả</a></li>
            </ul>
        </div>
    </div>

    <div class="nav-mobile">
        <div class="header-m">
            <a href="/">
                <img src="/Content/images/logo-top-mb.png" alt="Sử dụng năng lượng tiết kiệm và hiệu quả" class="m-logo float-left">
            </a>
            <a href="#menu">

                <img src="/Content/images/ico-menu.png" class="ico-menu float-right">
                <span class="clearfix"></span>
            </a>
        </div>
        <div id="menu">
            <ul>
                <li><a href="/">Trang chủ</a></li>
                <li><a href="/tin-tuc/t53653/gioi-thieu">Giới thiệu</a></li>
                <li><a href="/tin-tuc/t53654/the-le">Thể lệ</a></li>
                <li><a href="/tin-tuc/t53655/tai-lieu">Tài liệu</a></li>
                <li><a href="https://tietkiemnangluong.com.vn/">Kết quả</a></li>
            </ul>
        </div>
    </div>



</div><!-- end header-->
