    // Chặn tấn công CSRF (XSRF)
    function addAntiForgeryToken(data) {
        if (!data) {
            data = {};
        }
        var tokenInput = $('input[name=__RequestVerificationToken]');
        if (tokenInput.length) {
            data.__RequestVerificationToken = tokenInput.val();
        }
        return data;
    };
</script>
<script>


    //$('#questionitem-1').show("slow");
    function gotoQuestion(current,qnumber) {

        $.each($('.lb_question'), function (i, question) {
            var inputa = $(question).find("input");
            ans = ',';
            $.each($(inputa), function (ix, answer) {
                if ($(answer).is(":checked")) {

                    ans += $(answer).val() + ',';
                }

            });
            localStorage.setItem('as' + current, ans);

        });
        $('#hdIndex').val(qnumber);
        $.ajax({
            type: 'GET',
            url: "/Home/LoadExam/?index="+qnumber,

            success: function (data) {
                $("#DivQuestion").html(data);
                $('#numberquestiontitle').html(qnumber + '/' + '@ViewBag.NumberQuestion' + '');
            },
            error: function () {

            }
        });

    }


</script>
<script>
    function saveGame2() {
        ShowProgress();
        var archive = '';
        var ans = '';

        for (var id = 1; id <=@(ViewBag.NumberQuestion); id++)
        {

            if (parseInt($('#hdIndex').val()) == id) {
                $.each($('.lb_question'), function (i, question) {
                    var inputa = $(question).find("input");
                    ans = ',';
                    $.each($(inputa), function (ix, answer) {
                        if ($(answer).is(":checked")) {
                            //alert($(answer).val());
                            ans += $(answer).val() + ',';
                        }

                    });

                    archive += ans + '|';
                });
            }
            else {
                var as = localStorage.getItem('as' + id, ans);
                if (as == null || as == undefined) {
                    archive += '|';
                }
                else {
                    archive += as + '|';
                }
            }

        }




        var postdata = {
            'result': archive

        };
        $.ajax({
            type: 'POST',
            url: "/Home/End",
            data: addAntiForgeryToken(postdata),
            success: function (data) {
                HideProgress();
                $(window).unbind('beforeunload');
                if (data.ResponseCode >= 0) {
                    window.location.href = "/Home/Result";

                    return;
                }
                else {
                    if (data.ResponseCode === -101) {
                        window.location.href = "/";
                        return;
                    }
                    //Kết quả
                    if (data.ResponseCode === -102) {
                        window.location.href = "/Home/Result";
                        return;
                    }
                    bootbox.alert(data.Description);
                    return;
                }
            }
        });



    }
    function saveGame() {
        bootbox.confirm("Bạn muốn kết thúc bài thi?", function (result) {
            if (result === true) {
                ShowProgress();
                var archive = '';

                for (var  i = 1; i <@(ViewBag.NumberQuestion); i++)
                {
                    archive += localStorage.getItem('as' + i, ans) + '|';
                }
                var ans = '';

                $.each($('.lb_question'), function (i, question) {
                    var inputa = $(question).find("input");
                    ans = ',';
                    $.each($(inputa), function (ix, answer) {
                        if ($(answer).is(":checked")) {
                            //alert($(answer).val());
                            ans += $(answer).val() + ',';
                        }

                    });

                    archive += ans + '|';
                });


                var postdata = {
                    'result': archive

                };
                $.ajax({
                    type: 'POST',
                    url: "/Home/End",
                    data: addAntiForgeryToken(postdata),
                    success: function (data) {
                        HideProgress();
                        $(window).unbind('beforeunload');
                        if (data.ResponseCode >= 0) {
                            window.location.href = "/Home/Result";

                            return;
                        }
                        else {
                            if (data.ResponseCode === -101) {
                                window.location.href = '/';
                                return;
                            }
                            //Kết quả
                            if (data.ResponseCode === -102) {
                                window.location.href = "/Home/Result";
                                return;
                            }
                            bootbox.alert(data.Description);
                            return;
                        }
                    }
                });
            }
        });


    }
    function selectCard(obj) {

        var o = $(obj).parent().find("input");
        if (o.prop('checked')) {
            o.prop('checked', false);
        }
        else {
            o.prop('checked', true);
        }


    }
</script>
