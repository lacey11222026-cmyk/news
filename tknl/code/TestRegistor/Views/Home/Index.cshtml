<script>

    function JoinTest(id) {
        bootbox.confirm("Bạn muốn tham dự cuộc thi này?",
            function(result) {
                if (result === true) {
                    var postdata = {
                        'id': id

                    };
                    ShowProgress();
                    $.ajax({
                        type: 'POST',
                        url: "@Url.Action("Start")",
                        data: postdata,
                        success: function(data) {
                            HideProgress();
                            if (data.ResponseCode >= 0) {
                                window.location.href = '@Url.Action("Exam")';

                                return;
                            } else {
                                if (data.ResponseCode === -101) {
                                    window.location.href = '@Url.Action("Logon")';
                                    return;
                                }
                                //Kết quả
                                if (data.ResponseCode === -102) {
                                    window.location.href = '@Url.Action("ResultExam")?id=' + id;
                                    return;
                                }
                                bootbox.alert(data.Description);
                                return;
                            }
                        }
                    });
                }
            });
    }
    function ShowProgress() {
        $('#TB_overlay').show();
    }
    function HideProgress() {
        $('#TB_overlay').hide();
    }
</script>

@if (!String.IsNullOrEmpty(ViewBag.Test))
{
    <script>
        //return;
         var postdata = {
                        'id': '@ViewBag.Test'

                    };
                    ShowProgress();
                    $.ajax({
                        type: 'POST',
                        url: "@Url.Action("Start")",
                        data: postdata,
                        success: function(data) {
                            HideProgress();
                            if (data.ResponseCode >= 0) {
                                window.location.href = '@Url.Action("Exam")';

                                return;
                            } else {
                                if (data.ResponseCode === -101) {
                                    window.location.href = '@Url.Action("Logon")';
                                    return;
                                }
                                //Kết quả
                                if (data.ResponseCode === -102) {
                                    window.location.href = '@Url.Action("ResultExam")?id=' + '@ViewBag.Test';
                                    return;
                                }
                                bootbox.alert(data.Description);
                                return;
                            }
                        }
                    });
    </script>
}
