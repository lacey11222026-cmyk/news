@using BIZ
@using UTILS
@using WebEN.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
        
    <div style="width: 100%;">
        <div class="title9">CÁC TÀI LIỆU KHÁC</div>
        <ul class="list_document">
            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                <li><a title="@item.value.Title" href="@item.value.LinkUrl">
                    <img src="@item.value.MainImage?w=300&h=200&mode=crop" />
                </a><a title="@item.value.Title" href="@item.value.LinkUrl">@item.value.Title </a></li>
                
            }
        </ul>
    </div>
    <div class="clear"></div>
    
    
 

    }


}