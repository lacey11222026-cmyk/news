@using BIZ
@using UTILS
@using  WebEN.Helper
@model List<DATA.Channel>

@if (Model != null)
{
    if (Model.Count > 0)
    {

        <div class="box1" id="hotchannel">
            <div class="title1">Theo dòng sự kiện</div>
            <ul id="mycarouse">
                @foreach (var item in Model.Select((value, i) => new { i, value }))
                {
              
                    <li>
                        <div class="dong1">
                            <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Name, "Channel")"
                               title="@item.value.Name"><img src="@Utils.GetImageUrl(item.value.Id, EntityName.Channel, false)@(item.value.Image)?w=300&h=200&mode=crop"></a>
                            <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Name, "Channel")"
                               title="@item.value.Name">@item.value.Name
                            </a>
                            <p>@UTILS.Utils.SubString(item.value.Description, 380).</p>
                        </div>
                    </li>
                }

            </ul>

            <div class="clear"></div>
        </div>
    
    <script type="text/javascript">
        if (document.body.clientWidth > 979) {
            
            jQuery('#mycarouse').jcarousel({
                wrap: 'circular',
                auto: 8,
                offset: 1,
                scroll: 1,
                animation: "normal",
            });


            $("#hotchannel .jcarousel-clip-horizontal").css({ width: "300px", height: "330px", overflow: "hidden" });
        }
        

    </script>


    }


}

