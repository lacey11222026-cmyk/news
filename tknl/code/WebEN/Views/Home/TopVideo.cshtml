@using BIZ
@using UTILS
@using  WebEN.Helper
@model List<BIZ.Entity.CONTENT_FULL>

@if (Model != null)
{
    if (Model.Count > 0)
    {

        <div class="video">
            <div class="title10"><a href="/trang-chu-video.html">VIDEO</a></div>

            @foreach (var item in Model.Select((value, i) => new { i, value }))
            {
                if (item.i == 0)
                {
                    <div class="video_v vitri1">
                        <div class="dong1" style="height: auto;">

                            @if (ViewBag.IsIpad || ViewBag.Iphone)
                            {
                                <video controls preload="auto" width="300" height="200" id="myvideo">
                                    <source src="@item.value.Url" type="video/mp4" />
                                </video>
                                <script type="text/javascript">
                                    $(function () {
                                        var video_w = $('.dong1').width();
                                        var video_h = Math.round(video_w * 3 / 4);
                                        $("#myvideo").width(video_w).height(video_h);
                                    });

                                    $(window).resize(function () {
                                        var video_w = $('.dong1').width();
                                        var video_h = Math.round(video_w * 3 / 4);
                                        $("#myvideo").width(video_w).height(video_h);
                                    });
                                </script>
                            }
                            else
                            {
                                <div id="video_viewer">
                                </div>
                                <script src="/flash/jwplayer.js" type="text/javascript"></script>

                                <script type="text/javascript">
                                    var url = '@item.value.Url';
                                    var video_w = $('.dong1').width();
                                    var video_h = Math.round(video_w * 3 / 4);

                                    jwplayer('video_viewer').setup({
                                        'flashplayer': '/flash/player.flash.swf',
                                        'id': 'playerID',
                                        'width': video_w,
                                        'height': video_h,
                                        'file': url,
                                        'image': '@item.value.MainImage?w=600&h=400&mode=crop',
                                        //'plugins': { 'ova-jw': {} },
                                        //'config': configadsvideo,
                                        'abouttext': 'vtkmedia.vn',
                                        'aboutlink': 'http://vtkmedia.vn',
                                        //skin': '/flash/newsplayerskin.zip',
                                        'autostart': 'false',
                                    });

                                    $(window).resize(function () {
                                        var video_w = $('.dong1').width();
                                        var video_h = Math.round(video_w * 3 / 4);
                                        $("#video_viewer").width(video_w).height(video_h);
                                    });
                                </script>
                            }
                            <br />
                            <a href="/trang-chu-video.html?VideoId=@(@item.value.Id)">@item.value.Title </a>
                            <p>@UTILS.Utils.SubString(item.value.IntroText, 420)</p>
                        </div>
                    </div>

                }
                else
                {
                    if (item.i == 1)
                    {
                        @Html.Raw("<div class=\"n_list5\"><ul>")
                    }
                    <li>

                        <a href="/trang-chu-video.html?VideoId=@(@item.value.Id)"><img src="@item.value.MainImage?w=300&h=200&mode=crop" style="max-width: 80px;" alt="@item.value.Title"></a>

                        <a href="/trang-chu-video.html?VideoId=@(@item.value.Id)">@item.value.Title</a>
                    </li>
                    if (item.i == Model.Count - 1)
                    {
                        @Html.Raw("</ul></div>")

                    }
                }

            }
            <div class="clear"></div>
        </div>
    }



}
