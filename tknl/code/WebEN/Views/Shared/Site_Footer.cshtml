@using WebEN
@{

    var lstMenu = new BIZ.CategoryBO().GetAllCategoryFullsByPosition(UTILS.Constants.CategoryPosition.Footer, 18, false, "en-us");
}
@{var StaticSiteUrl = MvcApplication.StaticSiteUrl;}
@*@{Html.RenderAction("BannerTop", "Banner");}*@

<footer class="mt20">
    <div class="">
        <nav>
            <ul class="container">
                <li id="foot_home" class="home"><a href="/"><img src="@(StaticSiteUrl)/Content/images/icon-home-white.png"></a></li>
                @foreach (var item in lstMenu.Select((value, i) => new { i, value }))
                {
                    <li id="foot_@item.value.Id"><a href="@UTILS.Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)">@item.value.Name</a></li>
                }
            </ul>
        </nav>
        <div class="mt20 f-content container">
            <div class="row">
                <div class="col-md-6 col-xs-12">
                    <div class="f-content01">
                        <div><img src="@(StaticSiteUrl)/Content/images/logo-bottom.png"></div>
                        <div class="f-add">
                            <h2>Copyright by Energy - Petroleum Agency, Ministry of Industry and Trade</h2>
                            <p class="mt10">
                                Address: 54 Hai Ba Trung street, Cua Nam ward, Hanoi, Vietnam<br>
                                Responsible for content: Deputy Director
                                Dang Hai Dung<br>
                                Tel: 024. 22202358<br>
                                Email: vneec.gov@gmail.com<br />
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xs-12">
                    <div>
                        <img src="https://scp.gov.vn/content/img/img-footer.jpg" alt="" height="65">
                    </div>
                    <div class="f-add mt10">
                        <p>
                            License No. 148/GP-TTĐT | Date 13/8/2019 Place of issue: Administration of Radio, Television and Electronic Information - Ministry of Information and Communications<br>

                            Copyrights of National Energy Efficiency Programme. All rights reserved: tietkiemnangluong.com.vn | vneec.gov.vn
                        </p>
                    </div>
                    <div class="f-access">
                        <div class="total mt10">
                            <span>Tổng số lượt truy cập </span>
                            <ul>
                                @foreach (var s in HttpContext.Current.Application["TotalVisited"].ToString().Select(c => c.ToString()).ToList())
                                {
                                    <li>@s</li>
                                }
                            </ul>
                        </div>
                        <ul class="f-link-list mt10">
                            <li><a href="http://tietkiemnangluong.com.vn/"><img src="@(StaticSiteUrl)/Content/images/icon-vn.png"></a></li>
                            <li><a href="http://vneec.gov.vn/"><img src="@(StaticSiteUrl)/Content/images/icon-en.png"></a></li>
                            <li><a href="https://www.youtube.com/channel/UCFfXHgMRa5zwPhGltIv89LQ"><img src="@(StaticSiteUrl)/Content/images/icon-youtube.png"></a></li>
                            <li><a href="https://www.facebook.com/vptknl2019/"><img src="@(StaticSiteUrl)/Content/images/icon-face.png"></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- end container-->
</footer>



<div id="fb-root"></div>
<div class="clearfix">
</div>
<script>

    (function (d, s, id) {
        var js, fjs = d.getElementsByTagName(s)[0];
        if (d.getElementById(id)) return;
        js = d.createElement(s); js.id = id;
        js.src = "//connect.facebook.net/vi_VN/sdk.js#xfbml=1&version=v2.8&appId=275786053207358";
        fjs.parentNode.insertBefore(js, fjs);
    }(document, 'script', 'facebook-jssdk'));
</script>
<script>
    (function (i, s, o, g, r, a, m) {
        i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () {
            (i[r].q = i[r].q || []).push(arguments)
        }, i[r].l = 1 * new Date(); a = s.createElement(o),
            m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
    })(window, document, 'script', '//www.google-analytics.com/analytics.js', 'ga');

    ga('create', 'UA-58700840-1', 'auto');
