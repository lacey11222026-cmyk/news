@using BIZ
@using UTILS
@using WebEN
@using WebEN.Helper
@model List<BIZ.Entity.DOCUMENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
    <div class="document mt0">
        <div class="document-title">
            <a href="/van-ban.html" data-toggle="tab">Documents</a>

        </div>
        <div class="content">
            
                <ul class="document-list">
                    @foreach (var item in Model.Take(4).Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Name, "DocumentDetail")"
                               title="@item.value.Name">
                                @item.value.Name
                            </a>
                        </li>
                    }
                </ul>
                <a href="/van-ban.html" class="btn-viewmore">More <span>+</span></a>
            
          
        </div>
    </div>

    
    }

}
<style>
    .document-title {
        font-size: 20px;
        font-weight: 500;
        padding: 8px 10px;
        width:100%;
        background-color: #f5f5f5;
        display: inline-block;
    }
    .document .content {
        background-color: #f5f5f5;
        padding: 10px 10px;
       
    }
</style>