@using BIZ
@using DATA
@using UTILS
@using WebEN
@using WebEN.Helper
@model BIZ.Entity.DOCUMENT_FULL


@if (Model != null)
{

    <div class="danhgia-content01 container mt10">

        <div class="title-cm02 mt20">
            <a href="/van-ban.html">Document</a>
        </div>


    </div>

    <div class="border-bottom">
        <div class="mt30 cap1-content02 container">
            <div class="row row-40">
                <div class="col-md-8 col-sm-12 text-left">
                    <div class="document-table table-responsive mt20">
                        <table width="100%">
                            <tr>
                                <th width="20%">Name :</th>
                                <td colspan="3">
                                    @Model.Name. <a href="@Model.FilePath">
                                        <img style="width: 23px;" src="@(MvcApplication.StaticSiteUrl)images/icon-pdf.png">
                                    </a>
                                    &nbsp;@if (Model.FileName.ToLower().Contains(".pdf"))
                                    {

                                        <a href="@Url.Action("ViewPDF", "Document", new { url = Model.FilePath })" target="_blank">Xem online</a>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th width="20%">Description :</th>
                                <td colspan="3">
                                    @Model.Description
                                </td>
                            </tr>
                            <tr>
                                <th width="20%">Code : </th>
                                <td>@Model.Code</td>
                                <th width="20%">Effective Date :</th>
                                <td>@Model.EffectiveDate</td>
                            </tr>
                            <tr>
                                <th width="20%">Publish Date : </th>
                                <td>@Convert.ToDateTime(Model.PublishDate).ToString(@" dd'/'MM'/'yyyy")</td>
                                <th width="20%">Expiry Date :</th>
                                <td>@Model.ExpiryDate</td>
                            </tr>
                            <tr>
                                <th width="20%">Publish Orange : </th>
                                <td>@Model.SignedByDesc</td>
                                <th width="20%">Signed By :</th>
                                <td>@Model.SignedBy</td>
                            </tr>

                        </table>
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">

                    @Html.Partial("Site_Right")
                </div>
            </div>
        </div><!-- end content 02-->
    </div>




}

