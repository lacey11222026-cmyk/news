        jQuery('#mycarouse2').jcarousel({
            wrap: 'circular',
            auto: 5,
            scroll: 2,
            animation: "normal",
        });


        $("#slidenews .jcarousel-clip-horizontal").css({ width: "900px", height: "165px", overflow: "hidden" });

    </script>
        
                    }*@


    }
}
