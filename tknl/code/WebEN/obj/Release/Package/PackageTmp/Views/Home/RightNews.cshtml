@using BIZ
@using UTILS
@using WebEN
@using WebEN.Helper
@model WebEN.Models.LastestNewModel
@if (Model != null)
{
    if (Model.lstdata.Count > 0)
    {
        
    <div class="box1" style="height: 280px; overflow: hidden;">
        <div class="title10"><a href="@Model.Url">@Model.HeaderTitle</a></div>
        <div class="dong2">
            <a style="background:none; padding:0;" href="@ViewBag.Url">
                <img style="width:100%; height:105px;" src="@(MvcApplication.StaticSiteUrl)images/b3.png" /></a>
            @foreach (var item in Model.lstdata.Select((value, i) => new { i, value }))
            {
                <a href="@item.value.LinkUrl">@item.value.Title </a>
            }
        </div>
    </div>
        
    



    }
}