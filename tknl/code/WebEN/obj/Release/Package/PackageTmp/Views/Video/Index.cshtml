@using BIZ
@using BIZ.Entity
@using UTILS
@using WebEN
@using WebEN.Helper
@model BIZ.Entity.CONTENT_FULL

<div class="title_c1"><a href="/trang-chu-video.html">VIDEO</a></div>

@if (Model != null)
{
    <div class="video" id="video">
        @if (ViewBag.IsIpad || ViewBag.Iphone)
        {
            <video controls preload="auto" name="myvideo" id="myvideo">
                <source src="@Model.Url" type="video/mp4" />

            </video>

        }
        else
        {
            <div id="video_viewer">
            </div>
            <script src="/flash/jwplayer.js" type="text/javascript"></script>
                
            <script type="text/javascript">
                var width = $("#video").width();
                var height = width * 2 / 3;
                var url = '@Model.Url';
                jwplayer('video_viewer').setup({
                    'flashplayer': '/flash/player.flash.swf',
                    'id': 'playerID',
                    'width': width,
                    'height': height,
                    'file': url,
                    'image': '@Model.MainImage?w=600&h=400&mode=crop',
                    //'plugins': { 'ova-jw': {} },
                    //'config': configadsvideo,
                    'abouttext': 'vtkmedia.vn',
                    'aboutlink': 'http://vtkmedia.vn',
                    //skin': '/flash/newsplayerskin.zip',
                    'autostart': 'false',
                });
            </script>
        }
        <h1>@Model.Title</h1>
        <h5>@Utils.formatDateofWeek(Model.PublishDate.DayOfWeek), @Model.PublishDate.ToString("dd/MM/yyyy") - @Model.PublishDate.ToString("HH:mm")</h5>
        <p>@Model.IntroText</p>
        <div class="clear"></div>
        <div id="videodata">
        </div>
    </div>
    <script src="~/Scripts/jquery-services-110405.js" type="text/javascript"></script>
    <script type="text/javascript">
        loadvideo(14, 1);
        function BindData(data) {
            var html = '<ul class="list_video">';
            $.each(data.Items, function (index, item) {


                html += '<li><a href="/trang-chu-video.html?VideoId=' + item.Id + '">';
                html += '<image src="' + item.MainImage + "?w=300&h=200&mode=crop" + '" />';

                html += '</a>';
                html += '<a href="/trang-chu-video.html?VideoId=' + item.Id + '">';
                html += item.Title;

                html += '</a></li>';

            });
            html += '</ul> <div class="clear"></div>';


            return html;
        }
        function loadvideo(cate, pindex) {

            $.Services({
                element: $('#videodata'),
                //loadingImg: 'Đang tải dữ liệu ...',
                serviceName: 'ArticleService.ashx',
                data: {
                    __m: 'get_articles',

                    cid: cate,
                    nid: '@Model.Id',
                    _pi: pindex,
                    _ps: 18
                },
                success: function (data) {
                    var html = '';
                    if (data != undefined && data != null && data != '') {

                        html = BindData(data);

                    }
                    var pagehtml = GetAJAXPaging(data.Total, 18, pindex, 'loadvideo(' + cate + ',');

                    $('#videodata').html(html + pagehtml);

                }
            });

        }
    </script>
}