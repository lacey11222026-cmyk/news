@using UTILS
@using  WebEN.Models
@using  WebEN.Helper
@model WebEN.Models.SurveyItemModel

@if (Model != null)
{
    
        <div class="title3">BÌNH CHỌN</div>
        <div class="dong3">
            @Model.obj.Content

            @foreach (var item in Model.listdata)
            {

                if (Model.obj.Type == 1)
                {
                <p>

                    <input type="radio" value="@item.Id" name="answer_result">
                    @item.Content



                </p>
                }
                else
                {
                <p>

                    <input type="checkbox" value="@item.Id" name="answer_result">
                    @item.Content

                </p>
                }

            }

            <ul>
                <li>
                    <button id="sendquestion1">Bình chọn</button>
                </li>
                <li>
                    <button id="viewquestion1">Kết quả</button>
                </li>
                <li style="display: none">
                    <a class="frame" id="viewvote1" href="@Url.Action("View","Vote",new{Id=Model.obj.Id})">Xem kết quả</a>
                </li>
            </ul>
            <div class="clear"></div>
        </div>
    
    <script type="text/javascript">

        $("#viewquestion1").click(function () {
            $("#viewvote").click();
        });
        $("#sendquestion1").click(function () {
           
            var lstAnswer = '';
            var answers = $('input[name="answer_result"]:checked');
            $.each(answers, function (i, answer) {
                lstAnswer += '|' + $(answer).val();
            });
            lstAnswer += '|'
            if (lstAnswer == '|') {
                alert("Chưa chọn câu trả lời");

                return false;
            }
           
            $.post('@Url.Action("SubmitQuestion", "Vote")', { "lstAnswer": lstAnswer },
                function (data) {
                    $("#viewvote1").click();

                }, 'json');


        });
    </script>
   
}
