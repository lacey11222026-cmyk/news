@using BIZ
@using UTILS
@using WebEN.Helper
@model WebEN.Models.NewsModel
@if (Model != null)
{


    <div class="danhgia-content01 container mt10">

        <div class="title-cm02 mt20">
            <a href="#">Keyword: @ViewBag.keyword</a>
        </div>


    </div>
    <div class="border-bottom">
        <div class="mt30 cap1-content02 container">
            <div class="row row-40">
                <div class="col-md-8 col-sm-12 text-left">
                    
                    <div>

                        @if (Model.listdata != null)
                        {
                            <ul class="mt20 viewmore-list">
                                @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                                {

                                <li>
                                    <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=260&mode=crop"></a>
                                    <div>
                                        <a href="@item.value.LinkUrl">@item.value.Title</a>
                                        <span class="newsdate mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="hidden-xs">
                                        @item.value.IntroText
                                    </div>
                                </li>


                                }
                            </ul>
                        }
                        else
                        {
                            <div>Match results not found</div>
                        }


                        <div class="paging mt50 text-center">

                            <ul>
                                @{Html.RenderPartial("Pagination", new WebEN.Models.PaginationInfo
                                    {
                                        PageUrl = Url.SetParameter("page", "!0"),
                                        CurrentPage = Model.pageIndex,
                                        PageSize = Model.pageSize,
                                        TotalItemCount = Model.total,
                                    }); }
                            </ul>

                        </div>
                        <div class="clear padtop10"></div>

                    </div>

                </div>
                <div class="col-md-4 col-sm-12">

                    @Html.Partial("Site_Right")
                </div>
            </div>
        </div><!-- end content 02-->
    </div>

}
