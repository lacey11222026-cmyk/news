@model List<DATA.Banner>
@if (Model != null)
{
    

    foreach (var item in Model.Select((value, i) => new { i, value }))
    {
    <div class="bnr02 mt40">
        <a href="@item.value.Url" rel="nofollow" target="_blank"><img src="@item.value.Data" alt="@item.value.Name" class="w100"></a>
    </div>
    
    
    }
   
    
    
}