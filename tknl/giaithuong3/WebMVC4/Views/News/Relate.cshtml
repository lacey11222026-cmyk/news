@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {

        <h2 class="title-cm"><a href="#">Cùng chuyên mục</a></h2>
        <div class="row mt30">
            <div class="col-md-6 col-sm-12">
                @foreach (var item in Model.Take(1).Select((value, i) => new { i, value }))
                {
                    <div class="newsbig">
                        <a href="@item.value.LinkUrl" class="wrap-img"><img src="@item.value.MainImage?w=398&h=224&mode=crop" alt=""></a>
                        <h2 class="news-txt"><a href="@item.value.LinkUrl">@item.value.Title</a></h2>
                        <span class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>
            <div class="col-md-6 col-sm-12">
                <ul class="newslist04">
                    @foreach (var item in Model.Skip(1).Take(4).Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="@item.value.LinkUrl">@item.value.Title </a>
                            <span class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                        </li>
                    }

                </ul>
            </div>
        </div>

        <ul class="mt20 viewmore-list">
            @foreach (var item in Model.Skip(5).Select((value, i) => new { i, value }))
            {
                <li>
                    <a href="@item.value.LinkUrl"><img src="@item.value.MainImage?w=398&h=224&mode=crop"></a>
                    <div>
                        <a href="@item.value.LinkUrl">@item.value.Title </a>
                        <span class="date mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
                    </div>
                </li>
            }

        </ul>



    }


}