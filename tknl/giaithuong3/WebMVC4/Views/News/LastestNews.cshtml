@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CONTENT_FULL>
@if (Model != null)
{
    if (Model.Count > 0)
    {
       <h2 class="title-cm03"><a href="#">Tin mới</a></h2>

        <div class="mt20">
            @foreach (var item in Model.Take(1).Select((value, i) => new { i, value }))
            {
                <div class="newsnew">
                    <a href="@item.value.LinkUrl" class="img-wrap"><img src="@item.value.MainImage?w=360&h=205&mode=crop" alt=""></a>
                    <div>
                        <h3><a href="@item.value.LinkUrl">@item.value.Title</a></h3>
                        <p class="date mt10">@item.value.PublishDate.ToString("HH:mm - dd/MM/yyyy")</p>
                    </div>
                </div>
            }
            <div class="newsnew-list">
                <ul>
                    @foreach (var item in Model.Skip(1).Select((value, i) => new { i, value }))
                    {
                        <li>
                            <a href="@item.value.LinkUrl" class="img-wrap"><img src="@item.value.MainImage?w=126&h=70&mode=crop" alt=""></a>
                            <div>
                                <a href="@item.value.LinkUrl">@item.value.Title</a>
                                <p class="date mt10">@item.value.PublishDate.ToString("HH:mm - dd/MM/yyyy")</p>
                            </div>
                        </li>
                    }
                    </ul>
            </div>
        </div>






    }
}