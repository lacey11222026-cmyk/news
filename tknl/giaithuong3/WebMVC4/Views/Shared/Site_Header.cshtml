@using UTILS
@using WebMVC4.Helper
@{
    var Date = Utils.formatDateofWeek(DateTime.Now.DayOfWeek) + ", " + DateTime.Now.ToString("dd/MM/yyy ") + "| " + DateTime.Now.ToString("HH:mm");

    var DateEN = DateTime.Now.DayOfWeek.ToString() + ", " + DateTime.Now.ToString("dd/MM/yyy ") + "| " + DateTime.Now.ToString("HH:mm");
}
@{
    var langpage = WorkContext.GetLanguage();
}

<div class="header">
    <div class="container top-logo-pc">
        <div class="top-logo">
            <div>
                <ul class="top-logo-list">
                    <li><a href="/"><img src="/Content/img/top-logo-01.svg" alt="Bộ Công Thương"></a></li>
                    <li><a href="/"><img src="/Content/img/top-logo-02.svg" alt="VECEA"></a></li>
                </ul>
            </div>
            <div>
                <ul class="top-logo-list">
                    <li><a href="/"><img src="/Content/img/top-logo-03.svg" alt="Vneep"></a></li>
                    <li><a href="/"><img src="/Content/img/top-logo-04.svg" alt="Năng lượng Việt Nam"></a></li>
                    <li><a href="/"><img src="/Content/img/top-logo-05.svg" alt="Hiệu suất cao nhất"></a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="nav-pc">
        <div class="container">
            <ul class="nav-pc-content">
                <li><a href="/"><img src="/Content/img/icon-home.svg" alt="Trang chủ"></a></li>
                @{Html.RenderAction("Menu", "Home", new { lang = "vi-vn" });}
            </ul>
        </div>
    </div>

    <div class="nav-mobile">
        <div class="header-m">
            <div>
                <ul class="top-logo-list">
                    <li><a href="/"><img src="/Content/img/top-logo-01.svg" alt="Bộ Công Thương"></a></li>
                    <li><a href="/"><img src="/Content/img/top-logo-02.svg" alt="VECEA"></a></li>
                    <li><a href="/"><img src="/Content/img/top-logo-03.svg" alt="Vneep"></a></li>
                    <li><a href="/"><img src="/Content/img/top-logo-04.svg" alt="Năng lượng Việt Nam"></a></li>
                    <li><a href="/"><img src="/Content/img/top-logo-05.svg" alt="Hiệu suất cao nhất"></a></li>
                </ul>
            </div>
            <div>
                <a href="#menu">
                    <img src="/Content/img/ico-menu.png" class="ico-menu">
                </a>
            </div>
        </div>
        <div id="menu">

            <ul>
                <li><a href="/">Trang chủ</a></li>
                @{Html.RenderAction("MenuMobile", "Home", new { lang = "vi-vn" });}


            </ul>
        </div>
    </div>
</div><!-- end header-->


<script type="text/javascript">
    function search() {
        var searchtext = $("#txtKeyword").val();
        window.location = "/News/Search?q=" + encodeURIComponent(searchtext);

    }
    function AnyInput_KeyDown(sender, e) {
        if ((e.which && e.which == 13) || (e.keyCode && e.keyCode == 13)) {
            search();

            return false;
        }

        return true;
    }


    function Msearch() {
        var searchtext = $("#txtKeywordMobile").val();
        window.location = "/News/Search?q=" + encodeURIComponent(searchtext);

    }
    function MAnyInput_KeyDown(sender, e) {
        if ((e.which && e.which === 13) || (e.keyCode && e.keyCode === 13)) {
            Msearch();

            return false;
        }

        return true;
    }



</script>

