@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewModel
@if (Model != null)
{
    if (Model.lstdata.Count > 0)
    {

        <h2 class="title-cm text-center">Video</h2>
        <div class="mt50 video-wrap">
            <div class="video-list grid-2">
                @foreach (var item in Model.lstdata.Select((value, i) => new { i, value }))
                {
                    <div class="video-item">
                        <a href="/trang-chu-video?VideoId=@(item.value.Id)" class="img-wrap"><img src="@item.value.MainImage?w=500&h=280&mode=crop" alt=""></a>
                        <a href="/trang-chu-video?VideoId=@(item.value.Id)" class="news-txt">@item.value.Title</a>
                    </div>
                }
            </div>

        </div>


        <div class="mt40 text-center"><a href="/trang-chu-video" class="btn-cm btn-green">Xem thêm</a></div>
    }

}




