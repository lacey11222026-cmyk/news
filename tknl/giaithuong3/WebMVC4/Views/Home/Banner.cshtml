@model List<DATA.Banner>

@if (Model != null)
{
    
        foreach (var item in Model.Select((value, i) => new { i, value }))
        {

           

            <div>
                <a href="@item.value.Url">
                <img src="@item.value.Data" alt="" class="hidden-mb">
                <img src="@item.value.Description" alt="" class="block-mb">
                    </a>
            </div>
        }
   

   

}


