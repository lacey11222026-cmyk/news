
@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.LastestNewsApiModel
@if (Model.lstdata != null)
{
    if (Model.lstdata.Count > 0)
    {

        <div class="title-cm01">
            <a href="@Model.Url" target="_blank">@Model.HeaderTitle</a>
        </div>
        foreach (var item in Model.lstdata.Take(1).Select((value, i) => new { i, value }))
        {
            <a href="@item.value.LinkUrl" target="_blank" class="maxheight01 newsbox-content">
                <img src="@item.value.MainImage?w=367&h=206&mode=crop">
                <span>@item.value.Title</span>
            </a>
            <span class="newsdate mt10">@item.value.PublishDate.ToString("dd/MM/yyyy")</span>
        }
        <ul class="newslist-border mt20">
            @foreach (var item in Model.lstdata.Skip(1).Select((value, i) => new { i, value }))
            {
                <li><a href="@item.value.LinkUrl" target="_blank">@item.value.Title</a></li>
            }
        </ul>
        <a href="@Model.Url" target="_blank" class="btn-viewmore mt20">@Resources.Global.More <span>+</span></a>


    }
}