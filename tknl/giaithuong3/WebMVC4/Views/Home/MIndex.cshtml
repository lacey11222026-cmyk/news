@using BIZ
@using UTILS
@using WebMVC4.Helper

@{
    var langpage = WorkContext.GetLanguage();
}


@if (langpage == "vi-vn")
{


    <div class="content01 container mt30">
        <div class="row">
            <div class="col-lg-9 col-md-12">
                @{Html.RenderAction("Slide", "Home", new { lang = langpage });}
            </div>
            <div class="col-lg-3 col-md-12 sidebar-right">
                <div class="gray-box">
                    @Html.Partial("Site_Right")
                </div>
                <div class="gray-box mt20">
                    @{Html.RenderAction("TopDocument", "Home", new { CategoryId = 3, MaxLastestNews = 2 });}
                </div>
            </div>
        </div><!-- end row-->
    </div><!-- end content 01 -->
    <div class="bnrCenter container mt40">
        <div class="bnrSlider">
            @{Html.RenderAction("Banner", "Home", new { lang = langpage });}


        </div>
    </div>

    <div class="content03 mt40 container">
        <div class="row">
            <div class="col-md-4 col-sm-12 newsbox-cm">
                @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 7, MaxLastestNews = 3, cssClass = "maxheight02" });}
            </div>
            <div class="col-sm-12 newsbox-cm">
                @{Html.RenderAction("LastestNewsAPI2", "Home", new { CateName = "", CategoryId = 15, MaxLastestNews = 5, cssClass = "maxheight02", lang = langpage });}
            </div>
            <div class="col-md-4 col-sm-12 newsbox-cm">
                @{Html.RenderAction("LastestNewsAPI", "Home", new { CateName = "", CategoryId = 20, MaxLastestNews = 3, cssClass = "maxheight02", lang = langpage });}
            </div>
            <div class="col-md-4 col-sm-12 newsbox-cm">
                @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 39, MaxLastestNews = 3, cssClass = "maxheight02" });}
            </div>
        </div>
    </div>

    <div class="bnrCenter container mt40">
        <div class="bnrSlider">
            @{Html.RenderAction("Banner2", "Home", new { lang = langpage });}

        </div>
    </div>
    <div class="content04 mt40 container">
        <ul class="video-title nav nav-tabs">
            <li><a href="#video" class="nav-link active" id="video-tab" data-toggle="tab" data-target="#video">Video</a></li>
            <li><a href="#inforgraphic" class="nav-link" id="inforgraphic-tab" data-toggle="tab" data-target="#inforgraphic">INFOGRAPHIC</a></li>
            <li><a href="#podcast" class="nav-link" id="podcast-tab" data-toggle="tab" data-target="#podcast">PODCAST</a></li>
            <li><a href="#e-magazine" class="nav-link" id="e-magazine-tab" data-toggle="tab" data-target="#e-magazine">E-MAGAZINE</a></li>
        </ul>
        <div class="clearfix"></div>

        <div class="tab-content videotabs-content">
            <div class="video-content tab-pane active" id="video">
                @{Html.RenderAction("HomeVideo", "Home", new { CategoryName = "Video", CategoryId = 6, MaxLastestNews = 5 });}
            </div>
            <div class="multimedia-content tab-pane" id="inforgraphic">
                @{Html.RenderAction("LastestNews3", "Home", new { CateName = "", CategoryId = 41, MaxLastestNews = 3, cssClass = "maxheight02" });}

            </div>
            <div class="multimedia-content tab-pane" id="podcast">
                @{Html.RenderAction("Podcast", "Home", new { CategoryId = 42, MaxLastestNews = 3 });}
            </div>
            <div class="multimedia-content tab-pane" id="e-magazine">
                @{Html.RenderAction("Emagazine", "Home", new { CategoryId = 43, MaxLastestNews = 5 });}
            </div>
        </div>
    </div><!-- end content 04-->
    <div class="mt40 content02 container">
        <div class="row">
            <div class="col-lg-8 col-md-12">
                @{Html.RenderAction("LastestNews2", "Home", new { CateName = "", CategoryId = 19, MaxLastestNews = 5, cssClass = "maxheight02" });}
            </div>
            <div class="col-lg-4 col-md-12 col-12 hidden-767">
                <ul class="link-list">
                    @{Html.RenderAction("BannerRight2", "Home", new { lang = langpage });}

                </ul>
            </div>
        </div><!-- end row-->
    </div><!-- end content 02-->
    <div class="content03 mt40 container">
        <div class="row">
            <div class="col-md-4 col-sm-12 newsbox-cm">
                @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 37, MaxLastestNews = 3, cssClass = "maxheight02" });}
            </div>
            <div class="col-md-4 col-sm-12 newsbox-cm">
                @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 17, MaxLastestNews = 3, cssClass = "maxheight02" });}
            </div>
            <div class="col-md-4 col-sm-12 newsbox-cm">
                @{Html.RenderAction("LastestNews", "Home", new { CateName = "", CategoryId = 33, MaxLastestNews = 3, cssClass = "maxheight02" });}
            </div>
        </div>
    </div>
    <div class="container block-767 mt40">
        <div class="linkSlider">
            @{Html.RenderAction("BannerBottom", "Home", new { lang = langpage });}

        </div>
    </div>
}
