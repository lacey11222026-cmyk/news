@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.NewsModel
@if (Model != null)
{

    <div class="mt50 video-list grid-2">
        @foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
        {
            <div class="news-item">
                <a href="/trang-chu-video?VideoId=@(item.value.Id)" class="img-wrap"><img src="@item.value.MainImage?w=550&h=310&mode=crop" alt=""></a>
                <a href="/trang-chu-video?VideoId=@(item.value.Id)" class="news-txt">@item.value.Title</a>
            </div>

        }

    </div>

    <div class="paging mt50 text-center">
        <ul>
            @{Html.RenderPartial("PaginationVideo", new WebMVC4.Models.PaginationInfo
                {
                    PageUrl = Url.SetParameter("Page", "!0"),
                    CurrentPage = Model.pageIndex,
                    PageSize = Model.pageSize,
                    TotalItemCount = Model.total,
                }); }
        </ul>
    </div>

    <script>

        function GoVideoPage(page) {
            var VideoId = '@Model.Id';
            if (page > 0) {
                $.ajax({
                    type: "GET",
                    url: "/Video/LoadVideo/?VideoId=" + VideoId + "&page=" + page,
                    success: function (data) {
                        if (data != "null") {
                            $("#lstVideo").html(data);
                        }
                    }
                });
            }

        }

    </script>
}