@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.AlbumModel
@if (Model.listdata != null)
{

    <div class="news-page pt70 pb70 container">
        @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
        <div class="mt50 news-list grid-3">
            @if (Model.listdata != null)
            {
                foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                {
                    <div class="news-item">
                        <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "AlbumDetail")" class="img-wrap"><img src="@item.value.MainImage?w=398&h=224&mode=crop" alt=""></a>
                        <a href="@Utils.FormatUrlRewrite(item.value.Id, item.value.Title, "AlbumDetail")" class="news-txt-small">@item.value.Title</a>
                    </div>
                }
            }
        </div>
        <div class="paging mt50 text-center">
            <ul>
                @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                    {
                        PageUrl = Url.SetParameter("Page", "!0"),
                        CurrentPage = Model.pageIndex,
                        PageSize = Model.pageSize,
                        TotalItemCount = Model.total,
                    }); }
            </ul>
        </div>


    </div>

    
}