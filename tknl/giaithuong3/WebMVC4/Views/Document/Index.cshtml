@using BIZ
@using UTILS
@using WebMVC4.Helper
@model WebMVC4.Models.DocumentModel

@{
    var langpage = "vi-vn";
}
<div class="pt70 pb70 container">

    @{Html.RenderAction("Breadcrumb", "News", new { CategoryId = Model.CategoryId });}
    <div>

        <div class="filter-wrap mt40">
            @if (ViewBag.ParentCategoryId == 3 || ViewBag.CurrentCategoryId == 3)
            {
                <div class="form-select">
                    <select class="form-control" id="ddlCate">
                        <option value="3">Giải thưởng</option>
                        <option value="15">Giải thưởng HQNL trong Công nghiệp</option>
                        <option value="16">Giải thưởng HQNL trong Xây dựng</option>
                        <option value="17">Giải thưởng Sản phẩm HSNL cao nhất</option>
                        <option value="18">Giải thưởng Giải pháp công nghệ HQNL đổi mới, sáng tạo</option>
                    </select>
                </div>
            }
            @if (ViewBag.ParentCategoryId == 2 || ViewBag.CurrentCategoryId == 2)
            {
                <div class="form-select">
                    <select class="form-control" id="ddlCate">
                        <option value="2">Giải thưởng</option>
                        <option value="20">Giải thưởng HQNL trong Công nghiệp</option>
                        <option value="21">Giải thưởng HQNL trong Xây dựng</option>
                        <option value="22">Giải thưởng Sản phẩm HSNL cao nhất</option>
                        <option value="23">Giải thưởng Giải pháp công nghệ HQNL đổi mới, sáng tạo</option>
                    </select>
                </div>
            }
            <div class="form-select">
                <select class="form-control" id="ddlYear">
                    <option value="">Năm</option>
                    <option @if (ViewBag.year == "2026") { @Html.Raw("selected='selected'") ; } value="2026">2026</option>
                    <option @if (ViewBag.year == "2025") { @Html.Raw("selected='selected'") ; } value="2025">2025</option>
                    <option @if (ViewBag.year == "2024") { @Html.Raw("selected='selected'") ; } value="2024">2024</option>
                    <option @if (ViewBag.year == "2023") { @Html.Raw("selected='selected'") ; } value="2023">2023</option>
                    <option @if (ViewBag.year == "2022") { @Html.Raw("selected='selected'") ; } value="2022">2022</option>
                    <option @if (ViewBag.year == "2021") { @Html.Raw("selected='selected'") ; } value="2021">2021</option>
                    <option @if (ViewBag.year == "2020") { @Html.Raw("selected='selected'") ; } value="2020">2020</option>
                </select>
            </div>
            <div>
                <input id="txtkeyword" class="form-control" value="@ViewBag.keyword" type="text" placeholder="Từ khoá">
            </div>
            @*<div >
            <label class="">Từ ngày:</label>
            <input id="txtfromdate" class="form-control" type="text" placeholder="dd/MM/yyyy" value="@ViewBag.fromdate">
        </div>
        <div >
            <label class="">Đến ngày:</label>
            <input id="txttodate" class="form-control" type="text" placeholder="dd/MM/yyyy" value="@ViewBag.todate">
        </div>*@

            <div>
                <a href="javascript:;" onclick="searchdoc();" class="btn-cm btn-green">Tìm kiếm <span class="icon-search"></span></a>
            </div>
        </div>


        <div class="document-table table-responsive mt40">
            <table>
                <tbody>
                    <tr>
                        <th>STT </th>
                        <th>Số hiệu </th>
                        <th>Tên văn bản </th>
                        <th>Ngày ban hành </th>
                        <th>Download </th>
                    </tr>
                    @if (Model.listdata != null)
                    {


                        foreach (var item in Model.listdata.Select((value, i) => new { i, value }))
                        {
                            <tr>
                                <td style="text-align: center">@(item.i + 1) </td>
                                <td>@item.value.Code</td>
                                <td style="min-width:500px">
                                    <a href="@Url.Action("Detail","Document",new { id=item.value.Id})">
                                        @Html.Raw(item.value.Name)
                                    </a>
                                </td>
                                <td>   @Convert.ToDateTime(item.value.PublishDate).ToString(@" dd'/'MM'/'yyyy") </td>
                                <td>
                                    <ul class="tbl-btn">
                                        <li><a href="@Url.Action("ViewFile", "Document", new {id = item.value.Id})"><span class="view-icon"></span>View Online</a></li>
                                        <li><a href="@Url.Action("DownloadFile", "Document", new {id = item.value.Id})"><span class="download-icon"></span>Download</a></li>
                                    </ul>

                                </td>
                            </tr>
                        }
                    }


                </tbody>
            </table>
        </div>
        <div class="paging mt50 text-right">
            <ul>
                @{Html.RenderPartial("Pagination", new WebMVC4.Models.PaginationInfo
                    {
                        PageUrl = Url.SetParameter("Page", "!0"),
                        CurrentPage = Model.pageIndex,
                        PageSize = Model.pageSize,
                        TotalItemCount = Model.total,
                    }); }
            </ul>
        </div>
    </div>

</div><!-- end content left-->



<script type="text/javascript">


    function searchdoc() {
        var id = '@Model.CategoryId';
        var keyword = $("#txtkeyword").val();
        var fromdate = $("#txtfromdate").val();
        var todate = $("#txttodate").val();
        var year = $("#ddlYear").val();
        var cate = $("#ddlCate").val();
        
        //var agent = $("#ddlAgent").val();
        window.location = '/Document/Index/' + cate + '/?keyword=' + keyword + '&year=' + year  ;
        //window.location = jQuery.query.set("keyword", keyword).set("fromdate", fromdate).set("todate", todate).set("Page", "1");
    }
</script>
<script type="text/javascript">

 $('#menu_' + '@ViewBag.CurrentCategoryId').addClass("active");

  $('#menu_' + '@ViewBag.ParentCategoryId').addClass("active");



</script>