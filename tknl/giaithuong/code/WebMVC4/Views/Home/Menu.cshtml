@using BIZ
@using UTILS
@using WebMVC4.Helper
@model List<BIZ.Entity.CATEGORY_FULL>
<header class="header headernew">
    <div class="header-2019">
        <div class="container">
            <a href="/" class="logo2019 maxheight01"><img src="/Content/images/logo-bct.png" alt="Bộ công thương"></a>
            <div class="title-header maxheight01">
                <h1><img src="/Content/images/congnghesinhhoc.png" alt="Công nghệ sinh học"></h1>
            </div>
        </div>
        <div class="imgtop-wrap">
            <div class="imgtop2019"><img src="/Content/images/banner2019.gif" alt="" class=" pull-right maxheight01"></div>
        </div>
    </div><!-- end header -->
    <div class="clearfix"></div>




    
    <nav class="nav_top">
        <ul class="container">
            <li class="active"><a href="/"><img src="/Content/images/ico-home.png?vs=2019" alt="Trang chủ"></a></li>
            @if (Model != null)
            {

                if (Model.Count > 0)
                {
                    foreach (var item in Model.Select((value, i) => new { i, value }))
                    {

                        <li>
                            <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)" @(item.value.Type.GetValueOrDefault() == 11 ? " target='_blank'" : "")>@item.value.Name </a>
                            @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                        </li>
                    }
                }
            }
        </ul>
    </nav>

</header><!-- end header-->
<div class="nav-mobile">
    <div class="header-m">
        <div class="header-2019">
            <div class="container">
                <a href="index.html" class="logo2019 maxheight01"><img src="images/logo-bct.png" alt="Bộ công thương"></a>
                <div class="title-header maxheight01">
                    <h1><img src="images/congnghesinhhoc.png" alt="Công nghệ sinh học"></h1>
                </div>
            </div>
            <div class="imgtop-wrap">
                <div class="imgtop2019"><img src="images/banner2019.gif" alt="" class=" pull-right maxheight01"></div>
            </div>
        </div><!-- end header -->
        <div class="clearfix"></div>
        <a href="#menu">
            <img src="images/ico-menu.png" class="ico-menu pull-right">
            <span class="clearfix"></span>
        </a>
    </div>
    <div id="menu">
        <ul>
            @if (Model != null)
            {

                if (Model.Count > 0)
                {
                    foreach (var item in Model.Select((value, i) => new { i, value }))
                    {

                        <li>
                            <a href="@Utils.FormatUrlRewriteByType(item.value.Id, item.value.Name, int.Parse(item.value.Type.ToString()), item.value.Link)" @(item.value.Type.GetValueOrDefault() == 11 ? " target='_blank'" : "")>@item.value.Name </a>
                            @Html.Raw(HtmlHelpers.BindChildCategories(Convert.ToInt32(item.value.Id), int.Parse(item.value.Type.ToString())))
                        </li>
                    }
                }
            }
        </ul>
    </div>
</div>




